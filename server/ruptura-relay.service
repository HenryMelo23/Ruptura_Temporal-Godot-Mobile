[Unit]
Description=Ruptura Temporal online relay manager
After=network.target

[Service]
Type=simple
User=ruptura
Group=ruptura
WorkingDirectory=/opt/ruptura/Ruptura_Temporal-Godot-Mobile/server
Environment=PORT=8090
Environment=ROOM_HOST=72.61.217.238
Environment=ROOM_PORT_START=4522
Environment=ROOM_PORT_END=4599
Environment=ROOM_IDLE_MS=14400000
Environment=WARM_STANDBY_ROOMS=1
Environment=GODOT_SILENCE_ROOT_WARNING=1
Environment=GODOT_BIN=/opt/godot/Godot_v4.7-stable_linux.x86_64
Environment=PROJECT_PATH=/opt/ruptura/Ruptura_Temporal-Godot-Mobile
Environment=STREAMING_ENABLED=0
Environment=STREAM_PUBLIC_HOST=72.61.217.238
Environment=STREAM_MANAGER_PUBLIC_BASE_URL=http://72.61.217.238:8090
Environment=STREAM_RTMP_PORT=1935
Environment=STREAM_HLS_PORT=8888
Environment=STREAM_WEBRTC_PORT=8889
ExecStart=/usr/bin/node relay_manager.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
