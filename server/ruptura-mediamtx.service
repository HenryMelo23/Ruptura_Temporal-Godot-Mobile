[Unit]
Description=Ruptura Temporal QA streaming relay
After=network.target

[Service]
Type=simple
User=ruptura
Group=ruptura
WorkingDirectory=/opt/ruptura/Ruptura_Temporal-Godot-Mobile/server
ExecStart=/opt/ruptura/mediamtx/mediamtx /opt/ruptura/Ruptura_Temporal-Godot-Mobile/server/mediamtx.yml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
