func _configure_dedicated_server_timing() -> void :
	Engine.max_fps = DEDICATED_SERVER_NET_FPS
	Engine.physics_ticks_per_second = DEDICATED_SERVER_NET_FPS


func _ready() -> void :
	perf_ready_started_ms = Time.get_ticks_msec()
	var args: Array = OS.get_cmdline_args()
	args.append_array(OS.get_cmdline_user_args())
	if "--dedicated-server" in args:
		_configure_dedicated_server_timing()
		_net_report_start()
		dedicated_server_mode = true
		dedicated_warm_standby = "--warm-standby" in args
		dedicated_room_code = _cmd_arg_value(args, "--room-code=", "ROOM")
		var dedicated_port: = int(_cmd_arg_value(args, "--port=", "4422"))
		mode = "dedicated_server"
		visible = false
		set_process_input(false)
		set_process_unhandled_input(false)
		set_process(true)
		print("ONLINE ROOM: dedicated server %s on port %d" % [dedicated_room_code, dedicated_port])
		call_deferred("_start_dedicated_room_server", dedicated_port)
		return
	_net_report_start()
	font = ThemeDB.fallback_font
	_load_installed_content_packs()
	_load_menu_fonts()
	rng.randomize()
	if _is_mobile_runtime():
		DisplayServer.screen_set_orientation(DisplayServer.SCREEN_SENSOR_LANDSCAPE)

	music_player = AudioStreamPlayer.new()
	music_player.bus = "Master"
	add_child(music_player)
	music_player.finished.connect(_on_music_finished)
	music_crossfade_player = AudioStreamPlayer.new()
	music_crossfade_player.bus = "Master"
	add_child(music_crossfade_player)

	rain_audio_player = AudioStreamPlayer.new()
	rain_audio_player.bus = "Master"
	add_child(rain_audio_player)

	boss1_walk_audio_player = AudioStreamPlayer.new()
	boss1_walk_audio_player.bus = "Master"
	add_child(boss1_walk_audio_player)

	boss1_stop_audio_player = AudioStreamPlayer.new()
	boss1_stop_audio_player.bus = "Master"
	add_child(boss1_stop_audio_player)

	acorrentada_walk_audio_player = AudioStreamPlayer.new()
	acorrentada_walk_audio_player.bus = "Master"
	add_child(acorrentada_walk_audio_player)

	prismatica_ultimate_audio_player = AudioStreamPlayer.new()
	prismatica_ultimate_audio_player.bus = "Master"
	add_child(prismatica_ultimate_audio_player)

	nevasca_audio_player = AudioStreamPlayer.new()
	nevasca_audio_player.bus = "Master"
	add_child(nevasca_audio_player)

	for i in range(12):
		var p = AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		sfx_players.append(p)

	run_report_request = HTTPRequest.new()
	add_child(run_report_request)
	run_report_request.request_completed.connect(_on_run_report_request_completed)

	run_leaderboard_request = HTTPRequest.new()
	add_child(run_leaderboard_request)
	run_leaderboard_request.timeout = 8.0
