func _carousel_diff(index: float, scroll: float, count: int) -> float:
	if count <= 0:
		return 0.0
	var diff = index - scroll
	var half = float(count) * 0.5
	if diff > half:
		diff -= float(count)
	elif diff < - half:
		diff += float(count)
	return diff


