func _try_dash() -> void :
	if _local_player_controls_locked():
		return
	if _is_player_calcified():
		_add_text("CALCIFICADO", player_pos + Vector2(0, -60), Color(0.68, 0.68, 0.72), 0.5, 18)
		return
	if _secondary_player_locked():
		return
	if _player_silenced():
		_show_silenced_feedback()
		return
	if manifestation_key == "retornante" and retornante_tp_window > 0.0:
		_return_retornante_teleport()
		return
	if _teleport_effect_blocks_new_dash():
		return
	if manifestation_key == "lacerante":
		if not _lacerante_tp_available():
			return
		var dir_lacerante = _read_move()
		if dir_lacerante.length() <= 0.05:
			dir_lacerante = last_facing
		_execute_teleport(player_pos + dir_lacerante.normalized() * PLAYER_DASH_DISTANCE)
		_consume_lacerante_tp_charge()
		return
	if time_alive - last_dash_time < _current_dash_cooldown():
		return
	var dir = _read_move()
	if dir.length() <= 0.05:
		dir = last_facing
	_execute_teleport(player_pos + dir.normalized() * PLAYER_DASH_DISTANCE)


func _try_dash_to_screen(screen_pos: Vector2, viewport: Vector2) -> void :
	if _local_player_controls_locked():
		return
	if _is_player_calcified():
		_add_text("CALCIFICADO", player_pos + Vector2(0, -60), Color(0.68, 0.68, 0.72), 0.5, 18)
		return
	if _secondary_player_locked():
		return
	if _player_silenced():
		_show_silenced_feedback()
		return
	if manifestation_key == "retornante" and retornante_tp_window > 0.0:
		_return_retornante_teleport()
		return
	if _teleport_effect_blocks_new_dash():
		return
	if manifestation_key == "lacerante":
		if not _lacerante_tp_available():
			var remaining_lacerante: = _lacerante_tp_remaining_cooldown()
			if remaining_lacerante > 0.0:
				_add_text("%.1fs" % remaining_lacerante, player_pos + Vector2(0, -62), Color(1.0, 0.25, 0.32), 0.45, 18)
			return
		_execute_teleport(_teleport_destination_from_drag(screen_pos, viewport))
		_consume_lacerante_tp_charge()
		return
	if time_alive - last_dash_time < _current_dash_cooldown():
		var remaining = _current_dash_cooldown() - (time_alive - last_dash_time)
		_add_text("%.1fs" % remaining, player_pos + Vector2(0, -62), Color(0.35, 0.95, 1.0), 0.45, 18)
		return
	_execute_teleport(_teleport_destination_from_drag(screen_pos, viewport))


func _try_dash_to_world(target_world: Vector2) -> void :
	if _local_player_controls_locked():
		return
	if _is_player_calcified():
		_add_text("CALCIFICADO", player_pos + Vector2(0, -60), Color(0.68, 0.68, 0.72), 0.5, 18)
		return
	if _secondary_player_locked():
		return
	if _player_silenced():
		_show_silenced_feedback()
		return
	if manifestation_key == "retornante" and retornante_tp_window > 0.0:
		_return_retornante_teleport()
		return
	if _teleport_effect_blocks_new_dash():
		return
	var destination: Vector2 = player_pos + (target_world - player_pos).limit_length(PLAYER_DASH_DISTANCE)
	if manifestation_key == "lacerante":
		if not _lacerante_tp_available():
			var remaining_lacerante: = _lacerante_tp_remaining_cooldown()
			if remaining_lacerante > 0.0:
				_add_text("%.1fs" % remaining_lacerante, player_pos + Vector2(0, -62), Color(1.0, 0.25, 0.32), 0.45, 18)
			return
		_execute_teleport(destination)
		_consume_lacerante_tp_charge()
		return
	if time_alive - last_dash_time < _current_dash_cooldown():
		var remaining = _current_dash_cooldown() - (time_alive - last_dash_time)
		_add_text("%.1fs" % remaining, player_pos + Vector2(0, -62), Color(0.35, 0.95, 1.0), 0.45, 18)
		return
	_execute_teleport(destination)


func _update_lacerante_tp_state(delta: float) -> void :
	if manifestation_key != "lacerante":
		return
	if lacerante_tp_chain_timer > 0.0:
		lacerante_tp_chain_timer = max(0.0, lacerante_tp_chain_timer - delta)
	if not tp_cooldown_pending and lacerante_tp_chain_timer <= 0.0 and lacerante_tp_charges < LACERANTE_TP_MAX_CHARGES and time_alive >= lacerante_tp_cooldown_until:
		lacerante_tp_charges = LACERANTE_TP_MAX_CHARGES


func _lacerante_tp_available() -> bool:
	if manifestation_key != "lacerante":
		return false
	if tp_cooldown_pending:
		return lacerante_tp_chain_timer > 0.0 and lacerante_tp_charges > 0
	return lacerante_tp_charges > 0 and time_alive >= lacerante_tp_cooldown_until


func _lacerante_tp_remaining_cooldown() -> float:
	if tp_cooldown_pending and lacerante_tp_chain_timer > 0.0:
		return 0.0 if lacerante_tp_charges > 0 else LACERANTE_TP_CHAIN_COOLDOWN
	return max(0.0, lacerante_tp_cooldown_until - time_alive)


func _start_direct_teleport_cooldown() -> void :
	last_dash_time = time_alive
	tp_cooldown_release_time = time_alive + _current_dash_cooldown()


func _release_direct_teleport_cooldown() -> void :
	tp_cooldown_pending = false
	tp_cooldown_override = -1.0
	tp_cooldown_release_time = -1.0


func _consume_lacerante_tp_charge() -> void :
	lacerante_tp_charges = maxi(0, lacerante_tp_charges - 1)
	if tp_cooldown_pending:
		lacerante_tp_chain_timer = LACERANTE_TP_CHAIN_WINDOW if lacerante_tp_charges > 0 else 0.0
		return
	lacerante_tp_chain_timer = LACERANTE_TP_CHAIN_WINDOW if lacerante_tp_charges > 0 else 0.0


func _cartografica_has_active_pin() -> bool:
	return manifestation_key == "cartografica" and carto_tp_window > 0.0


func _start_cartografica_teleport_pin(origin: Vector2, destination: Vector2) -> void:
	carto_tp_origin = origin
	carto_tp_pin = _clamp_player_world(destination)
	carto_tp_window = 2.5
	_add_cartographic_coord(carto_tp_pin, -1, "fixed", "teleport")
	cartographic_route_timer = max(cartographic_route_timer, 0.75)
	tp_effects.append({"kind": "cartografica_pin", "life": carto_tp_window, "max": carto_tp_window, "pos": carto_tp_pin})
	_add_text("PIN CARTOGRAFICO", carto_tp_pin + Vector2(0, -92), Color(0.38, 1.0, 0.82), 0.9, 18)


func _execute_cartografica_pin_teleport(origin: Vector2) -> void:
	var destination: Vector2 = _clamp_player_world(carto_tp_pin)
	carto_tp_window = 0.0
	carto_tp_pin = Vector2.ZERO
	player_pos = destination
	tp_cooldown_pending = true
	tp_cooldown_override = 6.0
	tp_cooldown_release_time = -1.0
	tp_effects = tp_effects.filter(func(effect): return String(effect.get("kind", "")) != "cartografica_pin")
	tp_effects.append({"kind": "cartografica", "life": 0.62, "max": 0.62, "a": origin, "b": destination})
	_send_network_ability_visual(NET_ABILITY_TELEPORT, origin, player_pos, 0.55)
	_add_text("TRACADO CUMPRIDO", player_pos + Vector2(0, -92), Color(0.38, 1.0, 0.82), 0.9, 18)


func _teleport_destination_from_drag(screen_pos: Vector2, viewport: Vector2) -> Vector2:
	var drag = screen_pos - _dash_center(viewport)
	var dir = drag.normalized()
	if drag.length() <= 8.0:
		dir = _aim_direction()
	var strength = clamp(drag.length() / 64.0, 0.46, 1.0)
	if drag.length() <= 8.0:
		strength = 1.0
	return player_pos + dir * PLAYER_DASH_DISTANCE * strength


func _ground_target_profile(secondary: bool) -> Dictionary:
	if secondary:
		match manifestation_key:
			"lacerante":
				return {"range": 520.0, "radius": 220.0, "default": 170.0, "minimum": 60.0, "color": Color(1.0, 0.18, 0.28)}
