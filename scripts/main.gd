@rpc("any_peer", "call_remote", "reliable", 3)
func _rpc_request_team_revive(dead_peer_id: int, cost: int) -> void :
	if dedicated_server_mode:
		var sender: = _mp_sender_id()
		if sender == 0:
			return
		if _is_dedicated_spectator(sender):
