				draw_arc(pos, radius * 0.68, t * 1.2, t * 1.2 + PI * 1.3, 36, Color(0.44, 0.92, 1.0, 0.38 * ratio), 2.0)
			"cinzas":
				draw_arc(pos, radius, t * 3.0, t * 3.0 + PI * 1.45, 40, Color(1.0, 0.58, 0.28, 0.58 * ratio), 3.0)
