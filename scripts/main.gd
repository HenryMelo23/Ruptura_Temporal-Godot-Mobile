func _apply_boss_poison() -> void :
	boss_poison_timer = max(boss_poison_timer, 3.2)
	if boss_poison_tick <= 0.0:
		boss_poison_tick = 0.65


func _update_boss_poison(delta: float) -> void :
	if boss_poison_timer <= 0.0 or poison_damage <= 0.0 or boss_hp <= 0.0:
		return
	boss_poison_timer = max(0.0, boss_poison_timer - delta)
	boss_poison_tick -= delta
	if boss_poison_tick > 0.0:
		return
	boss_poison_tick = 0.65
	var poison_tick_damage = max(1.0, player_damage * poison_damage)
	_damage_boss(poison_tick_damage, "veneno")


func _boss_execute_threshold() -> float:
	if execute_threshold <= 0.0:
		return 0.0
	var collector_cards: = int(cards_bought.get("Coletora", 0))
	return min(execute_threshold * 0.2 + float(collector_cards) * 0.01, 0.08)


func _find_cout_reconstitutor(enemy: Dictionary) -> Dictionary:
	var kill_pos: = Vector2(enemy.get("pos", player_pos))
	for caster in enemies:
		if caster == enemy:
			continue
		if String(caster.get("type", "")) != ENEMY_COUT_ATTACK_SPEED:
			continue
		if float(caster.get("hp", 0.0)) <= 0.0:
			continue
		if kill_pos.distance_to(Vector2(caster.get("pos", kill_pos))) <= COUT_AS_AURA_RADIUS:
			return caster
	return {}


func _try_reconstitute_enemy(enemy: Dictionary) -> bool:
	if bool(enemy.get("no_reconstitute", false)):
		return false
	if bool(enemy.get("reconstituted_once", false)):
		return false
	if String(enemy.get("type", "")) == ENEMY_COUT_ATTACK_SPEED:
		return false
	var caster: = _find_cout_reconstitutor(enemy)
	if caster.is_empty():
		return false
	var max_hp: float = max(1.0, float(enemy.get("max_hp", enemy_base_hp)))
	enemy["hp"] = max_hp * COUT_AS_RECONSTITUTE_HP_RATIO
	enemy["speed"] = max(float(enemy.get("speed", enemy_speed_base)) * COUT_AS_RECONSTITUTE_SPEED_MULT, enemy_speed_base * 1.05)
	enemy["damage"] = float(enemy.get("damage", enemy_close_damage + 10.0)) * 1.08
	enemy["reconstitute_time"] = COUT_AS_RECONSTITUTE_TIME
	enemy["reconstitute_immunity"] = COUT_AS_RECONSTITUTE_TIME + COUT_AS_RECONSTITUTE_IMMUNITY_TIME
	enemy["reconstituted_by"] = int(caster.get("uid", 0))
	enemy["reconstituted_once"] = true
	enemy["stun"] = max(float(enemy.get("stun", 0.0)), 0.22)
	caster["reconstitute_pulse"] = 0.55
	_add_text("RECONSTITUIDO", Vector2(enemy["pos"]) + Vector2(-68, -72), Color(1.0, 0.54, 0.12), 0.9, 17)
	_spawn_radial_particles(Vector2(enemy["pos"]), Color(1.0, 0.48, 0.12), 18)
	shockwaves.append({"pos": Vector2(enemy["pos"]), "radius": 12.0, "max": 118.0, "life": 0.42, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(1.0, 0.42, 0.1)})
	return true


func _kill_enemy(enemy: Dictionary) -> void :
	if not enemies.has(enemy):
		return
	var kill_pos: Vector2 = enemy["pos"]
	if bool(enemy.get("aguilhao_nodule", false)):
		_spawn_enemy_desfragmentation(kill_pos, Color(0.56, 1.0, 0.2), 18)
		arauto_echo_breaks.append({"pos": kill_pos, "life": 0.5, "max": 0.5, "phase": rng.randf_range(0.0, TAU), "color": Color(0.56, 1.0, 0.2)})
		_add_text("NODULO ROMPIDO", kill_pos + Vector2(-58, -58), Color(0.64, 1.0, 0.24), 0.78, 16)
		enemies.erase(enemy)
		return
	if bool(enemy.get("skip_rewards", false)):
		enemies.erase(enemy)
		return
	if _try_reconstitute_enemy(enemy):
		return
	_try_gain_eclipsada_trait(enemy)
	_necronada_on_enemy_killed(enemy)
	_handle_devorador_enemy_death(enemy)
	_register_valid_necro_kill(enemy)
	_sanguinaria_handle_enemy_kill(enemy)
	if String(enemy.get("killed_by_source", "")).begins_with("lacerante") or (manifestation_key == "lacerante" and not is_multiplayer):
		_play_sfx("lacerante_kill", 0.025, 0.94, rng.randf_range(0.94, 1.04))
	_apply_aura_events(AuraSystem.on_enemy_killed(aura_state, enemy))
	var shard_color = _enemy_shard_color(enemy)
	if bool(enemy.get("eco_vinculado", false)):
		arauto_echo_breaks.append({"pos": kill_pos, "life": 0.5, "max": 0.5, "phase": rng.randf_range(0.0, TAU)})
		_add_text("ECO ROMPIDO", kill_pos + Vector2(-48, -58), Color(0.58, 0.92, 1.0), 0.75, 16)
	if String(enemy.get("type", "")) == ENEMY_DEVOTO:
		_add_phase3_miasma(kill_pos, 52.0, 2.0, 0.018)
	enemies.erase(enemy)
	_tutorial_enemy_was_killed(enemy)
	enemies_killed += 1
	_maybe_grant_enemy_spectral_core(enemy, kill_pos)
	_add_card_unlock_progress("enemy_kills", 1.0)
	_contractual_order_progress("kill", 1)
	var gain = _points_for_enemy(enemy)
	if manifestation_key == "lacerante" and _is_uncommon_enemy(enemy):
		var base_gain = gain
		gain = int(round(float(gain) * LACERANTE_UNCOMMON_POINTS_MULT))
		_add_text("CACADA +%d" % (gain - base_gain), kill_pos + Vector2(0, -88), Color(1.0, 0.36, 0.3), 0.85, 17)
	var mercenary_level = int(cards_bought.get("Mercenaria", 0))
	if mercenary_level > 0:
		combo_kills += 1
		gain += mercenary_bonus_points
		if combo_kills % 5 == 0:
			var contract_value = 25 + 40 * mercenary_level
			mercenary_bonus_points = min(500, mercenary_bonus_points + contract_value)
			mercenary_hud_pulse = 1.0
			_add_text("MERCENARIA +%d" % mercenary_bonus_points, kill_pos + Vector2(0, -96), Color(1.0, 0.62, 0.16), 0.9, 19)
	_apply_score_delta(gain)
	_add_text("+%d" % gain, kill_pos + Vector2(0, -64), Color(1.0, 0.85, 0.18), 0.8, 18)
	_spawn_enemy_desfragmentation(kill_pos, shard_color, 14 + int(clamp(float(enemy.get("max_hp", 0.0)) / 18.0, 0.0, 12.0)))
	if enemy["type"] == ENEMY_AGGLOMERATOR:
		for i in range(2):
			_spawn_enemy(ENEMY_COMMON, kill_pos + Vector2.from_angle(rng.randf_range(0, TAU)) * 42.0)
	if enemy["type"] == ENEMY_CURATER:
		_spawn_heal_orb(kill_pos, 0.2)
		var heal = int((player_hp_max - player_hp) * 0.5)
		if heal > 0:
			_heal_player(heal, "curater", true)
			_add_text("CURATER +%d" % heal, player_pos + Vector2(0, -78), Color(0.28, 1.0, 0.45), 1.0, 20)
	if enemy["type"] == ENEMY_LARAPIO:
		_play_sfx("Larapio-Dead.mp3", 0.025, 0.82, 1.0)
		var clean_kill: = int(enemy.get("stolen", 0)) <= 0
		var drop_count: = LARAPIO_CARD_DROP_CLEAN if clean_kill else LARAPIO_CARD_DROP_BASE
		var rare_slots: = 0
		if rng.randf() < LARAPIO_CARD_RARE_CHANCE:
			rare_slots += 1
		if clean_kill and rng.randf() < LARAPIO_CARD_RARE_CHANCE:
			rare_slots += 1
		_spawn_random_card_drops(kill_pos, drop_count, rare_slots)
		_schedule_next_larapio_spawn()
		_add_text("%d CARTAS" % drop_count, kill_pos + Vector2(0, -132), Color(1.0, 0.86, 0.24), 1.25, 22)
		if clean_kill:
			_add_text("SEM ROUBO: DROP MELHOR", kill_pos + Vector2(0, -164), Color(0.58, 1.0, 0.82), 1.25, 18)
		_spawn_heal_orb(kill_pos, 0.08)
		var returned = int(round(float(enemy.get("stolen", 0)) * (LARAPIO_LOOT_RETURN_RATIO + LARAPIO_LOOT_BONUS_RATIO)))
		if returned > 0:
			_spawn_larapio_loot(kill_pos, returned)
			_add_text("MOEDAS NO CHAO", kill_pos + Vector2(0, -88), Color(1.0, 0.78, 0.24), 1.0, 20)
	_maybe_spawn_late_heal_orb(enemy, kill_pos)
	if int(enemy.get("seeds", 0)) > 0:
		var spreads = 0
		for other in enemies:
			if other == enemy or float(other.get("hp", 0.0)) <= 0.0:
				continue
			if kill_pos.distance_to(other["pos"]) <= 180.0:
				other["seeds"] = min(5, int(other.get("seeds", 0)) + 1)
				other["parasite_mark_time"] = PARASITE_MARK_DURATION
				spreads += 1
				if spreads >= 2:
					break
		if spreads > 0:
			_spawn_radial_particles(kill_pos, Color(0.48, 1.0, 0.42), 10)
			_add_text("ESPALHOU x%d" % spreads, kill_pos + Vector2(0, -96), Color(0.58, 1.0, 0.46), 0.8, 18)
	if rng.randf() < _card_drop_chance():
		_spawn_heal_orb(kill_pos, 0.08)
	var threat = int(enemies_killed / 10)
	var mult = 1.0 + threat * 0.1
	enemy_base_hp += 0.62 * mult
	enemy_close_damage += 0.07 * mult
	enemy_far_damage += 0.022 * mult
	player_damage += 0.06 * mult
	enemy_speed_base = min(300.0, enemy_speed_base + 0.009)
	if not boss_active and not boss_dead:
		boss_hp_max = _boss_hp_for_phase(current_phase)
		boss_hp = boss_hp_max


func _points_for_enemy(enemy: Dictionary) -> int:
	var mult = _long_run_point_multiplier()
	var base_points: = float(enemy.get("points", 20)) * _elite_point_multiplier(enemy)
	return max(int(enemy.get("points", 20)), int(round(base_points * mult)))


func _long_run_point_multiplier() -> float:
	var minutes: float = maxf(0.0, time_alive / 60.0)
	var mult: float = POINT_REWARD_BASE_MULT + minutes * POINT_REWARD_PER_MINUTE
	if minutes > POINT_REWARD_LATE_START_MINUTES:
		mult += (minutes - POINT_REWARD_LATE_START_MINUTES) * POINT_REWARD_LATE_PER_MINUTE
	return clampf(mult, POINT_REWARD_BASE_MULT, POINT_REWARD_MAX_MULT)


func _next_score_event_id() -> String:
	score_event_sequence += 1
	return "%d:%d" % [_mp_unique_id(), score_event_sequence]


func _mark_score_event_applied(event_id: String) -> bool:
	if event_id == "":
		return true
	if applied_score_event_ids.has(event_id):
		return false
	applied_score_event_ids[event_id] = Time.get_ticks_msec()
	if applied_score_event_ids.size() > 256:
		var keys: Array = applied_score_event_ids.keys()
		keys.sort()
		while applied_score_event_ids.size() > 192 and not keys.is_empty():
			applied_score_event_ids.erase(keys.pop_front())
	return true


func _apply_score_delta(amount: int, broadcast: = true, event_id: String = "") -> void :
	if amount == 0:
		return
	# Replicas request local rewards; confirmed RPC credits apply without rebroadcast.
	if is_multiplayer and _is_world_replica() and broadcast:
		if amount > 0 and broadcast and _shop_rpc_available():
			rpc("_rpc_request_score_delta", amount, event_id if event_id != "" else _next_score_event_id())
		return
	if not _mark_score_event_applied(event_id):
		return
	score = max(0, score + amount)
	score_total = max(0, score_total + amount)
	if amount > 0:
		run_points_earned += amount
	else:
		run_points_spent += abs(amount)
	if amount > 0 and broadcast and is_multiplayer and _is_world_authority() and _shop_rpc_available():
		rpc("_rpc_add_score", amount, event_id if event_id != "" else _next_score_event_id())


func _elite_point_multiplier(enemy: Dictionary) -> float:
	match String(enemy.get("type", ENEMY_COMMON)):
		ENEMY_AGGLOMERATOR:
			return 1.55
		ENEMY_CURATER:
			return 1.38
		ENEMY_CRYSTAL:
			return 1.32
		ENEMY_PROJECTOR:
			return 1.26
		ENEMY_STALKER:
			return 1.18
		ENEMY_LARAPIO:
			return 1.45
		ENEMY_KAMIKAZE, ENEMY_ATIRADOR:
			return 1.12
	if _is_uncommon_enemy(enemy):
		return 1.22
	return 1.0


func _is_uncommon_enemy(enemy: Dictionary) -> bool:
	return String(enemy.get("type", ENEMY_COMMON)) != ENEMY_COMMON


func _maybe_spawn_late_heal_orb(enemy: Dictionary, pos: Vector2) -> void :
	if time_alive < 600.0:
		return
	var late_progress: float = clamp((time_alive - 600.0) / 600.0, 0.0, 1.0)
	var chance: float = 0.08 + late_progress * 0.1
	var heal_fraction: float = 0.07
	if _is_uncommon_enemy(enemy):
		chance += 0.07
		heal_fraction = 0.1
	if rng.randf() <= chance:
		_spawn_heal_orb(pos, heal_fraction)
		_add_text("SUSTENTO", pos + Vector2(0, -104), Color(0.38, 1.0, 0.52), 0.75, 17)


func _grant_boss_reward_cards(count: int, rare_slots: = BOSS_REWARD_RARE_COUNT) -> int:
	var picked: = _pick_boss_reward_cards(count, rare_slots)
	for card in picked:
		_apply_card(card)
	return picked.size()


func _pick_boss_reward_cards(count: int, rare_slots: = BOSS_REWARD_RARE_COUNT) -> Array:
	var picked: Array = []
	var rare_pool: Array = CARDS.filter( func(card): return _card_available_for_reward(card, true, false) and _is_rare_card(card))
	var common_pool: Array = CARDS.filter( func(card): return _card_available_for_reward(card, true, false) and _is_common_card(card))
	var fallback_pool: Array = CARDS.filter( func(card): return _card_available_for_reward(card, true, false))
	var remaining_rares: = rare_slots
	while remaining_rares > 0 and picked.size() < count and not rare_pool.is_empty():
		var rare_index: = rng.randi_range(0, rare_pool.size() - 1)
		var card: Dictionary = rare_pool[rare_index]
		rare_pool.remove_at(rare_index)
		fallback_pool.erase(card)
		picked.append(card)
		remaining_rares -= 1
	while picked.size() < count and not common_pool.is_empty():
		var common_index: = rng.randi_range(0, common_pool.size() - 1)
		var card: Dictionary = common_pool[common_index]
		common_pool.remove_at(common_index)
		fallback_pool.erase(card)
		picked.append(card)
	while picked.size() < count and not fallback_pool.is_empty():
		var index: = rng.randi_range(0, fallback_pool.size() - 1)
		var card: Dictionary = fallback_pool[index]
		fallback_pool.remove_at(index)
		picked.append(card)
	return picked


func _card_drop_chance() -> float:
	var progress = clamp(time_alive / (120.0 * 60.0), 0.0, 1.0)
	return clamp(0.045 + (0.4 - 0.045) * progress + luck * 0.25, 0.0, 0.7)


func _update_enemy_bullets(delta: float) -> void :
	if not _is_world_authority():
		return
	for bullet in enemy_bullets:
		var previous_bullet_pos: = Vector2(bullet.get("pos", player_pos))
		var bullet_type: = String(bullet.get("type", ""))
		var slow_mult = _secondary_ancorada_projectile_slow_at(Vector2(bullet["pos"]))
		if bullet_type == "boss4_comet":
			var comet_target: Vector2 = _boss_target_pos(true, 0.12)
			var desired_dir: Vector2 = (comet_target - Vector2(bullet["pos"])).normalized()
			var comet_dir: Vector2 = Vector2(bullet.get("dir", Vector2.LEFT)).normalized()
			if desired_dir.length() > 0.01:
				comet_dir = comet_dir.lerp(desired_dir, clampf(delta * 2.7, 0.0, 0.22)).normalized()
			bullet["dir"] = comet_dir
		bullet["pos"] += bullet["dir"] * 210.0 * slow_mult * float(bullet.get("speed_mult", 1.0)) * AuraSystem.world_multiplier(aura_state) * delta
		bullet["life"] = float(bullet["life"]) - delta
		bullet["phase"] = float(bullet.get("phase", 0.0)) + delta * 9.0
		if bullet_type == "boss7_dive_fireball":
			_update_boss7_dive_fireball_projectile(bullet, previous_bullet_pos)
			continue
		if bullet_type == "pyro_wall_seed":
			var last_wall_pos: = Vector2(bullet.get("last_wall_pos", bullet["pos"]))
			var current_pos: = Vector2(bullet["pos"])
			var travel: = current_pos - last_wall_pos
			while travel.length() >= PYRO_WALL_TILE_SIZE:
				last_wall_pos += travel.normalized() * PYRO_WALL_TILE_SIZE
				_add_phase2_fire_wall_tile(last_wall_pos)
				travel = current_pos - last_wall_pos
			bullet["last_wall_pos"] = last_wall_pos
		if bullet_type == "frost_shard":
			bullet["trail_cd"] = float(bullet.get("trail_cd", 0.0)) - delta
			if float(bullet["trail_cd"]) <= 0.0:
				bullet["trail_cd"] = 0.08
				_spawn_boss2_slow_zone(Vector2(bullet["pos"]), rng.randf_range(14.0, 20.0), 1.25)
		var bullet_hit_radius: = float(bullet.get("hit_radius", bullet.get("radius", 34.0)))
		_track_probability_near_miss(bullet, previous_bullet_pos, bullet_hit_radius)
		var remnant_hit: = _damage_remnant_from_enemy_bullet(bullet, bullet_hit_radius)
		if not remnant_hit and bullet["pos"].distance_to(player_pos) < bullet_hit_radius:
			bullet["probability_near_miss_registered"] = true
			bullet_type = String(bullet.get("type", "projetador"))
			var hit_was_blocked: = _player_invulnerable()
			_damage_player(int(bullet["damage"]), bullet_type, true)
			if current_phase == 5 and not hit_was_blocked:
				_increase_umbra_cadence(0.09)
			if bullet_type == "pyro_wall_seed":
				_add_phase2_fire_wall_tile(Vector2(bullet["pos"]))
			elif current_phase == 2:
				_apply_phase2_projectile_freeze()
			elif bullet_type == "miasma_cheese_spit":
				player_stun_timer = max(player_stun_timer, _hostile_control_duration(0.9))
				_add_text("COLADO 0.9s", player_pos + Vector2(0, -52), Color(0.84, 1.0, 0.24), 0.9, 18)
			elif bullet_type == "rat_spit":
				player_stun_timer = max(player_stun_timer, _hostile_control_duration(0.8))
				_add_phase3_miasma(Vector2(bullet["pos"]), 48.0, 1.9, 0.018)
				bullet["exploded"] = true
				_add_text("DOENCA", player_pos + Vector2(0, -44), Color(0.64, 1.0, 0.22), 0.9, 18)
			elif bullet_type == "phase4_magic" and not hit_was_blocked:
				_teleport_player_from_phase4_magic()
			elif bullet_type == "larapio_coin" or bullet_type == "larapio_stone":
				_apply_larapio_projectile_hit(bullet)
			bullet["life"] = 0.0
		else:
			var bullet_target_peer: = _remote_peer_in_radius(Vector2(bullet["pos"]), bullet_hit_radius)
			if bullet_target_peer != 0:
				bullet_type = String(bullet.get("type", "projetador"))
				_send_peer_damage(bullet_target_peer, int(bullet["damage"]), bullet_type, true)
				if bullet_type == "pyro_wall_seed":
					_add_phase2_fire_wall_tile(Vector2(bullet["pos"]))
				elif bullet_type == "rat_spit":
					_add_phase3_miasma(Vector2(bullet["pos"]), 48.0, 1.9, 0.018)
					bullet["exploded"] = true
				bullet["life"] = 0.0
		if float(bullet["life"]) <= 0.0 and String(bullet.get("type", "")) == "rat_spit" and not bool(bullet.get("exploded", false)):
			_add_phase3_miasma(Vector2(bullet["pos"]), 48.0, 1.9, 0.018)
			bullet["exploded"] = true
		if float(bullet["life"]) <= 0.0 and bool(bullet.get("probability_entered_near_zone", false)) and not bool(bullet.get("probability_near_miss_registered", false)):
			bullet["probability_near_miss_registered"] = true
			_gain_desvio_charge(Vector2(bullet.get("pos", player_pos)))
	enemy_bullets = enemy_bullets.filter( func(b): return float(b["life"]) > 0.0)


func _enemy_bullet_should_end_on_remnant_hit(bullet_type: String) -> bool:
	return bullet_type not in [
		"boss6_carnage_slime", 
		"boss6_carnage_pool"
	]


func _damage_remnant_from_enemy_bullet(bullet: Dictionary, hit_radius: float) -> bool:
	if necronada_remnants.is_empty():
		return false
	var bullet_pos: = Vector2(bullet.get("pos", player_pos))
	var bullet_type: = String(bullet.get("type", "projetador"))
	var closest_remnant: = {}
	var closest_dist: = INF
	for remnant in necronada_remnants:
		if float(remnant.get("hp", 0.0)) <= 0.0 or float(remnant.get("summon", 0.0)) > 0.0:
			continue
		var remnant_pos: = Vector2(remnant.get("pos", player_pos))
		var dist: = remnant_pos.distance_to(bullet_pos)
		if dist <= hit_radius + 18.0 and dist < closest_dist:
			closest_dist = dist
			closest_remnant = remnant
	if closest_remnant.is_empty():
		return false
	var damage: = maxf(1.0, float(bullet.get("damage", 1.0)) * 0.8)
	_damage_necronada_remnant(closest_remnant, damage)
	var hit_pos: = Vector2(closest_remnant.get("pos", bullet_pos))
	_add_text("-%d" % int(damage), hit_pos + Vector2(0, -42), Color(1.0, 0.35, 0.35), 0.45, 15)
	_spawn_radial_particles(hit_pos, Color(0.92, 0.25, 0.36), 7)
	if bullet_type == "pyro_wall_seed":
		_add_phase2_fire_wall_tile(bullet_pos)
	elif bullet_type == "rat_spit":
		_add_phase3_miasma(bullet_pos, 48.0, 1.9, 0.018)
		bullet["exploded"] = true
	if _enemy_bullet_should_end_on_remnant_hit(bullet_type):
		bullet["life"] = 0.0
	return true


func _teleport_player_from_phase4_magic() -> void :
	var old_pos: Vector2 = player_pos
	player_pos = Vector2(
		rng.randf_range(90.0, WORLD_SIZE.x - 90.0), 
		rng.randf_range(100.0, WORLD_SIZE.y - 90.0)
	)
	_spawn_radial_particles(old_pos, Color(0.7, 0.18, 1.0), 18)
	_spawn_radial_particles(player_pos, Color(1.0, 0.72, 0.18), 22)
	_add_text("DESLOCADO PELO NEXO", player_pos + Vector2(0, -78), Color(0.92, 0.72, 1.0), 1.1, 20)
	_vibrate(120, 0.48)


func _spawn_phase4_rift(enemy: Dictionary) -> void :
	var start: Vector2 = Vector2(enemy["pos"])
	var predicted: = (player_pos + last_facing.normalized() * 150.0).clamp(Vector2(80, 80), WORLD_SIZE - Vector2(80, 80))
	var duration: = PHASE4_RIFT_WARNING + _hostile_ground_hazard_duration(PHASE4_RIFT_ACTIVE_TIME)
	_add_phase4_hazard({"kind": "rift", "a": start, "b": predicted, "age": 0.0, "life": duration, "max": duration, "warning": PHASE4_RIFT_WARNING, "triggered": false, "phase": rng.randf_range(0.0, TAU)})
	_add_text("MAPA SENDO RASGADO", start + Vector2(0, -82), Color(0.9, 0.38, 1.0), 0.9, 17)


func _spawn_phase4_chrono_pulse(enemy: Dictionary) -> void :
	var duration: = PHASE4_CHRONO_WARNING + _hostile_ground_hazard_duration(0.45)
	_add_phase4_hazard({"kind": "chrono", "pos": Vector2(enemy["pos"]), "age": 0.0, "life": duration, "max": duration, "warning": PHASE4_CHRONO_WARNING, "triggered": false, "radius": 230.0})
	_add_text("CRONOFAGIA", Vector2(enemy["pos"]) + Vector2(0, -84), Color(1.0, 0.72, 0.18), 1.0, 18)


func _spawn_phase4_hostile_prism(enemy: Dictionary) -> void :
	var center: = Vector2(enemy["pos"]).lerp(player_pos, 0.42).clamp(Vector2(90, 90), WORLD_SIZE - Vector2(90, 90))
	var duration: = _hostile_ground_hazard_duration(5.0)
	_add_phase4_hazard({"kind": "hostile_prism", "pos": center, "age": 0.0, "life": duration, "max": duration, "shot_cd": 0.65, "phase": rng.randf_range(0.0, TAU)})
	_add_text("PRISMA HOSTIL", center + Vector2(0, -76), Color(0.38, 0.92, 1.0), 0.9, 17)


func _spawn_phase4_vector_field(enemy: Dictionary) -> void :
	var center: = player_pos.clamp(Vector2(100, 100), WORLD_SIZE - Vector2(100, 100))
	var duration: = _hostile_ground_hazard_duration(PHASE4_VECTOR_FIELD_TIME)
	_add_phase4_hazard({"kind": "vector", "pos": center, "age": 0.0, "life": duration, "max": duration, "radius": PHASE4_VECTOR_FIELD_RADIUS, "spin": -1.0 if rng.randf() < 0.5 else 1.0})
	_add_text("VETORES INCLINADOS", center + Vector2(0, - PHASE4_VECTOR_FIELD_RADIUS - 24), Color(0.2, 1.0, 0.72), 1.0, 17)


func _spawn_phase4_echo_sequence(enemy: Dictionary) -> void :
	var samples = []
	if phase4_player_history.is_empty():
		samples = [player_pos, player_pos - last_facing * 70.0, player_pos - last_facing * 140.0]
	else:
		for offset in [0, 4, 8]:
			var index: int = maxi(0, phase4_player_history.size() - 1 - offset)
			samples.append(Vector2(phase4_player_history[index]))
	for i in range(samples.size()):
		var warning: = PHASE4_ECHO_WARNING + float(i) * 0.22
		var duration: = warning + _hostile_ground_hazard_duration(0.3)
		_add_phase4_hazard({"kind": "echo", "pos": Vector2(samples[i]), "age": 0.0, "life": duration, "max": duration, "warning": warning, "triggered": false, "radius": 54.0})
	_add_text("SEU PASSADO FOI GRAVADO", Vector2(enemy["pos"]) + Vector2(0, -84), Color(1.0, 0.34, 0.72), 1.0, 17)


func _phase4_vector_rotation() -> float:
	if current_phase != 4:
		return 0.0
	for hazard in phase4_enemy_hazards:
		if String(hazard.get("kind", "")) == "vector" and float(hazard.get("life", 0.0)) > 0.0 and player_pos.distance_to(Vector2(hazard["pos"])) <= float(hazard.get("radius", PHASE4_VECTOR_FIELD_RADIUS)):
			return deg_to_rad(38.0) * float(hazard.get("spin", 1.0))
	return 0.0


func _spawn_phase4_prism_volley(hazard: Dictionary) -> void :
	var origin: Vector2 = Vector2(hazard["pos"])
	var base_dir: = (player_pos - origin).normalized()
	if base_dir.length() <= 0.01:
		base_dir = Vector2.RIGHT
	for offset in [-0.3, 0.0, 0.3]:
		enemy_bullets.append({"pos": origin, "dir": base_dir.rotated(float(offset)), "life": 5.0, "damage": player_hp_max * 0.075 + enemy_far_damage * 0.55, "phase": rng.randf_range(0.0, TAU), "type": "nexus_refracted", "speed_mult": 1.12})


func _apply_phase4_chrono_theft() -> void :
	last_attack_time += 0.65
	last_skill_time += 1.1
	last_secondary_time += 1.1
	last_dash_time += 1.1
	if manifestation_key == "lacerante":
		lacerante_tp_cooldown_until += 1.1
	_add_text("RECARGAS DEVORADAS", player_pos + Vector2(0, -92), Color(1.0, 0.58, 0.16), 1.1, 20)
	_vibrate(85, 0.34)


func _update_boss4_column_barrage_hazard(hazard: Dictionary) -> void :
	var step: float = maxf(0.1, float(hazard.get("step", BOSS4_COLUMN_BARRAGE_STEP)))
	var columns: int = maxi(1, int(hazard.get("columns", 1)))
	var index: int = clampi(int(floor(float(hazard.get("age", 0.0)) / step)), 0, columns - 1)
	var local_age: float = fposmod(float(hazard.get("age", 0.0)), step)
	if index != int(hazard.get("last_index", -1)):
		hazard["last_index"] = index
		var pulse_x: float = float(hazard.get("start_x", player_pos.x)) - float(index) * float(hazard.get("width", BOSS4_COLUMN_BARRAGE_WIDTH))
		for y_factor in [0.18, 0.42, 0.66, 0.88]:
			_spawn_radial_particles(Vector2(pulse_x, WORLD_SIZE.y * float(y_factor)), Color(1.0, 0.66, 0.18), 5)
	if local_age < float(hazard.get("warning", BOSS4_COLUMN_BARRAGE_WARNING)):
		return
	var width: float = float(hazard.get("width", BOSS4_COLUMN_BARRAGE_WIDTH))
	var x: float = float(hazard.get("start_x", WORLD_SIZE.x * 0.5)) - float(index) * width
	var damage: = _boss4_column_damage()
	var hit_key: = "hit_%d" % index
	if not bool(hazard.get(hit_key, false)) and abs(player_pos.x - x) <= width * 0.5 + 18.0:
		hazard[hit_key] = true
		_damage_player(damage, "bombardeio_nexo")
		boss_wave_slow_timer = max(boss_wave_slow_timer, BOSS4_COLUMN_BARRAGE_SLOW_TIME)
		_spawn_boss4_column_laser(player_pos)
		_spawn_radial_particles(player_pos, Color(1.0, 0.58, 0.16), 26)
		_vibrate(190, 0.78)
	if _remote_player_damage_ready():
		for peer_id in _targetable_remote_peer_ids():
			var peer_key: = "%s_peer_%d" % [hit_key, peer_id]
			if bool(hazard.get(peer_key, false)):
				continue
			var state: Dictionary = net_players_by_peer.get(peer_id, {})
			var remote_pos: = Vector2(state.get("pos", Vector2(-10000, -10000)))
			if abs(remote_pos.x - x) <= width * 0.5 + 18.0:
				hazard[peer_key] = true
				_send_peer_damage(peer_id, damage, "bombardeio_nexo")
				_request_peer_status(peer_id, "slow", BOSS4_COLUMN_BARRAGE_SLOW_TIME)


func _update_boss4_column_laser_hazard(hazard: Dictionary) -> void :
	if bool(hazard.get("triggered", false)) or float(hazard.get("age", 0.0)) < float(hazard.get("warning", BOSS4_COLUMN_LASER_WARNING)):
		return
	hazard["triggered"] = true
	var origin: Vector2 = Vector2(hazard.get("origin", boss_pos))
	var target: Vector2 = Vector2(hazard.get("target", player_pos))
	var dir: Vector2 = (target - origin).normalized()
	if dir.length() <= 0.01:
		dir = Vector2.LEFT
	var a: Vector2 = origin - dir * 40.0
	var b: Vector2 = origin + dir * 1180.0
	var damage: = int(player_hp_max * 0.14 + 76.0 + enemy_far_damage * 0.35)
	if _distance_to_segment(player_pos, a, b) <= 34.0:
		_damage_player(damage, "laser_nexo")
		_vibrate(210, 0.72)
		_spawn_radial_particles(player_pos, Color(0.4, 1.0, 0.92), 20)
	_damage_remote_player_on_segment(a, b, 34.0, damage, "laser_nexo", hazard, "hit_remote")


func _update_boss4_drag_wave_hazard(hazard: Dictionary, delta: float) -> void :
	var width: float = float(hazard.get("width", BOSS4_DRAG_WAVE_WIDTH))
	var x: float = float(hazard.get("start_x", WORLD_SIZE.x + 80.0)) - float(hazard.get("speed", BOSS4_DRAG_WAVE_SPEED)) * float(hazard.get("age", 0.0))
	hazard["x"] = x
	if not bool(hazard.get("hit", false)) and abs(player_pos.x - x) <= width * 0.5 + 18.0:
		hazard["hit"] = true
		hazard["drag_timer"] = BOSS4_DRAG_WAVE_TIME
		hazard["life"] = max(float(hazard.get("life", 0.0)), BOSS4_DRAG_WAVE_TIME)
		hazard["max"] = max(float(hazard.get("max", 1.0)), BOSS4_DRAG_WAVE_TIME)
		_add_text("ARRASTO DO NEXO", player_pos + Vector2(0, -86), Color(0.48, 1.0, 0.84), 0.9, 19)
		_vibrate(120, 0.48)
	if bool(hazard.get("hit", false)):
		hazard["drag_timer"] = max(0.0, float(hazard.get("drag_timer", 0.0)) - delta)
		player_pos = _clamp_player_world(player_pos + _hostile_knockback(Vector2.LEFT * BOSS4_DRAG_WAVE_FORCE * delta))
		if float(hazard.get("drag_timer", 0.0)) <= 0.0:
			hazard["life"] = min(float(hazard.get("life", 0.0)), 0.18)
	elif _remote_player_damage_ready():
		for peer_id in _targetable_remote_peer_ids():
			var peer_key: = "drag_peer_%d" % peer_id
			if bool(hazard.get(peer_key, false)):
				continue
			var state: Dictionary = net_players_by_peer.get(peer_id, {})
			var remote_pos: = Vector2(state.get("pos", Vector2(-10000, -10000)))
			if abs(remote_pos.x - x) <= width * 0.5 + 18.0:
				hazard[peer_key] = true
				_request_peer_status(peer_id, "slow", BOSS4_DRAG_WAVE_TIME)


func _update_boss4_sonic_wave_hazard(hazard: Dictionary, delta: float) -> void :
	var age: float = float(hazard.get("age", 0.0))
	var warning: float = float(hazard.get("warning", BOSS4_SONIC_WARNING))
	var width: float = float(hazard.get("width", BOSS4_SONIC_WIDTH))
	if not bool(hazard.get("grabbed", false)):
		if age < warning:
			return
		var a: Vector2 = Vector2(hazard.get("a", boss_pos))
		var b: Vector2 = Vector2(hazard.get("b", boss_pos + Vector2.LEFT * 900.0))
		if _distance_to_segment(player_pos, a, b) <= width:
			hazard["grabbed"] = true
			hazard["life"] = max(float(hazard.get("life", 0.0)), BOSS4_SONIC_GRAB_TIME)
			hazard["max"] = max(float(hazard.get("max", 1.0)), BOSS4_SONIC_GRAB_TIME + warning)
			hazard["target_y"] = 82.0 if player_pos.y > WORLD_SIZE.y * 0.5 else WORLD_SIZE.y - 82.0
			player_stun_timer = max(player_stun_timer, 0.2)
			_add_text("LEVITACAO SONICA", player_pos + Vector2(0, -96), Color(0.54, 1.0, 0.92), 0.9, 19)
		else:
			hazard["life"] = min(float(hazard.get("life", 0.0)), 0.16)
		return
	hazard["grab_timer"] = max(0.0, float(hazard.get("grab_timer", BOSS4_SONIC_GRAB_TIME)) - delta)
	hazard["slam_timer"] = float(hazard.get("slam_timer", 0.0)) - delta
	player_stun_timer = max(player_stun_timer, 0.1)
	var target_y: float = float(hazard.get("target_y", 82.0))
	player_pos = _clamp_player_world(player_pos.lerp(Vector2(player_pos.x, target_y), clampf(delta * 6.8, 0.0, 1.0)))
	if float(hazard.get("slam_timer", 0.0)) <= 0.0 or abs(player_pos.y - target_y) <= 13.0:
		var slam_index: int = int(hazard.get("slam_index", 0))
		if slam_index < BOSS4_SONIC_SLAMS:
			hazard["slam_index"] = slam_index + 1
			hazard["slam_timer"] = 0.58
			hazard["target_y"] = WORLD_SIZE.y - 82.0 if target_y < WORLD_SIZE.y * 0.5 else 82.0
			_damage_player(int(player_hp_max * 0.08 + 42.0), "onda_sonica_nexo")
			_spawn_radial_particles(player_pos, Color(0.54, 1.0, 0.92), 24)
			_vibrate(170, 0.66)
	if int(hazard.get("slam_index", 0)) >= BOSS4_SONIC_SLAMS or float(hazard.get("grab_timer", 0.0)) <= 0.0:
		hazard["life"] = min(float(hazard.get("life", 0.0)), 0.18)


func _boss4_gravity_laser_segment(hazard: Dictionary) -> Array:
	var origin: Vector2 = Vector2(hazard.get("origin", boss_pos))
	var dir: Vector2 = Vector2(hazard.get("dir", Vector2.LEFT)).normalized()
	if dir.length() <= 0.01:
		dir = Vector2.LEFT
	return [origin - dir * 64.0, origin + dir * 1380.0]


func _update_boss4_gravity_laser_hazard(hazard: Dictionary) -> void :
	if bool(hazard.get("triggered", false)) or float(hazard.get("age", 0.0)) < float(hazard.get("warning", BOSS4_GRAVITY_LASER_WARNING)):
		return
	hazard["triggered"] = true
	var segment: = _boss4_gravity_laser_segment(hazard)
	var a: Vector2 = segment[0]
	var b: Vector2 = segment[1]
	var width: float = float(hazard.get("width", BOSS4_GRAVITY_LASER_WIDTH))
	var damage: = int(hazard.get("damage", _boss4_gravity_laser_damage(bool(hazard.get("ultimate", false)))))
	if _distance_to_segment(player_pos, a, b) <= width:
		_damage_player(damage, "laser_gravitacional_nexo")
		_vibrate(230 if bool(hazard.get("ultimate", false)) else 145, 0.78)
		_spawn_radial_particles(player_pos, Color(0.52, 1.0, 0.96), 22)
	_damage_remote_player_on_segment(a, b, width, damage, "laser_gravitacional_nexo", hazard, "hit_remote")


func _update_boss4_gravity_well_hazard(hazard: Dictionary, delta: float) -> void :
	var warning: float = float(hazard.get("warning", BOSS4_GRAVITY_WELL_WARNING))
	if float(hazard.get("age", 0.0)) < warning:
		return
	var center: Vector2 = Vector2(hazard.get("pos", boss_pos))
	var radius: float = float(hazard.get("radius", BOSS4_GRAVITY_WELL_RADIUS))
	var dist: float = player_pos.distance_to(center)
	if dist <= radius and dist > 4.0:
		var pull_strength: float = 190.0 + boss4_instability * 1.1
		player_pos = _clamp_player_world(player_pos + _hostile_knockback((center - player_pos).normalized() * pull_strength * delta))
	hazard["tick"] = float(hazard.get("tick", 0.0)) - delta
	if float(hazard.get("tick", 0.0)) <= 0.0:
		hazard["tick"] = 0.42
		var damage: = int(player_hp_max * 0.035 + 16.0)
		if dist <= radius * 0.72:
			_damage_player(damage, "poco_gravitacional_nexo")
			_increase_boss4_instability(0.7)
		if _damage_remote_player_in_radius(center, radius * 0.72, damage, "poco_gravitacional_nexo"):
			_increase_boss4_instability(0.35)


func _update_phase4_enemy_hazards(delta: float) -> void :
	phase4_history_sample_timer -= delta
	if phase4_history_sample_timer <= 0.0:
		phase4_history_sample_timer = 0.18
		phase4_player_history.append(player_pos)
		if phase4_player_history.size() > 18:
			phase4_player_history.pop_front()
	for hazard in phase4_enemy_hazards:
		hazard["age"] = float(hazard.get("age", 0.0)) + delta
		hazard["life"] = float(hazard.get("life", 0.0)) - delta
		if _is_world_replica():
			continue
		match String(hazard.get("kind", "")):
			"rift":
				if float(hazard["age"]) >= float(hazard.get("warning", PHASE4_RIFT_WARNING)) and not bool(hazard.get("triggered", false)) and _distance_to_segment(player_pos, Vector2(hazard["a"]), Vector2(hazard["b"])) <= 22.0:
					hazard["triggered"] = true
					var line_dir: Vector2 = (Vector2(hazard["b"]) - Vector2(hazard["a"])).normalized()
					var side: = line_dir.orthogonal()
					if side.dot(player_pos - Vector2(hazard["a"])) < 0.0:
						side = - side
					player_pos = _clamp_player_world(player_pos + _hostile_knockback(side * 145.0))
					_damage_player(int(player_hp_max * 0.055 + 18.0), "fenda_nexo")
				_damage_remote_player_on_segment(Vector2(hazard["a"]), Vector2(hazard["b"]), 22.0, int(player_hp_max * 0.055 + 18.0), "fenda_nexo", hazard, "triggered_remote")
			"chrono":
				if not bool(hazard.get("triggered", false)) and float(hazard["age"]) >= float(hazard.get("warning", PHASE4_CHRONO_WARNING)):
					hazard["triggered"] = true
					if player_pos.distance_to(Vector2(hazard["pos"])) <= float(hazard["radius"]):
						_apply_phase4_chrono_theft()
			"hostile_prism":
				hazard["shot_cd"] = float(hazard.get("shot_cd", 0.0)) - delta
				if float(hazard["shot_cd"]) <= 0.0:
					hazard["shot_cd"] = 1.35
					_spawn_phase4_prism_volley(hazard)
			"echo":
				if not bool(hazard.get("triggered", false)) and float(hazard["age"]) >= float(hazard["warning"]):
					hazard["triggered"] = true
					if player_pos.distance_to(Vector2(hazard["pos"])) <= float(hazard["radius"]):
						_damage_player(int(player_hp_max * 0.08 + 24.0), "eco_entropico")
						_vibrate(55, 0.25)
					_damage_remote_player_in_radius(Vector2(hazard["pos"]), float(hazard["radius"]), int(player_hp_max * 0.08 + 24.0), "eco_entropico", hazard, "triggered_remote")
			"boss4_pulse":
				if not bool(hazard.get("triggered", false)) and float(hazard["age"]) >= float(hazard.get("warning", BOSS4_PULSE_WARNING)):
					hazard["triggered"] = true
					var center: = Vector2(hazard["pos"])
					var radius: = float(hazard.get("radius", BOSS4_PULSE_RADIUS))
					if player_pos.distance_to(center) <= radius:
						var push: = (player_pos - center).normalized()
						if push.length() <= 0.01:
							push = Vector2.LEFT
						player_pos = _clamp_player_world(player_pos + _hostile_knockback(push * 185.0))
						_damage_player(int(player_hp_max * 0.07 + 32.0), "pulso_nexo")
						_vibrate(120, 0.55)
					_damage_remote_player_in_radius(center, radius, int(player_hp_max * 0.07 + 32.0), "pulso_nexo", hazard, "triggered_remote")
			"boss4_fissure":
				if float(hazard["age"]) >= float(hazard.get("warning", PHASE4_RIFT_WARNING)) and not bool(hazard.get("triggered", false)) and _distance_to_segment(player_pos, Vector2(hazard["a"]), Vector2(hazard["b"])) <= 28.0:
					hazard["triggered"] = true
					if bool(hazard.get("teleport", false)):
						player_pos = _safe_random_world_point_near(player_pos, 240.0)
						_add_text("RASGO ESPACIAL", player_pos + Vector2(0, -78), Color(1.0, 0.42, 0.94), 0.75, 18)
					_damage_player(int(player_hp_max * 0.075 + 34.0), "fenda_boss4")
					_increase_boss4_instability(4.0)
				if _damage_remote_player_on_segment(Vector2(hazard["a"]), Vector2(hazard["b"]), 28.0, int(player_hp_max * 0.075 + 34.0), "fenda_boss4", hazard, "triggered_remote"):
					_increase_boss4_instability(2.0)
			"boss4_vector":
				if float(hazard["age"]) >= float(hazard.get("warning", BOSS4_VECTOR_WARNING)) and _distance_to_segment(player_pos, Vector2(hazard["pos"]) - Vector2(hazard["dir"]) * 720.0, Vector2(hazard["pos"]) + Vector2(hazard["dir"]) * 720.0) <= (26.0 if bool(hazard.get("elite", false)) else 20.0):
					if not bool(hazard.get("triggered", false)):
						hazard["triggered"] = true
						player_pos = _safe_random_world_point_near(player_pos, 300.0)
						_damage_player(int(player_hp_max * (0.1 if bool(hazard.get("elite", false)) else 0.07) + 42.0), "vetor_nexo")
						_increase_boss4_instability(5.5)
					hazard["life"] = min(float(hazard["life"]), 0.22)
				if _damage_remote_player_on_segment(Vector2(hazard["pos"]) - Vector2(hazard["dir"]) * 720.0, Vector2(hazard["pos"]) + Vector2(hazard["dir"]) * 720.0, 26.0 if bool(hazard.get("elite", false)) else 20.0, int(player_hp_max * (0.1 if bool(hazard.get("elite", false)) else 0.07) + 42.0), "vetor_nexo", hazard, "triggered_remote"):
					hazard["life"] = min(float(hazard["life"]), 0.22)
			"boss4_fragment":
				if not bool(hazard.get("triggered", false)) and float(hazard["age"]) >= float(hazard.get("warning", BOSS4_FRAGMENT_WARNING)):
					hazard["triggered"] = true
					var radius_f: = float(hazard.get("radius", 58.0))
					if player_pos.distance_to(Vector2(hazard["pos"])) <= radius_f:
						_damage_player(int(player_hp_max * 0.09 + 44.0), "fragmento_cosmico")
						_vibrate(100, 0.5)
					_damage_remote_player_in_radius(Vector2(hazard["pos"]), radius_f, int(player_hp_max * 0.09 + 44.0), "fragmento_cosmico", hazard, "triggered_remote")
					if bool(hazard.get("barrier", false)):
						hazard["life"] = max(float(hazard["life"]), 2.4)
						hazard["max"] = max(float(hazard.get("max", 1.0)), 2.4)
					else:
						hazard["life"] = min(float(hazard["life"]), 0.35)
			"boss4_collapse":
				hazard["tick"] = float(hazard.get("tick", 0.0)) - delta
				if float(hazard["tick"]) <= 0.0:
					hazard["tick"] = 0.42
					if player_pos.distance_to(Vector2(hazard["pos"])) <= float(hazard.get("radius", 110.0)):
						_damage_player(int(player_hp_max * 0.035 + 14.0), "mapa_colapso")
						_increase_boss4_instability(0.8)
					if _damage_remote_player_in_radius(Vector2(hazard["pos"]), float(hazard.get("radius", 110.0)), int(player_hp_max * 0.035 + 14.0), "mapa_colapso"):
						_increase_boss4_instability(0.4)
			"safe_zone":
				if player_pos.distance_to(Vector2(hazard["pos"])) <= float(hazard.get("radius", 112.0)):
					_decrease_boss4_instability(delta * 6.0)
			"boss4_column_barrage":
				_update_boss4_column_barrage_hazard(hazard)
			"boss4_column_laser":
				_update_boss4_column_laser_hazard(hazard)
			"boss4_drag_wave":
				_update_boss4_drag_wave_hazard(hazard, delta)
			"boss4_sonic_wave":
				_update_boss4_sonic_wave_hazard(hazard, delta)
			"boss4_gravity_laser":
				_update_boss4_gravity_laser_hazard(hazard)
			"boss4_gravity_well":
				_update_boss4_gravity_well_hazard(hazard, delta)
			"boss4_bubble":
				_update_boss4_bubble_hazard(hazard)
			"boss4_ultimate_ray":
				_update_boss4_ultimate_ray_hazard(hazard)
			"boss4_meteor_shockwave":
				if not bool(hazard.get("triggered", false)) and float(hazard.get("age", 0.0)) >= float(hazard.get("warning", 0.12)):
					hazard["triggered"] = true
					var shock_pos: Vector2 = Vector2(hazard.get("pos", player_pos))
					var shock_radius: float = float(hazard.get("radius", BOSS4_METEOR_SHOCKWAVE_RADIUS))
					var shock_damage: int = _boss4_damage(0.09, 38.0)
					if player_pos.distance_to(shock_pos) <= shock_radius:
						_damage_player(shock_damage, "onda_meteorito")
						_vibrate(135, 0.5)
					_damage_remote_player_in_radius(shock_pos, shock_radius, shock_damage, "onda_meteorito", hazard, "hit_remote")
	phase4_enemy_hazards = phase4_enemy_hazards.filter( func(hazard): return float(hazard.get("life", 0.0)) > 0.0)


func _update_phase4_environment(delta: float) -> void :
	if current_phase != 4:
		return
	_update_phase4_enemy_hazards(delta)
	for planet in phase4_planets:
		planet["life"] = float(planet.get("life", 0.0)) - delta
		planet["phase"] = float(planet.get("phase", 0.0)) + delta * 7.0
		var desired: = (player_pos - Vector2(planet["pos"])).normalized()
		var current_dir: = Vector2(planet.get("dir", desired)).normalized()
		planet["dir"] = current_dir.lerp(desired, clamp(delta * 2.35, 0.0, 1.0)).normalized()
		planet["pos"] = Vector2(planet["pos"]) + Vector2(planet["dir"]) * BOSS4_PLANET_SPEED * delta
		if not bool(planet.get("destroyed", false)) and Vector2(planet["pos"]).distance_to(player_pos) <= 48.0:
			planet["destroyed"] = true
			planet["life"] = 0.0
			_damage_player(int(player_hp_max * 0.25 + player_hp * 0.1 + enemy_far_damage), "planeta_nexo")
			_spawn_radial_particles(Vector2(planet["pos"]), Color(1.0, 0.58, 0.18), 24)
		if not bool(planet.get("destroyed", false)) and _damage_remote_player_in_radius(Vector2(planet["pos"]), 48.0, int(player_hp_max * 0.25 + enemy_far_damage), "planeta_nexo", planet, "hit_remote"):
			planet["destroyed"] = true
			planet["life"] = 0.0
			_spawn_radial_particles(Vector2(planet["pos"]), Color(1.0, 0.58, 0.18), 18)
		if float(planet["life"]) <= 0.0 and not bool(planet.get("destroyed", false)):
			planet["destroyed"] = true
			_add_phase4_null_zone(Vector2(planet["pos"]))
	phase4_planets = phase4_planets.filter( func(planet): return float(planet.get("life", 0.0)) > 0.0)

	for zone in phase4_null_zones:
		zone["life"] = float(zone.get("life", 0.0)) - delta
		zone["tick"] = float(zone.get("tick", 0.0)) - delta
		zone["remote_tick"] = max(0.0, float(zone.get("remote_tick", 0.0)) - delta)
		zone["phase"] = float(zone.get("phase", 0.0)) + delta * 2.0
		var zone_pos: = Vector2(zone["pos"])
		var dist: = player_pos.distance_to(zone_pos)
		if dist <= float(zone.get("radius", 92.0)) * 1.22 and dist > 4.0:
			player_pos = _clamp_player_world(player_pos + _hostile_knockback((zone_pos - player_pos).normalized() * (34.0 + boss4_instability * 0.28) * delta))
		if float(zone["tick"]) <= 0.0 and player_pos.distance_to(Vector2(zone["pos"])) <= float(zone.get("radius", 92.0)):
			zone["tick"] = BOSS4_NULL_ZONE_TICK
			_damage_player(max(1, int(player_hp_max * BOSS4_NULL_ZONE_DAMAGE_RATE)), "zona_nula")
			_add_text("NULO", player_pos + Vector2(0, -58), Color(0.76, 0.38, 1.0), 0.55, 18)
		if float(zone["remote_tick"]) <= 0.0 and net_player_pos.distance_to(Vector2(zone["pos"])) <= float(zone.get("radius", 92.0)):
			zone["remote_tick"] = BOSS4_NULL_ZONE_TICK
			_damage_remote_player(max(1, int(player_hp_max * BOSS4_NULL_ZONE_DAMAGE_RATE)), "zona_nula")
	phase4_null_zones = phase4_null_zones.filter( func(zone): return float(zone.get("life", 0.0)) > 0.0)


func _add_phase4_null_zone(pos: Vector2) -> void :
	phase4_null_zones.append({
		"pos": pos.clamp(Vector2(90, 90), WORLD_SIZE - Vector2(90, 90)), 
		"radius": 92.0, 
		"life": BOSS4_NULL_ZONE_DURATION, 
		"max": BOSS4_NULL_ZONE_DURATION, 
		"tick": 0.0, 
		"phase": rng.randf_range(0.0, TAU)
	})
	_play_sfx("Portal.mp3", 0.04, 0.54, 0.72)


func _damage_phase4_planet_at(pos: Vector2, amount: float, radius: float) -> bool:
	if current_phase != 4:
		return false
	var hit: = false
	if _damage_boss4_anchor_at(pos, amount, radius + 18.0):
		hit = true
	if _damage_boss4_prison_at(pos, amount, radius):
		hit = true
	if _damage_boss4_clone_at(pos, amount, radius):
		hit = true
	for planet in phase4_planets:
		if bool(planet.get("destroyed", false)) or Vector2(planet["pos"]).distance_to(pos) > radius:
			continue
		planet["hp"] = float(planet.get("hp", BOSS4_PLANET_HP)) - amount
		_add_text("-%d" % int(amount), Vector2(planet["pos"]) + Vector2(0, -58), Color(1.0, 0.84, 0.28), 0.48, 16)
		if float(planet["hp"]) <= 0.0:
			planet["destroyed"] = true
			planet["life"] = 0.0
			_spawn_radial_particles(Vector2(planet["pos"]), Color(0.86, 0.4, 1.0), 28)
			_add_text("PLANETA ROMPIDO", Vector2(planet["pos"]) + Vector2(0, -82), Color(1.0, 0.82, 0.28), 0.9, 19)
			hit = true
	for meteor in boss4_meteorites:
		if bool(meteor.get("destroyed", false)) or not bool(meteor.get("impacted", false)):
			continue
		var meteor_pos: Vector2 = Vector2(meteor.get("pos", Vector2.ZERO))
		if meteor_pos.distance_to(pos) > radius + BOSS4_METEOR_RADIUS * 0.42:
			continue
		meteor["hp"] = float(meteor.get("hp", BOSS4_METEOR_HP)) - amount
		_add_text("-%d" % int(amount), meteor_pos + Vector2(0, -72), Color(1.0, 0.84, 0.28), 0.42, 16)
		_spawn_radial_particles(meteor_pos, Color(1.0, 0.72, 0.2), 5)
		if float(meteor["hp"]) <= 0.0:
			meteor["destroyed"] = true
			_spawn_radial_particles(meteor_pos, Color(0.42, 0.9, 1.0), 32)
			_add_text("METEORITO DESTRUIDO", meteor_pos + Vector2(0, -96), Color(0.54, 1.0, 0.92), 0.9, 18)
			hit = true
	return hit


func _damage_boss4_anchor_at(pos: Vector2, amount: float, radius: float) -> bool:
	if not boss4_ultimate_active:
		return false
	for anchor in boss4_rupture_anchors:
		if bool(anchor.get("destroyed", false)) or Vector2(anchor["pos"]).distance_to(pos) > radius:
			continue
		anchor["hp"] = float(anchor.get("hp", BOSS4_ULTIMATE_ANCHOR_HP)) - amount
		_add_text("-%d" % int(amount), Vector2(anchor["pos"]) + Vector2(0, -62), Color(1.0, 0.78, 0.18), 0.48, 16)
		if float(anchor["hp"]) <= 0.0:
			anchor["destroyed"] = true
			boss4_ultimate_destroyed += 1
			_decrease_boss4_instability(8.0)
			_spawn_radial_particles(Vector2(anchor["pos"]), Color(1.0, 0.74, 0.18), 34)
			_add_text("%s ROMPIDA" % String(anchor.get("name", "ANCORA")), Vector2(anchor["pos"]) + Vector2(0, -86), Color(1.0, 0.88, 0.42), 0.9, 18)
		return true
	return false


func _damage_boss4_prison_at(pos: Vector2, amount: float, radius: float) -> bool:
	if boss4_prison.is_empty():
		return false
	var center: Vector2 = Vector2(boss4_prison.get("pos", player_pos))
	if pos.distance_to(center) > radius + 74.0:
		return false
	var fragments: int = max(0, int(boss4_prison.get("fragments", 0)) - 1)
	boss4_prison["fragments"] = fragments
	_spawn_radial_particles(center + Vector2.from_angle(rng.randf_range(0.0, TAU)) * 58.0, Color(0.82, 0.42, 1.0), 10)
	_add_text("FRAGMENTO %d" % fragments, center + Vector2(0, -96), Color(0.9, 0.72, 1.0), 0.45, 15)
	return true


func _damage_boss4_clone_at(pos: Vector2, amount: float, radius: float) -> bool:
	if boss4_clone.is_empty():
		return false
	if pos.distance_to(Vector2(boss4_clone.get("pos", player_pos))) > radius + 34.0:
		return false
	boss4_clone["hp"] = float(boss4_clone.get("hp", 0.0)) - amount
	if float(boss4_clone["hp"]) <= 0.0:
		var clone_pos: = Vector2(boss4_clone["pos"])
		boss4_clone.clear()
		_decrease_boss4_instability(7.0)
		phase4_enemy_hazards.append({"kind": "safe_zone", "pos": clone_pos, "age": 0.0, "life": 3.0, "max": 3.0, "radius": 112.0})
		_spawn_radial_particles(clone_pos, Color(0.42, 1.0, 0.92), 24)
	return true


func _safe_random_world_point_near(origin: Vector2, distance: float) -> Vector2:
	var angle: = rng.randf_range(0.0, TAU)
	return (origin + Vector2.from_angle(angle) * rng.randf_range(distance * 0.45, distance)).clamp(Vector2(70, 80), WORLD_SIZE - Vector2(70, 80))


func _apply_larapio_projectile_hit(bullet: Dictionary) -> void :
	if _player_invulnerable():
		return
	var bullet_type: = String(bullet.get("type", "larapio_stone"))
	var laugh_sfx: = "Risada-Moeda.mp3" if bullet_type == "larapio_coin" else "Risada-Pedra.mp3"
	var owner_found: = false
	var dist = 0.0
	if bullet.has("spawn_pos") and bullet.has("pos"):
		dist = Vector2(bullet["spawn_pos"]).distance_to(Vector2(bullet["pos"]))
	var extra_stun = clamp(dist / 250.0, 0.0, 3.0)
	player_stun_timer = max(player_stun_timer, _hostile_control_duration(LARAPIO_STUN_TIME + extra_stun))
	screen_shake_timer = max(screen_shake_timer, 0.22)
	screen_shake_strength = max(screen_shake_strength, 10.0)
	_vibrate(170, 0.62)
	_add_text("ATORDOADO 1.4s", player_pos + Vector2(0, -76), Color(1.0, 0.36, 0.28), 0.9, 19)
	for enemy in enemies:
		if int(enemy.get("uid", -999)) == int(bullet.get("owner_uid", -1)) and String(enemy.get("type", "")) == ENEMY_LARAPIO:
			owner_found = true
			_play_larapio_sfx(enemy, laugh_sfx, 0.86, 1.0, true)
			enemy["alerted"] = true
			enemy["direct_steal"] = true
			enemy["steal_cd"] = 0.0
			enemy["throw_cd"] = LARAPIO_THROW_INTERVAL
			break
	if not owner_found:
		_play_sfx(laugh_sfx, 0.035, 0.82, 1.0)


func _apply_phase2_projectile_freeze() -> void :
	_freeze_player(PHASE2_FREEZE_VISUAL_MIN_TIME, "CONGELADO!")


func _freeze_player(duration: float, label: = "CONGELADO!") -> void :
	if _player_invulnerable():
		return
	if player_control_immunity_timer > 0.0:
		_add_text("IMUNE!", player_pos + Vector2(0, -42), Color(0.7, 0.9, 1.0), 0.6, 18)
		return
	var freeze_time: = maxf(PHASE2_FREEZE_VISUAL_MIN_TIME, duration)
	_play_sfx("Congelando.mp3", 0.05, 0.75, 1.0)
	player_stun_timer = max(player_stun_timer, _hostile_control_duration(freeze_time))
	player_control_immunity_timer = player_stun_timer + 3.0
	player_freeze_visual_duration = freeze_time
	player_freeze_visual_timer = freeze_time
	_add_text(label, player_pos + Vector2(0, -42), Color(0.0, 0.88, 1.0), 1.0, 20)
	_spawn_radial_particles(player_pos, Color(0.62, 0.9, 1.0), 10)


func _frozen_player_frame_index() -> int:
	var elapsed: = maxf(0.0, player_freeze_visual_duration - player_freeze_visual_timer)
	if elapsed < 0.7:
		return 0
	if elapsed < 1.0:
		return 1
	if elapsed < 1.3:
		return 0
	if elapsed < 1.6:
		return 1
	return 0


func _update_boss2_environment(delta: float) -> void :
	if current_phase != 2 and boss2_ice_shards.is_empty() and boss2_snow_zones.is_empty() and boss2_frost_particles.is_empty():
		return
	var kept_shards = []
	for shard in boss2_ice_shards:
		shard["pos"] = Vector2(shard["pos"]) + Vector2(shard["vel"]) * delta
		shard["vel"] = Vector2(shard["vel"]) + Vector2(0, 260.0) * delta
		shard["life"] = float(shard["life"]) - delta
		if float(shard["life"]) > 0.0:
			kept_shards.append(shard)
	boss2_ice_shards = kept_shards
	var kept_zones = []
	for zone in boss2_snow_zones:
		zone["life"] = float(zone["life"]) - delta
		if float(zone["life"]) > 0.0:
			kept_zones.append(zone)
	boss2_snow_zones = kept_zones
	var kept_particles = []
	for particle in boss2_frost_particles:
		particle["pos"] = Vector2(particle["pos"]) + Vector2(particle["vel"]) * delta
		particle["life"] = float(particle["life"]) - delta
		if float(particle["life"]) > 0.0:
			kept_particles.append(particle)
	boss2_frost_particles = kept_particles


func _boss2_player_slow_mult() -> float:
	if current_phase != 2:
		return 1.0
	for zone in boss2_snow_zones:
		if player_pos.distance_to(Vector2(zone["pos"])) <= float(zone["radius"]):
			return BOSS2_SLOW_MULT
	return 1.0


func _environment_player_slow_mult() -> float:
	var mult = _boss2_player_slow_mult()
	if boss_wave_slow_timer > 0.0:
		mult = min(mult, 0.38)
	if boss1_rain_active and weather_kind == "rain":
		for puddle in puddles:
			if player_pos.distance_to(Vector2(puddle["pos"])) <= float(puddle["r"]):
				mult = min(mult, WEATHER_PUDDLE_SLOW_MULT)
				break
	if current_phase == 4:
		for hazard in phase4_enemy_hazards:
			if String(hazard.get("kind", "")) == "boss4_collapse" and player_pos.distance_to(Vector2(hazard["pos"])) <= float(hazard.get("radius", 110.0)):
				mult = min(mult, 0.74)
				break
	if current_phase == 5:
		for hazard in phase5_hazards:
			if String(hazard.get("kind", "")) == "prison":
				var max_life: = float(hazard.get("max", BOSS5_PRISON_DURATION))
				var life: = float(hazard.get("life", max_life))
				var elapsed: = max_life - life
				var warning_dur: = float(hazard.get("warning", BOSS5_PRISON_WARNING))
				if elapsed >= warning_dur:
					var radius_atual: = float(hazard.get("radius_atual", hazard.get("radius_inicial", 45.0)))
					if player_pos.distance_to(Vector2(hazard["pos"])) <= radius_atual:
						mult = min(mult, 0.3)
						break
	return mult


func _spawn_boss2_slow_zone(pos: Vector2, radius: float, life: = BOSS2_SLOW_ZONE_TIME) -> void :
	if current_phase != 2:
		return
	boss2_snow_zones.append({
		"pos": pos.clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40)), 
		"radius": radius, 
		"life": life, 
		"max": life, 
		"phase": rng.randf_range(0.0, TAU)
	})
	if boss2_snow_zones.size() > 34:
		boss2_snow_zones.pop_front()


