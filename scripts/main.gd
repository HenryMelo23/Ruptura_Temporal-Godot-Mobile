			hp_mult = 1.35
			speed *= 0.76
			damage *= 0.68
			points = 195
		ENEMY_NEXUS_ECHO:
			hp_mult = 0.95
			speed *= 1.08
			damage *= 0.80
			points = 185
	var hp = base_hp * hp_mult
	enemies.append({
		"uid": randi(),
		"type": kind,
		"pos": pos,
		"hp": hp,
		"max_hp": hp,
		"speed": speed,
		"damage": damage,
		"points": points,
		"phase": rng.randf() * 10.0,
		"hit_cd": 0.0,
		"shoot_cd": rng.randf_range(0.5, 2.0),
		"heal_tick": 0.0,
		"agglomerated_time": 0.0,
