			return 0.72
		"prismatica":
			return 0.42
		"retornante":
			return 0.62
		"gravitante":
			return 0.74
		"cartografica":
			return 0.66
		"mnesica":
			return 0.58
		"ressonante":
			return 0.50
		"contratual":
