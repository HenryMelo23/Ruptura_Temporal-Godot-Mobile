	for phase in range(1, 6):
		lines.append("Boss %d: tempo %s | dano %d" % [phase, _boss_duration_report(phase), int(round(float(run_damage_to_boss_by_phase.get(phase, 0.0))))])
	return "\n".join(lines)


func _boss_report_rows() -> Array:
