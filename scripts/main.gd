		boss_resonant_notes.clear()
		mnesic_boss_vulnerability = max(mnesic_boss_vulnerability, 1.2)
	_add_text("SINFONIA DO SILENCIO", player_pos + Vector2(0, -96), Color(1.0, 0.78, 0.24), 1.0, 22)
