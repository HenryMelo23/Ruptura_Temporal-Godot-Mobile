func _start_contractual_order() -> bool:
	if not contractual_order.is_empty():
		_add_text("ORDEM EM ANDAMENTO", player_pos + Vector2(0, -112), Color(1.0, 0.74, 0.24), 0.8, 18)
		return false
	var options: = _contractual_order_templates()
	var order: Dictionary = options[rng.randi_range(0, options.size() - 1)].duplicate(true)
	order["time_left"] = CONTRACT_ORDER_DURATION
	order["age"] = 0.0
	order["real_age"] = 0.0
	order["active"] = false
	order["progress"] = 0
	order["failed"] = false
	order["origin"] = player_pos
	contractual_order = order
	manifestation_secondaries.append({"kind": "contratual", "life": CONTRACT_ORDER_REVEAL_TIME, "max": CONTRACT_ORDER_REVEAL_TIME, "tick": 0.0})
	for enemy in enemies:
		if Vector2(enemy["pos"]).distance_to(player_pos) <= 420.0:
			_apply_contract_clause(enemy)
	if boss_active and boss_hp > 0.0:
		boss_contract_clause = "agressao"
		boss_contract_infractions = min(CONTRACT_MAX_INFRACTIONS, boss_contract_infractions + 1)
	_add_text("ORDEM JUDICIAL", player_pos + Vector2(0, -112), Color(1.0, 0.58, 0.24), 1.2, 24)
	_spawn_radial_particles(player_pos, Color(1.0, 0.58, 0.24), 22)
	return true


func _contractual_order_progress(kind: String, amount: = 1, clause: = "") -> void :
	if contractual_order.is_empty() or amount <= 0:
		return
	if not bool(contractual_order.get("active", false)):
		return
	var order_kind: = String(contractual_order.get("kind", ""))
	var accepted: = kind == order_kind
	if order_kind == "close_break" and kind == "break" and clause == "aproximacao":
		accepted = true
	elif order_kind == "aggression_break" and kind == "break" and clause == "agressao":
		accepted = true
	elif order_kind == "boss_break" and kind in ["boss_break", "execute"]:
		accepted = true
	elif order_kind == "arauto_hit" and kind in ["arauto_hit", "kill"]:
		accepted = true
	if not accepted:
		return
	contractual_order["progress"] = int(contractual_order.get("progress", 0)) + amount
	contractual_order["pulse"] = 0.55
	if int(contractual_order["progress"]) >= int(contractual_order.get("goal", 1)):
		_complete_contractual_order()


func _complete_contractual_order() -> void :
	if contractual_order.is_empty():
		return
	var reward_pool: = ["immortal", "damage", "speed", "veredict", "cooldown"]
	var reward: = String(reward_pool[rng.randi_range(0, reward_pool.size() - 1)])
	contractual_order_rewards[reward] = CONTRACT_ORDER_REWARD_TIME
	_add_text("ORDEM CUMPRIDA", player_pos + Vector2(0, -124), Color(0.38, 1.0, 0.58), 1.2, 24)
	_spawn_radial_particles(player_pos, Color(0.38, 1.0, 0.58), 36)
	contractual_order.clear()


func _fail_contractual_order() -> void :
	if contractual_order.is_empty():
		return
	var penalties: = ["speed_down", "damage_down", "defense_down", "silence_tick", "tax"]
	var penalty: = String(penalties[rng.randi_range(0, penalties.size() - 1)])
	contractual_order_penalties[penalty] = CONTRACT_ORDER_PENALTY_TIME
	if penalty == "tax":
		score = max(0, score - max(80, int(card_cost * 0.45)))
	_add_text("CONFISCO: %s" % penalty.to_upper(), player_pos + Vector2(0, -124), Color(1.0, 0.3, 0.18), 1.2, 22)
	_spawn_radial_particles(player_pos, Color(1.0, 0.3, 0.18), 30)
	contractual_order.clear()


func _update_contractual_order(delta: float) -> void :
	if contractual_order.is_empty():
		return
	var real_delta: = contractual_order_real_delta if contractual_order_real_delta > 0.0 else delta
	var previous_age: = float(contractual_order.get("real_age", contractual_order.get("age", 0.0)))
	var current_age: = previous_age + real_delta
	contractual_order["real_age"] = current_age
	contractual_order["age"] = current_age
	if current_age < CONTRACT_ORDER_EXECUTION_START_TIME:
		contractual_order["time_left"] = CONTRACT_ORDER_DURATION
		return
	var execution_delta: = real_delta
	if not bool(contractual_order.get("active", false)):
		contractual_order["active"] = true
		contractual_order["time_left"] = CONTRACT_ORDER_DURATION
		_add_text("PRAZO ABERTO", player_pos + Vector2(0, -112), Color(1.0, 0.8, 0.32), 0.9, 20)
		execution_delta = maxf(0.0, current_age - CONTRACT_ORDER_EXECUTION_START_TIME)
	contractual_order["time_left"] = max(0.0, float(contractual_order.get("time_left", 0.0)) - execution_delta)
	if String(contractual_order.get("kind", "")) in ["survive", "survive_low"]:
		var survived: = CONTRACT_ORDER_DURATION - float(contractual_order.get("time_left", 0.0))
		contractual_order["progress"] = int(floor(min(float(contractual_order.get("goal", 1)), survived)))
	if String(contractual_order.get("kind", "")) == "survive_low" and float(player_hp) / max(1.0, float(player_hp_max)) < 0.35:
		contractual_order["failed"] = true
	if bool(contractual_order.get("failed", false)):
		_fail_contractual_order()
		return
	if int(contractual_order.get("progress", 0)) >= int(contractual_order.get("goal", 1)):
		_complete_contractual_order()
		return
	if float(contractual_order.get("time_left", 0.0)) <= 0.0:
		_fail_contractual_order()


func _update_contractual_timed_effects(delta: float) -> void :
	for key in contractual_order_rewards.keys():
		contractual_order_rewards[key] = max(0.0, float(contractual_order_rewards[key]) - delta)
	for key in contractual_order_rewards.keys():
		if float(contractual_order_rewards[key]) <= 0.0:
			contractual_order_rewards.erase(key)
	for key in contractual_order_penalties.keys():
		contractual_order_penalties[key] = max(0.0, float(contractual_order_penalties[key]) - delta)
	for key in contractual_order_penalties.keys():
		if float(contractual_order_penalties[key]) <= 0.0:
			contractual_order_penalties.erase(key)


func _contractual_order_world_time_scale() -> float:
	if current_phase == 5 and phase5_transmute_active and phase5_transmute_timer <= 0.65:
		return 0.25
	if contractual_order.is_empty():
		return 1.0
	var age: = float(contractual_order.get("real_age", contractual_order.get("age", 0.0)))
	if age < CONTRACT_ORDER_SLOW_IN_TIME:
		var t: = clampf(age / maxf(0.01, CONTRACT_ORDER_SLOW_IN_TIME), 0.0, 1.0)
		return lerpf(1.0, 0.03, t)
	if age < CONTRACT_ORDER_READ_END_TIME:
		return 0.0
	if age < CONTRACT_ORDER_EXECUTION_START_TIME:
		var out_t: = clampf((age - CONTRACT_ORDER_READ_END_TIME) / maxf(0.01, CONTRACT_ORDER_SLOW_OUT_TIME), 0.0, 1.0)
		return lerpf(0.03, 1.0, out_t)
	return 1.0


func _contractual_damage_multiplier() -> float:
	var mult: = 1.0
	if contractual_order_rewards.has("damage") or contractual_order_rewards.has("veredict"):
		mult *= 1.55
	if contractual_order_penalties.has("damage_down"):
		mult *= 0.72
	return mult


func _contractual_speed_multiplier() -> float:
	var mult: = 1.0
	if contractual_order_rewards.has("speed"):
		mult *= 1.32
	if contractual_order_penalties.has("speed_down"):
		mult *= 0.78
	return mult


func _contractual_blocks_damage() -> bool:
	return contractual_order_rewards.has("immortal")


func _update_contractual_notifications(delta: float) -> void :
	var kept = []
	for trap in contractual_notifications:
		trap["life"] = float(trap.get("life", 0.0)) - delta
		trap["phase"] = float(trap.get("phase", 0.0)) + delta * 4.0
		var consumed: = false
		for enemy in enemies:
			if float(enemy.get("hp", 0.0)) <= 0.0:
				continue
			if Vector2(enemy["pos"]).distance_to(Vector2(trap.get("pos", player_pos))) <= 58.0:
				if enemy.has("contract_clause"):
					enemy["contract_infractions"] = min(CONTRACT_MAX_INFRACTIONS, int(enemy.get("contract_infractions", 0)) + 1)
				else:
					_apply_contract_clause(enemy)
				enemy["contract_flash"] = 0.7
				consumed = true
				break
		if not consumed and float(trap["life"]) > 0.0:
			kept.append(trap)
	contractual_notifications = kept


func _spawn_tp_parasite_eggs(origin: Vector2) -> void :
	var candidates = []
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) > 0.0:
			candidates.append({"kind": "enemy", "uid": int(enemy["uid"]), "distance": origin.distance_squared_to(Vector2(enemy["pos"]))})
	if boss_active and boss_hp > 0.0:
		candidates.append({"kind": "boss", "uid": -1, "distance": origin.distance_squared_to(boss_pos)})
	if _arauto_active():
		candidates.append({"kind": "arauto", "uid": -1, "distance": origin.distance_squared_to(Vector2(arauto["pos"]))})
	candidates.sort_custom( func(a, b): return float(a["distance"]) < float(b["distance"]))
	for i in range(3):
		var angle: = -0.65 + float(i) * 0.65
		var target = candidates[i % candidates.size()] if not candidates.is_empty() else {}
		tp_effects.append({
			"kind": "parasite_egg", 
			"life": TP_PARASITE_DURATION, 
			"max": TP_PARASITE_DURATION, 
			"pos": origin + Vector2.from_angle(angle) * 18.0, 
			"target_kind": String(target.get("kind", "")), 
			"target_uid": int(target.get("uid", -1)), 
			"phase": float(i) * 1.7
		})
	_spawn_radial_particles(origin, Color(0.54, 0.96, 0.22), 16)


func _apply_tp_gravity_wave(origin: Vector2) -> void :
	for enemy in enemies:
		var offset: Vector2 = Vector2(enemy["pos"]) - origin
		if offset.length() <= TP_GRAVITY_RADIUS:
			var direction: = offset.normalized() if offset.length() > 0.01 else Vector2.from_angle(rng.randf_range(0.0, TAU))
			enemy["pos"] = (Vector2(enemy["pos"]) + direction * 145.0).clamp(Vector2(45, 45), WORLD_SIZE - Vector2(45, 45))
	shockwaves.append({"pos": origin, "radius": 0.0, "max": TP_GRAVITY_RADIUS, "life": 0.55, "damage": 0.0, "hit": {}, "visual_only": true})
	_add_text("REPULSAO GRAVITACIONAL", origin + Vector2(0, -96), Color(0.52, 0.78, 1.0), 0.9, 18)


func _start_tp_lacerante(origin: Vector2, destination: Vector2) -> void :
	var candidates = []
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) > 0.0 and _distance_to_segment(Vector2(enemy["pos"]), origin, destination) <= _enemy_radius(enemy) + 34.0:
			candidates.append({"kind": "enemy", "uid": int(enemy["uid"]), "distance": origin.distance_squared_to(Vector2(enemy["pos"]))})
	if boss_active and boss_hp > 0.0 and _distance_to_segment(boss_pos, origin, destination) <= 78.0:
		candidates.append({"kind": "boss", "uid": -1, "distance": origin.distance_squared_to(boss_pos)})
	if _arauto_active() and _distance_to_segment(Vector2(arauto["pos"]), origin, destination) <= 78.0:
		candidates.append({"kind": "arauto", "uid": -1, "distance": origin.distance_squared_to(Vector2(arauto["pos"]))})
	candidates.sort_custom( func(a, b): return float(a["distance"]) < float(b["distance"]))
	if candidates.size() > 3:
		candidates.resize(3)
	var cuts: = TP_LACERANTE_BASE_CUTS + _lacerante_ultimate_extra_cuts()
	tp_effects.append({"kind": "lacerante", "life": TP_LACERANTE_DURATION, "max": TP_LACERANTE_DURATION, "tick": 0.0, "cuts": cuts, "cuts_done": 0, "targets": candidates, "origin": origin})
	_add_text("EXECUCAO EM %d CORTES" % cuts, destination + Vector2(0, -102), Color(1.0, 0.12, 0.2), 1.1, 20)


func _start_tp_acorrentada(origin: Vector2, destination: Vector2) -> void :
	var life: float = ACORRENTADA_TP_LINE_TIME + (ACORRENTADA_TP_OVERHEAT_LINE_BONUS if acorrentada_tension >= 70.0 else 0.0)
	tp_effects.append({"kind": "acorrentada", "life": life, "max": life, "a": origin, "b": destination, "hits": {}, "width": 44.0 if acorrentada_tension >= 70.0 else 34.0})
	var effect: Dictionary = tp_effects[-1]
	effect["physics"] = _init_chain_physics(origin, destination, "light" if acorrentada_tension < 70.0 else "heavy")
	var travel: Vector2 = destination - origin
	if travel.length() <= 1.0:
		return
	var target: Dictionary = _best_acorrentada_line_target(origin, travel.normalized(), travel.length(), 58.0)
	if not target.is_empty():
		_acorrentada_apply_elo_to_target(target, 1)
		_acorrentada_damage_target(target, player_damage * 0.48, "acorrentada_tp_chain", "teleport", origin)
		if acorrentada_combo_step < 3:
			acorrentada_combo_step += 1
		else:
			acorrentada_force_next_attack_3 = true
		_add_acorrentada_tension(6.0, 0.5 if String(target.get("kind", "")) == "boss" else 1.0)
	_add_text("TROCA DE ELO", destination + Vector2(0, -92), Color(0.3, 0.86, 1.0), 0.85, 18)


func _prismatica_teleport_path(origin: Vector2, destination: Vector2) -> Array:
	var path: Array = [origin]
	var candidates: Array = []
	var travel: Vector2 = destination - origin
	var max_distance: float = maxf(1.0, travel.length())
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		var pos: Vector2 = Vector2(enemy.get("pos", origin))
		if origin.distance_to(pos) <= max_distance + 120.0 and _distance_to_segment(pos, origin, destination) <= 145.0:
			candidates.append({"pos": pos, "d": origin.distance_squared_to(pos)})
	candidates.sort_custom(func(a, b): return float(a.get("d", 0.0)) < float(b.get("d", 0.0)))
	for i in range(mini(3, candidates.size())):
		path.append(Vector2(candidates[i].get("pos", origin)))
	path.append(destination)
	return path


func _apply_mnesica_teleport_fragment_burst(origin: Vector2) -> void:
	var radius: float = 150.0
	var amount: float = maxf(6.0, player_damage * 0.34)
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) > 0.0 and Vector2(enemy.get("pos", origin)).distance_to(origin) <= radius + _enemy_radius(enemy):
			_damage_enemy(enemy, amount, "mnesica_tp_fragments", true, true, origin, "teleport")
	if boss_active and boss_hp > 0.0 and boss_pos.distance_to(origin) <= radius + _boss_hit_radius():
		_damage_boss(amount * 0.72, "mnesica_tp_fragments", true, true, "teleport", origin)
	if _arauto_active() and Vector2(arauto.get("pos", origin)).distance_to(origin) <= radius + 56.0:
		_damage_arauto(amount * 0.82, "mnesica_tp_fragments", true, true, "teleport", origin)
	_spawn_radial_particles(origin, Color(0.86, 0.58, 1.0), 18)


func _update_teleport_effects(delta: float) -> void :
	retornante_tp_window = max(0.0, retornante_tp_window - delta)
	if carto_tp_window > 0.0:
		carto_tp_window = max(0.0, carto_tp_window - delta)
		if is_zero_approx(carto_tp_window):
			carto_tp_pin = Vector2.ZERO
			tp_cooldown_pending = true
			tp_cooldown_override = 6.0
			tp_effects = tp_effects.filter(func(effect): return String(effect.get("kind", "")) != "cartografica_pin")
			_finish_teleport_effect_cooldown()
	for effect in tp_effects:
		effect["life"] = float(effect.get("life", 0.0)) - delta
		match String(effect.get("kind", "")):
			"parasite_egg": _update_tp_parasite_egg(effect, delta)
			"lacerante": _update_tp_lacerante(effect, delta)
			"eletrica": _update_tp_electric(effect, delta)
			"acorrentada": _update_tp_acorrentada(effect, delta)
	tp_effects = tp_effects.filter( func(effect): return float(effect.get("life", 0.0)) > 0.0)
	if tp_cooldown_pending:
		if tp_cooldown_release_time > 0.0:
			if time_alive >= tp_cooldown_release_time:
				_release_direct_teleport_cooldown()
		elif tp_effects.is_empty():
			_finish_teleport_effect_cooldown()


func _update_tp_parasite_egg(effect: Dictionary, delta: float) -> void :
	var target_pos: = Vector2.ZERO
	var target_kind: = String(effect.get("target_kind", ""))
	var enemy = _enemy_by_uid(int(effect.get("target_uid", -1))) if target_kind == "enemy" else null
	if enemy:
		target_pos = Vector2(enemy["pos"])
	elif target_kind == "boss" and boss_active and boss_hp > 0.0:
		target_pos = boss_pos
	elif target_kind == "arauto" and _arauto_active():
		target_pos = Vector2(arauto["pos"])
	else:
		return
	var pos: Vector2 = Vector2(effect.get("pos", target_pos))
	var direction: Vector2 = (target_pos - pos).normalized()
	pos += direction * min(520.0 * delta, pos.distance_to(target_pos))
	effect["pos"] = pos
	effect["phase"] = float(effect.get("phase", 0.0)) + delta * 10.0
	if pos.distance_to(target_pos) <= 18.0:
		if enemy:
			enemy["stun"] = max(float(enemy.get("stun", 0.0)), TP_PARASITE_STUN)
		elif target_kind == "arauto":
			arauto["stun"] = max(float(arauto.get("stun", 0.0)), TP_PARASITE_STUN)
		elif not _boss_is_using_ability():
			boss_tp_stun_timer = max(boss_tp_stun_timer, TP_PARASITE_STUN)
		effect["life"] = 0.0
		_spawn_radial_particles(target_pos, Color(0.46, 0.96, 0.2), 10)


func _update_tp_acorrentada(effect: Dictionary, delta: float) -> void :
	var a: = Vector2(effect.get("a", player_pos))
	var b: = Vector2(effect.get("b", player_pos))
	if effect.has("physics"):
		_update_single_chain_physics(effect["physics"], a, b, delta)
	var hits: Dictionary = effect.get("hits", {})
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		var uid: = str(enemy.get("uid", 0))
		if hits.has(uid):
			continue
		if _distance_to_segment(Vector2(enemy["pos"]), a, b) <= float(effect.get("width", 34.0)) + _enemy_radius(enemy) * 0.35:
			hits[uid] = true
			_add_acorrentada_elo_enemy(enemy, 1)
			var killed: = _damage_enemy(enemy, player_damage * 0.32, "acorrentada_tp_chain", true, true, a, "teleport")
			if killed:
				_kill_enemy(enemy)
			_add_acorrentada_tension(4.0)
	if boss_active and boss_hp > 0.0 and not hits.has("boss") and _distance_to_segment(boss_pos, a, b) <= float(effect.get("width", 34.0)) + _boss_hit_radius() * 0.35:
		hits["boss"] = true
		_add_acorrentada_elo_boss(1)
		_damage_boss(player_damage * 0.18, "acorrentada_tp_chain", true, true, "teleport", a)
		_add_acorrentada_tension(2.0)
	effect["hits"] = hits


func _boss_is_using_ability() -> bool:
	if not boss_attacks.is_empty() or boss_stage_timer > 0.0 or boss_stage_approaching:
		return true
	if current_phase == 2 and (boss2_state != BOSS2_STATE_IDLE or boss2_ultimate_timer > 0.0):
		return true
	if current_phase == 3 and (_boss3_miasma_active() or boss3_faith_test_active):
		return true
	if current_phase == 4 and boss4_attack_pose_timer > 0.0:
		return true
	return current_phase == 5 and (boss5_siphon_timer > 0.0 or not phase5_telegraphs.is_empty())


func _update_tp_lacerante(effect: Dictionary, delta: float) -> void :
	var cuts: int = int(effect.get("cuts", TP_LACERANTE_BASE_CUTS))
	var done: int = int(effect.get("cuts_done", 0))
	effect["tick"] = float(effect.get("tick", 0.0)) - delta
	while done < cuts and float(effect["tick"]) <= 0.0:
		effect["tick"] = float(effect["tick"]) + TP_LACERANTE_DURATION / float(cuts)
		for target in effect.get("targets", []):
			if String(target.get("kind", "")) == "boss":
				if boss_active and boss_hp > 0.0:
					_damage_boss(50.0 + boss_hp_max * 0.005, "lacerante", true, true, "teleport", Vector2(effect.get("origin", player_pos)))
					_spawn_tp_cut_visual(boss_pos, done)
			elif String(target.get("kind", "")) == "arauto":
				if _arauto_active():
					_damage_arauto(50.0 + float(arauto.get("max_hp", 900.0)) * 0.005, "lacerante")
					_spawn_tp_cut_visual(Vector2(arauto["pos"]), done)
			else:
				var enemy = _enemy_by_uid(int(target.get("uid", -1)))
				if enemy:
					_damage_enemy(enemy, 50.0 + float(enemy.get("max_hp", 1.0)) * 0.005, "lacerante", true, true, Vector2(effect.get("origin", player_pos)), "teleport")
					_spawn_tp_cut_visual(Vector2(enemy["pos"]), done)
		done += 1
	effect["cuts_done"] = done


func _spawn_tp_cut_visual(pos: Vector2, cut_index: int) -> void :
	var angle: = float(cut_index) * 2.399
	var direction: = Vector2.from_angle(angle)
	slashes.append({"a": pos - direction * 46.0, "b": pos + direction * 46.0, "life": 0.18, "max": 0.18, "color": Color(1.0, 0.02, 0.1), "width": 15.0})


func _update_tp_electric(effect: Dictionary, delta: float) -> void :
	effect["tick"] = float(effect.get("tick", 0.0)) - delta
	if float(effect["tick"]) > 0.0:
		return
	effect["tick"] = TP_ELECTRIC_TICK
	var a: Vector2 = Vector2(effect.get("a", player_pos))
	var b: Vector2 = Vector2(effect.get("b", player_pos))
	for enemy in enemies:
		if _distance_to_segment(Vector2(enemy["pos"]), a, b) <= _enemy_radius(enemy) + 28.0:
			_damage_enemy(enemy, float(enemy.get("max_hp", 1.0)) * TP_ELECTRIC_MAX_HP_RATE, "eletrica", true, true, a, "teleport")
	if boss_active and boss_hp > 0.0 and _distance_to_segment(boss_pos, a, b) <= 82.0:
		_damage_boss(boss_hp_max * TP_ELECTRIC_MAX_HP_RATE, "eletrica", true, true, "teleport", a)
	if _arauto_active() and _distance_to_segment(Vector2(arauto["pos"]), a, b) <= 72.0:
		_damage_arauto(float(arauto["max_hp"]) * TP_ELECTRIC_MAX_HP_RATE, "eletrica", true, true, "teleport", a)
	slashes.append({"a": a, "b": b, "life": 0.12, "max": 0.12, "color": Color(0.22, 0.92, 1.0), "width": 18.0})


func _spawn_wave() -> void :
	if not _is_world_authority():
		return
	spawn_timer = _enemy_spawn_interval()
	if boss_active or _arauto_active():
		return
	var limit = _enemy_limit()
	if enemies.size() >= limit:
		return
	var kind = _choose_enemy_type()
	_spawn_enemy(kind, _spawn_point_for_type(kind))


func _phase_elapsed_time() -> float:
	return max(0.0, time_alive - phase_started_at)


func _choose_enemy_type() -> String:
	if current_phase == 7:
		return _choose_phase7_enemy_type()
	if current_phase == 6:
		return _choose_phase6_enemy_type()
	if current_phase == 5:
		return _choose_phase4_enemy_type()
	if current_phase == 4:
		return _choose_phase4_enemy_type()
	if current_phase == 3:
		var elapsed3: = _phase_elapsed_time()
		if elapsed3 < PHASE3_COMMON_ONLY_TIME:
			return ENEMY_COMMON
		var r3 = rng.randf()
		if elapsed3 < PHASE3_INCENSARIO_UNLOCK_TIME:
			if r3 <= 0.16 and _enemy_type_count(ENEMY_DEVOTO) < 2:
				return ENEMY_DEVOTO
			return ENEMY_COMMON
		if elapsed3 < PHASE3_GUARDIAO_UNLOCK_TIME:
			if r3 <= 0.08 and _enemy_type_count(ENEMY_INCENSARIO) < 1:
				return ENEMY_INCENSARIO
			if r3 <= 0.26 and _enemy_type_count(ENEMY_DEVOTO) < 3:
				return ENEMY_DEVOTO
			return ENEMY_COMMON
		if r3 <= 0.04 and _enemy_type_count(ENEMY_GUARDIAO) < 1:
			return ENEMY_GUARDIAO
		if r3 <= 0.12 and _enemy_type_count(ENEMY_INCENSARIO) < 2:
			return ENEMY_INCENSARIO
		if r3 <= 0.28 and _enemy_type_count(ENEMY_DEVOTO) < 3:
			return ENEMY_DEVOTO
		return ENEMY_COMMON
	if current_phase == 2:
		return _choose_phase2_enemy_type()
	var elapsed1: = _phase_elapsed_time()
	var roll = rng.randf()
	if elapsed1 >= PHASE1_REVIVATOR_UNLOCK_TIME and roll < 0.1 and _enemy_type_count(ENEMY_COUT_ATTACK_SPEED) < 2:
		return ENEMY_COUT_ATTACK_SPEED
	if elapsed1 >= PHASE1_CURATER_UNLOCK_TIME:
		if roll < 0.09 and _enemy_type_count(ENEMY_CURATER) < _curater_limit():
			return ENEMY_CURATER
		if roll < 0.5:
			return ENEMY_COMMON
		if roll < 0.65:
			return ENEMY_STALKER
		if roll < 0.79:
			return ENEMY_PROJECTOR
		if roll < 0.89 and _enemy_type_count(ENEMY_SHIELD_REFLECTOR) < 2:
			return ENEMY_SHIELD_REFLECTOR
		if not _has_enemy_type(ENEMY_CRYSTAL) and roll < 0.97:
			return ENEMY_CRYSTAL
		return ENEMY_COMMON
	if elapsed1 >= PHASE1_SHIELD_CRYSTAL_UNLOCK_TIME:
		if roll < 0.6:
			return ENEMY_COMMON
		if roll < 0.76:
			return ENEMY_STALKER
		if roll < 0.88:
			return ENEMY_PROJECTOR
		if roll < 0.95 and _enemy_type_count(ENEMY_SHIELD_REFLECTOR) < 2:
			return ENEMY_SHIELD_REFLECTOR
		if not _has_enemy_type(ENEMY_CRYSTAL):
			return ENEMY_CRYSTAL
		return ENEMY_COMMON
	if elapsed1 >= PHASE1_PROJECTOR_UNLOCK_TIME:
		if roll < 0.7:
			return ENEMY_COMMON
		if roll < 0.86:
			return ENEMY_STALKER
		return ENEMY_PROJECTOR
	if elapsed1 >= PHASE1_STALKER_UNLOCK_TIME and roll < 0.24:
		return ENEMY_STALKER
	return ENEMY_COMMON


func _choose_phase2_enemy_type() -> String:
	var elapsed: = _phase_elapsed_time()
	if elapsed < PHASE2_KAMIKAZE_UNLOCK_TIME:
		return ENEMY_COMMON
	if elapsed >= PHASE2_PYRO_UNLOCK_TIME and _enemy_type_count(ENEMY_PYRO_PENGUIN) < PHASE2_PYRO_LIMIT:
		if rng.randf() < 0.18:
			return ENEMY_PYRO_PENGUIN
	if _enemy_type_count(ENEMY_KAMIKAZE) < PHASE2_KAMIKAZE_LIMIT and rng.randf() < 0.28:
		return ENEMY_KAMIKAZE
	return ENEMY_COMMON


func _choose_phase4_enemy_type() -> String:
	var elapsed: = _phase_elapsed_time()
	var kinds: = [
		ENEMY_NEXUS_CARTOGRAPHER, 
		ENEMY_NEXUS_CHRONOPHAGE, 
		ENEMY_NEXUS_REFRACTOR, 
		ENEMY_NEXUS_WEAVER, 
		ENEMY_NEXUS_ECHO
	]
	if current_phase == 4 and elapsed < PHASE4_ADAPT_TIME:
		kinds = [
			ENEMY_NEXUS_CARTOGRAPHER, 
			ENEMY_NEXUS_ECHO, 
			ENEMY_NEXUS_REFRACTOR
		]
	var available = kinds.filter( func(kind): return not _has_enemy_type(String(kind)))
	var pool: Array = available if not available.is_empty() else kinds
	return String(pool[rng.randi_range(0, pool.size() - 1)])


func _choose_phase6_enemy_type() -> String:
	var elapsed: = _phase_elapsed_time()
	var roll: = rng.randf()
	if elapsed >= PHASE1_SHIELD_CRYSTAL_UNLOCK_TIME:
		if roll < 0.6:
			return ENEMY_LODARIO
		if roll < 0.76:
			return ENEMY_CHRONAL_LEECH
		if roll < 0.88 and _phase6_miasma_eel_count() < _phase6_miasma_eel_cap():
			return ENEMY_MIASMA_EEL
		if not _has_enemy_type(ENEMY_FOSSIL_PUSTULE):
			return ENEMY_FOSSIL_PUSTULE
		return ENEMY_LODARIO
	if elapsed >= PHASE1_PROJECTOR_UNLOCK_TIME:
		if roll < 0.7:
			return ENEMY_LODARIO
		if roll < 0.86:
			return ENEMY_CHRONAL_LEECH
		if _phase6_miasma_eel_count() < _phase6_miasma_eel_cap():
			return ENEMY_MIASMA_EEL
		return ENEMY_LODARIO
	if elapsed >= PHASE1_STALKER_UNLOCK_TIME and roll < 0.24:
		return ENEMY_CHRONAL_LEECH
	return ENEMY_LODARIO


func _choose_phase7_enemy_type() -> String:
	var elapsed: = _phase_elapsed_time()
	var roll: = rng.randf()
	var pangoliro_count: = _enemy_type_count(ENEMY_PANGOLIRO)
	var corvol_count: = _enemy_type_count(ENEMY_CORVOL)
	if elapsed < 45.0:
		return ENEMY_CINERIDO
	if elapsed < 105.0:
		if roll < 0.32 and pangoliro_count < PHASE7_PANGOLIRO_LIMIT:
			return ENEMY_PANGOLIRO
		return ENEMY_CINERIDO
	if elapsed < 180.0:
		if roll < 0.20 and corvol_count < PHASE7_CORVOL_LIMIT:
			return ENEMY_CORVOL
		if roll < 0.48 and pangoliro_count < PHASE7_PANGOLIRO_LIMIT:
			return ENEMY_PANGOLIRO
		return ENEMY_CINERIDO
	if elapsed < 240.0:
		if roll < 0.26 and corvol_count < PHASE7_CORVOL_LIMIT:
			return ENEMY_CORVOL
		if roll < 0.56 and pangoliro_count < PHASE7_PANGOLIRO_LIMIT:
			return ENEMY_PANGOLIRO
		return ENEMY_CINERIDO
	if roll < 0.30 and corvol_count < PHASE7_CORVOL_LIMIT:
		return ENEMY_CORVOL
	if roll < 0.62 and pangoliro_count < PHASE7_PANGOLIRO_LIMIT:
		return ENEMY_PANGOLIRO
	return ENEMY_CINERIDO


func _phase6_miasma_eel_count() -> int:
	var count: = 0
	for enemy in enemies:
		if String(enemy.get("type", "")) == ENEMY_MIASMA_EEL and float(enemy.get("hp", 0.0)) > 0.0:
			count += 1
	return count


func _phase6_miasma_eel_cap() -> int:
	return maxi(1, int(floor(float(maxi(1, _enemy_limit())) * 0.25)))


func _enemy_limit() -> int:
	var mp_bonus: int = _multiplayer_enemy_limit_bonus()
	if current_phase == 7:
		return _phase7_enemy_limit() + mp_bonus
	if current_phase == 6:
		return _phase6_enemy_limit() + mp_bonus
	if current_phase == 5:
		return 5 + mp_bonus
	if current_phase == 4:
		return (PHASE4_LIMIT_EARLY if _phase_elapsed_time() < PHASE4_ADAPT_TIME else PHASE4_LIMIT_FULL) + mp_bonus
	if current_phase == 3:
		var elapsed3: = _phase_elapsed_time()
		if elapsed3 < PHASE3_COMMON_ONLY_TIME:
			return PHASE3_LIMIT_EARLY + mp_bonus
		if elapsed3 < PHASE3_GUARDIAO_UNLOCK_TIME:
			return PHASE3_LIMIT_MID + mp_bonus
		return PHASE3_LIMIT_FULL + mp_bonus
	if current_phase == 2:
		var elapsed: = _phase_elapsed_time()
		if elapsed >= PHASE2_PYRO_UNLOCK_TIME:
			return PHASE2_COMMON_LIMIT + PHASE2_KAMIKAZE_LIMIT + PHASE2_PYRO_LIMIT + mp_bonus
		if elapsed >= PHASE2_KAMIKAZE_UNLOCK_TIME:
			return PHASE2_COMMON_LIMIT + PHASE2_KAMIKAZE_LIMIT + mp_bonus
		return PHASE2_COMMON_LIMIT + mp_bonus
	var elapsed1: = _phase_elapsed_time()
	if elapsed1 >= PHASE1_LIMIT_BREAK_TIME:
		if phase1_limit_break_kills_start < 0:
			phase1_limit_break_kills_start = enemies_killed
		var kills_after_break = max(0, enemies_killed - phase1_limit_break_kills_start)
		return ENEMY_MAX_BASE + int(floor(float(kills_after_break) / float(PHASE1_LIMIT_KILLS_PER_EXTRA))) + mp_bonus
	phase1_limit_break_kills_start = -1
	return ENEMY_MAX_BASE + mp_bonus


func _phase6_enemy_limit() -> int:
	var elapsed: = _phase_elapsed_time()
	if elapsed >= PHASE1_LIMIT_BREAK_TIME:
		if phase1_limit_break_kills_start < 0:
			phase1_limit_break_kills_start = enemies_killed
		var kills_after_break = max(0, enemies_killed - phase1_limit_break_kills_start)
		return ENEMY_MAX_BASE + int(floor(float(kills_after_break) / float(PHASE1_LIMIT_KILLS_PER_EXTRA)))
	phase1_limit_break_kills_start = -1
	return ENEMY_MAX_BASE


func _phase7_enemy_limit() -> int:
	var elapsed: = _phase_elapsed_time()
	if elapsed >= PHASE7_LIMIT_BREAK_TIME:
		if phase1_limit_break_kills_start < 0:
			phase1_limit_break_kills_start = enemies_killed
		var kills_after_break = max(0, enemies_killed - phase1_limit_break_kills_start)
		return PHASE7_ENEMY_LIMIT_BASE + int(floor(float(kills_after_break) / float(PHASE7_LIMIT_KILLS_PER_EXTRA)))
	phase1_limit_break_kills_start = -1
	return PHASE7_ENEMY_LIMIT_BASE


func _curater_limit() -> int:
	return 3 if _phase_elapsed_time() < 1500.0 else 5


func _enemy_spawn_interval() -> float:
	if current_phase == 7:
		return _phase7_spawn_interval()
	if current_phase == 6:
		return _phase6_spawn_interval()
	if current_phase == 5:
		return 1.1
	if current_phase == 4:
		return 1.42 if _phase_elapsed_time() < PHASE4_ADAPT_TIME else 1.24
	var interval = ENEMY_SPAWN_INTERVAL
	if current_phase == 3:
		var elapsed3: = _phase_elapsed_time()
		interval = 1.3 if elapsed3 < PHASE3_COMMON_ONLY_TIME else (1.16 if elapsed3 < PHASE3_GUARDIAO_UNLOCK_TIME else 1.02)
		if not _active_prismatica_secondary().is_empty():
			interval *= 0.5
		return interval
	if current_phase == 2:
		var elapsed: = _phase_elapsed_time()
		interval = 1.32 if elapsed < PHASE2_KAMIKAZE_UNLOCK_TIME else (1.12 if elapsed < PHASE2_PYRO_UNLOCK_TIME else 0.98)
		if not _active_prismatica_secondary().is_empty():
			interval *= 0.5
		return interval
	if current_phase != 2:
		var ramp_window = max(1.0, ENEMY_RAMP_PEAK_TIME - ENEMY_RAMP_START_TIME)
		var progress = clamp((_phase_elapsed_time() - ENEMY_RAMP_START_TIME) / ramp_window, 0.0, 1.0)
		interval = lerp(ENEMY_SPAWN_INTERVAL_EARLY, ENEMY_SPAWN_INTERVAL_LATE, progress)
	if not _active_prismatica_secondary().is_empty():
		interval *= 0.5
	return interval


func _phase6_spawn_interval() -> float:
	var ramp_window = max(1.0, ENEMY_RAMP_PEAK_TIME - ENEMY_RAMP_START_TIME)
	var progress = clamp((_phase_elapsed_time() - ENEMY_RAMP_START_TIME) / ramp_window, 0.0, 1.0)
	var interval = lerp(ENEMY_SPAWN_INTERVAL_EARLY, ENEMY_SPAWN_INTERVAL_LATE, progress)
	if not _active_prismatica_secondary().is_empty():
		interval *= 0.5
	return interval


func _phase7_spawn_interval() -> float:
	var progress: float = clampf(_phase_elapsed_time() / 300.0, 0.0, 1.0)
	var interval: float = lerpf(1.22, 0.92, progress)
	if not _active_prismatica_secondary().is_empty():
		interval *= 0.5
	return interval


func _has_enemy_type(kind: String) -> bool:
	for enemy in enemies:
		if enemy["type"] == kind:
			return true
	return false


func _larapio_spawn_delay() -> float:
	var elapsed: float = _phase_elapsed_time()
	var base_time: float = PHASE1_SECONDARY_LARAPIO_SPAWN_TIME if _phase1_is_after_phase6() else LARAPIO_SPAWN_TIME
	var steps: int = int(max(0.0, elapsed) / LARAPIO_COOLDOWN_STEP_TIME)
	var bonus: float = min(LARAPIO_COOLDOWN_MAX_BONUS, float(steps) * LARAPIO_COOLDOWN_STEP_BONUS)
	return base_time + bonus


func _schedule_next_larapio_spawn() -> void :
	larapio_spawned = false
	next_larapio_spawn_time = time_alive + _larapio_spawn_delay()


func _try_spawn_larapio() -> void :
	if current_phase != 1 or boss_active or boss_dead or _arauto_active():
		return
	if time_alive < next_larapio_spawn_time:
		return
	if _has_enemy_type(ENEMY_LARAPIO):
		return
	larapio_spawned = true
	next_larapio_spawn_time = INF
	_spawn_enemy(ENEMY_LARAPIO, _spawn_point_on_edge())
	_add_text("LARAPIO CHEGANDO!", player_pos + Vector2(0, -120), Color(1.0, 0.72, 0.22), 2.2, 25)


func _arauto_active() -> bool:
	return not arauto.is_empty() and bool(arauto.get("active", false)) and float(arauto.get("hp", 0.0)) > 0.0


func _arauto_is_aguilhao() -> bool:
	return String(arauto.get("variant", ARAUTO_VARIANT_CONDUTOR)) == ARAUTO_VARIANT_AGUILHAO


func _try_spawn_arauto() -> void :
	if arauto_spawned or boss_active or boss_dead or boss_call_timer >= 0.0:
		return
	if current_phase != 1 and current_phase != 6:
		return
	var spawn_clock: float = _phase_elapsed_time()
	if spawn_clock <= ARAUTO_SPAWN_TIME:
		return
	_spawn_arauto()


