		secondary["boss_tesla_shock"] = 0.0
		secondary["arauto_tesla_shock"] = 0.0
	secondary["life"] = 0.0
	secondary["cooldown_started"] = true
	if start_cooldown:
		last_secondary_time = time_alive
	_add_text(message, player_pos + Vector2(0, -108), color, 0.85, 19)
