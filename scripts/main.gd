func _update_arauto(delta: float) -> void :
	_update_arauto_vfx(delta)
	if not _arauto_active():
		return
	arauto_target_switch_timer = maxf(0.0, arauto_target_switch_timer - delta)
	arauto["anim"] = float(arauto.get("anim", 0.0)) + delta
	arauto["stun"] = max(0.0, float(arauto.get("stun", 0.0)) - delta)
	arauto["aura_null"] = max(0.0, float(arauto.get("aura_null", 0.0)) - delta)
	arauto["aura_wound"] = max(0.0, float(arauto.get("aura_wound", 0.0)) - delta)
	arauto["fragilidade_cronal"] = max(0.0, float(arauto.get("fragilidade_cronal", 0.0)) - delta)
	if float(arauto["fragilidade_cronal"]) <= 0.0:
		arauto["fragilidade_cronal_bonus"] = 0.0
	arauto["entry_timer"] = max(0.0, float(arauto.get("entry_timer", 0.0)) - delta)
	if float(arauto["entry_timer"]) > 0.0:
		return
	if float(arauto.get("stun", 0.0)) > 0.0:
		return
	if _arauto_is_aguilhao():
		_update_aguilhao_arauto(delta)
		return
	var phase2: = float(arauto["hp"]) <= float(arauto["max_hp"]) * 0.5
	if phase2 and not bool(arauto.get("phase2", false)):
		arauto["phase2"] = true
		arauto["orbit_sign"] = - float(arauto.get("orbit_sign", 1.0))
		arauto["gaze_cd"] = min(float(arauto.get("gaze_cd", ARAUTO_GAZE_COOLDOWN_PHASE2)), 1.5)
		arauto["silence_cd"] = min(float(arauto.get("silence_cd", ARAUTO_SILENCE_COOLDOWN_PHASE2)), 2.2)
		arauto["echo_pulse_cd"] = min(float(arauto.get("echo_pulse_cd", ARAUTO_ECHO_PULSE_COOLDOWN_PHASE2)), 2.8)
		_add_text("O OLHO DA RUPTURA DESPERTOU!", Vector2(arauto["pos"]) + Vector2(-170, -154), Color(1.0, 0.4, 0.92), 2.0, 25)
		shockwaves.append({"pos": Vector2(arauto["pos"]), "radius": 20.0, "max": 360.0, "life": 0.58, "damage": 0.0, "hit": {}, "visual_only": true})
	_move_arauto(delta, phase2)
	if bool(arauto.get("silence_active", false)):
		_update_arauto_silence(delta, phase2)
		return
	if bool(arauto.get("gaze_active", false)):
		_update_arauto_gaze(delta, phase2)
		return
	arauto["silence_cd"] = float(arauto.get("silence_cd", ARAUTO_SILENCE_COOLDOWN)) - delta
	if float(arauto["silence_cd"]) <= 0.0:
		_start_arauto_silence()
		return
	arauto["echo_pulse_cd"] = float(arauto.get("echo_pulse_cd", ARAUTO_ECHO_PULSE_COOLDOWN)) - delta
	if float(arauto["echo_pulse_cd"]) <= 0.0:
		_cast_arauto_echo_pulse(phase2)
		arauto["echo_pulse_cd"] = ARAUTO_ECHO_PULSE_COOLDOWN_PHASE2 if phase2 else ARAUTO_ECHO_PULSE_COOLDOWN
		return
	arauto["gaze_cd"] = float(arauto.get("gaze_cd", ARAUTO_GAZE_COOLDOWN)) - delta
	if float(arauto["gaze_cd"]) <= 0.0:
		_start_arauto_gaze()
		return
	arauto["shot_cd"] = float(arauto.get("shot_cd", ARAUTO_SHOT_COOLDOWN)) - delta
	if float(arauto["shot_cd"]) <= 0.0:
		_fire_arauto_shot(phase2)
		arauto["shot_cd"] = ARAUTO_SHOT_COOLDOWN_PHASE2 if phase2 else ARAUTO_SHOT_COOLDOWN


func _update_arauto_vfx(delta: float) -> void :
	for ray in arauto_rays:
		ray["life"] = float(ray.get("life", 0.0)) - delta
	for fx in arauto_echo_breaks:
		fx["life"] = float(fx.get("life", 0.0)) - delta
	arauto_rays = arauto_rays.filter( func(ray): return float(ray.get("life", 0.0)) > 0.0)
	arauto_echo_breaks = arauto_echo_breaks.filter( func(fx): return float(fx.get("life", 0.0)) > 0.0)


func _move_arauto(delta: float, phase2: bool) -> void :
	var pos: = Vector2(arauto.get("pos", player_pos))
	var target: = _arauto_target_entry(false)
	var to_player: Vector2 = Vector2(target.get("pos", player_pos)) - pos
	var distance: float = max(1.0, to_player.length())
	var radial: Vector2 = to_player / distance
	var tangent: Vector2 = Vector2( - radial.y, radial.x) * float(arauto.get("orbit_sign", 1.0))
	var radial_factor: float = 0.0
	if distance < ARAUTO_DISTANCE_MIN:
		radial_factor = -0.85
	elif distance > ARAUTO_DISTANCE_MAX:
		radial_factor = 0.65
	var move_dir: Vector2 = (tangent + radial * radial_factor).normalized()
	var speed: float = ARAUTO_SPEED * (1.25 if phase2 else 1.0)
	var next: Vector2 = (pos + move_dir * speed * delta).clamp(Vector2(80, 90), WORLD_SIZE - Vector2(80, 90))
	if next != pos + move_dir * speed * delta:
		arauto["orbit_sign"] = - float(arauto.get("orbit_sign", 1.0))
	arauto["pos"] = next
	if abs(next.x - pos.x) > 0.01:
		arauto["facing"] = 1.0 if next.x > pos.x else -1.0


func _update_aguilhao_arauto(delta: float) -> void :
	arauto["aguilhao_vulnerable"] = max(0.0, float(arauto.get("aguilhao_vulnerable", 0.0)) - delta)
	var phase2: = float(arauto["hp"]) <= float(arauto["max_hp"]) * 0.5
	if phase2 and not bool(arauto.get("phase2", false)):
		arauto["phase2"] = true
		arauto["state"] = "phase2_transition"
		arauto["state_timer"] = 1.0
		arauto["charge_cd"] = min(float(arauto.get("charge_cd", AGUILHAO_CHARGE_COOLDOWN_PHASE2)), 1.1)
		arauto["pulse_cd"] = min(float(arauto.get("pulse_cd", AGUILHAO_PULSE_COOLDOWN)), 1.8)
		_add_text("A CHAGA SE ABRIU!", Vector2(arauto["pos"]) + Vector2(-116, -112), Color(0.7, 1.0, 0.26), 1.8, 24)
		shockwaves.append({"pos": Vector2(arauto["pos"]), "radius": 12.0, "max": 260.0, "life": 0.54, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(0.48, 1.0, 0.18)})
		return

	arauto["charge_cd"] = max(0.0, float(arauto.get("charge_cd", AGUILHAO_CHARGE_COOLDOWN)) - delta)
	arauto["seed_cd"] = max(0.0, float(arauto.get("seed_cd", AGUILHAO_SEED_COOLDOWN)) - delta)
	arauto["pulse_cd"] = max(0.0, float(arauto.get("pulse_cd", AGUILHAO_PULSE_COOLDOWN)) - delta)
	var state: = String(arauto.get("state", "idle"))
	match state:
		"phase2_transition":
			arauto["state_timer"] = max(0.0, float(arauto.get("state_timer", 0.0)) - delta)
			if float(arauto["state_timer"]) <= 0.0:
				arauto["state"] = "idle"
			return
		"charge_windup":
			arauto["state_timer"] = max(0.0, float(arauto.get("state_timer", 0.0)) - delta)
			if float(arauto["state_timer"]) <= 0.0:
				arauto["state"] = "charge"
				arauto["state_timer"] = AGUILHAO_CHARGE_DURATION
				arauto["charge_hit_local"] = false
			return
		"charge":
			_update_aguilhao_charge(delta, phase2)
			return
		"seed":
			arauto["state_timer"] = max(0.0, float(arauto.get("state_timer", 0.0)) - delta)
			if float(arauto["state_timer"]) <= 0.0:
				_resolve_aguilhao_seed(phase2)
				_set_aguilhao_recovery(0.55)
			return
		"pulse":
			arauto["state_timer"] = max(0.0, float(arauto.get("state_timer", 0.0)) - delta)
			if float(arauto["state_timer"]) <= 0.0:
				_resolve_aguilhao_pulse(phase2, int(arauto.get("pulse_stage", 0)))
			return
		"recovery":
			arauto["state_timer"] = max(0.0, float(arauto.get("state_timer", 0.0)) - delta)
			if float(arauto["state_timer"]) <= 0.0:
				arauto["state"] = "idle"
			return

	_move_aguilhao(delta, phase2)
	_choose_aguilhao_ability(phase2)


func _move_aguilhao(delta: float, phase2: bool) -> void :
	var pos: = Vector2(arauto.get("pos", player_pos))
	var target: = _arauto_target_entry(false)
	var target_pos: = Vector2(target.get("pos", player_pos))
	var to_target: = target_pos - pos
	var distance: = to_target.length()
	if distance <= 1.0:
		return
	var desired: = to_target.normalized()
	if distance < 170.0:
		desired = - desired
	elif distance < 250.0:
		desired = Vector2( - desired.y, desired.x) * float(arauto.get("facing", 1.0))
	var speed: = AGUILHAO_MOVE_SPEED * (AGUILHAO_PHASE2_MOVE_MULT if phase2 else 1.0)
	var next: = (pos + desired.normalized() * speed * delta).clamp(Vector2(70, 80), WORLD_SIZE - Vector2(70, 80))
	arauto["pos"] = next
	if abs(next.x - pos.x) > 0.01:
		arauto["facing"] = 1.0 if next.x > pos.x else -1.0


func _choose_aguilhao_ability(phase2: bool) -> void :
	var target: = _arauto_target_entry(false)
	var target_pos: = Vector2(target.get("pos", player_pos))
	var distance: = Vector2(arauto.get("pos", player_pos)).distance_to(target_pos)
	var last: = String(arauto.get("last_ability", ""))
	var threat_limit: = AGUILHAO_SEED_LIMIT_PHASE2 if phase2 else AGUILHAO_SEED_LIMIT
	if distance >= 235.0 and float(arauto.get("charge_cd", 0.0)) <= 0.0 and last != "charge":
		_start_aguilhao_charge(phase2)
		return
	if _count_aguilhao_threats() < threat_limit and float(arauto.get("seed_cd", 0.0)) <= 0.0 and last != "seed":
		_start_aguilhao_seed(phase2)
		return
	if distance <= 215.0 and float(arauto.get("pulse_cd", 0.0)) <= 0.0 and last != "pulse":
		_start_aguilhao_pulse()
		return
	if float(arauto.get("charge_cd", 0.0)) <= 0.0:
		_start_aguilhao_charge(phase2)
	elif float(arauto.get("pulse_cd", 0.0)) <= 0.0 and distance <= 250.0:
		_start_aguilhao_pulse()
	elif float(arauto.get("seed_cd", 0.0)) <= 0.0 and _count_aguilhao_threats() < threat_limit:
		_start_aguilhao_seed(phase2)


func _start_aguilhao_charge(phase2: bool) -> void :
	var pos: = Vector2(arauto.get("pos", player_pos))
	var target: = _arauto_target_entry(true)
	var target_pos: = Vector2(target.get("pos", player_pos))
	var dir: = (target_pos - pos).normalized()
	if dir.length() <= 0.05:
		dir = Vector2.RIGHT * float(arauto.get("facing", 1.0))
	arauto["state"] = "charge_windup"
	arauto["state_timer"] = AGUILHAO_CHARGE_WINDUP_PHASE2 if phase2 else AGUILHAO_CHARGE_WINDUP
	arauto["charge_dir"] = dir
	arauto["charge_target"] = (pos + dir * 780.0).clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))
	arauto["charge_cd"] = AGUILHAO_CHARGE_COOLDOWN_PHASE2 if phase2 else AGUILHAO_CHARGE_COOLDOWN
	arauto["last_ability"] = "charge"
	arauto["facing"] = 1.0 if dir.x >= 0.0 else -1.0


func _update_aguilhao_charge(delta: float, phase2: bool) -> void :
	var pos: = Vector2(arauto.get("pos", player_pos))
	var dir: = Vector2(arauto.get("charge_dir", Vector2.RIGHT)).normalized()
	if dir.length() <= 0.05:
		dir = Vector2.RIGHT
	var intended: = pos + dir * AGUILHAO_CHARGE_SPEED * delta * (1.08 if phase2 else 1.0)
	var next: = intended.clamp(Vector2(48, 58), WORLD_SIZE - Vector2(48, 58))
	arauto["pos"] = next
	arauto["state_timer"] = max(0.0, float(arauto.get("state_timer", 0.0)) - delta)
	if not bool(arauto.get("charge_hit_local", false)) and _local_player_damageable_by_contact() and _distance_to_segment(player_pos, pos, next) <= AGUILHAO_CHARGE_HIT_WIDTH:
		arauto["charge_hit_local"] = true
		var push: = (player_pos - next).normalized()
		if push.length() <= 0.05:
			push = dir
		player_pos = _clamp_player_world(player_pos + push * 76.0)
		boss_wave_slow_timer = max(boss_wave_slow_timer, 1.15)
		_damage_player(int(player_hp_max * AGUILHAO_CHARGE_DAMAGE_RATE + enemy_close_damage * 0.45), "aguilhao_charge")
		_add_text("CHAGA PERFURANTE", player_pos + Vector2(-78, -82), Color(0.64, 1.0, 0.24), 0.85, 18)
	_damage_remote_player_on_segment(pos, next, AGUILHAO_CHARGE_HIT_WIDTH, int(player_hp_max * AGUILHAO_CHARGE_DAMAGE_RATE + enemy_close_damage * 0.45), "aguilhao_charge", arauto, "aguilhao_charge")
	if _aguilhao_charge_hit_nodule(pos, next):
		return
	if next != intended:
		_set_aguilhao_recovery(AGUILHAO_BOUNDARY_RECOVERY)
		return
	if float(arauto.get("state_timer", 0.0)) <= 0.0:
		_set_aguilhao_recovery(0.55)


func _aguilhao_charge_hit_nodule(a: Vector2, b: Vector2) -> bool:
	for enemy in enemies.duplicate():
		if not bool(enemy.get("aguilhao_nodule", false)) or float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		if _distance_to_segment(Vector2(enemy.get("pos", player_pos)), a, b) > _enemy_radius(enemy) + AGUILHAO_CHARGE_HIT_WIDTH * 0.55:
			continue
		var hit_pos: = Vector2(enemy.get("pos", a))
		_spawn_enemy_desfragmentation(hit_pos, Color(0.56, 1.0, 0.2), 22)
		enemies.erase(enemy)
		arauto_echo_breaks.append({"pos": hit_pos, "life": 0.62, "max": 0.62, "phase": rng.randf_range(0.0, TAU), "color": Color(0.56, 1.0, 0.2)})
		arauto["stun"] = AGUILHAO_CHARGE_NODE_STUN
		arauto["aguilhao_vulnerable"] = AGUILHAO_CHARGE_NODE_STUN
		arauto["state"] = "idle"
		_add_text("NODULO RASGADO", hit_pos + Vector2(-70, -66), Color(0.7, 1.0, 0.26), 0.95, 17)
		_add_text("AGUILHAO EXPOSTO", Vector2(arauto["pos"]) + Vector2(-86, -96), Color(1.0, 0.92, 0.26), 0.95, 18)
		shockwaves.append({"pos": hit_pos, "radius": 16.0, "max": 170.0, "life": 0.45, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(0.62, 1.0, 0.22)})
		return true
	return false


func _start_aguilhao_seed(phase2: bool) -> void :
	var spots: Array = []
	var target: = _arauto_target_entry(true)
	var target_pos: = Vector2(target.get("pos", player_pos))
	var threat_limit: = AGUILHAO_SEED_LIMIT_PHASE2 if phase2 else AGUILHAO_SEED_LIMIT
	var count: = mini(2, maxi(0, threat_limit - _count_aguilhao_threats()))
	for i in range(count):
		var angle: = rng.randf_range(0.0, TAU)
		var spot: = (target_pos + Vector2.from_angle(angle) * rng.randf_range(96.0, 172.0)).clamp(Vector2(65, 65), WORLD_SIZE - Vector2(65, 65))
		spots.append(spot)
	arauto["seed_spots"] = spots
	arauto["state"] = "seed"
	arauto["state_timer"] = AGUILHAO_SEED_WARNING
	arauto["seed_cd"] = AGUILHAO_SEED_COOLDOWN * (0.86 if phase2 else 1.0)
	arauto["last_ability"] = "seed"


func _resolve_aguilhao_seed(phase2: bool) -> void :
	var threat_limit: = AGUILHAO_SEED_LIMIT_PHASE2 if phase2 else AGUILHAO_SEED_LIMIT
	for spot in Array(arauto.get("seed_spots", [])):
		if _count_aguilhao_threats() >= threat_limit:
			break
		var before: = enemies.size()
		_spawn_enemy(ENEMY_CHRONAL_LEECH, Vector2(spot))
		if enemies.size() <= before:
			continue
		var leech: Dictionary = enemies[enemies.size() - 1]
		leech["aguilhao_spawned"] = true
		leech["skip_rewards"] = true
		leech["no_reconstitute"] = true
		leech["hp"] = max(float(leech.get("hp", enemy_base_hp)), enemy_base_hp * 1.2)
		leech["max_hp"] = float(leech["hp"])
		leech["leech_timer"] = min(float(leech.get("leech_timer", SANGUESSUGA_FALL_WARNING_TIME)), 0.42)
		leech["leech_life"] = min(float(leech.get("leech_life", SANGUESSUGA_DORMANT_TIME)), 12.0)
		_add_text("SEMEADURA", Vector2(spot) + Vector2(-42, -56), Color(0.62, 1.0, 0.22), 0.72, 15)
	arauto["seed_spots"] = []


func _start_aguilhao_pulse() -> void :
	arauto["state"] = "pulse"
	arauto["state_timer"] = AGUILHAO_PULSE_WARNING
	arauto["pulse_stage"] = 0
	arauto["pulse_cd"] = AGUILHAO_PULSE_COOLDOWN
	arauto["last_ability"] = "pulse"


func _resolve_aguilhao_pulse(phase2: bool, stage: int) -> void :
	var center: = Vector2(arauto.get("pos", player_pos))
	var radius: = AGUILHAO_PULSE_RADIUS * (1.22 if phase2 and stage > 0 else 1.0)
	var damage: = int(player_hp_max * AGUILHAO_PULSE_DAMAGE_RATE + enemy_close_damage * 0.32)
	if _local_player_damageable_by_contact() and player_pos.distance_to(center) <= radius:
		var dir: = (player_pos - center).normalized()
		if dir.length() <= 0.05:
			dir = Vector2.RIGHT
		player_pos = _clamp_player_world(player_pos + dir * (64.0 + float(stage) * 22.0))
		boss_wave_slow_timer = max(boss_wave_slow_timer, 0.95)
		_damage_player(damage, "aguilhao_pulse")
	_damage_remote_player_in_radius(center, radius, damage, "aguilhao_pulse")
	shockwaves.append({"pos": center, "radius": 14.0, "max": radius, "life": 0.46, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(0.54, 1.0, 0.18)})
	_spawn_radial_particles(center, Color(0.56, 1.0, 0.18), 24 + stage * 8)
	if phase2 and stage == 0:
		arauto["pulse_stage"] = 1
		arauto["state_timer"] = 0.42
		return
	_set_aguilhao_recovery(0.48)


func _set_aguilhao_recovery(duration: float) -> void :
	arauto["state"] = "recovery"
	arauto["state_timer"] = duration
	arauto["seed_spots"] = []


func _arauto_eye_pos() -> Vector2:
	var pos: = Vector2(arauto.get("pos", player_pos))
	var facing: = float(arauto.get("facing", 1.0))
	return pos + Vector2(20.0 * facing, -22.0)


func _arauto_target_entry(force_rotate: bool = false) -> Dictionary:
	var targets: = _combat_targets()
	if targets.is_empty():
		return {"peer_id": _mp_unique_id(), "pos": player_pos, "local": true}
	var current_index: = -1
	for index in range(targets.size()):
		if int(Dictionary(targets[index]).get("peer_id", 0)) == arauto_target_peer_id:
			current_index = index
			break
	if force_rotate or current_index < 0 or arauto_target_switch_timer <= 0.0:
		arauto_target_cursor = posmod(maxi(current_index, arauto_target_cursor) + 1, targets.size())
		var selected: Dictionary = targets[arauto_target_cursor]
		arauto_target_peer_id = int(selected.get("peer_id", 0))
		arauto_target_switch_timer = 2.0
		return selected
	return targets[current_index]


func _arauto_target_pos(peer_id: int, fallback: Vector2) -> Vector2:
	if peer_id == _mp_unique_id():
		return player_pos
	var state: Dictionary = net_players_by_peer.get(peer_id, {})
	if state.is_empty() or bool(state.get("dead", false)) or bool(state.get("stealthed", false)):
		return fallback
	return Vector2(state.get("pos", fallback))


func _fire_arauto_shot(phase2: bool) -> void :
	var origin: = _arauto_eye_pos()
	var target: = _arauto_target_entry(true)
	var dir: = (Vector2(target.get("pos", player_pos)) - origin).normalized()
	if dir.length() <= 0.01:
		dir = Vector2.RIGHT
	var damage: = int((player_hp_max * 0.052 + enemy_far_damage) * ARAUTO_DAMAGE_MULT)
	enemy_bullets.append({"pos": origin, "dir": dir, "life": 4.2, "damage": damage, "phase": rng.randf_range(0.0, TAU), "type": "arauto_shot", "speed_mult": ARAUTO_SHOT_SPEED_MULT * (1.08 if phase2 else 1.0)})


func _start_arauto_silence() -> void :
	var target: = _arauto_target_entry(true)
	arauto["silence_active"] = true
	arauto["silence_age"] = 0.0
	arauto["silence_target_peer"] = int(target.get("peer_id", _mp_unique_id()))
	arauto["silence_target"] = Vector2(target.get("pos", player_pos))
	arauto["silence_locked"] = false
	_add_text("SILENCIO DO ARAUTO!", Vector2(arauto["pos"]) + Vector2(-122, -148), Color(0.58, 0.86, 1.0), 1.0, 21)


func _update_arauto_silence(delta: float, phase2: bool) -> void :
	var charge: float = ARAUTO_SILENCE_WARNING * (0.82 if phase2 else 1.0)
	arauto["silence_age"] = float(arauto.get("silence_age", 0.0)) + delta
	if float(arauto["silence_age"]) < charge * 0.55:
		var target_peer: = int(arauto.get("silence_target_peer", _mp_unique_id()))
		var tracked: = _arauto_target_pos(target_peer, Vector2(-10000, -10000))
		if tracked.x < -9000.0:
			var replacement: = _arauto_target_entry(true)
			target_peer = int(replacement.get("peer_id", _mp_unique_id()))
			tracked = Vector2(replacement.get("pos", player_pos))
			arauto["silence_target_peer"] = target_peer
		arauto["silence_target"] = tracked
	elif not bool(arauto.get("silence_locked", false)):
		arauto["silence_locked"] = true
		_add_text("SILENCIO TRAVADO!", Vector2(arauto.get("silence_target", player_pos)) + Vector2(-64, -72), Color(0.72, 0.92, 1.0), 0.55, 18)
	if float(arauto["silence_age"]) >= charge:
		_resolve_arauto_silence(phase2)
		arauto["silence_active"] = false
		arauto["silence_cd"] = ARAUTO_SILENCE_COOLDOWN_PHASE2 if phase2 else ARAUTO_SILENCE_COOLDOWN


func _resolve_arauto_silence(phase2: bool) -> void :
	var center: = Vector2(arauto.get("silence_target", player_pos))
	var radius: float = ARAUTO_SILENCE_RADIUS * (1.14 if phase2 else 1.0)
	_apply_arauto_silence_hit(center, radius, phase2, int(arauto.get("silence_target_peer", _mp_unique_id())))
	shockwaves.append({"pos": center, "radius": 8.0, "max": radius + 92.0, "life": 0.34, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(0.5, 0.88, 1.0)})
	_spawn_radial_particles(center, Color(0.52, 0.86, 1.0), 24)


func _apply_arauto_silence_hit(center: Vector2, radius: float, phase2: bool, target_peer: int) -> void :
	var duration: = ARAUTO_SILENCE_DURATION * (1.16 if phase2 else 1.0)
	var damage: = int((player_hp_max * 0.035 + enemy_far_damage * 0.2) * ARAUTO_DAMAGE_MULT)
	if target_peer == _mp_unique_id():
		if player_pos.distance_to(center) > radius:
			return
		player_silence_timer = max(player_silence_timer, duration)
		_damage_player(damage, "silencio_arauto")
		_add_text("SILENCIADO!", player_pos + Vector2(-50, -88), Color(0.72, 0.92, 1.0), 0.9, 21)
		return
	var remote_pos: = _arauto_target_pos(target_peer, Vector2(-10000, -10000))
	if remote_pos.distance_to(center) <= radius:
		_send_peer_damage(target_peer, damage, "silencio_arauto")
		_request_peer_status(target_peer, "silence", duration)


func _cast_arauto_echo_pulse(phase2: bool) -> void :
	var center: = Vector2(arauto.get("pos", player_pos))
	var radius: float = ARAUTO_ECHO_PULSE_RADIUS * (1.12 if phase2 else 1.0)
	for enemy in enemies:
		if not bool(enemy.get("eco_vinculado", false)) or float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		if Vector2(enemy["pos"]).distance_to(center) > radius:
			continue
		var max_hp: float = float(enemy.get("max_hp", enemy_base_hp))
		enemy["hp"] = min(max_hp, float(enemy.get("hp", max_hp)) + max_hp * 0.1)
		enemy["speed"] = min(enemy_speed_base * 2.15, float(enemy.get("speed", enemy_speed_base)) * 1.04)
		enemy["stun"] = 0.0
		enemy["phase"] = float(enemy.get("phase", 0.0)) + 1.2
	if player_pos.distance_to(center) <= radius:
		var direction: = (player_pos - center).normalized()
		if direction.length() <= 0.05:
			direction = Vector2.RIGHT
		player_pos = _clamp_player_world(player_pos + direction * (88.0 if phase2 else 66.0))
		_damage_player(int((player_hp_max * 0.052 + enemy_close_damage * 0.35) * ARAUTO_DAMAGE_MULT), "pulso_ecos")
		_add_text("PULSO DOS ECOS", player_pos + Vector2(-72, -92), Color(0.55, 0.92, 1.0), 0.82, 19)
	_damage_remote_player_in_radius(center, radius, int((player_hp_max * 0.052 + enemy_close_damage * 0.35) * ARAUTO_DAMAGE_MULT), "pulso_ecos")
	shockwaves.append({"pos": center, "radius": 16.0, "max": radius, "life": 0.48, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(0.42, 0.78, 1.0)})
	_spawn_radial_particles(center, Color(0.46, 0.82, 1.0), 28)


func _start_arauto_gaze() -> void :
	var target: = _arauto_target_entry(true)
	arauto["gaze_active"] = true
	arauto["gaze_age"] = 0.0
	arauto["gaze_target_peer"] = int(target.get("peer_id", _mp_unique_id()))
	arauto["gaze_target"] = Vector2(target.get("pos", player_pos))
	arauto["gaze_locked"] = false
	_add_text("OLHAR DA RUPTURA - USE UM ECO!", Vector2(arauto["pos"]) + Vector2(-185, -152), Color(1.0, 0.72, 1.0), 1.35, 21)


func _update_arauto_gaze(delta: float, phase2: bool) -> void :
	var charge: = ARAUTO_GAZE_CHARGE_PHASE2 if phase2 else ARAUTO_GAZE_CHARGE
	arauto["gaze_age"] = float(arauto.get("gaze_age", 0.0)) + delta
	if float(arauto["gaze_age"]) < charge * ARAUTO_GAZE_LOCK_RATIO:
		var target_peer: = int(arauto.get("gaze_target_peer", _mp_unique_id()))
		var tracked: = _arauto_target_pos(target_peer, Vector2(-10000, -10000))
		if tracked.x < -9000.0:
			var replacement: = _arauto_target_entry(true)
			target_peer = int(replacement.get("peer_id", _mp_unique_id()))
			tracked = Vector2(replacement.get("pos", player_pos))
			arauto["gaze_target_peer"] = target_peer
		arauto["gaze_target"] = tracked
	elif not bool(arauto.get("gaze_locked", false)):
		arauto["gaze_locked"] = true
		_add_text("ALVO TRAVADO!", player_pos + Vector2(-58, -96), Color(1.0, 0.32, 0.72), 0.65, 20)
	if float(arauto["gaze_age"]) >= charge:
		_resolve_arauto_gaze(phase2)
		arauto["gaze_active"] = false
		arauto["gaze_cd"] = ARAUTO_GAZE_COOLDOWN_PHASE2 if phase2 else ARAUTO_GAZE_COOLDOWN


func _resolve_arauto_gaze(phase2: bool) -> void :
	var origin: = _arauto_eye_pos()
	var target: = Vector2(arauto.get("gaze_target", player_pos))
	var direction: = target - origin
	var distance: float = max(1.0, direction.length())
	var dir: Vector2 = direction / distance
	var finish: Vector2 = origin + dir * WORLD_SIZE.length() * 1.25
	var blocker: = {}
	var best_projection: = INF
	for enemy in enemies:
		if not bool(enemy.get("eco_vinculado", false)) or float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		var enemy_pos: = Vector2(enemy["pos"])
		var projection: = (enemy_pos - origin).dot(dir)
		if projection <= 0.0 or projection > distance:
			continue
		if _distance_to_segment(enemy_pos, origin, finish) <= _enemy_radius(enemy):
			if projection < best_projection:
				best_projection = projection
				blocker = enemy
	if not blocker.is_empty():
		finish = Vector2(blocker["pos"])
		arauto_echo_breaks.append({"pos": finish, "life": 0.55, "max": 0.55, "phase": rng.randf_range(0.0, TAU)})
		_add_text("ECO SACRIFICADO - OLHAR BLOQUEADO!", finish + Vector2(-125, -58), Color(0.58, 0.92, 1.0), 1.05, 18)
		_kill_enemy(blocker)
		arauto_rays.append({"a": origin, "b": finish, "life": 0.42, "max": 0.42, "blocked": true})
		return
	var target_peer: = int(arauto.get("gaze_target_peer", _mp_unique_id()))
	var damage_percent: = 0.18 if phase2 else 0.14
	var damage: = int((player_hp_max * damage_percent + enemy_far_damage * 0.35) * ARAUTO_DAMAGE_MULT)
	if target_peer == _mp_unique_id() and _distance_to_segment(player_pos, origin, finish) <= ARAUTO_GAZE_HIT_RADIUS:
		_damage_player(int((player_hp_max * damage_percent + enemy_far_damage * 0.35) * ARAUTO_DAMAGE_MULT), "olhar_da_ruptura")
		_add_text("OLHAR DA RUPTURA", player_pos + Vector2(-72, -96), Color(1.0, 0.18, 0.72), 0.95, 20)
	elif target_peer != _mp_unique_id():
		var remote_pos: = _arauto_target_pos(target_peer, Vector2(-10000, -10000))
		if _distance_to_segment(remote_pos, origin, finish) <= ARAUTO_GAZE_HIT_RADIUS:
			_send_peer_damage(target_peer, damage, "olhar_da_ruptura")
	arauto_rays.append({"a": origin, "b": finish, "life": 0.42, "max": 0.42, "blocked": false})


func _damage_arauto(amount: float, source: String, show_text: = true, apply_aura_multiplier: = true, source_category: = "", attack_origin: = Vector2.ZERO) -> void :
	if not _arauto_active():
		return
	var effective_source_category: = source_category
	if effective_source_category == "" and _damage_source_category(source) == "basic_attack":
		effective_source_category = "manifestation_secondary"
	if is_multiplayer and not _is_world_authority():
		amount = _outgoing_damage_amount(amount, source)
		_send_client_damage_request(NET_DAMAGE_ARAUTO, "", amount, source, player_pos, show_text)
		return
	if apply_aura_multiplier and not source.begins_with("aura_"):
		amount *= AuraSystem.damage_multiplier(aura_state)
	if _is_direct_player_damage_source(source, effective_source_category):
		amount *= _contractual_damage_multiplier()
	if _is_direct_player_damage_source(source, effective_source_category):
		var opportunity: = AuraSystem.consume_opportunity_damage(aura_state, player_damage)
		amount += float(opportunity.get("bonus", 0.0))
		_apply_aura_events(opportunity.get("events", []))
	amount *= _mandamento_damage_multiplier(effective_source_category)
	var trigger_card_effects: = _card_damage_can_trigger(source)
	if trigger_card_effects:
		_consume_fratura_cronal_on_arauto(source)
	var guard_count: int = _count_aguilhao_nodules() if _arauto_is_aguilhao() else _count_arauto_echoes()
	var reduction: float = min(AGUILHAO_MAX_NODE_REDUCTION, float(guard_count) * AGUILHAO_NODE_DAMAGE_REDUCTION) if _arauto_is_aguilhao() else min(ARAUTO_MAX_DAMAGE_REDUCTION, float(guard_count) * ARAUTO_ECHO_DAMAGE_REDUCTION)
	amount = _apply_limiar_ruina_damage(amount, float(arauto.get("hp", 0.0)), float(arauto.get("max_hp", arauto.get("hp", 1.0))), source, effective_source_category, Vector2(arauto.get("pos", player_pos)))
	var final: float = max(1.0, amount * (1.0 - reduction))
	if _arauto_is_aguilhao() and float(arauto.get("aguilhao_vulnerable", 0.0)) > 0.0:
		final *= AGUILHAO_STUN_VULNERABILITY_MULT
	final *= _fragilidade_arauto_multiplier(source)
	final *= _pressao_cerco_arauto_multiplier(source)
	var hp_before: float = float(arauto["hp"])
	arauto["hp"] = max(0.0, hp_before - final)
	var actual_damage: float = hp_before - max(0.0, float(arauto["hp"]))
	if String(aura_state.get("name", "")) == "Crepuscular" and _is_direct_player_damage_source(source, effective_source_category):
		AuraSystem.on_boss_hit(aura_state, Vector2(arauto["pos"]), actual_damage)
		if actual_damage > 0.0 and String(aura_state.get("crepuscular_phase", "")) == "ocaso":
			arauto["crepuscular_ocaso_mark"] = maxf(float(arauto.get("crepuscular_ocaso_mark", 0.0)), 3.5)
	var antimatter_should_trigger: bool = _antimatter_direct_trigger(source, effective_source_category)
	if antimatter_should_trigger:
		_trigger_antimatter_implosion(Vector2(arauto["pos"]))
	else:
		_register_antimatter_damage(actual_damage, source, effective_source_category)
	if float(arauto["hp"]) <= 0.0:
		_store_excess_damage(max(0.0, final - hp_before), source, effective_source_category)
	elif actual_damage > 0.0:
		_select_excess_discharge_target_boss(source, effective_source_category)
	if trigger_card_effects:
		_register_eco_impact("arauto", 0, Vector2(arauto["pos"]), actual_damage, source, effective_source_category)
		if hp_before > 0.0 and float(arauto["hp"]) <= 0.0:
			_reduce_margem_debt_on_kill(2.0)
	if show_text:
		var color: = Color(0.62, 1.0, 0.3) if guard_count > 0 else _damage_color(source)
		_add_text("-%d" % int(final), Vector2(arauto["pos"]) + Vector2(rng.randf_range(-28, 28), -82), color, 0.62, _damage_text_size(18))
	if trigger_card_effects:
		_consume_pulso_desestabilizador(Vector2(arauto["pos"]), source)
	if float(arauto["hp"]) <= 0.0:
		_finish_arauto()


func _finish_arauto() -> void :
	if arauto.is_empty():
		return
	var pos: = Vector2(arauto.get("pos", player_pos))
	var was_aguilhao: = _arauto_is_aguilhao()
	for enemy in enemies.duplicate():
		if bool(enemy.get("eco_vinculado", false)) or bool(enemy.get("aguilhao_nodule", false)) or bool(enemy.get("aguilhao_spawned", false)):
			_spawn_enemy_desfragmentation(Vector2(enemy.get("pos", pos)), _enemy_shard_color(enemy), 12)
			enemies.erase(enemy)
	_spawn_arauto_card_rewards(pos)
	_add_text("AGUILHAO DESFEITO" if was_aguilhao else "ARAUTO DESFEITO", pos + Vector2(-138 if was_aguilhao else -118, -108), Color(0.72, 1.0, 0.38) if was_aguilhao else Color(0.82, 0.94, 1.0), 2.1, 30)
	_add_text("+4 CARTAS NO MAPA", pos + Vector2(-116, -146), Color(1.0, 0.86, 0.24), 2.1, 22)
	_spawn_radial_particles(pos, Color(0.58, 1.0, 0.2) if was_aguilhao else Color(0.72, 0.64, 1.0), 60)
	shockwaves.append({"pos": pos, "radius": 22.0, "max": 520.0, "life": 0.85, "damage": 0.0, "hit": {}, "visual_only": true, "color": Color(0.54, 1.0, 0.18) if was_aguilhao else Color(0.72, 0.64, 1.0)})
	arauto.clear()
	_spawn_arauto_evolution_fragment(pos, ARAUTO_VARIANT_AGUILHAO if was_aguilhao else ARAUTO_VARIANT_CONDUTOR)


func _manifest_evolution_fragment_available() -> bool:
	return not bool(manifest_evolution_fragment_claimed_this_run)


func _mark_manifest_evolution_fragment_collected(source: String) -> void:
	manifest_evolution_fragment_claimed_this_run = true
	manifest_evolution_fragment_claim_source = source


func _spawn_arauto_evolution_fragment(pos: Vector2, source: String = "") -> void :
	if not _manifest_evolution_fragment_available():
		_add_text("JOIA JA COLETADA", pos + Vector2(-96, -182), Color(0.68, 0.72, 0.82), 1.45, 19)
		return
	var fragment_source: String = source if source != "" else ARAUTO_VARIANT_AGUILHAO if current_phase == 6 else ARAUTO_VARIANT_CONDUTOR
	if not is_multiplayer:
		arauto_evolution_fragment = {
			"pos": pos.clamp(Vector2(70, 80), WORLD_SIZE - Vector2(70, 80)), 
			"life": 0.0, 
			"pulse": rng.randf_range(0.0, TAU), 
			"source": fragment_source
		}
	else:
		arauto_evolution_fragments.clear()
		for peer_id in _reward_peer_ids():
			net_reward_sequence += 1
			arauto_evolution_fragments.append({
				"fragment_id": "fragment_%d_%d" % [Time.get_ticks_msec(), net_reward_sequence], 
				"owner_peer": peer_id, 
				"pos": pos.clamp(Vector2(70, 80), WORLD_SIZE - Vector2(70, 80)), 
				"life": 0.0, 
				"pulse": rng.randf_range(0.0, TAU), 
				"source": fragment_source
			})
	_add_text("FRAGMENTO DE EVOLUCAO", pos + Vector2(-120, -182), _manifestation_color(), 2.1, 22)


func _spawn_arauto_card_rewards(pos: Vector2) -> void :
	for peer_id in _reward_peer_ids():
		var pool: Array = _available_card_drop_pool()
		for i in range(ARAUTO_CARD_REWARD_COUNT):
			if pool.is_empty():
				pool = _available_card_drop_pool()
				if pool.is_empty():
					return
			var index: = rng.randi_range(0, pool.size() - 1)
			var card: Dictionary = pool[index]
			pool.remove_at(index)
			var angle: = TAU * float(i) / float(ARAUTO_CARD_REWARD_COUNT) + rng.randf_range(-0.24, 0.24)
			_append_owned_card_drop(card, pos, angle, peer_id, 18.0, 42.0, 76.0, 80.0, 132.0)


func _spawn_random_card_drops(pos: Vector2, count: int, rare_slots: int) -> void :
	for peer_id in _reward_peer_ids():
		var peer_rare_slots: = rare_slots
		var rare_pool: Array = CARDS.filter( func(card): return _card_available_for_reward(card, true, true) and _is_rare_card(card))
		var common_pool: Array = CARDS.filter( func(card): return _card_available_for_reward(card, true, true) and _is_common_card(card))
		for i in range(count):
			var card: Dictionary = {}
			if peer_rare_slots > 0 and not rare_pool.is_empty():
				var rare_index: = rng.randi_range(0, rare_pool.size() - 1)
				card = rare_pool[rare_index]
				rare_pool.remove_at(rare_index)
				peer_rare_slots -= 1
			elif not common_pool.is_empty():
				var common_index: = rng.randi_range(0, common_pool.size() - 1)
				card = common_pool[common_index]
				common_pool.remove_at(common_index)
			if card.is_empty():
				return
			var angle: = TAU * float(i) / float(max(1, count)) + rng.randf_range(-0.34, 0.34)
			_append_owned_card_drop(card, pos, angle, peer_id, 20.0, 54.0, 92.0, 84.0, 146.0)


func _reward_peer_ids() -> Array[int]:
	if not is_multiplayer:
		return [0]
	var peer_ids: Array[int] = [_mp_unique_id()]
	for peer_key in net_players_by_peer.keys():
		var peer_id: = int(peer_key)
		if not peer_ids.has(peer_id):
			peer_ids.append(peer_id)
	peer_ids.sort()
	return peer_ids


func _append_owned_card_drop(card: Dictionary, pos: Vector2, angle: float, owner_peer: int, life: float, min_speed: float, max_speed: float, min_radius: float, max_radius: float) -> void :
	if not _card_drop_texture_available(card):
		return
	net_reward_sequence += 1
	arauto_card_drops.append({
		"drop_id": "drop_%d_%d" % [Time.get_ticks_msec(), net_reward_sequence], 
		"owner_peer": owner_peer, 
		"card": card.duplicate(true), 
		"pos": (pos + Vector2.from_angle(angle) * rng.randf_range(min_radius, max_radius)).clamp(Vector2(70, 80), WORLD_SIZE - Vector2(70, 80)), 
		"vel": Vector2.from_angle(angle) * rng.randf_range(min_speed, max_speed), 
		"life": life, 
		"age": 0.0, 
		"phase": rng.randf_range(0.0, TAU)
	})


func _reward_owned_by_local(reward: Dictionary) -> bool:
	var owner_peer: = int(reward.get("owner_peer", 0))
	return owner_peer == 0 or owner_peer == _mp_unique_id()


func _update_arauto_card_drops(delta: float) -> void :
	for drop in arauto_card_drops:
		var card: Dictionary = drop.get("card", {})
		if not _card_drop_texture_available(card):
			drop["life"] = 0.0
			continue
		drop["age"] = float(drop.get("age", 0.0)) + delta
		drop["life"] = float(drop.get("life", 0.0)) - delta
		drop["pos"] = (Vector2(drop["pos"]) + Vector2(drop.get("vel", Vector2.ZERO)) * delta).clamp(Vector2(60, 70), WORLD_SIZE - Vector2(60, 70))
		drop["vel"] = Vector2(drop.get("vel", Vector2.ZERO)) * pow(0.08, delta)
		var drop_id: = String(drop.get("drop_id", ""))
		if drop_id != "" and net_collected_drop_ids.has(drop_id):
			continue
		if _reward_owned_by_local(drop) and Vector2(drop["pos"]).distance_to(player_pos) <= _neutral_pickup_radius(50.0):
			_apply_card(card)
			if drop_id != "":
				net_collected_drop_ids[drop_id] = true
			drop["life"] = 0.0
			var card_color: Color = card.get("color", Color(1.0, 0.86, 0.24))
			_spawn_radial_particles(Vector2(drop["pos"]), card_color, 22)
			_add_text("CARTA: %s" % String(card.get("nick", card.get("name", "???"))), player_pos + Vector2(-80, -88), card_color, 1.25, 20)
	arauto_card_drops = arauto_card_drops.filter( func(drop): return float(drop.get("life", 0.0)) > 0.0)


func _available_card_drop_pool() -> Array:
	return CARDS.filter( func(card): return _card_available_for_reward(card, true, true))


func _update_arauto_evolution_fragment(delta: float) -> void :
	if is_multiplayer:
		for fragment in arauto_evolution_fragments:
			var fragment_id: = String(fragment.get("fragment_id", ""))
			fragment["life"] = float(fragment.get("life", 0.0)) + delta
			fragment["pulse"] = float(fragment.get("pulse", 0.0)) + delta * 4.4
			if fragment_id != "" and net_collected_fragment_ids.has(fragment_id):
				continue
			if _reward_owned_by_local(fragment) and Vector2(fragment.get("pos", player_pos)).distance_to(player_pos) <= _neutral_pickup_radius(BOSS_FRAGMENT_PICKUP_RADIUS):
				var fragment_pos: = Vector2(fragment.get("pos", player_pos))
				net_collected_fragment_ids[fragment_id] = true
				_mark_manifest_evolution_fragment_collected(String(fragment.get("source", "")))
				_spawn_radial_particles(fragment_pos, _manifestation_color(), 38)
				_open_manifest_evolution_choice(fragment_pos)
				return
		return
	if arauto_evolution_fragment.is_empty():
		return
	arauto_evolution_fragment["life"] = float(arauto_evolution_fragment.get("life", 0.0)) + delta
	arauto_evolution_fragment["pulse"] = float(arauto_evolution_fragment.get("pulse", 0.0)) + delta * 4.4
	if Vector2(arauto_evolution_fragment.get("pos", player_pos)).distance_to(player_pos) <= _neutral_pickup_radius(BOSS_FRAGMENT_PICKUP_RADIUS):
		var pos: = Vector2(arauto_evolution_fragment.get("pos", player_pos))
		_mark_manifest_evolution_fragment_collected(String(arauto_evolution_fragment.get("source", "")))
		arauto_evolution_fragment.clear()
		_spawn_radial_particles(pos, _manifestation_color(), 38)
		_open_manifest_evolution_choice(pos)


