	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		print("Atualizador: consulta indisponivel HTTP ", response_code)
		return
	var payload = JSON.parse_string(body.get_string_from_utf8())
	if not payload is Dictionary:
		print("Atualizador: manifesto invalido")
		return
	_apply_app_update_manifest(payload)


func _apply_app_update_manifest(payload: Dictionary) -> void :
	if not bool(payload.get("available", false)):
		return
	var version_code: = int(payload.get("version_code", 0))
	var download_url: = String(payload.get(_app_update_download_url_field(), payload.get("download_url", "")))
	var sha256: = String(payload.get("sha256", "")).to_lower()
	var expected_prefix: = ONLINE_RELAY_BASE_URL + _app_update_download_prefix()
	if version_code <= GAME_VERSION_CODE or not download_url.begins_with(expected_prefix):
		print("Atualizador: versao ou URL recusada")
		return
	if sha256.length() != 64 or not sha256.is_valid_hex_number(false):
		print("Atualizador: SHA-256 invalido")
		return
	app_update_manifest = payload.duplicate(true)
	app_update_status = "available"
	app_update_error = ""
	app_update_selected = 0
	app_update_popup_visible = true
	_block_ui_input()


func _app_update_filename() -> String:
	var version: = String(app_update_manifest.get("version", "nova")).replace("/", "_").replace("\\", "_")
	var filename: = String(app_update_manifest.get("filename", ""))
	if filename != "":
		return filename.get_file().replace("/", "_").replace("\\", "_")
	return "ruptura_temporal_%s.%s" % [version, "exe" if _app_update_platform() == "windows" else "apk"]


func _cleanup_stale_app_update_files(keep_path: = "") -> int:
	var updates_dir_absolute: = ProjectSettings.globalize_path(APP_UPDATE_STORAGE_DIR)
	if not DirAccess.dir_exists_absolute(updates_dir_absolute):
		return 0
	var keep_absolute: = ProjectSettings.globalize_path(keep_path) if keep_path != "" else ""
	var dir: = DirAccess.open(APP_UPDATE_STORAGE_DIR)
	if dir == null:
		return 0
	var removed: = 0
	dir.list_dir_begin()
	var filename: = dir.get_next()
	while filename != "":
		if not dir.current_is_dir():
			var extension: = filename.get_extension().to_lower()
			if APP_UPDATE_CACHED_EXTENSIONS.has(extension):
				var candidate: = APP_UPDATE_STORAGE_DIR + "/" + filename
				var candidate_absolute: = ProjectSettings.globalize_path(candidate)
				if candidate_absolute != keep_absolute and DirAccess.remove_absolute(candidate_absolute) == OK:
					removed += 1
		filename = dir.get_next()
	dir.list_dir_end()
	if removed > 0:
		print("Atualizador: limpou %d instalador(es) antigo(s)." % removed)
	return removed


func _start_app_update_download() -> void :
	if app_update_download_request == null or app_update_manifest.is_empty():
		_set_app_update_error("Download indisponivel neste dispositivo.")
		return
	var absolute_dir: = ProjectSettings.globalize_path(APP_UPDATE_STORAGE_DIR)
	var mkdir_err: = DirAccess.make_dir_recursive_absolute(absolute_dir)
	if mkdir_err != OK and mkdir_err != ERR_ALREADY_EXISTS:
		_set_app_update_error("Nao foi possivel preparar a pasta da atualizacao.")
		return
	_cleanup_stale_app_update_files()
	app_update_download_path = APP_UPDATE_STORAGE_DIR + "/" + _app_update_filename()
	var absolute_path: = ProjectSettings.globalize_path(app_update_download_path)
	if FileAccess.file_exists(app_update_download_path):
		DirAccess.remove_absolute(absolute_path)
	app_update_download_request.download_file = app_update_download_path
	app_update_status = "downloading"
	app_update_error = ""
	app_update_selected = 0
	var err: = app_update_download_request.request(String(app_update_manifest.get(_app_update_download_url_field(), app_update_manifest.get("download_url", ""))), ["Cache-Control: no-cache"])
	if err != OK:
		app_update_download_request.download_file = ""
		_set_app_update_error("Falha ao iniciar download: %s" % error_string(err))


func _cancel_app_update_download() -> void :
	if app_update_download_request != null:
		app_update_download_request.cancel_request()
		app_update_download_request.download_file = ""
	_remove_partial_app_update()
	app_update_status = "available"
	app_update_selected = 0


func _remove_partial_app_update() -> void :
	if app_update_download_path == "":
		return
	var absolute_path: = ProjectSettings.globalize_path(app_update_download_path)
	if FileAccess.file_exists(app_update_download_path):
		DirAccess.remove_absolute(absolute_path)


func _on_app_update_download_completed(result: int, response_code: int, _headers: PackedStringArray, _body: PackedByteArray) -> void :
	if app_update_download_request != null:
		app_update_download_request.download_file = ""
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		_remove_partial_app_update()
		_set_app_update_error("Download interrompido. Verifique sua conexao e tente novamente.")
		return
	app_update_status = "verifying"
	call_deferred("_finish_app_update_download")


func _finish_app_update_download() -> void :
	var verification: = _verify_app_update_file(
		app_update_download_path, 
		int(app_update_manifest.get("size", 0)), 
		String(app_update_manifest.get("sha256", ""))
	)
	if not bool(verification.get("ok", false)):
		_remove_partial_app_update()
		_set_app_update_error(String(verification.get("error", "O arquivo recebido falhou na verificacao.")))
		return
	_open_app_update_installer()


func _verify_app_update_file(file_path: String, expected_size: int, expected_sha256: String) -> Dictionary:
	return _verify_update_file(file_path, expected_size, expected_sha256, _app_update_file_label())


func _verify_update_file(file_path: String, expected_size: int, expected_sha256: String, file_label: String) -> Dictionary:
	var file: = FileAccess.open(file_path, FileAccess.READ)
	if file == null:
		return {"ok": false, "error": "O arquivo baixado nao pode ser aberto."}
	var actual_size: = file.get_length()
	if expected_size <= 0 or actual_size != expected_size:
		file.close()
		return {"ok": false, "error": "O tamanho do %s nao confere com a versao publicada." % file_label}
	var hashing: = HashingContext.new()
	var hash_err: = hashing.start(HashingContext.HASH_SHA256)
	if hash_err != OK:
		file.close()
		return {"ok": false, "error": "Nao foi possivel iniciar a verificacao SHA-256."}
	while file.get_position() < actual_size:
		var remaining: = actual_size - file.get_position()
		var chunk: = file.get_buffer(mini(APP_UPDATE_HASH_CHUNK_BYTES, remaining))
		if chunk.is_empty():
			file.close()
			return {"ok": false, "error": "Leitura incompleta durante a verificacao do %s." % file_label}
		hashing.update(chunk)
	file.close()
	var actual_sha256: = hashing.finish().hex_encode().to_lower()
	if actual_sha256 != expected_sha256.to_lower():
		return {"ok": false, "error": "A assinatura SHA-256 do %s nao confere." % file_label}
	return {"ok": true, "size": actual_size, "sha256": actual_sha256}


func _open_app_update_installer() -> void :
	if OS.get_name() != "Android":
		var open_target: = ProjectSettings.globalize_path(app_update_download_path)
		var err: = OS.shell_open(open_target)
		app_update_status = "installer_open" if err == OK else "validated"
		app_update_selected = 0
		return
	if not Engine.has_singleton(APP_UPDATE_PLUGIN_NAME):
		OS.shell_open(String(app_update_manifest.get("apk_url", app_update_manifest.get("download_url", ""))))
		app_update_status = "browser_fallback"
		app_update_selected = 0
		return
	var plugin = Engine.get_singleton(APP_UPDATE_PLUGIN_NAME)
	var result: = String(plugin.call("installUpdate", ProjectSettings.globalize_path(app_update_download_path)))
	if result == "PERMISSION_REQUIRED":
		app_update_status = "permission_required"
		app_update_selected = 0
	elif result.begins_with("OK:"):
		app_update_status = "installer_open"
		app_update_selected = 0
	else:
		_set_app_update_error("O Android recusou o instalador: %s" % result.trim_prefix("ERRO:"))


func _set_app_update_error(message: String) -> void :
	app_update_status = "error"
	app_update_error = message
	app_update_selected = 0
	app_update_popup_visible = true


func _dismiss_app_update() -> void :
	if bool(app_update_manifest.get("mandatory", false)):
		return
	if app_update_status == "downloading":
		_cancel_app_update_download()
	app_update_popup_visible = false
	app_update_selected = 0
	ui_input_block_until_msec = 0


func _limit_discord_field(text: String) -> String:
	if text.length() <= 1000:
		return text
	return text.substr(0, 997) + "..."


func _on_run_report_request_completed(_result: int, response_code: int, _headers: PackedStringArray, _body: PackedByteArray) -> void :
	run_report_in_flight = false
	if response_code >= 200 and response_code < 300:
		run_report_status = "Relatorio enviado"
	else:
		run_report_status = "Falha Discord HTTP %d" % response_code


func _reset_qa_streaming_runtime(clear_access: = true) -> void :
	if clear_access:
		qa_streaming_unlocked = false
		qa_streaming_enabled = false
	qa_streaming_in_flight = false
	qa_streaming_native_active = false
	qa_streaming_desktop_ffmpeg_active = false
	qa_streaming_desktop_ffmpeg_pid = -1
	qa_streaming_session_id = ""
	qa_streaming_publish_url = ""
	qa_streaming_native_publish_url = ""
	qa_streaming_desktop_publish_url = ""
	qa_streaming_watch_url = ""
	qa_streaming_viewer_url = ""
	qa_streaming_poll_timer = 0.0
	qa_streaming_publish_wait = 0.0
	qa_streaming_link_sent = false
	qa_streaming_permission_pending = false
	qa_streaming_frame_active = false
	qa_streaming_frame_in_flight = false
	qa_streaming_frame_in_flight_count = 0
	for i in range(qa_stream_frame_request_busy.size()):
		qa_stream_frame_request_busy[i] = false
	qa_streaming_frame_url = ""
	qa_streaming_frame_timer = 0.0
	qa_streaming_frame_seq = 0
	qa_streaming_frame_count = 0
	qa_streaming_last_frame_size = 0
	qa_streaming_sent_this_second = 0
	qa_streaming_sent_per_second = 0
	qa_streaming_fps_timer = 0.0
	qa_streaming_frame_content_type = "image/jpeg"
	qa_streaming_status = ""


func _qa_streaming_is_active() -> bool:
	return qa_streaming_native_active or qa_streaming_desktop_ffmpeg_active or qa_streaming_frame_active or qa_streaming_in_flight


func _qa_stream_transport_label() -> String:
	if _qa_stream_native_available():
		return "android nativo"
	return "viewport"


func _qa_stream_session_protocol() -> String:
	return "rtmp-hls" if _qa_stream_native_available() else "frame-mjpeg"


func _start_qa_streaming_session() -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		_reset_qa_streaming_runtime()
		return
	if DisplayServer.get_name() == "headless":
		qa_streaming_enabled = false
		qa_streaming_status = "Streaming: headless indisponivel"
		return
	_reset_qa_streaming_runtime(false)
	if not qa_streaming_unlocked or not qa_streaming_enabled:
		qa_streaming_enabled = false
		return
	if qa_streaming_in_flight or qa_streaming_session_id != "":
		return
	if qa_stream_session_request == null:
		qa_streaming_status = "Streaming: HTTP indisponivel"
		return
	qa_streaming_in_flight = true
	qa_streaming_status = "Streaming: abrindo sessao..."
	var payload: = {
		"player": player_nickname, 
		"room": online_room_code if online_room_code != "" else ("solo-%d" % int(Time.get_unix_time_from_system())), 
		"version": GAME_VERSION, 
		"protocol": _qa_stream_session_protocol(), 
		"streamWidth": _qa_stream_target_size().x, 
		"streamHeight": _qa_stream_target_size().y, 
		"streamFps": _qa_stream_target_fps(), 
		"streamQuality": _qa_stream_jpeg_quality(), 
		"streamBitrate": _qa_stream_bitrate(), 
		"bufferMs": QA_FRAME_STREAM_BUFFER_MS
	}
	var err: = qa_stream_session_request.request(
		qa_stream_base_url + "/streams", 
		["Content-Type: application/json"], 
		HTTPClient.METHOD_POST, 
		JSON.stringify(payload)
	)
	if err != OK:
		qa_streaming_in_flight = false
		qa_streaming_status = "Streaming: falha ao chamar relay"


func _on_qa_stream_session_request_completed(result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray) -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		_reset_qa_streaming_runtime()
		return
	qa_streaming_in_flight = false
	var payload = JSON.parse_string(body.get_string_from_utf8())
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300 or typeof(payload) != TYPE_DICTIONARY:
		qa_streaming_status = "Streaming: relay indisponivel"
		return
	qa_streaming_session_id = String(payload.get("id", ""))
	qa_streaming_publish_url = String(payload.get("publishUrl", ""))
	qa_streaming_native_publish_url = String(payload.get("rtmpPublishUrl", qa_streaming_publish_url))
	qa_streaming_desktop_publish_url = String(payload.get("mjpegPublishUrl", ""))
	qa_streaming_frame_url = String(payload.get("frameUrl", qa_streaming_publish_url))
	qa_streaming_watch_url = String(payload.get("hlsUrl", payload.get("mjpegUrl", payload.get("watchUrl", ""))))
	qa_streaming_viewer_url = String(payload.get("viewerUrl", qa_streaming_watch_url))
	if qa_streaming_session_id == "":
		qa_streaming_status = "Streaming: sessao invalida"
		return
	if _qa_stream_native_available() and qa_streaming_native_publish_url.begins_with("rtmp"):
		_start_native_qa_stream()
	else:
		if qa_streaming_frame_url == "":
			qa_streaming_status = "Streaming: sessao invalida"
			return
		qa_streaming_frame_active = true
		qa_streaming_frame_timer = 999.0
		qa_streaming_publish_wait = 0.0
		qa_streaming_status = "Streaming: enviando imagem..."


func _send_qa_stream_link_to_discord() -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		return
	if qa_stream_discord_request == null:
		return
	_load_run_report_webhook_url()
	if run_report_webhook_url == "":
		return
	var link: = qa_streaming_viewer_url if qa_streaming_viewer_url != "" else qa_streaming_watch_url
	if link == "":
		return
	var body: = {
		"username": "Ruptura Temporal", 
		"content": "Transmissao da partida iniciada por **%s**: %s" % [player_nickname if player_nickname != "" else "Jogador", link], 
		"embeds": [{
			"title": "Stream ao vivo - v%s" % GAME_VERSION, 
			"description": "Tela da partida enviada pelo jogo. Transporte: %s. Perfil: %dx%d @ %.0f FPS alvo." % [_qa_stream_transport_label(), _qa_stream_target_size().x, _qa_stream_target_size().y, _qa_stream_target_fps()], 
			"color": 65525
		}]
	}
	qa_stream_discord_request.request(run_report_webhook_url, ["Content-Type: application/json"], HTTPClient.METHOD_POST, JSON.stringify(body))


func _on_qa_stream_discord_request_completed(_result: int, _response_code: int, _headers: PackedStringArray, _body: PackedByteArray) -> void :
	pass


func _qa_stream_menu_subtitle() -> String:
	var size: = _qa_stream_target_size()
	if qa_streaming_native_active or qa_streaming_desktop_ffmpeg_active or qa_streaming_frame_active:
		if qa_streaming_native_active:
			return "%s nativo // RTMP H.264 // %dx%d" % [qa_streaming_quality_mode, size.x, size.y]
		if qa_streaming_desktop_ffmpeg_active:
			return "%s desktop // FFmpeg MJPEG // %dx%d" % [qa_streaming_quality_mode, size.x, size.y]
		return "%s viewport // %d fps enviados" % [qa_streaming_quality_mode, qa_streaming_sent_per_second]
	if qa_streaming_in_flight or qa_streaming_permission_pending:
		return "abrindo permissao // %s %dx%d" % [qa_streaming_quality_mode, size.x, size.y]
	if qa_streaming_status != "":
		return qa_streaming_status.replace("Streaming: ", "").to_lower()
	if not _qa_stream_native_available():
		return "iniciar transmissao // viewport %s %dx%d" % [qa_streaming_quality_mode, size.x, size.y]
	return "iniciar transmissao // %s %dx%d" % [qa_streaming_quality_mode, size.x, size.y]


func _toggle_qa_streaming_from_menu() -> void :
	if not QA_STREAMING_FEATURE_ENABLED or not qa_streaming_unlocked:
		return
	if _qa_streaming_is_active():
		_stop_qa_streaming("manual")
		_add_text("STREAMING ENCERRADO", player_pos + Vector2(0, -100), Color(1.0, 0.74, 0.22), 1.2, 22)
		_save_config()
		return
	qa_streaming_enabled = true
	qa_streaming_status = "Streaming: iniciando..."
	_start_qa_streaming_session()
	_save_config()


func _start_native_qa_stream() -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		_reset_qa_streaming_runtime()
		return
	if not _qa_stream_native_available():
		qa_streaming_status = "Streaming: plugin nativo ausente"
		return
	var streamer = Engine.get_singleton(QA_STREAM_PLUGIN_NAME)
	var target_size: = _qa_stream_target_size()
	var result = streamer.call("startStream", qa_streaming_native_publish_url, qa_streaming_watch_url, target_size.x, target_size.y, int(_qa_stream_target_fps()), _qa_stream_bitrate())
	qa_streaming_native_active = str(result).begins_with("OK")
	qa_streaming_permission_pending = qa_streaming_native_active
	qa_streaming_frame_active = false
	qa_streaming_frame_in_flight = false
	qa_streaming_frame_in_flight_count = 0
	qa_streaming_publish_wait = 0.0
	qa_streaming_status = "Streaming: permissao Android" if str(result).begins_with("OK") else ("Streaming: " + str(result))


func _qa_stream_desktop_encoder_available() -> bool:
	if not QA_STREAMING_FEATURE_ENABLED:
		return false
	if OS.get_name() != "Windows" or DisplayServer.get_name() == "headless":
		return false
	if qa_streaming_desktop_ffmpeg_path != "":
		return true
	var candidates: Array[String] = []
	var env_path: = OS.get_environment(QA_DESKTOP_STREAM_FFMPEG_ENV).strip_edges()
	if env_path != "":
		candidates.append(env_path)
	candidates.append("ffmpeg")
	for candidate in candidates:
		var output: Array = []
		var code: = OS.execute(candidate, PackedStringArray(["-version"]), output, true, false)
		if code == 0:
			qa_streaming_desktop_ffmpeg_path = candidate
			return true
	return false


func _qa_stream_desktop_window_title() -> String:
	var app_name: = String(ProjectSettings.get_setting("application/config/name", "Ruptura Temporal Mobile"))
	if OS.has_feature("debug"):
		return app_name + " (DEBUG)"
	return app_name


func _qa_stream_desktop_gfxcapture_available() -> bool:
	if qa_streaming_desktop_gfxcapture_probe >= 0:
		return qa_streaming_desktop_gfxcapture_probe == 1
	if qa_streaming_desktop_ffmpeg_path == "":
		qa_streaming_desktop_gfxcapture_probe = 0
		return false
	var output: Array = []
	var code: = OS.execute(qa_streaming_desktop_ffmpeg_path, PackedStringArray(["-hide_banner", "-h", "filter=gfxcapture"]), output, true, false)
	var probe_text: = ""
	for line in output:
		probe_text += str(line) + "\n"
	qa_streaming_desktop_gfxcapture_probe = 1 if code == 0 and probe_text.find("gfxcapture") >= 0 else 0
	return qa_streaming_desktop_gfxcapture_probe == 1


func _qa_stream_desktop_capture_rect() -> Rect2i:
	var window_pos: = DisplayServer.window_get_position()
	var window_size: = DisplayServer.window_get_size()
	if window_size.x <= 32 or window_size.y <= 32:
		var screen: = DisplayServer.window_get_current_screen()
		window_pos = DisplayServer.screen_get_position(screen)
		window_size = DisplayServer.screen_get_size(screen)
	window_size.x = maxi(32, window_size.x - (window_size.x % 2))
	window_size.y = maxi(32, window_size.y - (window_size.y % 2))
	return Rect2i(window_pos, window_size)


func _qa_stream_desktop_gdigrab_args() -> PackedStringArray:
	var target_size: = _qa_stream_target_size()
	var fps: int = maxi(15, int(round(_qa_stream_target_fps())))
	var jpeg_quality: = _qa_stream_desktop_mjpeg_quality()
	var capture_rect: = _qa_stream_desktop_capture_rect()
	return PackedStringArray([
		"-hide_banner", 
		"-loglevel", "error", 
		"-nostdin", 
		"-f", "gdigrab", 
		"-framerate", str(fps), 
		"-offset_x", str(capture_rect.position.x), 
		"-offset_y", str(capture_rect.position.y), 
		"-video_size", "%dx%d" % [capture_rect.size.x, capture_rect.size.y], 
		"-draw_mouse", "0", 
		"-i", "desktop", 
		"-vf", "scale=%d:%d:flags=fast_bilinear" % [target_size.x, target_size.y], 
		"-c:v", "mjpeg", 
		"-q:v", str(jpeg_quality), 
		"-f", "mpjpeg", 
		"-boundary_tag", "ruptura-frame", 
		qa_streaming_desktop_publish_url
	])


func _qa_stream_desktop_gfxcapture_args() -> PackedStringArray:
	var target_size: = _qa_stream_target_size()
	var fps: int = maxi(15, int(round(_qa_stream_target_fps())))
	var jpeg_quality: = _qa_stream_desktop_mjpeg_quality()
	var hwnd: = int(DisplayServer.window_get_native_handle(DisplayServer.WINDOW_HANDLE))
	var source: = "gfxcapture=capture_cursor=0:capture_border=0:display_border=0:width=%d:height=%d:resize_mode=scale_aspect:max_framerate=%d:output_fmt=bgra" % [target_size.x, target_size.y, fps]
	if hwnd > 0:
		source = "gfxcapture=hwnd=%d:capture_cursor=0:capture_border=0:display_border=0:width=%d:height=%d:resize_mode=scale_aspect:max_framerate=%d:output_fmt=bgra" % [hwnd, target_size.x, target_size.y, fps]
	return PackedStringArray([
		"-hide_banner", 
		"-loglevel", "error", 
		"-nostdin", 
		"-f", "lavfi", 
		"-i", source, 
		"-vf", "hwdownload,format=bgra,scale=%d:%d:flags=fast_bilinear" % [target_size.x, target_size.y], 
		"-c:v", "mjpeg", 
		"-q:v", str(jpeg_quality), 
		"-f", "mpjpeg", 
		"-boundary_tag", "ruptura-frame", 
		qa_streaming_desktop_publish_url
	])


func _qa_stream_desktop_ffmpeg_args() -> PackedStringArray:
	if _qa_stream_desktop_gfxcapture_available():
		return _qa_stream_desktop_gfxcapture_args()
	return _qa_stream_desktop_gdigrab_args()


func _start_desktop_qa_stream() -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		_reset_qa_streaming_runtime()
		return
	if not _qa_stream_desktop_encoder_available():
		qa_streaming_status = "Streaming: ffmpeg indisponivel"
		return
	var pid: = OS.create_process(qa_streaming_desktop_ffmpeg_path, _qa_stream_desktop_ffmpeg_args(), false)
	if pid <= 0:
		qa_streaming_status = "Streaming: falha ao abrir ffmpeg"
		return
	qa_streaming_desktop_ffmpeg_pid = pid
	qa_streaming_desktop_ffmpeg_active = true
	qa_streaming_native_active = false
	qa_streaming_permission_pending = false
	qa_streaming_frame_active = false
	qa_streaming_frame_in_flight = false
	qa_streaming_frame_in_flight_count = 0
	qa_streaming_publish_wait = 0.0
	qa_streaming_poll_timer = 0.0
	qa_streaming_link_sent = true
	qa_streaming_status = _qa_stream_live_status()
	_send_qa_stream_link_to_discord()


func _stop_qa_streaming(reason: = "stop") -> void :
	var session_to_close: = qa_streaming_session_id
	if qa_streaming_in_flight and qa_stream_session_request != null and qa_stream_session_request.is_inside_tree():
		qa_stream_session_request.cancel_request()
	if qa_streaming_native_active and Engine.has_singleton(QA_STREAM_PLUGIN_NAME):
		var streamer = Engine.get_singleton(QA_STREAM_PLUGIN_NAME)
		streamer.call("stopStream")
	if qa_streaming_desktop_ffmpeg_active and qa_streaming_desktop_ffmpeg_pid > 0:
		OS.kill(qa_streaming_desktop_ffmpeg_pid)
	qa_streaming_native_active = false
	qa_streaming_desktop_ffmpeg_active = false
	qa_streaming_desktop_ffmpeg_pid = -1
	qa_streaming_permission_pending = false
	qa_streaming_frame_active = false
	qa_streaming_frame_in_flight = false
	qa_streaming_frame_in_flight_count = 0
	for i in range(qa_stream_frame_requests.size()):
		var frame_request: HTTPRequest = qa_stream_frame_requests[i]
		if frame_request != null and frame_request.is_inside_tree():
			frame_request.cancel_request()
		if i < qa_stream_frame_request_busy.size():
			qa_stream_frame_request_busy[i] = false
	if QA_STREAMING_FEATURE_ENABLED and session_to_close != "" and qa_stream_stop_request != null and qa_stream_stop_request.is_inside_tree():
		qa_stream_stop_request.request(qa_stream_base_url + "/streams/" + session_to_close, [], HTTPClient.METHOD_DELETE)
	_reset_qa_streaming_runtime(false)
	qa_streaming_enabled = false
	if QA_STREAMING_FEATURE_ENABLED and session_to_close != "":
		qa_streaming_status = "Streaming: encerrado (%s)" % reason


func _update_qa_streaming(delta: float) -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		return
	if qa_streaming_native_active:
		qa_streaming_publish_wait += delta
		qa_streaming_poll_timer += delta
		if qa_streaming_poll_timer >= 1.0:
			qa_streaming_poll_timer = 0.0
			if _qa_stream_native_available():
				var native_status: = str(Engine.get_singleton(QA_STREAM_PLUGIN_NAME).call("getStatus"))
				var target_size: = _qa_stream_target_size()
				qa_streaming_status = "Streaming: %s %s %dx%d" % [native_status, qa_streaming_quality_mode, target_size.x, target_size.y]
				if native_status == "ao vivo confirmado" and not qa_streaming_link_sent:
					qa_streaming_permission_pending = false
					qa_streaming_link_sent = true
					_send_qa_stream_link_to_discord()
				elif _qa_streaming_status_failed(native_status):
					_stop_qa_streaming(native_status)
					return
		if qa_streaming_publish_wait > 35.0 and not qa_streaming_link_sent:
			_stop_qa_streaming("timeout-video")
		return
	if qa_streaming_desktop_ffmpeg_active:
		qa_streaming_publish_wait += delta
		qa_streaming_poll_timer += delta
		if qa_streaming_poll_timer >= 1.0:
			qa_streaming_poll_timer = 0.0
			if qa_streaming_desktop_ffmpeg_pid > 0 and not OS.is_process_running(qa_streaming_desktop_ffmpeg_pid):
				qa_streaming_desktop_ffmpeg_active = false
				qa_streaming_desktop_ffmpeg_pid = -1
				qa_streaming_status = "Streaming: ffmpeg encerrou"
				return
			qa_streaming_status = _qa_stream_live_status()
		return
	if not qa_streaming_frame_active:
		return
	if not qa_streaming_link_sent:
		qa_streaming_publish_wait += delta
	qa_streaming_poll_timer += delta
	qa_streaming_frame_timer += delta
	qa_streaming_fps_timer += delta
	if qa_streaming_fps_timer >= 1.0:
		qa_streaming_sent_per_second = qa_streaming_sent_this_second
		qa_streaming_sent_this_second = 0
		qa_streaming_fps_timer = 0.0
	if qa_streaming_publish_wait > 25.0 and qa_streaming_frame_count <= 0:
		_stop_qa_streaming("timeout-frame")
		return
	var interval: = 1.0 / (_qa_stream_target_fps())
	if qa_streaming_frame_timer >= interval and qa_streaming_frame_in_flight_count < _qa_stream_max_in_flight():
		qa_streaming_frame_timer = 0.0
		_send_qa_stream_frame()
	if qa_streaming_poll_timer >= 2.0 and qa_streaming_frame_count > 0:
		qa_streaming_poll_timer = 0.0
		qa_streaming_status = _qa_stream_live_status()


func _qa_stream_live_status() -> String:
	var target_size: = _qa_stream_target_size()
	var mode_label: = "%s %s" % [qa_streaming_quality_mode, _qa_stream_transport_label()]
	if qa_streaming_desktop_ffmpeg_active:
		mode_label += " desktop FFmpeg"
	var fps_label: = int(round(_qa_stream_target_fps())) if qa_streaming_desktop_ffmpeg_active else qa_streaming_sent_per_second
	return "Streaming: %s %d fps %dx%d" % [mode_label, fps_label, target_size.x, target_size.y]


func _qa_stream_target_fps() -> float:
	if _qa_stream_native_available():
		return float(QA_NATIVE_STREAM_MODE_FPS.get(_sanitize_qa_stream_quality_mode(qa_streaming_quality_mode), QA_STREAM_FPS))
	return float(QA_FRAME_STREAM_MODE_FPS.get(_sanitize_qa_stream_quality_mode(qa_streaming_quality_mode), 30.0))


func _qa_stream_target_size() -> Vector2i:
	var mode: = _sanitize_qa_stream_quality_mode(qa_streaming_quality_mode)
	var max_size: = Vector2i(640, 360)
	match mode:
		"720p": max_size = Vector2i(1280, 720)
		"360p": max_size = Vector2i(640, 360)
		"180p": max_size = Vector2i(320, 180)

	if not is_inside_tree():
		return max_size

	var vp_size: Vector2i = get_viewport().size
	if _qa_stream_native_available():
		var screen_size: = DisplayServer.screen_get_size()
		if screen_size.x > 0 and screen_size.y > 0:
			vp_size = screen_size
	else:
		return max_size
	var vp_width: = float(vp_size.x)
	var vp_height: = float(vp_size.y)
	if vp_width <= 0.0 or vp_height <= 0.0:
		return max_size

	var aspect_ratio: = vp_width / vp_height
	var target_width: int
	var target_height: int

	if aspect_ratio >= (float(max_size.x) / float(max_size.y)):
		target_width = max_size.x
		target_height = int(round(target_width / aspect_ratio))
	else:
		target_height = max_size.y
		target_width = int(round(target_height * aspect_ratio))

	if target_width % 2 != 0:
		target_width += 1
	if target_height % 2 != 0:
		target_height += 1

	return Vector2i(target_width, target_height)


func _qa_stream_desktop_mjpeg_quality() -> int:
	match _sanitize_qa_stream_quality_mode(qa_streaming_quality_mode):
		"720p":
			return 31
		"360p":
			return 12
	return 12


func _qa_stream_jpeg_quality() -> float:
	return float(QA_FRAME_STREAM_MODE_QUALITY.get(_sanitize_qa_stream_quality_mode(qa_streaming_quality_mode), 0.68))


func _qa_stream_max_in_flight() -> int:
	return int(QA_FRAME_STREAM_MODE_MAX_IN_FLIGHT.get(_sanitize_qa_stream_quality_mode(qa_streaming_quality_mode), 2))


func _qa_stream_bitrate() -> int:
	if _qa_stream_native_available():
		return int(QA_NATIVE_STREAM_MODE_BITRATE.get(_sanitize_qa_stream_quality_mode(qa_streaming_quality_mode), QA_STREAM_BITRATE))
	return int(QA_FRAME_STREAM_MODE_BITRATE.get(_sanitize_qa_stream_quality_mode(qa_streaming_quality_mode), 1200000))


func _qa_stream_native_available() -> bool:
	return QA_STREAMING_FEATURE_ENABLED and OS.get_name() == "Android" and Engine.has_singleton(QA_STREAM_PLUGIN_NAME)


func _sanitize_qa_stream_quality_mode(value: String) -> String:
	var normalized: = value.strip_edges().to_lower()
	for mode in QA_FRAME_STREAM_MODES:
		if normalized == String(mode).to_lower():
			return String(mode)
	return "360p"


func _cycle_qa_stream_quality_mode(direction: = 1) -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		return
	var current: = _sanitize_qa_stream_quality_mode(qa_streaming_quality_mode)
	var index: = QA_FRAME_STREAM_MODES.find(current)
	if index < 0:
		index = 1
	index = (index + direction + QA_FRAME_STREAM_MODES.size()) % QA_FRAME_STREAM_MODES.size()
	qa_streaming_quality_mode = String(QA_FRAME_STREAM_MODES[index])
	if qa_streaming_enabled:
		qa_streaming_status = "Streaming: qualidade %s na proxima run" % qa_streaming_quality_mode


func _capture_qa_stream_frame() -> PackedByteArray:
	if not QA_STREAMING_FEATURE_ENABLED:
		return PackedByteArray()
	if DisplayServer.get_name() == "headless":
		qa_streaming_frame_content_type = "image/png"
		return PackedByteArray()
	var viewport_texture: = get_viewport().get_texture()
	if viewport_texture == null or not viewport_texture.get_rid().is_valid():
		qa_streaming_frame_content_type = "image/png"
		return PackedByteArray()
	var image: = viewport_texture.get_image()
	if image == null or image.is_empty():
		qa_streaming_frame_content_type = "image/png"
		return PackedByteArray()
	var target_size: = _qa_stream_target_size()
	if image.get_width() != target_size.x or image.get_height() != target_size.y:
		image.resize(target_size.x, target_size.y, Image.INTERPOLATE_BILINEAR)
	image.convert(Image.FORMAT_RGB8)
	if image.has_method("save_jpg_to_buffer"):
		qa_streaming_frame_content_type = "image/jpeg"
		var jpg_bytes: PackedByteArray = image.call("save_jpg_to_buffer", _qa_stream_jpeg_quality())
		if not jpg_bytes.is_empty():
			return jpg_bytes
	qa_streaming_frame_content_type = "image/png"
	return image.save_png_to_buffer()


func _send_qa_stream_frame() -> void :
	if not QA_STREAMING_FEATURE_ENABLED:
		return
	var request_index: = _qa_stream_available_request_index()
	if request_index < 0 or qa_streaming_frame_url == "":
		qa_streaming_status = "Streaming: frame HTTP indisponivel"
		return
	var frame: = _capture_qa_stream_frame()
	if frame.is_empty():
		qa_streaming_status = "Streaming: frame vazio"
		return
	qa_streaming_frame_seq += 1
	qa_streaming_last_frame_size = frame.size()
	qa_stream_frame_request_busy[request_index] = true
	qa_streaming_frame_in_flight_count += 1
	qa_streaming_frame_in_flight = true
	var headers: = PackedStringArray([
		"Content-Type: " + qa_streaming_frame_content_type, 
		"Cache-Control: no-store", 
		"X-Frame-Seq: %d" % qa_streaming_frame_seq, 
		"X-Frame-At: %d" % Time.get_ticks_msec()
	])
	var request: HTTPRequest = qa_stream_frame_requests[request_index]
	var err: = request.request_raw(qa_streaming_frame_url, headers, HTTPClient.METHOD_POST, frame)
	if err != OK:
		qa_stream_frame_request_busy[request_index] = false
		qa_streaming_frame_in_flight_count = max(0, qa_streaming_frame_in_flight_count - 1)
		qa_streaming_frame_in_flight = qa_streaming_frame_in_flight_count > 0
		qa_streaming_status = "Streaming: falha ao enviar frame"


func _qa_stream_available_request_index() -> int:
	for i in range(qa_stream_frame_requests.size()):
		if bool(qa_stream_frame_request_busy[i]):
			continue
		var request: HTTPRequest = qa_stream_frame_requests[i]
		if request != null and request.is_inside_tree():
			return i
	return -1


func _on_qa_stream_frame_request_completed(result: int, response_code: int, _headers: PackedStringArray, body: PackedByteArray, request_index: int = -1) -> void :
	if request_index >= 0 and request_index < qa_stream_frame_request_busy.size() and bool(qa_stream_frame_request_busy[request_index]):
		qa_stream_frame_request_busy[request_index] = false
		qa_streaming_frame_in_flight_count = max(0, qa_streaming_frame_in_flight_count - 1)
	qa_streaming_frame_in_flight = qa_streaming_frame_in_flight_count > 0
	if not qa_streaming_frame_active:
		return
	if result != HTTPRequest.RESULT_SUCCESS or response_code < 200 or response_code >= 300:
		qa_streaming_status = "Streaming: frame recusado %d" % response_code
		return
	qa_streaming_frame_count += 1
	var payload = JSON.parse_string(body.get_string_from_utf8())
	if typeof(payload) == TYPE_DICTIONARY:
		qa_streaming_frame_count = int(payload.get("frameCount", qa_streaming_frame_count))
	qa_streaming_sent_this_second += 1
	qa_streaming_status = _qa_stream_live_status()
	if not qa_streaming_link_sent:
		qa_streaming_link_sent = true
		_send_qa_stream_link_to_discord()


func _qa_streaming_status_failed(status: String) -> bool:
	var normalized: = status.strip_edges().to_lower()
	if normalized == "":
		return false
	return normalized.contains("erro") or normalized.contains("falha") or normalized.contains("negada") or normalized.contains("incompativel") or normalized.contains("indisponivel")


func _online_menu_available() -> bool:
	return MULTIPLAYER_MENU_ENABLED or online_mode_unlocked


