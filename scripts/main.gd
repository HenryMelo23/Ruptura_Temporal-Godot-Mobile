			"player_damage": player_damage, 
			"kind": "eclipsada_sol", 
			"pierce": false, 
			"hits": {}, 
			"color": color, 
			"range_limit": ECLIPSADA_SOL_Q_RANGE, 
			"fall_range": ECLIPSADA_SOL_Q_RANGE + 5.0, 
			"travel": 22.0, 
			"solar_splash": true
		})
	_push_eclipsada_vfx({
		"kind": "q_sol", 
		"origin": origin, 
		"target": player_pos + dir * ECLIPSADA_SOL_Q_RANGE, 
