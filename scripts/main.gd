func _boss2_speed_scale() -> float:
	var pct = boss_hp / max(1.0, boss_hp_max)
	if pct <= 0.4:
		return 1.25
	if pct <= 0.6:
		return 1.12
	return 1.0


func _update_boss2_animation(delta: float) -> void :
	var frame_count: = 4
	var frame_time: = 1.0
	match boss2_state:
		BOSS2_STATE_REPOSITION:
			frame_count = 2
			frame_time = 0.34
		BOSS2_STATE_FREEZING_BREATH:
			frame_time = 0.22
		BOSS2_STATE_SPIN_SPIT_UP:
			frame_time = 0.2
		BOSS2_STATE_GLACIAL_STOMP:
			frame_time = 0.24
		BOSS2_STATE_ICE_PRISON:
			frame_time = 0.3
		BOSS2_STATE_CRYSTAL_SHIELD, BOSS2_STATE_DOUBLE_BLIZZARD:
			frame_time = 0.34
		BOSS2_STATE_FLASH_FREEZE:
			frame_time = 0.18
		_:
			frame_time = 1.0
	boss2_anim_timer += delta
	while boss2_anim_timer >= frame_time:
		boss2_anim_timer -= frame_time
		boss2_anim_frame = (boss2_anim_frame + 1) % frame_count
	boss_phase = float(boss2_anim_frame)


func _boss2_smooth_waves(waves: Array, speed_scale: float) -> Array:
	var adjusted = []
	for wave in waves:
		var w = wave.duplicate()
		w["vx"] = float(w.get("vx", 0.0)) * BOSS2_WAVE_SPEED_MULT * speed_scale * 60.0
		w["vy"] = float(w.get("vy", 0.0)) * BOSS2_WAVE_SPEED_MULT * speed_scale * 60.0
		w["width"] = max(42.0, float(w.get("width", BOSS2_WAVE_WIDTH)) * BOSS2_WAVE_WIDTH_MULT)
		if w.has("pivot_new_vel"):
			var pivot_vel: Vector2 = w["pivot_new_vel"]
			w["pivot_new_vel"] = pivot_vel * BOSS2_WAVE_SPEED_MULT * speed_scale * 60.0
		adjusted.append(w)
	return adjusted


func _boss2_shield_active() -> bool:
	if current_phase != 2:
		return false
	for attack in boss_attacks:
		if String(attack.get("kind", "")) == "shield":
			return true
	return false


func _update_boss2_attacks(delta: float) -> void :
	for attack in boss_attacks:
		attack["age"] = float(attack.get("age", 0.0)) + delta
		var age = float(attack["age"])
		match String(attack["kind"]):
			"blizzard":
				if age < float(attack["warn"]):
					continue
				for i in range(attack["waves"].size()):
					var wave = attack["waves"][i]
					wave["x"] = float(wave.get("x", 0.0)) + float(wave.get("vx", 0.0)) * delta
					wave["y"] = float(wave.get("y", 0.0)) + float(wave.get("vy", 0.0)) * delta
					if String(wave.get("type", "")) == "sinusoidal":
						wave["y"] = WORLD_SIZE.y * 0.5 + sin(age * 4.2 + float(wave.get("phase", 0.0))) * 180.0
					if String(wave.get("type", "")) == "pivoting" and not bool(wave.get("pivoted", false)):
						var direction = String(wave.get("direction", "left"))
						if (direction == "left" and float(wave["x"]) <= float(wave["pivot_coord"])) or (direction == "down" and float(wave["y"]) >= float(wave["pivot_coord"])):
							wave["pivoted"] = true
							var new_vel: Vector2 = wave["pivot_new_vel"]
							wave["vx"] = new_vel.x
							wave["vy"] = new_vel.y
					var key = "w" + str(i)
					if _boss2_wave_hits_player(wave) and time_alive - float(attack["hit"].get(key, -999.0)) >= 1.1:
						attack["hit"][key] = time_alive
						_damage_player(int(player_hp_max * 0.045 + 12 + 55 + enemy_far_damage * 0.55), "boss")
						_spawn_boss2_slow_zone(player_pos, 54.0, 2.2)
					var remote_key = key + "_remote"
					if _boss2_wave_hits_pos(wave, net_player_pos) and time_alive - float(attack["hit"].get(remote_key, -999.0)) >= 1.1:
						attack["hit"][remote_key] = time_alive
						_damage_remote_player(int(net_player_hp_max * 0.045 + 12 + 55 + enemy_far_damage * 0.55), "boss")
					attack["waves"][i] = wave
			"frost_breath":
				if age < float(attack["warn"]):
					continue
				attack["tick"] = float(attack.get("tick", 0.0)) - delta
				var dir: Vector2 = attack["dir"]
				if boss2_state == BOSS2_STATE_FREEZING_BREATH:
					var to_current_player = player_pos - boss_pos
					if to_current_player.length() > 0.0:
						var current_angle: = dir.angle()
						var target_angle = to_current_player.angle()
						var angle_step = clamp(wrapf(target_angle - current_angle, - PI, PI), -0.42 * delta, 0.42 * delta)
						dir = Vector2.from_angle(current_angle + angle_step)
						attack["dir"] = dir
						boss2_breath_dir = dir
				for i in range(3):
					_spawn_boss2_frost_particle(boss_pos + dir * 54.0, dir)
				var to_player = player_pos - boss_pos
				var dist = to_player.length()
				if dist > 0.0:
					var angle_diff = abs(wrapf(to_player.angle() - dir.angle(), - PI, PI))
					if dist < 280.0 and angle_diff < 0.48 and float(attack["tick"]) <= 0.0:
						attack["tick"] = 0.18
						_damage_player(int(player_hp_max * 0.022 + 8), "boss")
						_spawn_boss2_slow_zone(player_pos, 42.0, 1.4)
				attack["remote_tick"] = float(attack.get("remote_tick", 0.0)) - delta
				var to_remote = net_player_pos - boss_pos
				var remote_dist = to_remote.length()
				if remote_dist > 0.0:
					var remote_angle_diff = abs(wrapf(to_remote.angle() - dir.angle(), - PI, PI))
					if remote_dist < 280.0 and remote_angle_diff < 0.48 and float(attack["remote_tick"]) <= 0.0:
						attack["remote_tick"] = 0.18
						_damage_remote_player(int(net_player_hp_max * 0.022 + 8), "boss")
				if float(attack["tick"]) <= 0.0:
					attack["tick"] = 0.18
					var base_angle = dir.angle()
					for offset in [-0.25, 0.0, 0.25]:
						_spawn_boss2_frost_bullet(boss_pos + dir * 64.0, Vector2.from_angle(base_angle + offset), player_hp_max * 0.065 + 38 + enemy_far_damage * 1.15, 5.45)
			"avalanche":
				if age < float(attack["warn"]):
					continue
				for i in range(attack["targets"].size()):
					var target: Vector2 = attack["targets"][i]
					var key = str(i)
					var local = age - float(attack["warn"])
					if local >= 1.0 and not attack["dropped"].has(key):
						attack["dropped"][key] = true
						screen_shake_timer = max(screen_shake_timer, 0.2)
						screen_shake_strength = max(screen_shake_strength, 9.0)
						_spawn_boss2_ice_burst(target, 8, 0.62)
						_spawn_boss2_slow_zone(target, 62.0, BOSS2_SLOW_ZONE_TIME)
						if player_pos.distance_to(target) <= 58.0 and not attack["hit"].has(key):
							attack["hit"][key] = true
							_damage_player(int((player_hp_max - player_hp) * 0.06 + 12 + 55 + enemy_far_damage * 0.55), "boss")
						_damage_remote_player_in_radius(target, 58.0, int((net_player_hp_max - net_player_hp) * 0.06 + 12 + 55 + enemy_far_damage * 0.55), "boss", attack["hit"], key + "_remote")
			"spin_spit_up":
				if age < float(attack["warn"]):
					continue
				var local_spin = age - float(attack["warn"])
				for i in range(attack["targets"].size()):
					var target_data: Dictionary = attack["targets"][i]
					var key: = str(i)
					if local_spin >= float(target_data.get("delay", 0.0)) and not attack["dropped"].has(key):
						attack["dropped"][key] = true
						var target_pos: = Vector2(target_data.get("pos", player_pos))
						var radius: = float(target_data.get("radius", 60.0))
						screen_shake_timer = max(screen_shake_timer, 0.16)
						screen_shake_strength = max(screen_shake_strength, 7.0)
						_spawn_boss2_ice_burst(target_pos, 7, 0.58)
						_spawn_boss2_slow_zone(target_pos, radius, rng.randf_range(3.5, 4.0))
						if player_pos.distance_to(target_pos) <= radius and not attack["hit"].has(key):
							attack["hit"][key] = true
							_damage_player(int((player_hp_max - player_hp) * 0.06 + 12 + 55 + enemy_far_damage * 0.55), "boss")
						_damage_remote_player_in_radius(target_pos, radius, int((net_player_hp_max - net_player_hp) * 0.06 + 12 + 55 + enemy_far_damage * 0.55), "boss", attack["hit"], key + "_remote")
			"glacial_stomp":
				if age < float(attack["warn"]):
					continue
				if age <= float(attack["warn"]) + BOSS2_STOMP_ACTIVE:
					for i in range(attack["cracks"].size()):
						var crack: Dictionary = attack["cracks"][i]
						var key: = str(i)
						var a: = Vector2(crack.get("a", boss_pos))
						var b: = Vector2(crack.get("b", boss_pos))
						var width: = float(crack.get("width", 30.0))
						if _distance_to_segment(player_pos, a, b) <= width and not attack["hit"].has(key):
							attack["hit"][key] = true
							_damage_player(int(player_hp_max * 0.055 + 58 + enemy_far_damage * 0.5), "boss")
							if not _player_invulnerable():
								player_stun_timer = max(player_stun_timer, _hostile_control_duration(0.45))
							_spawn_boss2_slow_zone(player_pos, 44.0, 2.4)
						_damage_remote_player_on_segment(a, b, width, int(net_player_hp_max * 0.055 + 58 + enemy_far_damage * 0.5), "boss", attack["hit"], key + "_remote")
				elif not bool(attack.get("released", false)):
					attack["released"] = true
					for crack in attack["cracks"]:
						var release_a: = Vector2(crack.get("a", boss_pos))
						var release_b: = Vector2(crack.get("b", boss_pos))
						_spawn_boss2_slow_zone(release_a.lerp(release_b, 0.58), 42.0, 2.6)
			"ice_prison":
				if age < float(attack["warn"]):
					continue
				var center: = Vector2(attack.get("center", player_pos))
				var radius: = float(attack.get("radius", 140.0))
				if not bool(attack.get("closed", false)):
					attack["closed"] = true
					for crystal in attack["crystals"]:
						_spawn_boss2_ice_burst(Vector2(crystal.get("pos", center)), 5, 0.45)
					if player_pos.distance_to(center) <= radius * 0.58 and not bool(attack.get("hit", false)):
						attack["hit"] = true
						_damage_player(int(player_hp_max * 0.045 + 48 + enemy_far_damage * 0.45), "boss")
						_spawn_boss2_slow_zone(player_pos, 58.0, 2.8)
					_damage_remote_player_in_radius(center, radius * 0.58, int(net_player_hp_max * 0.045 + 48 + enemy_far_damage * 0.45), "boss", attack, "hit_remote")
				elif age >= float(attack.get("duration", 1.0)) - 0.18 and not bool(attack.get("released", false)):
					attack["released"] = true
					for crystal in attack["crystals"]:
						_spawn_boss2_slow_zone(Vector2(crystal.get("pos", center)), 34.0, 2.3)
			"flash_freeze":
				var target_freeze: = Vector2(attack.get("target", player_pos))
				var radius_freeze: = float(attack.get("radius", BOSS2_FLASH_FREEZE_RADIUS))
				if age >= float(attack.get("warn", BOSS2_FLASH_FREEZE_WARNING)) and not bool(attack.get("burst", false)):
					attack["burst"] = true
					_spawn_boss2_ice_burst(target_freeze, 22, 1.0)
					_spawn_boss2_slow_zone(target_freeze, radius_freeze, BOSS2_FLASH_FREEZE_STUN)
					screen_shake_timer = max(screen_shake_timer, 0.24)
					screen_shake_strength = max(screen_shake_strength, 11.0)
					if player_pos.distance_to(target_freeze) <= radius_freeze and not bool(attack.get("hit", false)):
						attack["hit"] = true
						var freeze_damage: = int(player_hp_max * 0.035 + 28 + enemy_far_damage * 0.38)
						_damage_player(freeze_damage, "boss2_flash_freeze")
					_damage_remote_player_in_radius(target_freeze, radius_freeze, int(net_player_hp_max * 0.035 + 28 + enemy_far_damage * 0.38), "boss2_flash_freeze", attack, "hit_remote")
			"shield":
				attack["angle"] = float(attack.get("angle", 0.0)) + delta * 3.0
				attack["shot_timer"] = float(attack.get("shot_timer", 0.0)) - delta
				if float(attack["shot_timer"]) <= 0.0:
					attack["shot_timer"] = 1.5
					for i in range(3):
						var angle = float(attack["angle"]) + i * TAU / 3.0
						var origin = boss_pos + Vector2.from_angle(angle) * 92.0
						var dir = (player_pos - origin).normalized()
						_spawn_boss2_frost_bullet(origin, dir, player_hp_max * 0.07 + 44 + enemy_far_damage * 1.15, 5.05)
				attack["pillar_timer"] = float(attack.get("pillar_timer", 0.0)) - delta
				if int(attack.get("pillars_spawned", 0)) < int(attack.get("pillar_count", BOSS2_SHIELD_PILLAR_MIN)) and float(attack["pillar_timer"]) <= 0.0:
					var remaining: int = max(1, int(attack.get("pillar_count", BOSS2_SHIELD_PILLAR_MIN)) - int(attack.get("pillars_spawned", 0)))
					var time_left: float = max(0.35, float(attack.get("duration", BOSS2_SHIELD_TIME)) - age)
					attack["pillar_timer"] = max(0.24, time_left / float(remaining))
					attack["pillars_spawned"] = int(attack.get("pillars_spawned", 0)) + 1
					var target: Vector2 = (player_pos + Vector2(rng.randf_range(-34.0, 34.0), rng.randf_range(-28.0, 28.0))).clamp(Vector2(80, 80), WORLD_SIZE - Vector2(80, 80))
					_add_boss_attack({"kind": "ice_pillar", "age": 0.0, "duration": 1.2, "warn": 0.82, "target": target, "radius": rng.randf_range(44.0, 58.0), "hit": false, "dropped": false})
			"ice_pillar":
				var target_pillar: = Vector2(attack.get("target", player_pos))
				if age >= float(attack.get("warn", 0.82)) and not bool(attack.get("dropped", false)):
					attack["dropped"] = true
					var pillar_radius: = float(attack.get("radius", 52.0))
					_spawn_boss2_ice_burst(target_pillar, 9, 0.7)
					_spawn_boss2_slow_zone(target_pillar, pillar_radius, 2.6)
					screen_shake_timer = max(screen_shake_timer, 0.13)
					screen_shake_strength = max(screen_shake_strength, 7.5)
					if player_pos.distance_to(target_pillar) <= pillar_radius and not bool(attack.get("hit", false)):
						attack["hit"] = true
						_damage_player(int(player_hp_max * 0.085 + 58 + enemy_far_damage * 1.2), "boss2_ice_pillar")
					_damage_remote_player_in_radius(target_pillar, pillar_radius, int(net_player_hp_max * 0.085 + 58 + enemy_far_damage * 1.2), "boss2_ice_pillar", attack, "hit_remote")
	boss_attacks = boss_attacks.filter( func(a): return float(a.get("age", 0.0)) < float(a.get("duration", 1.0)))


func _boss2_wave_hits_player(wave: Dictionary) -> bool:
	return _boss2_wave_hits_pos(wave, player_pos)


func _boss2_wave_hits_pos(wave: Dictionary, pos: Vector2) -> bool:
	var width = float(wave.get("width", BOSS2_WAVE_WIDTH))
	var direction = String(wave.get("direction", "left"))
	if direction == "left" or direction == "right":
		return abs(pos.x - float(wave.get("x", 0.0))) <= width * 0.5
	return abs(pos.y - float(wave.get("y", 0.0))) <= width * 0.5


func _start_boss_stage() -> void :
	boss_stage_timer = BOSS_STAGE_JUMP_TIME
	boss_stage_approaching = boss_pos.distance_to(WORLD_SIZE * 0.5) > 18.0
	boss_stage_safe_angle = rng.randf_range( - PI, PI)
	boss_transition_waves.clear()
	boss_attacks.clear()
	_vibrate(140, 0.42)
	_add_text("SALTO DE RUPTURA", boss_pos + Vector2(0, -120), Color(0.74, 0.2, 1.0), 1.5, 30)
	_play_sfx("boss_impact", 0.025, 0.92, 0.96)


func _boss_stage_enraged() -> bool:
	return boss_hp / max(1.0, boss_hp_max) < BOSS_STAGE_ENRAGED_THRESHOLD


func _next_boss_stage_safe_angle(previous: float, enraged: bool) -> float:
	var min_shift: = PI * (0.32 if enraged else 0.42)
	var max_shift: = PI * (0.5 if enraged else 0.78)
	var direction: = -1.0 if rng.randf() < 0.5 else 1.0
	return wrapf(previous + direction * rng.randf_range(min_shift, max_shift), - PI, PI)


func _update_boss_stage(delta: float) -> void :
	var center: = WORLD_SIZE * 0.5
	if boss_stage_approaching:
		boss_phase += delta * 8.0
		boss_pos = boss_pos.move_toward(center, BOSS1_STAGE_APPROACH_SPEED * delta)
		if boss_pos.distance_to(center) > 4.0:
			return
		boss_pos = center
		boss_stage_approaching = false
	boss_stage_timer -= delta
	boss_pos = center
	var elapsed = BOSS_STAGE_JUMP_TIME - boss_stage_timer
	var enraged: = _boss_stage_enraged()
	var wave_interval: = BOSS_STAGE_ENRAGED_WAVE_INTERVAL if enraged else BOSS_STAGE_WAVE_INTERVAL
	var wave_count: = BOSS_STAGE_ENRAGED_WAVE_COUNT if enraged else BOSS_STAGE_WAVE_COUNT
	var latest_wave_index = int(floor((elapsed - BOSS_STAGE_SLAM_TIME) / wave_interval))
	latest_wave_index = min(latest_wave_index, wave_count - 1)
	for wave_index in range(latest_wave_index + 1 if elapsed >= BOSS_STAGE_SLAM_TIME else 0):
		var already = false
		for wave in boss_transition_waves:
			if int(wave.get("idx", -1)) == wave_index:
				already = true
				break
		if not already:
			_vibrate(BOSS_STAGE_WAVE_HAPTIC_MS, 0.34 + float(wave_index) * 0.08)
			if wave_index == 0:
				screen_shake_timer = 0.32
				screen_shake_strength = 18.0
				_spawn_radial_particles(boss_pos, Color(0.7, 0.24, 1.0), 34)
				_add_text("ABERTURAS ESTREITAS" if enraged else "FIQUE NAS ABERTURAS", boss_pos + Vector2(0, -138), Color(0.34, 1.0, 0.92), 1.8, 24)
				_play_sfx("boss_impact", 0.025, 1.0, 0.92 if enraged else 1.0)
			var safe_angle: float = boss_stage_safe_angle
			if wave_index > 0:
				var previous_wave: Array = boss_transition_waves.filter( func(item): return int(item.get("idx", -1)) == wave_index - 1)
				var previous_angle: float = float(previous_wave[0].get("open_angle", boss_stage_safe_angle)) if not previous_wave.is_empty() else boss_stage_safe_angle
				safe_angle = _next_boss_stage_safe_angle(previous_angle, enraged)
			boss_transition_waves.append({
				"idx": wave_index, 
				"pos": boss_pos, 
				"radius": 42.0, 
				"speed": BOSS_STAGE_WAVE_SPEED, 
				"width": 13.0 if enraged else 20.0, 
				"kind": "dupla_abertura", 
				"open_angle": safe_angle, 
				"open_size": BOSS_STAGE_ENRAGED_OPENING if enraged else BOSS_STAGE_WAVE_OPENING, 
				"age": 0.0, 
				"warning": _telegraph_window(BOSS_STAGE_WAVE_WARNING), 
				"hit": false, 
				"hit_client": false, 
				"enraged": enraged
			})
			_play_sfx("boss_wave", 0.035, 0.84, 1.1 if enraged else 0.96)
	if boss_stage_timer <= 0.0:
		boss_stage_timer = 0.0
		boss_stage_approaching = false
		boss_attack_timer = 1.0


func _start_boss1_absorb() -> void :
	if player_hp <= player_hp_max * 0.3:
		boss1_absorb_cooldown = 3.5
		_stop_boss1_stop_audio_context(false)
		return
	boss1_absorb_timer = BOSS1_ABSORB_DURATION
	boss1_absorb_damage = 0.0
	boss1_absorb_retaliate_timer = 0.0
	boss1_absorb_bursts_fired = 0
	boss1_absorb_end_sfx_played = false
	_play_boss1_pre_stop_warning()
	_play_boss1_stop_loop()
	boss1_absorb_stop_started = true
	boss_attack_timer = BOSS1_ABSORB_DURATION + 1.0
	_add_text("ABSORCAO TEMPORAL", boss_pos + Vector2(0, -132), Color(0.42, 0.92, 1.0), 1.35, 24)
	_spawn_radial_particles(boss_pos, Color(0.42, 0.92, 1.0), 28)
	_play_sfx("Portal.mp3", 0.05, 0.52, 0.82)
	_vibrate(120, 0.42)


func _update_boss1_absorb(delta: float) -> void :
	boss_phase += delta * 4.0
	boss1_absorb_timer = max(0.0, boss1_absorb_timer - delta)
	if rng.randf() < delta * 12.0:
		var dir: = Vector2.from_angle(rng.randf_range(0.0, TAU))
		effects.append({"pos": boss_pos + dir * rng.randf_range(42.0, 96.0), "vel": - dir * rng.randf_range(45.0, 95.0), "life": 0.34, "max": 0.34, "color": Color(0.3, 0.9, 1.0, 0.54), "size": rng.randf_range(8.0, 18.0), "kind": "trail"})
	if boss1_absorb_timer <= BOSS1_STOP_END_LEAD and not boss1_absorb_end_sfx_played:
		boss1_absorb_end_sfx_played = true
		_play_sfx("boss1_absorb_end", 0.02, 0.72, 1.0)
	if boss1_absorb_timer <= 0.0:
		boss1_absorb_cooldown = BOSS1_ABSORB_COOLDOWN
		_stop_boss1_stop_audio_context(false)
		_add_boss1_absorb_retaliation()


func _add_boss1_absorb_retaliation() -> void :
	var absorbed: float = boss1_absorb_damage
	var burst_count: int = BOSS1_ABSORB_RETALIATE_BURSTS
	var shots_per_burst: int = 3
	boss_attacks.append({
		"kind": "absorb_retaliation", 
		"age": 0.0, 
		"duration": 4.2, 
		"absorbed": absorbed, 
		"bursts": burst_count, 
		"shots_per_burst": shots_per_burst, 
		"fired": 0, 
		"spawn_cd": 0.0, 
		"spin": rng.randf_range(0.0, TAU)
	})
	_add_text("DEVOLUCAO %.0f" % absorbed, boss_pos + Vector2(0, -138), Color(1.0, 0.62, 0.18), 1.0, 22)
	boss1_absorb_damage = 0.0


func _update_boss_transition_waves(delta: float) -> void :
	for wave in boss_transition_waves:
		wave["age"] = float(wave.get("age", 0.0)) + delta
		if float(wave["age"]) < float(wave.get("warning", 0.0)):
			continue
		wave["radius"] = float(wave["radius"]) + float(wave["speed"]) * delta
		_apply_boss_transition_wave_to_player(wave, player_pos, 0)
		_apply_boss_transition_wave_to_remnants(wave)
		for peer_id in _targetable_remote_peer_ids():
			var state: Dictionary = net_players_by_peer.get(peer_id, {})
			_apply_boss_transition_wave_to_player(wave, Vector2(state.get("pos", Vector2.ZERO)), peer_id)
	boss_transition_waves = boss_transition_waves.filter( func(w): return float(w.get("radius", 0.0)) < 1250.0 and float(w.get("age", 0.0)) < 7.5)


func _apply_boss_transition_wave_to_player(wave: Dictionary, target_pos: Vector2, remote_peer_id: int) -> void :
	var remote: = remote_peer_id != 0
	var hit_key: = "hit_peer_%d" % remote_peer_id if remote else "hit"
	var dist: = target_pos.distance_to(Vector2(wave["pos"]))
	if bool(wave.get(hit_key, false)) or abs(dist - float(wave["radius"])) > float(wave["width"]) + 16.0:
		return
	var angle_to_player: = (target_pos - Vector2(wave["pos"])).angle()
	var opening: = float(wave["open_angle"])
	var opening_size: = float(wave["open_size"])
	var first_gap: bool = abs(wrapf(angle_to_player - opening, - PI, PI)) <= opening_size * 0.5
	var opposite_gap: bool = abs(wrapf(angle_to_player - (opening + PI), - PI, PI)) <= opening_size * 0.5
	if first_gap or opposite_gap:
		return
	wave[hit_key] = true
	var enraged: = bool(wave.get("enraged", false))
	var damage: = int(player_hp_max * (BOSS_STAGE_ENRAGED_DAMAGE_RATE if enraged else BOSS_STAGE_WAVE_DAMAGE_RATE) + (BOSS_STAGE_ENRAGED_DAMAGE_FLAT if enraged else BOSS_STAGE_WAVE_DAMAGE_FLAT))
	if remote:
		_send_peer_damage(remote_peer_id, damage, "boss_wave_enraged" if enraged else "boss_wave")
		if enraged:
			_request_peer_status(remote_peer_id, "slow", _hostile_control_duration(BOSS_STAGE_ENRAGED_SLOW_TIME))
	else:
		_damage_player(damage, "boss_wave_enraged" if enraged else "boss_wave")
		if enraged:
			boss_wave_slow_timer = max(boss_wave_slow_timer, _hostile_control_duration(BOSS_STAGE_ENRAGED_SLOW_TIME))
	_play_sfx("boss_impact", 0.035, 0.78, 0.82 if enraged else 1.0)


func _apply_boss_transition_wave_to_remnants(wave: Dictionary) -> void :
	var wave_pos: = Vector2(wave["pos"])
	var enraged: = bool(wave.get("enraged", false))
	var damage: = int(player_hp_max * (BOSS_STAGE_ENRAGED_DAMAGE_RATE if enraged else BOSS_STAGE_WAVE_DAMAGE_RATE) + (BOSS_STAGE_ENRAGED_DAMAGE_FLAT if enraged else BOSS_STAGE_WAVE_DAMAGE_FLAT))
	for i in range(necronada_remnants.size()):
		var remnant: Dictionary = necronada_remnants[i]
		if float(remnant.get("hp", 0.0)) <= 0.0 or float(remnant.get("summon", 0.0)) > 0.0:
			continue
		var hit_key: = "hit_remnant_%d_%d" % [int(remnant.get("id", -1)), i]
		if bool(wave.get(hit_key, false)):
			continue
		var r_pos: = Vector2(remnant.get("pos", player_pos))
		var dist: = r_pos.distance_to(wave_pos)
		if abs(dist - float(wave["radius"])) > float(wave["width"]) + 16.0:
			continue
		var angle_to_remnant: = (r_pos - wave_pos).angle()
		var opening: = float(wave["open_angle"])
		var opening_size: = float(wave["open_size"])
		var first_gap: bool = abs(wrapf(angle_to_remnant - opening, - PI, PI)) <= opening_size * 0.5
		var opposite_gap: bool = abs(wrapf(angle_to_remnant - (opening + PI), - PI, PI)) <= opening_size * 0.5
		if first_gap or opposite_gap:
			continue
		wave[hit_key] = true
		_damage_necronada_remnant(remnant, float(damage) * 0.75)
		_add_text("-%d" % int(float(damage) * 0.75), r_pos + Vector2(0, -38), Color(1.0, 0.35, 0.35), 0.45, 16)
		_spawn_radial_particles(r_pos, Color(1.0, 0.2, 0.2), 6)


func _launch_boss_attack() -> void :
	var pct = boss_hp / max(1.0, boss_hp_max)
	var pool = ["bubble", "pressure_bubbles", "rush"]
	if pct <= 0.7:
		pool = ["bubble", "pressure_bubbles", "rain", "tide", "sand", "rush"]
	if pct <= 0.35:
		pool = ["bubble_combo", "pressure_barrage", "tide_combo", "rush_combo"]
	var choice = pool[rng.randi_range(0, pool.size() - 1)]
	var attack_target: = _boss_target_pos(true, 0.2)
	match choice:
		"bubble":
			_add_boss_bubble(attack_target)
		"pressure_bubbles":
			_add_boss_pressure_bubbles(5)
		"rain":
			_add_boss_rain(7)
		"tide":
			_add_boss_tide()
		"sand":
			_add_boss_sand(3)
		"rush":
			_add_boss_rush()
		"bubble_combo":
			_add_boss_bubble(attack_target)
			_add_boss_sand(2)
		"pressure_barrage":
			_add_boss_pressure_bubbles(8)
		"tide_combo":
			_add_boss_tide()
			_add_boss_sand(3)
		"rush_combo":
			_add_boss_rush()
			_add_boss_pressure_bubbles(6)


func _add_boss_bubble(target: Vector2) -> void :
	_add_boss_attack({"kind": "bubble", "target": target, "age": - BOSS1_BUBBLE_WARNING_LEAD, "duration": 3.2, "hit": false, "particles": []})
	_play_sfx("boss1_anti_bubble", 0.025, 0.78, 1.0)


func _add_boss_rain(count: int) -> void :
	_add_boss_attack({
		"kind": "boiling_bubbles", 
		"age": - BOSS1_BUBBLE_WARNING_LEAD, 
		"duration": 4.9, 
		"count": 5, 
		"fired": 0, 
		"spawn_cd": 0.0, 
		"drops": []
	})
	_play_sfx("boss1_anti_bubble", 0.025, 0.78, 1.0)


func _add_boss_pressure_bubbles(count: int) -> void :
