		_reset_manifest_evolution_state()
	manifest_evolution_options = _roll_manifest_evolution_options(manifestation_key, 3)
	if manifest_evolution_options.is_empty():
		return
	manifest_evolution_previous_mode = mode
	manifest_evolution_selected = 0
	manifest_evolution_focus_timer = 0.0
	mode = "manifest_evolution"
	_block_ui_input(180)
	_spawn_radial_particles(pos, _manifestation_color(), 42)
	_add_text("EVOLUCAO DA MANIFESTACAO", pos + Vector2(0, -126), _manifestation_color(), 2.1, 26)


func _choose_manifest_evolution(index: int) -> void :
	if index < 0 or index >= manifest_evolution_options.size():
		return
	var entry: Dictionary = manifest_evolution_options[index]
	manifest_evolution_state["manifestation"] = manifestation_key
	manifest_evolution_state["evolution"] = String(entry.get("id", ""))
	manifest_evolution_state["family"] = String(entry.get("family", ""))
	manifest_evolution_state["profile"] = Dictionary(entry.get("profile", {}))
	manifest_evolution_state["shot_counter"] = 0
	manifest_evolution_state["impact_counter"] = 0
	manifest_evolution_state["target_hits"] = {}
	manifest_evolution_options.clear()
	_add_text("EVOLUIDA: %s" % String(entry.get("name", "Manifestacao")), player_pos + Vector2(0, -112), _manifestation_color(), 1.5, 23)
	_play_sfx("ui_spectrum_switch", 0.012, 0.58, 1.15)
	_vibrate(95, 0.35)
	mode = manifest_evolution_previous_mode if manifest_evolution_previous_mode != "" else "game"
	if mode == "manifest_evolution":
		mode = "game"
	_block_ui_input(120)


func _active_manifest_evolution_family() -> String:
	if manifest_evolution_state.is_empty():
		return ""
	if String(manifest_evolution_state.get("manifestation", "")) != manifestation_key:
		return ""
	return String(manifest_evolution_state.get("family", ""))


func _active_manifest_evolution_profile() -> Dictionary:
	if _active_manifest_evolution_family() == "":
		return {}
	return Dictionary(manifest_evolution_state.get("profile", {}))


func _apply_manifest_evolution_to_bullet(bullet: Dictionary) -> void :
	var family: = _active_manifest_evolution_family()
	if family == "":
		return
	var profile: = _active_manifest_evolution_profile()
	match family:
		"eco":
			manifest_evolution_state["shot_counter"] = int(manifest_evolution_state.get("shot_counter", 0)) + 1
			var every: = maxi(1, int(profile.get("every", 4)))
			if int(manifest_evolution_state["shot_counter"]) % every == 0:
				_spawn_manifest_evolution_echoes(bullet, profile)
		"perfuracao":
			bullet["evolution_pierce_left"] = int(profile.get("pierces", 1))
			bullet["pierce"] = true
		"caca":
			bullet["evolution_homing"] = true
			bullet["evolution_turn"] = float(profile.get("turn", 0.15))
			bullet["evolution_range"] = float(profile.get("range", 320.0))


func _spawn_manifest_evolution_echoes(source: Dictionary, profile: Dictionary) -> void :
	var scale: = float(profile.get("scale", 0.34))
	var spread: = float(profile.get("spread", 0.2))
	var base_dir: = Vector2(source.get("dir", Vector2.RIGHT)).normalized()
	if base_dir.length() <= 0.05:
		base_dir = Vector2.RIGHT
	for side in [-1.0, 1.0]:
		if bullets.size() >= MAX_BULLETS:
			return
		var echo: = source.duplicate(true)
		echo["uid"] = ""
		echo["dir"] = base_dir.rotated(spread * side)
		echo["damage"] = float(source.get("damage", player_damage)) * scale
		echo["life"] = minf(float(source.get("life", 0.8)), 0.72)
		echo["max_life"] = float(echo["life"])
		echo["age"] = 0.0
		echo["hits"] = {}
		echo["pierce"] = false
		echo["evolution_echo"] = true
		echo.erase("evolution_pierce_left")
		_add_bullet(echo)


func _update_manifest_evolution_projectile(bullet: Dictionary, delta: float) -> void :
	if not bool(bullet.get("evolution_homing", false)):
		return
	var origin: = Vector2(bullet.get("pos", player_pos))
	var best_pos: = Vector2.ZERO
	var best_dist: = float(bullet.get("evolution_range", 320.0))
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		var dist: = origin.distance_to(Vector2(enemy["pos"]))
		if dist < best_dist:
			best_dist = dist
			best_pos = Vector2(enemy["pos"])
	if _arauto_active():
		var arauto_dist: = origin.distance_to(Vector2(arauto["pos"]))
		if arauto_dist < best_dist:
			best_dist = arauto_dist
			best_pos = Vector2(arauto["pos"])
	if boss_active and boss_hp > 0.0:
		var boss_dist: = origin.distance_to(boss_pos)
		if boss_dist < best_dist:
			best_dist = boss_dist
			best_pos = boss_pos
	if best_pos == Vector2.ZERO:
		return
	var desired: = (best_pos - origin).normalized()
	if desired.length() <= 0.05:
		return
	var turn: = clampf(float(bullet.get("evolution_turn", 0.15)) * 60.0 * delta, 0.0, 1.0)
	bullet["dir"] = Vector2(bullet.get("dir", desired)).normalized().lerp(desired, turn).normalized()


func _manifest_evolution_on_projectile_hit(bullet: Dictionary, target: Dictionary, target_pos: Vector2) -> bool:
	var family: = _active_manifest_evolution_family()
	if family == "":
		return false
	var profile: = _active_manifest_evolution_profile()
	match family:
		"perfuracao":
			var left: = int(bullet.get("evolution_pierce_left", 0))
			if left > 0:
				bullet["evolution_pierce_left"] = left - 1
				return true
		"elo":
			_apply_manifest_evolution_elo(target_pos, profile)
		"pulso":
			manifest_evolution_state["impact_counter"] = int(manifest_evolution_state.get("impact_counter", 0)) + 1
			if int(manifest_evolution_state["impact_counter"]) % maxi(1, int(profile.get("every", 4))) == 0:
				_apply_manifest_evolution_burst(target_pos, profile, 1.0)
		"vortice":
			manifest_evolution_state["impact_counter"] = int(manifest_evolution_state.get("impact_counter", 0)) + 1
			if int(manifest_evolution_state["impact_counter"]) % maxi(1, int(profile.get("every", 4))) == 0:
				_apply_manifest_evolution_vortex(target_pos, profile)
		"selo":
			_apply_manifest_evolution_seal(target, profile)
	return false


func _apply_manifest_evolution_elo(center: Vector2, profile: Dictionary) -> void :
	var radius: = float(profile.get("radius", 145.0))
	var slow_time: = 1.15
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		if center.distance_to(Vector2(enemy["pos"])) <= radius:
			enemy["evolution_slow"] = max(float(enemy.get("evolution_slow", 0.0)), slow_time)
			enemy["evolution_slow_mult"] = min(float(enemy.get("evolution_slow_mult", 1.0)), float(profile.get("slow", 0.75)))
			slashes.append({"a": center, "b": Vector2(enemy["pos"]), "life": 0.16, "max": 0.16, "color": _manifestation_color(), "width": 8.0})


func _apply_manifest_evolution_burst(center: Vector2, profile: Dictionary, direction_mult: float) -> void :
	var radius: = float(profile.get("radius", 140.0))
	var force: = float(profile.get("force", 80.0)) * direction_mult
	var damage: float = player_damage * float(profile.get("damage", 0.12))
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		var pos: = Vector2(enemy["pos"])
		var dist: = center.distance_to(pos)
		if dist <= radius:
			var dir: = (pos - center).normalized()
			if dir.length() <= 0.05:
				dir = Vector2.RIGHT.rotated(rng.randf_range(0.0, TAU))
			enemy["pos"] = (pos + dir * force * (1.0 - dist / maxf(radius, 1.0))).clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))
			_damage_enemy(enemy, damage, "evolucao_%s" % manifestation_key, false)
	shockwaves.append({"pos": center, "radius": 14.0, "max": radius, "life": 0.34, "damage": 0.0, "hit": {}, "visual_only": true})


func _apply_manifest_evolution_vortex(center: Vector2, profile: Dictionary) -> void :
	var radius: = float(profile.get("radius", 160.0))
	var force: = float(profile.get("force", 86.0))
	var damage: float = player_damage * float(profile.get("damage", 0.1))
	for enemy in enemies:
		if float(enemy.get("hp", 0.0)) <= 0.0:
			continue
		var pos: = Vector2(enemy["pos"])
		var dist: = center.distance_to(pos)
		if dist <= radius:
			var dir: = (center - pos).normalized()
			enemy["pos"] = (pos + dir * force * (1.0 - dist / maxf(radius, 1.0))).clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))
			_damage_enemy(enemy, damage, "evolucao_%s" % manifestation_key, false)
	shockwaves.append({"pos": center, "radius": radius, "max": 18.0, "life": 0.3, "damage": 0.0, "hit": {}, "visual_only": true})


func _apply_manifest_evolution_seal(target: Dictionary, profile: Dictionary) -> void :
	var uid: = str(target.get("uid", target.get("kind", "boss")))
	var hits: Dictionary = manifest_evolution_state.get("target_hits", {})
	var next_hits: = int(hits.get(uid, 0)) + 1
	hits[uid] = next_hits
	manifest_evolution_state["target_hits"] = hits
	if next_hits < maxi(1, int(profile.get("hits", 3))):
		return
	if String(target.get("kind", "")) == "arauto" and _arauto_active():
		arauto["stun"] = max(float(arauto.get("stun", 0.0)), float(profile.get("duration", 0.65)))
	elif target.has("stun"):
		target["stun"] = max(float(target.get("stun", 0.0)), float(profile.get("duration", 0.65)))
	elif String(target.get("kind", "")) == "boss":
		boss_tp_stun_timer = max(boss_tp_stun_timer, float(profile.get("duration", 0.65)))
	hits[uid] = 0
	_add_text("SELO", Vector2(target.get("pos", player_pos)) + Vector2(0, -72), _manifestation_color(), 0.65, 16)


func _manifest_evolution_on_skill(center: Vector2) -> void :
	if _active_manifest_evolution_family() != "campo":
		return
	var profile: = _active_manifest_evolution_profile()
	var fields: Array = manifest_evolution_state.get("fields", [])
	fields.append({
		"pos": center, 
		"life": float(profile.get("duration", 3.2)), 
		"max": float(profile.get("duration", 3.2)), 
		"radius": float(profile.get("radius", 160.0)), 
		"slow": float(profile.get("slow", 0.72)), 
		"damage": float(profile.get("damage", 0.05)), 
		"tick": 0.0, 
		"color": _manifestation_color()
	})
	manifest_evolution_state["fields"] = fields
	_add_text("CAMPO EVOLUIDO", center + Vector2(0, -86), _manifestation_color(), 0.85, 18)


func _manifest_evolution_on_teleport(origin: Vector2, destination: Vector2) -> void :
	if _active_manifest_evolution_family() != "passo":
		return
	var profile: = _active_manifest_evolution_profile()
	_apply_manifest_evolution_burst(origin, profile, 0.75)
	_apply_manifest_evolution_burst(destination, profile, 1.0)


func _update_manifest_evolution_effects(delta: float) -> void :
	if manifest_evolution_state.is_empty():
		return
	var fields: Array = manifest_evolution_state.get("fields", [])
	for field in fields:
		field["life"] = float(field.get("life", 0.0)) - delta
		field["tick"] = float(field.get("tick", 0.0)) - delta
		var center: = Vector2(field.get("pos", player_pos))
		var radius: = float(field.get("radius", 150.0))
		if float(field["tick"]) <= 0.0:
			field["tick"] = 0.35
			for enemy in enemies:
				if float(enemy.get("hp", 0.0)) <= 0.0:
					continue
				if center.distance_to(Vector2(enemy["pos"])) <= radius:
					enemy["evolution_slow"] = max(float(enemy.get("evolution_slow", 0.0)), 0.55)
					enemy["evolution_slow_mult"] = min(float(enemy.get("evolution_slow_mult", 1.0)), float(field.get("slow", 0.72)))
					_damage_enemy(enemy, player_damage * float(field.get("damage", 0.05)), "evolucao_%s" % manifestation_key, false)
			if boss_active and boss_hp > 0.0 and center.distance_to(boss_pos) <= radius:
				_damage_boss(player_damage * float(field.get("damage", 0.05)) * 0.45, "evolucao_%s" % manifestation_key, false)
			if _arauto_active() and center.distance_to(Vector2(arauto["pos"])) <= radius:
				_damage_arauto(player_damage * float(field.get("damage", 0.05)) * 0.45, "evolucao_%s" % manifestation_key, false)
	manifest_evolution_state["fields"] = fields.filter( func(field): return float(field.get("life", 0.0)) > 0.0)


func _process(delta: float) -> void :
	hud_feedback.update(self, delta)
	CatalogInterface.sync(self, delta)
	_update_menu_presentation(delta)
	if vfx_director:
		vfx_director.set_particles_enabled(gfx_particles)
		vfx_director.update(delta)
	if boss_active:
		if boss_hp_lag < 0.0:
			boss_hp_lag = boss_hp
		else:
			boss_hp_lag = move_toward(boss_hp_lag, boss_hp, maxf(25.0, absf(boss_hp_lag - boss_hp) * 4.0) * delta)
	else:
		boss_hp_lag = -1.0
	_net_report_tick(delta)
	if dedicated_server_mode:
		_update_dedicated_room_lifecycle()
		return
	_update_interrupted_run_autosave(delta)
	_update_startup_thanks(delta)
	if _startup_thanks_active():
		queue_redraw()
		return
	_update_app_update_check(delta)
	_update_content_update_check(delta)
	_update_umbra_mind_check(delta)
	_update_veteran_unlock_sync(delta)
	_update_qa_streaming(delta)
	_update_run_security_checkpoint(delta)
	_update_mouse_cursor_mode()
	is_gamepad_active = Input.get_connected_joypads().size() > 0
	if menu_analog_cooldown > 0.0:
		menu_analog_cooldown -= delta
	if mp_manifest_rejection_timer > 0.0:
		mp_manifest_rejection_timer = maxf(0.0, mp_manifest_rejection_timer - delta)
	if is_gamepad_active and _gamepad_navigation_mode() and menu_analog_cooldown <= 0.0:
		var menu_y = Input.get_joy_axis(0, JOY_AXIS_LEFT_Y)
		var menu_x = Input.get_joy_axis(0, JOY_AXIS_LEFT_X)
		if menu_y < -0.5:
			_simulate_key_press(KEY_UP)
			menu_analog_cooldown = 0.25
		elif menu_y > 0.5:
			_simulate_key_press(KEY_DOWN)
			menu_analog_cooldown = 0.25
		elif menu_x < -0.5:
			_simulate_key_press(KEY_LEFT)
			menu_analog_cooldown = 0.25
		elif menu_x > 0.5:
			_simulate_key_press(KEY_RIGHT)
			menu_analog_cooldown = 0.25
	_update_orientation(delta)
	_update_music_pause_fade(delta)
	_update_rain_audio_fade(delta)
	_update_lobby_ready_resend()
	_update_online_room_heartbeat(delta)
	if is_multiplayer:
		_update_network_interpolation(delta)
		_update_revive_request(delta)
	_update_network_ability_visuals(delta)
	_update_network_rewind_visuals(delta)
	if mode == "game":
		_update_shop_mp_request(delta)
		_update_boss_mp_request(delta)
		_update_phase_mp_request(delta)
	if is_multiplayer:
		_update_pause_mp_request(delta)
	if mode == "manifest_mp":
		_update_manifest_mp_ready_resend()

	if mode == "game":
		contractual_order_real_delta = delta
		_update_game(delta * _contractual_order_world_time_scale())
		contractual_order_real_delta = 0.0
	elif mode == "phase_transition":
		_update_phase_transition(delta)
	elif mode == "shop_countdown":
		_update_shop_countdown(delta)
	elif mode == "shop_opening":
		_update_shop_opening(delta)
	elif mode == "shop_return":
		_update_shop_return(delta)
	elif mode == "shop_mp_waiting" or mode == "shop_mp_requested":
		_update_shop_mp_waiting(delta)
	elif mode == "boss_call":
		_update_boss_call(delta)
	elif mode == "pause_countdown":
		_update_pause_countdown(delta)
	elif mode == "shop":
		_update_shop(delta)
	elif mode == "manifest" or mode == "manifest_mp":
		_update_manifest_selection_flow(delta)
	elif mode == "manifest_evolution":
		_update_effects(delta)
	elif mode == "multiplayer_preload":
		_update_multiplayer_preload(delta)
	elif mode == "multiplayer_syncing":
		_update_effects(delta)
	elif mode == "death_slow":
		_update_death_screen_delay(delta)
	elif mode == "retry_return":
		_update_retry_return(delta)
	elif mode == "game_over" or mode == "victory":
		_update_effects(delta)
	_refresh_screen_shake_frame_offset()
	_sync_bombastica_scene_vfx_positions()
	_update_mobile_performance_budget(delta)
	queue_redraw()

func _update_multiplayer_preload(_delta: float) -> void :
	if online_preload_started_ms <= 0:
		return
	if online_preload_local_ready:
		return
	if Time.get_ticks_msec() - online_preload_started_ms > NET_PRELOAD_TIMEOUT_MS:
		online_preload_stage = "PRELOAD DEMORANDO..."


func _update_network_interpolation(delta: float) -> void :
	var now_ms: = Time.get_ticks_msec()
	for peer_key in net_players_by_peer.keys():
		var state: Dictionary = net_players_by_peer[peer_key]
		if not bool(state.get("has_snapshot", false)):
			continue
		var state_age: = minf(NET_EXTRAPOLATION_LIMIT, maxf(0.0, float(now_ms - int(state.get("snapshot_ms", now_ms))) / 1000.0))
		var predicted_state: = Vector2(state.get("pos", Vector2.ZERO)) + Vector2(state.get("velocity", Vector2.ZERO)) * state_age
		var previous_state_render: = Vector2(state.get("render_pos", predicted_state))
		var next_state_render: = _smooth_network_position(previous_state_render, predicted_state, delta)
		var raw_state_move: = (next_state_render - previous_state_render) / maxf(delta, 0.001)
		var smoothed_state_move: = Vector2(state.get("move", Vector2.ZERO)).lerp(raw_state_move, clampf(15.0 * delta, 0.0, 1.0))
		state["render_pos"] = next_state_render
		state["move"] = Vector2.ZERO if smoothed_state_move.length() < 10.0 else smoothed_state_move
		state["last_pos"] = next_state_render
		net_players_by_peer[peer_key] = state
	_sync_legacy_remote_player()
	if net_player_has_snapshot:
		var player_age: = minf(NET_EXTRAPOLATION_LIMIT, maxf(0.0, float(now_ms - net_player_snapshot_last_ms) / 1000.0))
		var predicted_player: Vector2 = net_player_pos + net_player_velocity * player_age
		var previous_render_pos: Vector2 = net_player_render_pos
		net_player_render_pos = _smooth_network_position(net_player_render_pos, predicted_player, delta)
		var raw_move: Vector2 = (net_player_render_pos - previous_render_pos) / maxf(delta, 0.001)
		net_player_move = net_player_move.lerp(raw_move, clampf(15.0 * delta, 0.0, 1.0))
		if net_player_move.length() < 10.0:
			net_player_move = Vector2.ZERO
		net_player_last_pos = net_player_render_pos

	if not _is_world_replica():
		return

	for enemy in enemies:
		var target: = Vector2(enemy.get("_net_target_pos", enemy.get("pos", Vector2.ZERO)))
		var velocity: = Vector2(enemy.get("_net_velocity", Vector2.ZERO))
		var snapshot_ms: = int(enemy.get("_net_snapshot_ms", now_ms))
		var age: = minf(NET_EXTRAPOLATION_LIMIT, maxf(0.0, float(now_ms - snapshot_ms) / 1000.0))
		enemy["pos"] = _smooth_network_position(Vector2(enemy.get("pos", target)), target + velocity * age, delta)

	if net_boss_has_snapshot:
		var boss_age: = minf(NET_EXTRAPOLATION_LIMIT, maxf(0.0, float(now_ms - net_boss_snapshot_last_ms) / 1000.0))
		boss_pos = _smooth_network_position(boss_pos, net_boss_target_pos + net_boss_velocity * boss_age, delta)

	for bullet in enemy_bullets:
		var target: = Vector2(bullet.get("_net_target_pos", bullet.get("pos", Vector2.ZERO)))
		var velocity: = Vector2(bullet.get("_net_velocity", Vector2.ZERO))
		var snapshot_ms: = int(bullet.get("_net_snapshot_ms", now_ms))
		var age: = minf(NET_EXTRAPOLATION_LIMIT, maxf(0.0, float(now_ms - snapshot_ms) / 1000.0))
		bullet["pos"] = _smooth_network_position(Vector2(bullet.get("pos", target)), target + velocity * age, delta)


func _smooth_network_position(current: Vector2, target: Vector2, delta: float) -> Vector2:
	if current.distance_squared_to(target) >= NET_SNAP_DISTANCE * NET_SNAP_DISTANCE:
		return target
	var weight: = 1.0 - exp( - NET_INTERPOLATION_SHARPNESS * maxf(delta, 0.0))
	return current.lerp(target, clampf(weight, 0.0, 1.0))


func _update_network_ability_visuals(delta: float) -> void :
	if net_ability_visuals.is_empty():
		return
	for visual in net_ability_visuals:
		_update_network_ability_replica(visual, delta)
		visual["life"] = float(visual.get("life", 0.0)) - delta
	net_ability_visuals = net_ability_visuals.filter( func(visual): return float(visual.get("life", 0.0)) > 0.0)


func _update_network_ability_replica(visual: Dictionary, delta: float) -> void :
	if int(visual.get("action", -1)) != NET_ABILITY_SECONDARY:
		return
	var kind: = String(visual.get("kind", ""))
	if kind in ["eletrica", "prismatica", "retornante", "cartografica", "mnesica", "ressonante", "contratual"]:
		var source_peer: int = int(visual.get("source", 0))
		var source_state: Dictionary = net_players_by_peer.get(source_peer, {})
		if not source_state.is_empty():
			visual["center"] = Vector2(source_state.get("render_pos", source_state.get("pos", visual.get("center", Vector2.ZERO))))
		elif source_peer == net_player_peer_id:
			visual["center"] = net_player_render_pos
	visual["active_time"] = float(visual.get("active_time", 0.0)) + delta
	visual["angle"] = float(visual.get("angle", 0.0)) + SECONDARY_PRISMATICA_BEAM_SPIN_SPEED * delta
	visual["charge"] = float(visual.get("charge", 0.0)) + delta
	visual["ghost_tick"] = float(visual.get("ghost_tick", 0.0)) + delta
	if kind == "lacerante":
		var cuts: Array = visual.get("cuts", [])
		for cut in cuts:
			cut["life"] = float(cut.get("life", 0.0)) - delta
		cuts = cuts.filter( func(cut): return float(cut.get("life", 0.0)) > 0.0)
		visual["cut_timer"] = float(visual.get("cut_timer", 0.0)) - delta
		if float(visual["cut_timer"]) <= 0.0 and int(visual.get("cut_index", 0)) < int(visual.get("max_cuts", 15)):
			visual["cut_timer"] = 0.075
			var index: = int(visual.get("cut_index", 0))
			var seed: = int(visual.get("seed", 0))
			var center: = Vector2(visual.get("center", Vector2.ZERO))
			var angle: = float(seed % 8191) * 0.001 + float(index) * 2.39996
			var half_length: = 92.0 + fposmod(float(seed + index * 47), 68.0)
			var offset: = Vector2.from_angle(angle + PI * 0.5) * sin(float(index) * 1.71 + seed) * 42.0
			cuts.append({"a": center + offset - Vector2.from_angle(angle) * half_length, "b": center + offset + Vector2.from_angle(angle) * half_length, "life": 0.36, "max": 0.36})
			visual["cut_index"] = index + 1
		visual["cuts"] = cuts
	elif kind == "prismatica":
		_update_secondary_prismatica_zaps(visual, delta, false)
	elif kind == "parasitica":
		for target in visual.get("targets", []):
			target["age"] = float(target.get("age", 0.0)) + delta
			if not bool(target.get("arrived", false)) and float(target["age"]) >= float(target.get("arrival", 1.95)):
				target["arrived"] = true
				target["feed_left"] = PARASITE_FEAST_DURATION
			if bool(target.get("arrived", false)):
				target["feed_left"] = maxf(0.0, float(target.get("feed_left", 0.0)) - delta)


func _next_network_event_id(prefix: String) -> String:
	net_event_sequence += 1
	return "%s_%d_%d_%d" % [prefix, _mp_unique_id(), Time.get_ticks_msec(), net_event_sequence]


func _update_network_rewind_visuals(delta: float) -> void :
	if net_remote_rewind_visuals.is_empty():
		return
	for visual in net_remote_rewind_visuals:
		visual["elapsed"] = float(visual.get("elapsed", 0.0)) + delta
		var duration: = maxf(0.01, float(visual.get("duration", BOSS1_CLOCK_TRAVEL_TIME + BOSS1_CLOCK_TURN_TIME)))
		var progress: = clampf(float(visual.get("elapsed", 0.0)) / duration, 0.0, 1.0)
		var affected_peer: = int(visual.get("peer_id", 0))
		if affected_peer != 0 and affected_peer != _mp_unique_id() and net_players_by_peer.has(affected_peer):
			var from_pos: = Vector2(visual.get("from", Vector2.ZERO))
			var to_pos: = Vector2(visual.get("to", from_pos))
			var rewind_pos: = from_pos.lerp(to_pos, smoothstep(0.0, 1.0, progress))
			var state: Dictionary = net_players_by_peer.get(affected_peer, {})
			state["render_pos"] = rewind_pos
			state["last_pos"] = rewind_pos
			if progress >= 1.0:
				state["pos"] = to_pos
				state["hp"] = float(visual.get("hp", state.get("hp", 1.0)))
			net_players_by_peer[affected_peer] = state
		visual["life"] = maxf(0.0, duration - float(visual.get("elapsed", 0.0)))
	net_remote_rewind_visuals = net_remote_rewind_visuals.filter( func(visual): return float(visual.get("life", 0.0)) > 0.0)


func _update_dedicated_room_lifecycle() -> void :
	if dedicated_room_shutdown_pending or dedicated_room_owner_peer_id != 0:
		return
	if dedicated_warm_standby:
		return
	if dedicated_started_ms > 0 and Time.get_ticks_msec() - dedicated_started_ms >= NET_OWNER_CONNECT_TIMEOUT_MS:
		dedicated_room_shutdown_pending = true
		call_deferred("_shutdown_dedicated_room")


func _shutdown_dedicated_room() -> void :
	for i in range(15):
		await get_tree().process_frame
	_cleanup_runtime_resources()
	for i in range(3):
		await get_tree().process_frame
	get_tree().quit()


func _update_orientation(delta: float) -> void :
	orientation_poll_timer -= delta
	if orientation_poll_timer > 0.0:
		return
	orientation_poll_timer = 0.5
	last_manual_orientation = DisplayServer.SCREEN_SENSOR_LANDSCAPE
	DisplayServer.screen_set_orientation(DisplayServer.SCREEN_SENSOR_LANDSCAPE)


func _update_manifest_selection_flow(delta: float) -> void :
	if manifest_preview_open:
		manifest_preview_time += delta
	if manifest_select_stage == MANIFEST_STAGE_TRANSITION:
		manifest_transition_elapsed = minf(MANIFEST_SPECTRUM_TRANSITION_TIME, manifest_transition_elapsed + delta)
		if manifest_transition_elapsed >= MANIFEST_SPECTRUM_TRANSITION_TIME:
			manifest_select_stage = MANIFEST_STAGE_AURA
			aura_scroll_pos = float(selected_aura)
			_block_ui_input()
			if mode == "manifest_mp":
				_sync_manifest_mp_selection(true)
	if not manifest_is_dragging:
		var target = float(selected_aura if manifest_select_stage == MANIFEST_STAGE_AURA else selected_manifestation)
		var count = AURAS.size() if manifest_select_stage == MANIFEST_STAGE_AURA else MANIFESTATIONS.size()
		var scroll_value = aura_scroll_pos if manifest_select_stage == MANIFEST_STAGE_AURA else manifest_scroll_pos
		var diff = target - scroll_value
		var half_size = count / 2.0
		if diff > half_size:
			scroll_value += count
		elif diff < - half_size:
			scroll_value -= count
		scroll_value = lerp(scroll_value, target, 12.0 * delta)
		scroll_value = fposmod(scroll_value, float(count))
		if manifest_select_stage == MANIFEST_STAGE_AURA:
			aura_scroll_pos = scroll_value
		else:
			manifest_scroll_pos = scroll_value


