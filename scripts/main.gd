			gameplay_cheat_text = cheat_edit.text
		cheat_edit.visible = false
		cheat_edit.release_focus()
	gameplay_cheat_focused = false
	if clear_text:
		gameplay_cheat_text = ""


func _submit_gameplay_cheat() -> void :
