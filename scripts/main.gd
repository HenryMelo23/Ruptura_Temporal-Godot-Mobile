func _draw_layout_scale_controls(rect: Rect2) -> void:
	var controls := _layout_scale_control_rects(rect)
	_draw_small_rect_button(controls[0], "-", Color(0.12, 0.14, 0.18), Color(0.54, 0.72, 0.82))
	_draw_small_rect_button(controls[1], "+", Color(0.12, 0.14, 0.18), Color(0.54, 0.72, 0.82))


func _layout_scale_control_rects(rect: Rect2) -> Array[Rect2]:
	return [
		Rect2(rect.end.x - 76.0, rect.position.y - 30.0, 34.0, 26.0),
		Rect2(rect.end.x - 38.0, rect.position.y - 30.0, 34.0, 26.0)
	]



func _draw_cooldown_overlay(center: Vector2, radius: float, elapsed: float, cooldown: float) -> void:
	if elapsed >= cooldown:
		return
	var ratio = clamp(elapsed / max(0.01, cooldown), 0.0, 1.0)
	draw_circle(center, radius * 0.92, Color(0.0, 0.0, 0.0, 0.46))
	draw_arc(center, radius + 3, -PI * 0.5, -PI * 0.5 + TAU * ratio, 64, Color(0.80, 1.0, 1.0, 0.88), 4)
	draw_arc(center, radius * 0.62, 0, TAU, 32, Color(1.0, 1.0, 1.0, 0.18), 1.4)
	_draw_centered("%.1f" % (cooldown - elapsed), center + Vector2(0, 6), int(clamp(radius * 0.28, 13.0, 17.0)), Color.WHITE)


func _draw_shop_mp_request(viewport: Vector2) -> void:
