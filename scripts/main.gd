			damage *= 0.90
			points = 105
		ENEMY_INCENSARIO:
			hp_mult = 0.90
			speed *= 0.72
			damage *= 0.75
			points = 125
		ENEMY_GUARDIAO:
			hp_mult = 2.75
			speed *= 0.52
			damage *= 1.35
			points = 170
		ENEMY_PYRO_PENGUIN:
			hp_mult = 1.85
			speed *= 0.72
