		Vector2(pos.x + width * 0.5, base_y - 0.5), 
		Vector2(pos.x + width * 0.66, base_y + 10.5), 
		Vector2(pos.x + width + 4.0, base_y - 5.5), 
		Vector2(pos.x + width * 0.68, base_y + 7.5), 
