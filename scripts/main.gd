	_sync_deck_network()
	var owned = _owned_deck_cards_from_counts(_deck_view_counts())
	_clamp_deck_selection(owned.size())
	mode = "pause_deck"
	_block_ui_input()


func _return_from_deck() -> void :
	mode = deck_previous_mode if deck_previous_mode != "" else "paused"
