	draw_line(center + Vector2(0, crystal_y - 34), center + Vector2(0, crystal_y + 18), Color(1.0, 1.0, 1.0, 0.42), 1.2, true)
	draw_circle(center + Vector2(0, crystal_y - 8), 28.0 + pulse * 6.0, Color(color.r, color.g, color.b, 0.08), true)
