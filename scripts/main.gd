func _larapio_walk_laugh_options() -> Array[String]:
	return ["Risada-Loop.mp3", "Risada-Loop2.mp3", "Risada-Loop3.mp3"]


func _play_larapio_walk_laugh(enemy: Dictionary, volume: = 0.56, pitch: = 1.0, force: = false) -> void :
