	boss6_lodarian_pools.append({"pos": pos.clamp(Vector2(45, 45), WORLD_SIZE - Vector2(45, 45)), "life": duration, "max": duration, "radius": radius, "tick": 0.25, "phase": rng.randf_range(0.0, TAU), "kind": pool_kind})


