						draw_line(boss_pos - camera + wobble * 0.2, player_screen + wobble, Color(0.58, 1.0, 0.96, 0.28 * fade), 2.4, true)
					draw_arc(player_screen, 52.0, - time_alive * 2.0, TAU - time_alive * 2.0, 52, Color(0.5, 1.0, 0.92, 0.72 * fade), 3.0)
