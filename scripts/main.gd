func _wrap_manifest_scroll(value: float) -> float:
	return fposmod(value, float(MANIFESTATIONS.size()))


func _nearest_manifest_index(value: float) -> int:
	var count = MANIFESTATIONS.size()
	var idx = int(round(_wrap_manifest_scroll(value))) % count
	return idx if idx >= 0 else idx + count


func _set_selected_manifestation(index: int, vibrate: = true) -> void :
	var count = MANIFESTATIONS.size()
	if count <= 0:
		return
	var next_index = posmod(index, count)
	var guard: = 0
	while _manifest_choice_taken(next_index, false) and guard < count:
		next_index = posmod(next_index + (1 if index >= selected_manifestation else -1), count)
		guard += 1
	if guard >= count and _manifest_choice_taken(next_index, false):
		return
	var changed = next_index != selected_manifestation
	selected_manifestation = next_index
	if changed and vibrate:
		manifest_last_vibrated_index = selected_manifestation
		_vibrate(36, 0.18)
		_play_sfx("ui_manifest_switch", 0.015, 0.48, 1.0)


func _manifestation_unlocked(index: int) -> bool:
	if index < 0 or index >= MANIFESTATIONS.size():
		return false
	var key: = String(MANIFESTATIONS[index].get("key", ""))
	return bool(unlocked_manifestation_ids.get(key, false)) or (key == "retornante" and retornante_unlocked)


func _try_apply_initial_phase_cheat(cheat: String) -> bool:
	var normalized: = cheat.strip_edges().to_upper().replace(" ", "").replace("_", "").replace("-", "")
	if normalized == "FASEAUTO" or normalized == "FASE0":
		forced_initial_phase = 0
		force_phase6_start = false
		gameplay_cheat_text = ""
		_save_config()
		_add_text("SORTEIO DE FASE RESTAURADO", player_pos + Vector2(0, -100), Color(0.5, 0.92, 1.0), 1.4, 23)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.06)
		_vibrate(70, 0.28)
		return true
	if not normalized.begins_with("FASE"):
		return false
	var suffix: = normalized.substr(4)
	if suffix.length() != 1 or not suffix.is_valid_int():
		return false
	var phase: = _sanitize_forced_initial_phase(int(suffix))
	if phase == 0:
		return false
	if forced_initial_phase == phase or (phase == 6 and force_phase6_start and forced_initial_phase == 0):
		forced_initial_phase = 0
		force_phase6_start = false
	else:
		forced_initial_phase = phase
		force_phase6_start = phase == 6
	gameplay_cheat_text = ""
	_save_config()
	var fixed: = _sanitize_forced_initial_phase(forced_initial_phase) > 0
	var msg: = ("PRIMEIRA FASE: %s" % _forced_initial_phase_label()) if fixed else "SORTEIO DE FASE RESTAURADO"
	var color: = Color(0.52, 1.0, 0.28) if fixed else Color(0.5, 0.92, 1.0)
	_add_text(msg, player_pos + Vector2(0, -100), color, 1.4, 24)
	_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.1)
	_vibrate(80, 0.32)
	return true


func _try_apply_collection_unlock_cheat(cheat: String) -> bool:
	var normalized: = cheat.strip_edges().to_upper().replace(" ", "").replace("_", "").replace("-", "")
	if normalized == "CARTASTODAS" or normalized == "TODASCARTAS" or normalized == "DECKTOTAL":
		for card in CARDS:
			var card_id: = _card_id(card)
			if card_id != "":
				unlocked_card_ids[card_id] = true
		gameplay_cheat_text = ""
		_save_card_unlocks()
		_add_text("TODAS AS CARTAS LIBERADAS", player_pos + Vector2(0, -100), Color(1.0, 0.72, 0.22), 1.4, 24)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.08)
		_vibrate(80, 0.32)
		return true
	if normalized == "FORMASCOMPLETAS" or normalized == "MANIFESTACOESTODAS" or normalized == "ESPECTROSTODOS":
		for item in MANIFESTATIONS:
			var manifestation_key_id: = String(item.get("key", ""))
			if manifestation_key_id != "":
				unlocked_manifestation_ids[manifestation_key_id] = true
		for aura in AURAS:
			var spectrum_key_id: = String(aura.get("key", ""))
			if spectrum_key_id != "":
				unlocked_spectrum_ids[spectrum_key_id] = true
		retornante_unlocked = true
		gameplay_cheat_text = ""
		_save_config()
		_save_card_unlocks()
		_add_text("MANIFESTACOES E ESPECTROS LIBERADOS", player_pos + Vector2(0, -100), Color(0.7, 0.52, 1.0), 1.4, 22)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.12)
		_vibrate(80, 0.32)
		return true
	return false


func _try_unlock_retornante_cheat() -> bool:
	var cheat: = gameplay_cheat_text.strip_edges()
	var normalized: = cheat.to_upper().replace(" ", "").replace("_", "").replace("-", "")
	if normalized == "ONLINE30":
		online_mode_unlocked = true
		gameplay_cheat_text = ""
		_save_config()
		menu_selected = clampi(menu_selected, 0, max(0, _menu_option_count() - 1))
		_add_text("MODO ONLINE LIBERADO", player_pos + Vector2(0, -100), Color(0.0, 1.0, 0.82), 1.4, 24)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.12)
		_vibrate(80, 0.32)
		return true
	if cheat.to_upper() in ["CUTSCENE", "VIDEO", "RESET_CUTSCENE", "RESET_VIDEO", "ABERTURA", "RESET_ABERTURA"]:
		reset_startup_video()
		gameplay_cheat_text = ""
		_save_config()
		_add_text("CUTSCENE REATIVADA", player_pos + Vector2(0, -100), Color(0.38, 0.92, 1.0), 1.4, 24)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.14)
		_vibrate(80, 0.32)
		return true
	if cheat.to_lower() == "geovaninha":
		retornante_unlocked = true
		unlocked_manifestation_ids["retornante"] = true
		gameplay_cheat_text = ""
		_save_config()
		_save_card_unlocks()
		_add_text("RETORNANTE LIBERADA", player_pos + Vector2(0, -100), Color(0.82, 0.48, 1.0), 1.4, 24)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.16)
		_vibrate(80, 0.32)
		return true
	if _try_apply_collection_unlock_cheat(cheat):
		return true
	if cheat == "QA231021":
		qa_data_unlocked = true
		gameplay_cheat_text = ""
		_save_config()
		_add_text("DADOS QA LIBERADO", player_pos + Vector2(0, -100), Color(0.74, 1.0, 0.36), 1.4, 24)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.08)
		_vibrate(80, 0.32)
		return true
	if cheat.to_upper() == "CHANZADA":
		_reset_qa_streaming_runtime(false)
		qa_streaming_unlocked = true
		qa_streaming_enabled = false
		qa_streaming_quality_mode = _sanitize_qa_stream_quality_mode(qa_streaming_quality_mode)
		qa_streaming_status = "Streaming: liberado no hub"
		gameplay_cheat_text = ""
		if DisplayServer.get_name() != "headless":
			_save_config()
			_add_text("TRANSMISSAO LIBERADA", player_pos + Vector2(0, -100), Color(0.0, 1.0, 0.82), 1.4, 24)
			_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.12)
			_vibrate(80, 0.32)
		return true
	if _try_apply_initial_phase_cheat(cheat):
		return true
	if cheat.to_lower() == "henry_meelo":
		ui_platform_override_unlocked = true
		if _sanitize_ui_platform_override(ui_platform_override) == UI_PLATFORM_DESKTOP:
			ui_platform_override = UI_PLATFORM_ANDROID
		else:
			ui_platform_override = UI_PLATFORM_DESKTOP
		gameplay_cheat_text = ""
		_apply_graphics_settings()
		_save_config()
		_add_text("INTERFACE " + _ui_platform_profile_label(), player_pos + Vector2(0, -100), Color(1.0, 0.78, 0.22), 1.4, 24)
		_play_sfx("ui_spectrum_switch", 0.01, 0.6, 1.14)
		_vibrate(80, 0.32)
		return true
	return false


