		"player_damage": player_damage, 
		"speed": speed, 
		"kind": kind, 
		"pierce": not sol, 
		"hits": {}, 
		"ricochets": 0, 
		"durability": 0.0, 
		"fly_sfx_cd": 0.0, 
		"color": color, 
		"range_limit": ECLIPSADA_SHURIKEN_RANGE, 
		"fall_range": ECLIPSADA_SHURIKEN_FALL_RANGE, 
		"travel": 36.0, 
