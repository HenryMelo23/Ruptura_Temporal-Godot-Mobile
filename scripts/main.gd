	for i in range(CATALOG_TABS.size()):
		var rect = Rect2(i * tab_w + 3, 92, tab_w - 6, 48)
		var selected = i == catalog_tab
		_draw_holo_panel(rect, Color(0.0, 1.0, 0.82) if selected else Color(0.18, 0.38, 0.48), selected, 0.68)
