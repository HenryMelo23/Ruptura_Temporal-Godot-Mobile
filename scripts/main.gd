func _check_shop_mp_exit() -> bool:
	var all_ready: = shop_mp_ready_count >= shop_mp_expected_count if shop_mp_expected_count > 1 else shop_mp_partner_ready
	if shop_mp_ready_to_leave and all_ready:
		_finish_shop()
		return true
