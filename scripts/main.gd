			_draw_centered("TODAS", det_c + Vector2(0, - det_r - 14.0), 9, Color(0.7, 1.0, 1.0))

	_draw_cooldown_overlay(atk_c, atk_r, time_alive - last_attack_time, _current_attack_interval())
