			_start_direct_teleport_cooldown()
			_add_text("ANCORA LANCADA", destination + Vector2(0, -92), Color(0.34, 1.0, 0.42), 0.85, 18)
		"acorrentada":
			_start_tp_acorrentada(origin, destination)
