		TUTORIAL_STATE_DASH:
			action_key = "dash"
	if action_key == "" or not buttons.has(action_key):
		return
	var rect: Rect2 = Rect2(buttons[action_key])
	var pulse: float = 0.5 + sin(t * 7.0) * 0.5
	var glow: Rect2 = rect.grow(10.0 + pulse * 7.0)
