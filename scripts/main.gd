		"life": ECLIPSADA_SOL_E_DURATION, 
		"max": ECLIPSADA_SOL_E_DURATION, 
		"pos": target_pos, 
		"tick": 0.0, 
		"pulse": 0, 
		"radius": ECLIPSADA_SOL_E_RADIUS + _eclipsada_trait_value("area", 0.0), 
		"color": color, 
		"phase": rng.randf_range(0.0, TAU)
	})
