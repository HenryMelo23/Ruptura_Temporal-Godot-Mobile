func _update_sanguessuga_parasite(delta: float) -> void :
	if sanguessuga_parasite_timer <= 0.0:
		sanguessuga_bleed_tick_timer = 0.0
		sanguessuga_parasite_visual_timer = 0.0
		return
	sanguessuga_parasite_timer = maxf(0.0, sanguessuga_parasite_timer - delta)
	sanguessuga_bleed_tick_timer -= delta
	sanguessuga_parasite_visual_timer -= delta
	while sanguessuga_bleed_tick_timer <= 0.0 and sanguessuga_parasite_timer > 0.0 and player_hp > 0 and not is_dead:
		sanguessuga_bleed_tick_timer += SANGUESSUGA_BLEED_TICK
		_apply_sanguessuga_bleed_tick()
	if sanguessuga_parasite_visual_timer <= 0.0 and player_hp > 0 and not is_dead:
		sanguessuga_parasite_visual_timer = rng.randf_range(0.3, 0.45)
		effects.append({"text": "", "pos": player_pos + Vector2(rng.randf_range(-14.0, 14.0), rng.randf_range(-28.0, 18.0)), "life": 0.42, "max": 0.42, "color": Color(0.56, 1.0, 0.22, 0.82), "size": rng.randi_range(3, 6), "vel": Vector2(rng.randf_range(-18.0, 18.0), rng.randf_range(22.0, 58.0))})
	if sanguessuga_parasite_timer <= 0.0:
		sanguessuga_bleed_tick_timer = 0.0
		sanguessuga_parasite_visual_timer = 0.0


func _apply_sanguessuga_bleed_tick() -> void :
	var damage: = maxi(1, int(round(float(player_hp_max) * SANGUESSUGA_BLEED_HP_RATE)))
	_apply_direct_dot_player_damage(damage, "sanguessuga_cronal_bleed")


func _apply_direct_dot_player_damage(amount: int, source: String) -> void :
	if amount <= 0 or is_dead:
		return
	var final: = maxi(1, amount)
	_track_player_damage(final, source)
	player_hp -= final
	last_damage_time = time_alive
	damage_flash_timer = maxf(damage_flash_timer, 0.08)
	_add_text("-%d" % final, player_pos + Vector2(rng.randf_range(-18, 18), -68), Color(0.74, 1.0, 0.22), 0.45, 15)
	_spawn_radial_particles(player_pos, Color(0.55, 1.0, 0.18), 2)


func _apply_sanguessuga_parasitism(impact_damage: int) -> void :
	if sanguessuga_parasite_timer > 0.0:
		_apply_direct_dot_player_damage(maxi(1, int(round(float(_sanguessuga_tick_damage()) * 0.35))), "sanguessuga_cronal_impact")
		sanguessuga_parasite_timer = minf(SANGUESSUGA_PARASITE_MAX_TIME, sanguessuga_parasite_timer + 1.0)
		_add_text("PARASITA +1s", player_pos + Vector2(0, -98), Color(0.62, 1.0, 0.22), 0.65, 16)
		return
	_damage_player(maxi(1, impact_damage), "sanguessuga_cronal_impact")
	if is_dead:
		return
	sanguessuga_parasite_timer = SANGUESSUGA_PARASITE_TIME
	sanguessuga_bleed_tick_timer = SANGUESSUGA_BLEED_TICK
	sanguessuga_parasite_visual_timer = 0.1
	_add_text("PARASITADO", player_pos + Vector2(0, -102), Color(0.58, 1.0, 0.18), 0.9, 19)


func _sanguessuga_tick_damage() -> int:
	return maxi(1, int(round(float(player_hp_max) * SANGUESSUGA_BLEED_HP_RATE)))


func _update_sanguessuga_cronal(enemy: Dictionary, delta: float) -> bool:
	enemy["parado"] = true
	var state: = String(enemy.get("leech_state", SANGUESSUGA_STATE_FALL_WARNING))
	var timer: = float(enemy.get("leech_timer", SANGUESSUGA_FALL_WARNING_TIME))
	match state:
		SANGUESSUGA_STATE_FALL_WARNING:
			timer -= delta
			enemy["alpha"] = 0.3 + 0.18 * (0.5 + 0.5 * sin(time_alive * 12.0))
			if timer <= 0.0:
				state = SANGUESSUGA_STATE_FALLING
				timer = rng.randf_range(SANGUESSUGA_FALL_TIME_MIN, SANGUESSUGA_FALL_TIME_MAX)
				enemy["leech_fall_duration"] = timer
				enemy["alpha"] = 0.75
		SANGUESSUGA_STATE_FALLING:
			timer -= delta
			var duration: = maxf(0.01, float(enemy.get("leech_fall_duration", SANGUESSUGA_FALL_TIME_MAX)))
			enemy["alpha"] = lerpf(0.75, 1.0, clampf(1.0 - timer / duration, 0.0, 1.0))
			if timer <= 0.0:
				enemy["pos"] = _sanguessuga_nearest_solitary_point(Vector2(enemy["pos"]), int(enemy.get("uid", -1)))
				state = SANGUESSUGA_STATE_DORMANT
				timer = SANGUESSUGA_DORMANT_TIME
				enemy["leech_life"] = SANGUESSUGA_DORMANT_TIME
				enemy["leech_arm_timer"] = SANGUESSUGA_ATTACK_ARM_TIME
				enemy["alpha"] = 1.0
				_spawn_radial_particles(Vector2(enemy["pos"]), Color(0.54, 1.0, 0.18), 8)
		SANGUESSUGA_STATE_DORMANT:
			timer -= delta
			var arm_timer: = maxf(0.0, float(enemy.get("leech_arm_timer", SANGUESSUGA_ATTACK_ARM_TIME)) - delta)
			enemy["leech_arm_timer"] = arm_timer
			enemy["leech_life"] = timer
			enemy["alpha"] = clampf(timer / 3.0, 0.28, 1.0) if timer <= 3.0 else 1.0
			if timer <= 0.0:
				state = SANGUESSUGA_STATE_EXPIRING
				timer = 0.38
			elif arm_timer > 0.0:
				enemy["alpha"] = 0.72 + 0.18 * sin(time_alive * 9.0 + float(enemy.get("phase", 0.0)))
			else:
				var target: = _sanguessuga_activation_target(Vector2(enemy["pos"]))
				if not target.is_empty():
					state = SANGUESSUGA_STATE_TRIGGERED
					timer = SANGUESSUGA_TRIGGER_TIME
					enemy["leech_target_peer"] = int(target.get("peer_id", 0))
					enemy["leech_target_pos"] = Vector2(target.get("pos", player_pos))
					enemy["leech_hit_done"] = false
					enemy["alpha"] = 1.0
					_add_text("SALTO", Vector2(enemy["pos"]) + Vector2(0, -44), Color(0.74, 1.0, 0.2), 0.32, 14)
		SANGUESSUGA_STATE_TRIGGERED:
			timer -= delta
			enemy["alpha"] = 1.0
			if timer <= 0.0:
				var target_pos: = _sanguessuga_target_current_pos(int(enemy.get("leech_target_peer", 0)), Vector2(enemy.get("leech_target_pos", player_pos)))
				var from: = Vector2(enemy["pos"])
				var dir: = (target_pos - from).normalized()
				if dir.length() <= 0.05:
					dir = Vector2.LEFT
				var prediction: = dir * minf(52.0, player_speed * 0.18)
				var to: = (target_pos + prediction).clamp(Vector2(55, 55), WORLD_SIZE - Vector2(55, 55))
				state = SANGUESSUGA_STATE_LEAPING
				timer = clampf(from.distance_to(to) / 430.0, SANGUESSUGA_LEAP_TIME_MIN, SANGUESSUGA_LEAP_TIME_MAX)
				enemy["leech_leap_duration"] = timer
				enemy["leech_leap_from"] = from
				enemy["leech_leap_to"] = to
				enemy["facing_dir"] = dir
		SANGUESSUGA_STATE_LEAPING:
			timer -= delta
			var duration: = maxf(0.01, float(enemy.get("leech_leap_duration", SANGUESSUGA_LEAP_TIME_MAX)))
			var progress: = clampf(1.0 - timer / duration, 0.0, 1.0)
			var eased: = progress * progress * (3.0 - 2.0 * progress)
			var from: = Vector2(enemy.get("leech_leap_from", enemy["pos"]))
			var to: = Vector2(enemy.get("leech_leap_to", enemy["pos"]))
			enemy["pos"] = from.lerp(to, eased)
			enemy["last_move_dir"] = (to - from).normalized()
			_sanguessuga_try_hit(enemy)
			if bool(enemy.get("leech_hit_done", false)):
				state = SANGUESSUGA_STATE_ATTACHED
				timer = 0.2
			elif progress >= 1.0:
				state = SANGUESSUGA_STATE_MISSED
				timer = SANGUESSUGA_MISS_TIME
				_spawn_radial_particles(Vector2(enemy["pos"]), Color(0.5, 0.66, 0.42), 6)
		SANGUESSUGA_STATE_ATTACHED:
			timer -= delta
			enemy["alpha"] = maxf(0.0, timer / 0.2)
			if timer <= 0.0:
				enemy["skip_rewards"] = true
				return true
		SANGUESSUGA_STATE_MISSED:
			timer -= delta
			enemy["alpha"] = clampf(timer / SANGUESSUGA_MISS_TIME, 0.0, 1.0)
			if timer <= 0.0:
				state = SANGUESSUGA_STATE_EXPIRING
				timer = 0.28
		SANGUESSUGA_STATE_EXPIRING:
			timer -= delta
			enemy["alpha"] = maxf(0.0, timer / 0.38)
			if timer <= 0.0:
				enemy["skip_rewards"] = true
				return true
	enemy["leech_state"] = state
	enemy["state"] = state
	enemy["leech_timer"] = timer
	return false


func _sanguessuga_activation_target(origin: Vector2) -> Dictionary:
	for target in _combat_targets():
		if origin.distance_to(Vector2(target.get("pos", player_pos))) <= SANGUESSUGA_DETECTION_RADIUS:
			return target
	return {}


func _sanguessuga_target_current_pos(peer_id: int, fallback: Vector2) -> Vector2:
	if peer_id == _mp_unique_id() and _local_player_targetable():
		return player_pos
	var state: Dictionary = net_players_by_peer.get(peer_id, {})
	if not state.is_empty():
		return Vector2(state.get("pos", fallback))
	return fallback


func _sanguessuga_try_hit(enemy: Dictionary) -> void :
	if bool(enemy.get("leech_hit_done", false)):
		return
	if float(enemy.get("contact_grace", 0.0)) > 0.0:
		return
	var center: = Vector2(enemy["pos"])
	var damage: = maxi(1, int(round(float(player_hp_max) * 0.018 + 9.0)))
	if _local_player_damageable_by_contact() and center.distance_to(player_pos) <= 32.0:
		enemy["leech_hit_done"] = true
		_apply_sanguessuga_parasitism(damage)
		_spawn_radial_particles(player_pos, Color(0.62, 1.0, 0.18), 10)
		return
	for peer_id in _targetable_remote_peer_ids(true):
		var state: Dictionary = net_players_by_peer.get(peer_id, {})
		var peer_pos: = Vector2(state.get("pos", Vector2(-10000, -10000)))
		if center.distance_to(peer_pos) <= 32.0:
			enemy["leech_hit_done"] = true
			var peer_hp_max: = maxf(1.0, float(state.get("hp_max", player_hp_max)))
			_send_peer_damage(peer_id, maxi(1, int(round(peer_hp_max * 0.018 + 9.0))), "sanguessuga_cronal_impact")
			_request_peer_status(peer_id, "sanguessuga_cronal", SANGUESSUGA_PARASITE_TIME)
			_spawn_radial_particles(peer_pos, Color(0.62, 1.0, 0.18), 10)
			return


func _move_enemy(enemy: Dictionary, delta: float) -> void :
	var lacerante_secondary = _active_lacerante_secondary()

	if float(enemy.get("devorador_fear", 0.0)) > 0.0:
		var fear_dir: = Vector2(enemy.get("devorador_fear_dir", Vector2(enemy["pos"]) - player_pos)).normalized()
		if fear_dir.length() <= 0.05:
			fear_dir = Vector2.RIGHT.rotated(float(int(enemy.get("uid", 0)) % 16) * TAU / 16.0)
		var fear_speed: = float(enemy.get("speed", enemy_speed_base)) * 1.22
		enemy["pos"] = (Vector2(enemy["pos"]) + fear_dir * fear_speed * delta).clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))
		enemy["last_move_dir"] = fear_dir
		enemy["facing_dir"] = fear_dir
		return

	var target_pos = _get_enemy_target_pos(enemy)
	if String(aura_state.get("name", "")) == "Insana":
		var best_echo_distance: float = INF
		for echo in Array(aura_state.get("insane_queue", [])):
			var echo_pos: Vector2 = Vector2(echo.get("pos", target_pos))
			var echo_distance: float = Vector2(enemy["pos"]).distance_to(echo_pos)
			if echo_distance < best_echo_distance:
				best_echo_distance = echo_distance
				target_pos = echo_pos
	if not lacerante_secondary.is_empty():
		target_pos = Vector2(lacerante_secondary.get("center", target_pos))
	var is_disco = not _active_prismatica_secondary().is_empty()
	var dir = (target_pos - enemy["pos"]).normalized()
	if enemy["type"] == ENEMY_LARAPIO and not is_disco:
		var to_player = (target_pos - Vector2(enemy["pos"])).normalized()
		var dist = Vector2(enemy["pos"]).distance_to(target_pos)
		var has_loot = int(enemy.get("stolen", 0)) > 0
		var desperate = _larapio_desperate(enemy)
		var patrol_target: = Vector2(enemy.get("larapio_patrol_target", _random_larapio_patrol_target()))
		var patrol_dir: = (patrol_target - Vector2(enemy["pos"])).normalized()
		var edge_push: = _larapio_edge_push(Vector2(enemy["pos"]))
		if bool(enemy.get("direct_steal", false)) and player_stun_timer > 0.0:
			dir = to_player
		elif float(enemy.get("larapio_escape_timer", 0.0)) > 0.0 and patrol_dir.length() > 0.05:
			dir = patrol_dir
		elif desperate:
			if dist < LARAPIO_DESPERATE_KEEP_DISTANCE:
				dir = ( - to_player + to_player.orthogonal() * float(enemy.get("strafe", 1.0)) * 0.55).normalized()
			else:
				dir = (to_player.orthogonal() * float(enemy.get("strafe", 1.0)) + patrol_dir * 0.2).normalized()
		elif has_loot or enemy["hp"] < enemy["max_hp"] * 0.5:
			dir = - to_player
		elif bool(enemy.get("alerted", false)) and dist < 430.0:
			dir = ( - to_player + to_player.orthogonal() * float(enemy.get("strafe", 1.0)) * 0.72).normalized()
		elif dist < LARAPIO_STEAL_RADIUS * 0.82:
			dir = - to_player
		else:
			dir = (to_player + to_player.orthogonal() * float(enemy.get("strafe", 1.0)) * 0.24).normalized()
		if patrol_dir.length() > 0.05 and not (bool(enemy.get("direct_steal", false)) and player_stun_timer > 0.0):
			var patrol_weight: = 0.16 if desperate else (0.34 if not has_loot else 0.48)
			dir = (dir * (1.0 - patrol_weight) + patrol_dir * patrol_weight).normalized()
		if edge_push.length() > 0.05:
			var trap_time: float = clamp(float(enemy.get("larapio_corner_time", 0.0)) / LARAPIO_CORNER_TRAP_TIME, 0.0, 1.0)
			var push_weight: float = 0.65 + trap_time * 1.35
			dir = (dir * 0.55 + edge_push * push_weight + edge_push.orthogonal() * float(enemy.get("strafe", 1.0)) * 0.28).normalized()
	var speed_mult = 1.0
	if float(enemy.get("parasite_slow_time", 0.0)) > 0.0:
		speed_mult *= 0.8
	if float(enemy.get("acorrentada_slow", 0.0)) > 0.0:
		speed_mult *= 0.85 if not _is_uncommon_enemy(enemy) else 0.92
	if float(enemy.get("evolution_slow", 0.0)) > 0.0:
		speed_mult *= clampf(float(enemy.get("evolution_slow_mult", 0.75)), 0.35, 1.0)
	if is_disco:
		speed_mult *= 1.12
		dir = (target_pos - enemy["pos"]).normalized()
	if manifestation_key == "ancorada":
		for anchor in anchors:
			if anchor["pos"].distance_to(enemy["pos"]) < 130.0:
				speed_mult = 0.76
				break
	if enemy["type"] == ENEMY_LARAPIO:
		if bool(enemy.get("direct_steal", false)) and player_stun_timer > 0.0:
			speed_mult *= 1.55
		if _larapio_desperate(enemy):
			speed_mult *= 1.22
		if int(enemy.get("stolen", 0)) > 0:
			speed_mult *= 1.35
		if float(enemy.get("happy_timer", 0.0)) > 0.0:
			speed_mult *= 1.18
	if enemy["type"] == ENEMY_SHIELD_REFLECTOR and not _shield_reflector_active(enemy):
		speed_mult *= SHIELD_REFLECTOR_UNBURDENED_SPEED_MULT
	if dir.length() > 0.05:
		dir = _steer_entity_with_avoidance(enemy, Vector2(enemy["pos"]), dir, delta)
		enemy["last_move_dir"] = dir
		enemy["facing_dir"] = dir
	enemy["pos"] += dir * float(enemy["speed"]) * speed_mult * AuraSystem.world_multiplier(aura_state) * delta
	enemy["pos"] = enemy["pos"].clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))


func _stalker_profile() -> Dictionary:
	var window = max(1.0, 720.0 - ANOMALIA_ESPREITADOR_TIME)
	var progress = clamp((time_alive - ANOMALIA_ESPREITADOR_TIME) / window, 0.0, 1.0)
	return {
		"base": 0.88 + progress * 0.38, 
		"furtivo": 0.66 + progress * 0.24, 
		"sprint": 1.32 + progress * 0.56, 
		"duration": 0.85 + progress * 0.45, 
		"cooldown": 9.2 - progress * 2.6
	}


func _update_stalker(enemy: Dictionary, delta: float) -> void :
	var t_pos = _get_enemy_target_pos(enemy)
	var dist = enemy["pos"].distance_to(t_pos)
	var profile = _stalker_profile()
	if dist > 300.0:
		enemy["invisible"] = true
		enemy["alpha"] = 0.32 + (sin(time_alive * 6.0 + float(enemy["phase"])) + 1.0) * 0.2
		enemy["speed"] = enemy_speed_base * float(profile["furtivo"])
	else:
		enemy["invisible"] = false
		enemy["alpha"] = 1.0
		if not bool(enemy.get("sprint_active", false)) and time_alive - float(enemy.get("sprint_timer", 0.0)) > float(profile["cooldown"]):
			enemy["sprint_active"] = true
			enemy["sprint_timer"] = time_alive
			_spawn_radial_particles(enemy["pos"], Color(0.65, 0.95, 1.0), 8)
		if bool(enemy.get("sprint_active", false)):
			if time_alive - float(enemy["sprint_timer"]) < float(profile["duration"]):
				enemy["speed"] = enemy_speed_base * float(profile["sprint"])
				enemy["alpha"] = 1.0
			else:
				enemy["sprint_active"] = false
				enemy["sprint_timer"] = time_alive
				enemy["speed"] = enemy_speed_base * float(profile["base"])
		else:
			enemy["speed"] = enemy_speed_base * float(profile["base"])


func _update_enemy_dots(enemy: Dictionary, delta: float) -> void :
	enemy["parasite_slow_time"] = max(0.0, float(enemy.get("parasite_slow_time", 0.0)) - delta)
	if float(enemy.get("parasite_mark_time", 0.0)) > 0.0:
		enemy["parasite_mark_time"] = max(0.0, float(enemy["parasite_mark_time"]) - delta)
		if float(enemy["parasite_mark_time"]) <= 0.0:
			enemy["seeds"] = 0
	if float(enemy.get("poison", 0.0)) > 0.0:
		enemy["poison_tick"] = float(enemy.get("poison_tick", 0.0)) - delta
		if float(enemy["poison_tick"]) <= 0.0:
			enemy["poison_tick"] = 0.65
			enemy["poison"] = max(0.0, float(enemy["poison"]) - 0.65)
			_damage_enemy(enemy, max(1.0, player_damage * poison_damage), "veneno", false)
	if int(enemy.get("laceracao", 0)) > 0:
		enemy["bleed_timer"] = max(0.0, float(enemy.get("bleed_timer", 0.0)) - delta)
		if float(enemy["bleed_timer"]) > 0.0 and int(Time.get_ticks_msec() / 350) % 2 == 0:
			enemy["hp"] = float(enemy["hp"]) - int(enemy.get("laceracao", 0)) * 0.18
	enemy["carto_confuse"] = max(0.0, float(enemy.get("carto_confuse", 0.0)) - delta)
	enemy["carto_mobile_coord"] = max(0.0, float(enemy.get("carto_mobile_coord", 0.0)) - delta)
	if float(enemy.get("carto_confuse", 0.0)) > 0.0:
		var wobble = Vector2.from_angle(time_alive * 5.1 + float(enemy.get("uid", 0)) * 0.013)
		enemy["pos"] = (Vector2(enemy["pos"]) + wobble * float(enemy.get("speed", enemy_speed_base)) * delta * 0.48).clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))
		enemy["shoot_cd"] = max(float(enemy.get("shoot_cd", 0.0)), 0.3)
	enemy["mnesic_tricked"] = max(0.0, float(enemy.get("mnesic_tricked", 0.0)) - delta)
	enemy["mnesic_dejavu"] = max(0.0, float(enemy.get("mnesic_dejavu", 0.0)) - delta)
	enemy["mnesic_vulnerable"] = max(0.0, float(enemy.get("mnesic_vulnerable", 0.0)) - delta)
	enemy["mnesic_replay"] = max(0.0, float(enemy.get("mnesic_replay", 0.0)) - delta)
	if float(enemy.get("mnesic_replay", 0.0)) > 0.0:
		var replay_dir = (Vector2(enemy.get("pos", player_pos)) - player_pos).normalized()
		if replay_dir.length() <= 0.05:
			replay_dir = Vector2.from_angle(float(enemy.get("uid", 0)) * 0.01)
		enemy["pos"] = (Vector2(enemy["pos"]) + replay_dir * float(enemy.get("speed", enemy_speed_base)) * delta * 0.42).clamp(Vector2(40, 40), WORLD_SIZE - Vector2(40, 40))
	enemy["resonant_flash"] = max(0.0, float(enemy.get("resonant_flash", 0.0)) - delta)
	enemy["contract_vulnerable"] = max(0.0, float(enemy.get("contract_vulnerable", 0.0)) - delta)
	_update_contract_clause(enemy, delta)


func _update_curater(enemy: Dictionary, delta: float) -> void :
	enemy["heal_tick"] = float(enemy.get("heal_tick", 0.0)) - delta
	if float(enemy["heal_tick"]) > 0.0:
		return
	enemy["heal_tick"] = 1.0
	for target in enemies:
		if target == enemy or target["type"] == ENEMY_CURATER or float(target["hp"]) <= 0.0:
			continue
		if target["pos"].distance_to(enemy["pos"]) < 210.0 and float(target["hp"]) < float(target["max_hp"]):
			var heal = (float(target["max_hp"]) - float(target["hp"])) * 0.2
			target["hp"] = min(float(target["max_hp"]), float(target["hp"]) + heal)
			_add_text("+%d" % int(heal), target["pos"] + Vector2(0, -44), Color(0.3, 1.0, 0.45), 0.8, 18)


