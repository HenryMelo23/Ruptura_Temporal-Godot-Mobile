func _spawn_umbra_rats(_count: int) -> void :
	var corners: Array[Vector2] = [
		Vector2(100.0, 100.0), 
		Vector2(WORLD_SIZE.x - 100.0, 100.0), 
		Vector2(100.0, WORLD_SIZE.y - 100.0), 
		Vector2(WORLD_SIZE.x - 100.0, WORLD_SIZE.y - 100.0)
	]
	var total_to_spawn: int = 4 + boss5_rat_extras

	var spawned: int = 0
	for i in range(total_to_spawn):
		if phase5_rats.size() >= 40:
			break
		var corner_idx: int = i % 4
		var corner_pos: Vector2 = corners[corner_idx]
		var offset: Vector2 = Vector2(rng.randf_range(-18.0, 18.0), rng.randf_range(-18.0, 18.0))
		var speed_mult: float = minf(1.4, 0.84 + float(boss5_rat_extras) * 0.048)
		phase5_rats.append({
			"pos": corner_pos + offset, 
			"corner_idx": corner_idx, 
			"life": 5.0, 
			"max_life": 5.0, 
			"size": 30.0, 
			"speed": 280.0 * speed_mult, 
			"phase": rng.randf_range(0.0, TAU)
		})
		spawned += 1

	_add_text("PRAGA DOS RATOS (%d)" % spawned, boss_pos + Vector2(0, -120), Color(0.3, 0.8, 1.0), 1.0, 20)


func _update_phase5_rats(delta: float) -> void :
	if boss5_dimension != "rastro" and current_phase == 5:
		phase5_rats.clear()
		return

	for rat in phase5_rats:
		var life: float = float(rat.get("life", 0.0)) - delta
		rat["life"] = life
		if life <= 0.0:
			continue

		rat["phase"] = float(rat.get("phase", 0.0)) + delta * 8.0
		var pos: Vector2 = Vector2(rat["pos"])
		var dir: Vector2 = (player_pos - pos).normalized()
		var speed: float = float(rat.get("speed", 235.0))
		pos = (pos + dir * speed * delta).clamp(Vector2(30, 30), WORLD_SIZE - Vector2(30, 30))
		rat["pos"] = pos

		if pos.distance_to(player_pos) <= 30.0:
			_damage_player(80, "umbra_rat")
			boss_hp = minf(boss_hp_max, boss_hp + boss_hp_max * 0.002)
			boss5_rat_extras = mini(4, boss5_rat_extras + 1)
			_add_text("RATO HIT (+1 EXTRA)", player_pos + Vector2(0, -40), Color(0.3, 0.8, 1.0), 0.75, 16)
			_umbra_learn("PRAGA_RATOS", 0.22)
			rat["life"] = 0.0

		rat["remote_hit_cd"] = maxf(0.0, float(rat.get("remote_hit_cd", 0.0)) - delta)
		if pos.distance_to(net_player_pos) <= 30.0 and float(rat["remote_hit_cd"]) <= 0.0:
			rat["remote_hit_cd"] = 0.75
			_damage_remote_player(80, "umbra_rat")
			boss_hp = minf(boss_hp_max, boss_hp + boss_hp_max * 0.002)
			boss5_rat_extras = mini(4, boss5_rat_extras + 1)
			_umbra_learn("PRAGA_RATOS", 0.12)
			rat["life"] = 0.0

	phase5_rats = phase5_rats.filter( func(rat): return float(rat.get("life", 0.0)) > 0.0)


func _umbra_learn(action: String, reward: float) -> void :
	if action == "" or not boss5_mobile_weights.has(action):
		return
	var current: = float(boss5_mobile_weights.get(action, 0.0))
	boss5_mobile_weights[action] = clampf(lerp(current, reward * 3.0, 0.08), -3.5, 3.5)
	_save_umbra_mobile_memory()


func _update_boss_phase4(delta: float) -> void :
	boss4_anim_time += delta
	boss4_attack_pose_timer = max(0.0, boss4_attack_pose_timer - delta)
	boss4_stun_timer = max(0.0, boss4_stun_timer - delta)
	boss4_vulnerable_timer = max(0.0, boss4_vulnerable_timer - delta)
	boss4_no_hit_timer += delta
	boss_phase += delta * 2.0
	if boss_entry_timer > 0.0:
		boss_entry_timer = max(0.0, boss_entry_timer - delta)
		var progress: float = clamp(1.0 - boss_entry_timer / BOSS4_ENTRY_TIME, 0.0, 1.0)
		var eased: float = 1.0 - pow(1.0 - progress, 3.0)
		boss_pos = Vector2(lerp(WORLD_SIZE.x + 220.0, boss4_entry_target.x, eased), boss4_entry_target.y)
		if boss_entry_timer <= 0.0:
			boss_pos = boss4_entry_target
			_boss_entry_impact_feedback(0.72)
			_add_text("NEXO ESTABILIZADO", boss_pos + Vector2(0, -145), Color(1.0, 0.78, 0.22), 1.6, 25)
		return
	boss_pos = boss4_entry_target
	_update_boss4_stage()
	_update_boss4_specials(delta)
	_update_boss4_strike_sequence(delta)
	if boss4_ultimate_active:
		_update_boss4_ultimate(delta)
		return
	boss4_ultimate_cooldown = max(0.0, boss4_ultimate_cooldown - delta)
	if boss4_ultimate_cooldown <= 0.0 and boss_hp > 0.0:
		_start_boss4_ultimate()
		return
	if boss4_stun_timer > 0.0:
		return
	_update_boss4_pattern_timers(delta)
	boss4_attack_timer -= delta
	if boss4_attack_timer <= 0.0:
		boss4_attack_timer = BOSS4_ATTACK_INTERVAL
		_spawn_boss4_stage_attack()


func _update_boss4_stage() -> void :
	var ratio: float = boss_hp / max(1.0, boss_hp_max)
	var next_stage: int = 1
	if ratio <= 0.25:
		next_stage = 4
	elif ratio <= 0.5:
		next_stage = 3
	elif ratio <= 0.75:
		next_stage = 2
	if next_stage != boss4_stage:
		boss4_stage = next_stage
		boss4_attack_timer = min(boss4_attack_timer, 1.2)
		_increase_boss4_instability(8.0)
		var label: String = "COLAPSO DO NEXO" if boss4_stage == 4 else ("PREDADOR DE PETS" if boss4_stage == 3 else "ARENA QUEBRADA")
		_add_text(label, boss_pos + Vector2(0, -152), Color(1.0, 0.7, 0.18), 1.6, 25)


func _boss4_attack_interval() -> float:
	return BOSS4_ATTACK_INTERVAL


func _spawn_boss4_stage_attack() -> void :
