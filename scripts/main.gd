			var is_coin = bullet.get("type") == "larapio_coin"
			var body = Color(1.0, 0.78, 0.14) if is_coin else Color(0.36, 0.34, 0.32)
			var rim = Color(0.52, 0.28, 0.04) if is_coin else Color(0.12, 0.11, 0.10)
