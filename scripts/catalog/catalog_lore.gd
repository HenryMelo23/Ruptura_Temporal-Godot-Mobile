## Lore do Catalogo Temporal baseada no livro "Ruptura Temporal"
## (Luis Henrique Bessa de Melo). Gerado de docs/catalogo_lore_livro.json.
## Campos: g grupo, s subtitulo, r resumo, h historia, n nota da Geovana,
## l trecho do livro, e ecos (ids), d dimensao, img/texture_path arte, m mecanica.

const DATA := {
	"geovana": {"s": "Física. Cientista do tempo. Viúva de um futuro.", "r": "A mulher que trancou a porta do laboratório por dentro.", "h": "Antes de tudo, era a garota das primeiras fileiras \"com cara de quem queria estar em Marte\". Virou física, líder de um projeto sem nome e esposa de Henrique às 23:10 de uma noite comum. Quando ele morreu, ela sumiu do mundo por meses, voltou exigindo controle total e rebatizou o projeto: Ruptura. Atravessou o arco sozinha para não deixar ninguém morrer no lugar dela.", "n": "Eu não sou a vilã. Eu acho. Eu espero.", "l": "\"Até onde você iria por quem ama?\" — a pergunta que ela fez a Lara e que ninguém respondeu.", "e": ["henrique", "ruptura", "d37", "manifestacoes"], "img": "res://assets/story/intro_05.jpg", "g": "fracoes"},
	"henrique": {"s": "Cientista da informação. O homem que pensava demais.", "r": "Morreu dizendo \"já te amo em todas as realidades\".", "h": "Respondeu um story sobre o céu de Brasília, foi a um skate park às 6:30 da manhã e passou a vida inventando nomes ridículos para máquinas do tempo: Retornator 9000, Vai-e-Volta V2, Roda-Tempo. Uma costura de traje cedeu durante um ajuste no condensador interespacial, e uma gota verde de D37 caiu entre o polegar e o indicador. Ele não sentiu nada. Não contou a ninguém. Em menos de dois dias, o DNA dele se quebrava em pedaços.", "n": "Ele dizia que, se inventasse a máquina primeiro, voltaria para se cutucar no ombro e apontar pra mim. Eu inventei primeiro.", "l": "\"Oi… Geovaninha.\" — as últimas palavras pelo rádio selado de Roberto.", "e": ["geovana", "d37", "racional", "profetica"], "img": "res://assets/story/intro_01.jpg", "g": "fracoes"},
	"d37": {"s": "Composto refrigerante sem nome oficial.", "r": "Uma gota verde-neon. Nenhum sintoma. Vinte e quatro horas.", "h": "Líquido refrigerante do condensador de frequência interespacial, verde como fósforo sob luz negra. Ao tocar a pele de Henrique, evaporou e não deixou ardor nem alerta de radiação. Por dentro, reescrevia as células \"como se obedecessem a uma ordem que não é genética\". O Setor 7 isolou a sala tarde demais. Os arquivos do catálogo ainda usam D37 como coordenada: tudo o que a Ruptura toca parece ter aprendido a mesma gramática.", "n": "A molécula tá viva. Eu falei isso pro médico. Eu falei isso pra todo mundo.", "l": "\"Ah, sim, uma gota de composto D37 escorreu no meu pulso. Mas não senti nada.\"", "e": ["henrique", "ruptura", "rebobinador", "necrocronismo"], "img": "res://assets/story/intro_03.jpg", "g": "fracoes"},
	"ruptura": {"s": "Projeto, fenômeno e ferida.", "r": "Risco: irreversível. Estava escrito na lousa.", "h": "Na lousa dela: \"PROJETO: RUPTURA. Objetivo: criar uma anomalia temporal controlada. Base teórica: incerta. Risco: irreversível.\" O arco de contenção de bobinas de Hafnônio abriu a fenda a 112% de carga. Quando o General mandou cortar a energia, o portal não fechou: ficou faminto, engoliu o laboratório inteiro e cuspiu Geovana numa praia de céu roxo. Desde então, cada lugar por onde ela salta começa a apodrecer por dentro.", "n": "Henrique ia adorar o nome. Ele tinha mau gosto pra nomes.", "l": "\"Essa ruptura será temporal? Ou emocional?\" — escrito ao lado da foto colada no painel.", "e": ["geovana", "arauto", "matriarca_chaga", "fase_1"], "img": "res://assets/story/intro_07.jpg", "g": "fracoes"},
	"arauto": {"s": "A fenda que manda recado.", "r": "Aparece quando a Ruptura percebe que ela está ficando forte.", "h": "Os sapos do Nexo mediram a Ressonância de Geovana e desenharam raízes secas no holograma: cada salto dela deixa um rasgo vivo. O Arauto é o que sai desses rasgos quando eles aprendem a andar. Carrega fragmentos de evolução como quem carrega uma conta a pagar. Derrotá-lo não fecha a ferida; só entrega a próxima escolha.", "n": "Cada vez que fico mais forte, alguma coisa do outro lado vem cobrar.", "l": "\"A realidade está apodrecendo atrás de você.\" — o Capitão, diante do mapa de rombos.", "e": ["ruptura", "manifestacoes", "capitao"], "img": "res://assets/story/jump_b.jpg", "g": "fracoes"},
	"manifestacoes": {"s": "A energia que não estava no projeto.", "r": "Nasceram na travessia. Moldadas pela perda.", "h": "O bracelete devia ser só uma chave de sintonia. No vórtice, uma onda azul atravessou o corpo de Geovana: o olho esquerdo acendeu, as veias saltaram, a saturação passou de 121%. Na praia, o cabelo dela levitou como um globo de plasma e uma pedra do tamanho de um carro se partiu na palma aberta. Nada daquilo era projetado. Cada Manifestação é uma forma diferente de a mesma dor encontrar saída.", "n": "Isso vem de dentro. Eu odeio não saber o que vem de dentro.", "l": "\"Algo que tinha nascido na travessia, moldado não pelo tempo — mas pela perda.\"", "e": ["eletrica", "geovana", "ruptura"], "img": "res://assets/story/intro_09.jpg", "g": "fracoes"},
	"cartas": {"s": "O que ela carrega nos bolsos do jaleco.", "r": "Cada carta guarda um pedaço da vida de antes.", "h": "O bolso esquerdo do jaleco foi feito para trenas e marcadores. Agora guarda núcleos, fragmentos, uma foto dobrada, um chocolate esquecido. As Cartas são o mesmo princípio: a Ruptura devolve à Geovana pedaços do que ela viveu, deformados em regra de combate. Quem lê todas, em ordem, lê a história dela com Henrique de trás pra frente.", "n": "Algumas eu compraria de volta por qualquer preço. Outras eu queria esquecer.", "l": "\"Geovana enfiou a mão no bolso esquerdo do jaleco. De lá, puxou uma fotografia dobrada.\"", "e": ["geovana", "petro", "carta_zero", "arquivo_impossivel"], "img": "res://assets/sprites/Cartas_back.png", "g": "fracoes"},
	"bussola": {"s": "Quintiliano Bussolaro, mercador de sete camadas.", "r": "Vende o que a porta derruba no chão da loja dele.", "h": "Estava no meio de um salto quando o tempo de Geovana rasgou e prendeu a geringonça dele meio aberta. Desde então a porta vaza: abre sozinha onde ela estiver e a puxa para a oficina. Bússola não atravessa, abre; se pisasse na linha dela, viraria pó. É o primeiro ser em muito tempo que olha para Geovana e vê uma cliente, não uma ameaça.", "n": "Ele mente sobre quase tudo. Sobre o chá, acho que não.", "l": "Não está no livro. Nasceu da porta que a própria Ruptura deixou entreaberta.", "e": ["ruptura", "avarento", "moeda_estavel"], "img": "res://assets/sprites/merchant/portrait_mercador.png", "m": "Abre a oficina entre fases. Vende e conserta cartas, e cada conversa com ele revela um pouco mais da porta que vaza.", "g": "fracoes"},
	"petro_ficha": {"s": "Golem de bolso nascido do primeiro núcleo.", "r": "Morreu no castelo. Está voltando, de metal, como um bebê.", "h": "Ela guardou o núcleo do monstro de pedra num canto frio do abrigo. De manhã, havia um buraco na madeira e uma criaturinha de trinta centímetros a esperando do lado de fora. Ele desenhou o caranguejo no chão com carvão, colheu fruta para ela e cresceu a dois metros quando ela lhe deu energia. Caiu no castelo. O núcleo sobrou no bolso dela e, no Nexo, começou a criar braços de novo.", "n": "\"Pe\" de pedra. \"Tro\" eu inventei. Combina com teimoso.", "l": "\"Obrigado, Petro... posso te chamar de Petro, né?\"", "e": ["petro", "caranguejo_cosmico", "aglomerador"], "img": "res://assets/story/boss1_fragment.jpg", "m": "Registro narrativo ligado ao Castelo. Não aparece em combate; desbloqueia ao recuperar o fragmento da fase 1.", "g": "fracoes"},
	"stiff": {"s": "Rato humanoide. Pai de uma filha \"diferente\".", "r": "Dividido entre duas vozes. Devorado pelo próprio deus.", "h": "Murmurava sozinho junto a uma fogueira: \"Pai Rato sabe o que faz… mas o Pai Rato tirou ela de mim.\" A filha foi levada por nascer diferente. Guiou Geovana até a catedral, empurrou-a no esgoto de crânios e depois entrou na missa implorando por ela. O Pai-Rato o comeu na frente de todos.", "n": "Ele não era mau. Ele só tinha medo há quarenta anos.", "l": "\"Stiff confuso… Stiff quer a filha dele!\"", "e": ["pai_rato", "devoto", "portador_relicario"], "img": "res://assets/story/boss3_fragment.jpg", "m": "Registro narrativo da Catedral dos Ratos. Explica o Pai-Rato e os cultistas; liberado após a fase 3.", "g": "fracoes"},
	"capitao": {"s": "Sapo-gorila de quatro metros. Vigia de um mundo.", "r": "\"Entre uma vida e o mundo, eu escolheria o mundo.\"", "h": "Chegou a um planeta esmagado pela própria gravidade e decidiu não abandonar o que restava, contra o conselho dos seus. Isso foi há trinta mil anos. Carrega uma centelha parecida com a de Geovana, mas velha, uma brasa que já não cintila. Quer a energia dela para o motor da cidade. Diz que ela é a anomalia. Pediu desculpas quando gritou.", "n": "Ele tem razão sobre o mapa. Isso é o pior.", "l": "\"Você ainda não percebeu que é a própria anomalia?\"", "e": ["nexo_ruptura", "cartografo_vazio", "equilibrista"], "img": "res://assets/story/boss4_fragment.jpg", "m": "Registro narrativo do Nexo. Ajuda a ler o mapa de rombos e a origem do Arauto; liberado após a fase 4.", "g": "fracoes"},
	"general_aires": {"s": "Chefe militar do projeto.", "r": "Mandou cortar a energia. O portal não fechou.", "h": "Chamou Henrique de \"recurso substituível\" e ofereceu desligar os aparelhos dele para \"acelerar o luto\". Planejou usar cinco detentos de Bangu V como cobaias e, quando o projeto terminasse, fazer Geovana desaparecer. Na noite da travessia, gritou \"CORTEM A ENERGIA\" e transformou a fenda num buraco faminto. Depois correu.", "n": "Ele não entendeu nada. E mesmo assim decidiu tudo.", "l": "\"Dez minutos. Depois disso, esperamos você no comando. Ou assumimos o controle.\"", "e": ["sanguinaria", "valicente", "ruptura"], "img": "res://assets/story/intro_04.jpg", "m": "Registro do prólogo. Não aparece em combate; explica por que Geovana atravessou sozinha.", "g": "fracoes"},
	"valicente": {"s": "Executivo de terno azul e gravata dourada.", "r": "\"Sua genialidade só é valiosa se for controlável.\"", "h": "Comandava mais com silêncio do que com gritos. Ameaçou tirar de Geovana a liberdade, não o cargo, enquanto Henrique morria do outro lado do vidro. Aceitou o plano dos detentos com um aceno e uma única pergunta: \"Vai ter alarde?\". Não confiava \"um milímetro\" nela. Tinha razão de não confiar.", "n": "Eu disse pra ele me prender. Ele preferiu esperar eu terminar.", "l": "\"Não tenho certeza se essa mulher quer concluir o projeto ou... explodir com ele.\"", "e": ["oportunista", "general_aires", "cofre_excesso"], "m": "Registro do prólogo. Não aparece em combate; é a sombra por trás das cartas de economia e controle.", "img": "res://assets/story/intro_04.jpg", "g": "fracoes"},
	"lara": {"s": "Colega de laboratório. A última amiga.", "r": "Subiu sete andares até a porta 702.", "h": "Foi a única que bateu na porta do apartamento escondido. Encontrou \"um caos metódico\" e uma folha com o título Ruptura Temporal. Ouviu a pergunta que Geovana carrega até hoje e não soube responder. Foi também quem contou o que o General e o executivo planejavam fazer com gente \"do tipo que ninguém sentiria falta\".", "n": "Droga, Lara. Por que você não me respondeu?", "l": "\"Volta pro mundo, Geo. Ainda tem gente esperando por você lá fora.\"", "e": ["geovana", "vanguarda", "tregua_regenerativa"], "m": "Registro do prólogo. Não aparece em combate; ecoa nas cartas de cura e trégua.", "img": "res://assets/story/intro_06.jpg", "g": "fracoes"},
	"fase_1": {"s": "0043-C: Castelo", "r": "Praia de areia molhada, céu roxo, um castelo onde o tempo paira.", "h": "Primeira coordenada do bracelete. O céu cinza tremia com pulsos roxos \"como relâmpagos lentos\" e uma hera púrpura cobria as torres quebradas. A areia daqui obedece a alguém: levanta em pequenos corpos sem forma, os corrompidos, que tentam absorver quem toca neles. No pátio sem teto, sobre um altar lascado, dorme algo com um relógio no peito.", "n": "O tempo aqui não corre. Ele pairava. Tô escrevendo no passado e nem sei por quê.", "l": "\"Destino mais próximo: 0043-C: CASTELO\"", "e": ["caranguejo_cosmico", "comum", "petro_ficha"], "d": 1, "img": "res://assets/story/arrive1_wide.jpg", "g": "fases"},
	"fase_2": {"s": "O mundo branco", "r": "Um frio que tenta apagar a memória do calor.", "h": "Sem céu, sem chão, sem direção. A peça no bolso do jaleco era a única fonte de calor de verdade. Os habitantes são pequenos, de penas azuladas e olhos de lua, e o primeiro deles congelou o dedo de Geovana até o meio da mão antes de gritar. O grito era um alarme. Dezenas responderam da nevasca.", "n": "Já passei por coisa pior. Literalmente quebrei o tempo.", "l": "\"Um frio que não apenas congelava o corpo — mas tentava apagar a própria memória do calor.\"", "e": ["nevasca", "pinguim_atirador", "sineiro_boreal"], "d": 2, "img": "res://assets/story/arrive2_wide.jpg", "g": "fases"},
	"fase_3": {"s": "A cidade do toque de recolher", "r": "Ruas góticas, nuvem verde e cartazes sobre aceitar.", "h": "Casas estreitas com janelas que parecem olhos vazios, postes de vela e uma nuvem esverdeada que prende a noite. Nos cartazes: \"O caminho da salvação está em aceitar\" e \"O sacrifício da carne é necessário para se tornar um novo ser\". Quarenta anos atrás uma estrela caiu do céu e um rato aprendeu a falar com os Céus. Depois disso, não sobraram humanos.", "n": "Que cheiro é esse? Queijo. Queijo ancestral.", "l": "\"Ratos pecadores devem ser limpos na missa de hoje.\"", "e": ["pai_rato", "stiff", "devoto"], "d": 3, "img": "res://assets/story/arrive3_wide.jpg", "g": "fases"},
	"fase_4": {"s": "Coração do Nexo", "r": "Gravidade de julgamento, céu amarelo e trinta mil anos de rotina.", "h": "A gravidade ali \"não era apenas uma lei da física; era um julgamento\". Uma civilização de anfíbios em trajes pressurizados cuida das ruínas de quem deixou o mundo morrer \"enquanto olhava para as estrelas\". A cidade funciona perfeitamente e ninguém sorri. Quanto mais perto do centro, mais pesada fica a culpa de quem passa.", "n": "Eles não estão vivendo. Estão durando.", "l": "\"Uma civilização que dominou as dimensões, mas que esqueceu como se sente o calor de um sorriso.\"", "e": ["nexo_ruptura", "capitao", "cartografo_vazio"], "d": 4, "img": "res://assets/story/arrive4_wide.jpg", "g": "fases"},
	"fase_5": {"s": "Por dentro da cápsula", "r": "O lugar onde Geovana se partiu em duas.", "h": "Não é uma dimensão: é o que aconteceu dentro dela no quarto da cápsula, depois do jantar. De um lado, a Geovana que destruiria cada átomo para ouvir Henrique de novo. Do outro, a cientista que viu o mapa de rombos. No pesadelo, fios dourados a moviam como marionete e uma serpente de olhos dourados apertava o pescoço dela. UMBRA aprendeu com as duas.", "n": "Isso não é um lugar. É uma lembrança. Minha.", "l": "\"Ali, no silêncio sepulcral daquela cápsula de repouso, Geovana se fragmentou.\"", "e": ["umbra", "insana", "geovana"], "d": 5, "img": "res://assets/story/arrive5_wide.jpg", "g": "fases"},
	"fase_6": {"s": "Um rombo que ela deixou", "r": "O que sobra de um mundo depois que ela salta.", "h": "No holograma do Capitão, os pontos por onde ela passou viravam raízes secas, perdendo cor e consistência. A Chaga é uma dessas raízes vista de perto: um mundo que apodreceu depois do salto e tentou preservar a dor em âmbar, como inseto antigo. Tudo aqui está preso. Tudo aqui quer voltar a ser carne.", "n": "Tudo aqui está preso. Como insetos no tempo. Como eu.", "l": "\"Cada ponto onde você saltou está se destruindo de dentro para fora.\"", "e": ["matriarca_chaga", "ruptura", "pustula_fossil"], "d": 6, "img": "res://assets/story/arrive6_wide.jpg", "g": "fases"},
	"fase_7": {"s": "Onde tudo está prestes a queimar", "r": "Uma floresta em cinzas que talvez seja culpa dela.", "h": "Geovana escreveu, na cápsula, que a luz brilha mais forte onde tudo está prestes a queimar. Aqui a frase virou paisagem: troncos em brasa, céu laranja e uma ave que trata a morte como etapa. Ninguém conta para ela quem acendeu o fogo. Ela não pergunta.", "n": "Uma floresta queimada. Fui eu que fiz isso?", "l": "\"Às vezes, a luz brilha mais forte onde tudo está prestes a queimar.\"", "e": ["fenix", "cinerido", "fuligarra_corvol"], "d": 7, "img": "res://assets/story/arrive7_wide.jpg", "g": "fases"},
	"comum": {"s": "Corrompido de areia", "r": "Súdito sem forma do Caranguejo. Tenta te absorver.", "d": 1, "h": "Montes de areia que se erguem do chão como vermes acordando, com pernas curtas e olhos sem brilho. Não agem por vontade própria: obedecem ao que pulsa no peito do Caranguejo do Nulo. Quando tocam alguém, não caem, sobem: serpenteiam pelo braço procurando uma entrada, como um molde tentando refazer o corpo à força.", "n": "Quando morrem soltam uma faísca dourada que entra em mim. Eu não pedi isso.", "l": "\"Eram deformados, instáveis — como fragmentos de alguma coisa que não terminou de nascer.\"", "e": ["caranguejo_cosmico", "aglomerador", "fase_1"], "g": "inimigos"},
	"espreitador": {"s": "Corrompido que cava", "r": "Some na duna e volta embaixo de você.", "d": 1, "h": "Na primeira manhã, a placa de madeira do abrigo amanheceu com um buraco perfeito, largo o bastante para a cabeça de um cachorro. Não foi o Espreitador, foi Petro. Mas Geovana passou a noite seguinte olhando cada furo na areia, e a areia daqui aprendeu com o olhar dela: há corrompidos que só existem por baixo.", "n": "Tá tudo aqui... por enquanto. Eu conto os dedos toda manhã.", "l": "\"A madeira havia sido furada quase que perfeitamente, como por algo que cavou com precisão.\"", "e": ["comum", "petro_ficha", "fase_1"], "g": "inimigos"},
	"projetador": {"s": "Arremessador das dunas", "r": "A primeira coisa que tentou matá-la foi uma pedra.", "d": 1, "h": "Antes de qualquer monstro, veio uma pedra \"de tamanho absurdo\", e depois outra. A segunda se partiu ao meio contra a palma aberta de Geovana, na primeira vez que a energia azul respondeu. O Projetador é a dúvida que ela nunca resolveu: quem jogou as pedras? Ele fica parado, longe, e responde com mais pedras.", "n": "Eu levantei a mão pra me proteger. A pedra que quebrou.", "l": "\"Uma corrente azul rasgou o espaço entre ela e a rocha.\"", "e": ["eletrica", "comum", "fase_1"], "g": "inimigos"},
	"aglomerador": {"s": "O que come a areia para crescer", "r": "Engole um corrompido e volta maior.", "d": 1, "h": "O primeiro monstro de verdade tinha o tamanho de um urso e olhos da cor do céu. Quando caiu, uma criatura de areia rastejou até os pés dele, e ele a comeu numa mordida. As costas alargaram, os braços engrossaram, a pedra ficou escura como obsidiana. Por isso os Aglomeradores existem: no Castelo, quem come o menor vira o maior.", "n": "Você não vai virar a segunda forma, não enquanto eu estiver aqui.", "l": "\"Agarrou a criatura de areia como se fosse um pedaço de fruta e a levou até a boca.\"", "e": ["comum", "petro_ficha", "petro"], "g": "inimigos"},
	"cristalizado": {"s": "Hera roxa endurecida", "r": "Cristais ocos crescendo onde o tempo para.", "d": 1, "h": "As muralhas do castelo estão cobertas de musgo seco e cristais ocos que brilham com a mesma luz roxa do céu. Perto do altar, a luz pulsa mais forte, e o que encosta nela endurece. Os Cristalizadores são corrompidos que ficaram perto demais do relógio: carregam uma casca que leva tempo para quebrar.", "n": "A arquitetura daqui funciona como filtro de energia. Bonito. Odeio.", "l": "\"As pedras antigas estavam cobertas por camadas de musgo seco e cristais ocos.\"", "e": ["caranguejo_cosmico", "briguer_escudeiro", "fase_1"], "g": "inimigos"},
	"curater": {"s": "Núcleo que remenda", "r": "Fica atrás dos outros e devolve areia aos feridos.", "d": 1, "h": "No abrigo, a areia do chão foi chamada até a esfera azul, grão por grão, e formou uma casca \"como casca sobre uma semente\". Foi assim que Petro nasceu. O Curater faz o mesmo para o lado errado: carrega um núcleo pequeno que puxa areia para os corrompidos feridos e se esconde atrás deles enquanto trabalha.", "n": "Se a areia remenda eles, remendou o Petro também. Não gosto do que isso diz.", "l": "\"Não como se fosse sugada com violência, mas como se estivesse sendo chamada.\"", "e": ["petro_ficha", "comum", "rebobinador"], "g": "inimigos"},
	"larapio": {"s": "Ladrão de dobras", "r": "Pega o que é seu e some num portal do tamanho de um bolso.", "d": 1, "h": "Cinco pequenas peças se soltaram do bracelete assim que ela pisou na areia: azul, verde, roxo, amarelo e vermelho, sugadas para fendas invisíveis. Ninguém sabe se o Larápio veio antes ou depois disso, mas ele abre exatamente o mesmo tipo de fenda, e tem uma obsessão por tudo que brilha.", "n": "Eu tentei alcançar as peças. Era tarde. É sempre tarde com ele também.", "l": "\"Cinco pequenas peças do bracelete se desprenderam, como fragmentos energizados.\"", "e": ["ruptura", "avarento", "moeda_estavel"], "g": "inimigos"},
	"rebobinador": {"s": "Ponteiro que volta", "r": "Devolve energia a quem já devia ter caído.", "d": 1, "h": "O relógio no peito do Caranguejo não marca horas: os ponteiros giram em direções contrárias, quebram, retrocedem e se recompõem \"em ciclos viciados de destruição e renascimento\". O Rebobinador é um pedaço desse relógio que escapou. Onde ele passa, o que caiu tenta levantar de novo.", "n": "Retornator 9000. Henrique teria chamado assim. E teria achado engraçado.", "l": "\"A cada segundo, voltavam a se recompor, em ciclos viciados.\"", "e": ["caranguejo_cosmico", "carta_zero", "necrocronismo"], "g": "inimigos"},
	"briguer_escudeiro": {"s": "Placa de carapaça andante", "r": "Devolve o tiro na velocidade do seu próprio tiro.", "d": 1, "h": "O Caranguejo é feito de placas rígidas \"fundidas com matéria e memória\". Algumas se soltaram e aprenderam a andar sozinhas, com uma membrana na frente que rebate o que vem. Atire de frente e o seu próprio disparo volta para você, exatamente tão rápido quanto foi.", "n": "Atirar de frente num escudo. Eu sou física. Eu sei. Eu fiz mesmo assim.", "l": "\"Seu corpo era feito de placas rígidas, reluzentes.\"", "e": ["caranguejo_cosmico", "cristalizado", "ponto_cego"], "g": "inimigos"},
	"pinguim_atirador": {"s": "Sentinela de penas azuis", "r": "Pequeno, curioso e com um raio de gelo no bico.", "d": 2, "h": "Do tamanho de uma criança, olhos grandes \"como duas pequenas luas\". Olhou para Geovana sem medo, como se já a esperasse, e por um segundo ela sentiu companhia. Depois ele se encolheu e disparou um raio fino que congelou o dedo dela até o meio da mão. Só a peça no bolso, aquecendo, impediu o resto.", "n": "Ei, tá tudo bem, eu não quero te mach— Ai.", "l": "\"O jato atingiu a ponta do dedo indicador de Geovana com precisão cirúrgica.\"", "e": ["nevasca", "sineiro_boreal", "fase_2"], "g": "inimigos"},
	"pinguim_kamikaze": {"s": "Vulto rápido na nevasca", "r": "Vem correndo pela tempestade e não volta.", "d": 2, "h": "Depois do grito, vieram vultos pequenos e pretos atravessando as cortinas de neve, \"rápidos demais para distinguir forma\". Nem todos atiravam. Alguns só corriam até ela. No mundo branco, defender a colônia vale mais do que voltar para ela.", "n": "Eu girava e atirava pra todo lado. Não consegui ver a cara de nenhum.", "l": "\"Vultos pequenos e pretos passavam entre as cortinas da nevasca.\"", "e": ["pinguim_atirador", "nevasca", "fase_2"], "g": "inimigos"},
	"pinguim_incendiario": {"s": "O calor que eles guardam", "r": "Fogo no meio do gelo. Rompe as rotas de fuga.", "d": 2, "h": "Quando Geovana derrubou os primeiros, a neve começou a derreter onde eles caíam. Há um calor guardado dentro desse povo, usado para cavar galerias e aquecer ninhos. Na guerra, ele vira chão em chamas entre ela e a saída.", "n": "O mundo congelado agora ardia em luz. Parte da luz era minha.", "l": "\"A tempestade respondia. O mundo congelado agora ardia em luz.\"", "e": ["pinguim_atirador", "nevasca", "cinzas_escolha"], "g": "inimigos"},
	"sineiro_boreal": {"s": "O grito que chama", "r": "Um assobio dobrado, de muitas bocas ao mesmo tempo.", "d": 2, "h": "O primeiro pinguim inclinou-se para trás e soltou um grito que vibrou nos ossos de Geovana e fez a paisagem pulsar. Era um chamado. O Sineiro transformou esse grito em cerimônia: cada badalada prende os passos que ela acabou de dar em marcas de gelo, como se o mundo branco quisesse lembrar por onde ela andou.", "n": "Algo foi despertado. E eu não estava mais sozinha.", "l": "\"O som não era só físico. Ele ecoou por dentro do peito.\"", "e": ["pinguim_atirador", "nevasca", "fase_2"], "g": "inimigos"},
	"devoto": {"s": "Fiel de túnica", "r": "\"O herege voltou.\"", "d": 3, "h": "Sombras que deslizavam pelas paredes em coro: \"Ser desprezível, trazendo o pecado para o mundo. O Pai irá te purificar.\" Prometem amarrar a herege e \"poupar a vida sofrida\" dela. Cada Devoto tem uma casa normal, com cozinha e fogão de ferro. A fé é que não é normal.", "n": "Eles falam a minha língua. Isso significa que pensam. Isso significa que escolheram.", "l": "\"Iremos te amarrar e pouparemos sua vida sofrida.\"", "e": ["pai_rato", "stiff", "salmodiante"], "g": "inimigos"},
	"incensario": {"s": "Turíbulo do Ninho", "r": "O incenso sagrado que desajusta a carne.", "d": 3, "h": "Um dos ratos mais velhos cuspiu uma gosma viscosa na perna de Geovana. Quando ela tentava avançar, o corpo recuava; quando erguia o joelho, o pé ia para o lado. \"O veneno do ninho desajusta a carne\", sussurraram. O Incensário espalha a mesma coisa no ar, em nuvem, durante a missa.", "n": "Se o sinal tá errado, é só reiniciar. Eu reiniciei a minha perna com eletricidade.", "l": "\"Bela tentativa. Mas o corpo ainda é meu.\"", "e": ["pai_rato", "poison", "devoto"], "g": "inimigos"},
	"flagelante": {"s": "Passo de procissão quebrada", "r": "Avança em zigue-zague, em surtos de fervor.", "d": 3, "h": "Os ratos menores saltaram na frente do altar em formação defensiva, túnicas pingando um líquido oleoso, olhos de fanatismo absoluto. Os Flagelantes são os que não esperam a formação: correm em zigue-zague pelas passarelas enferrujadas, porque a dor, para eles, é ritmo.", "n": "Uns pulavam. Outros rodopiavam. Era um culto. Uma missa. Um carnaval que fede.", "l": "\"Ela não crê. Ela fere. Ela ruge!\"", "e": ["devoto", "pai_rato", "fase_3"], "g": "inimigos"},
	"salmodiante": {"s": "Voz do coro", "r": "O cântico vira disparo em leque.", "d": 3, "h": "Do interior do templo vinha \"um coro intenso, harmonioso e aterrorizante ao mesmo tempo\". Os Salmodiantes guardam os textos do Pai e os recitam até a garganta acender. Quando o salmo termina, o que sai da boca já não é palavra.", "n": "Eu juro que um deles estava desafinado. Pequenas vitórias.", "l": "\"Pai-Rato, continue o Cântico. Nós cuidaremos da herege.\"", "e": ["devoto", "pai_rato", "incensario"], "g": "inimigos"},
	"portador_relicario": {"s": "Quem carrega o cálice", "r": "Acelera os fiéis com fervor de relíquia.", "d": 3, "h": "O cálice cerimonial do Pai-Rato era entalhado em osso e coberto de símbolos. Os Portadores carregam relicários do mesmo osso, com frascos dourados de um líquido \"pulsante, quase vivo\". Cada pulso apressa a procissão. Ninguém pergunta de quem eram os ossos. Stiff perguntaria.", "n": "Crânios pregados nas paredes. Olhos vazios. Eu remei por cima deles.", "l": "\"Um receptáculo rudimentar entalhado em osso e coberto por símbolos.\"", "e": ["pai_rato", "stiff", "devoto"], "g": "inimigos"},
	"guardiao": {"s": "Paladino do altar", "r": "Fé de grande porte. Protege o trono de queijo.", "d": 3, "h": "O Pai-Rato se move \"com uma agilidade sobrenatural, quase quatro vezes maior que Stiff\". Os Guardiões são os que ele escolheu para chegar perto disso: grandes, ungidos e postos entre os hereges e o símbolo sagrado, a mandala torta onde brilhava o fragmento dourado.", "n": "Não basta vencer o fanático. É preciso destruir a fé dele.", "l": "\"Este mundo não existe para seres fracos, Stiff. Apenas os mais fortes sobrevivem.\"", "e": ["pai_rato", "carrasco_de_colossos", "fase_3"], "g": "inimigos"},
	"cartografo_vazio": {"s": "Médico de traje dourado", "r": "Leu o bracelete dela enquanto ela dormia.", "d": 4, "h": "Pequenos, com pouco mais de um metro, viseiras douradas e vozes que eram frequências. Escanearam as cordas vocais de Geovana para falar a língua dela e leram tudo o que havia no bracelete quântico. \"Esperamos que não tenha sido invasivo.\" Em combate, fazem a mesma coisa: mapeiam para onde ela vai antes de ela ir.", "n": "Médicos baixinhos com traje de astronauta. Eu digo isso em voz alta e continua estranho.", "l": "\"Você permaneceu em estado de dormência por três ciclos solares completos.\"", "e": ["capitao", "nexo_ruptura", "desvio_probabilidade"], "g": "inimigos"},
	"cronofago": {"s": "Fome de margem", "r": "Perto dele, cada segundo pesa mais.", "d": 4, "h": "Três ciclos solares numa maca. \"Perder setenta e duas horas era um luxo que ela não podia pagar.\" O Cronófago é o Nexo inteiro em forma de bicho: uma vida tão longa que aprendeu a comer o tempo dos outros. Ao lado dele, a janela para agir encolhe.", "n": "Trinta mil anos. E eles ainda querem os meus três dias.", "l": "\"No multiverso, o tempo era uma moeda volátil.\"", "e": ["nexo_ruptura", "rebobinador", "intervalo_fraturado"], "g": "inimigos"},
	"refrator_hostil": {"s": "Retórica em forma de espelho", "r": "Devolve o que você manda, torto.", "d": 4, "h": "No jantar, o Secretário e o Ministro faziam o mesmo: pegavam cada palavra de Geovana e devolviam mais afiada. \"O que você chama de amor, nós chamamos de ruído estatístico.\" O Refrator não copia a imagem de quem o ataca. Copia o erro, e devolve.", "n": "Um pingo de razão contamina o sistema inteiro. Eu sou o sistema.", "l": "\"Como pode priorizar um único átomo em um oceano de estrelas?\"", "e": ["nexo_ruptura", "prismatica", "capitao"], "g": "inimigos"},
	"tecelao_vetorial": {"s": "Fio dourado", "r": "Costura o mapa em trajetórias que você não escolheu.", "d": 4, "h": "No pesadelo da cápsula, fios de seda dourada, iguais aos do portal, prendiam os pulsos e tornozelos de Geovana e a faziam andar sobre os mundos que ela pisoteou. O Tecelão é o lado acordado desse sonho: puxa linhas pela arena até o movimento dela parecer de outra pessoa.", "n": "Uma marionete. Movida por mãos gigantes. Eu acordei gritando.", "l": "\"Ela era uma marionete, movida por mãos gigantescas e invisíveis.\"", "e": ["umbra", "nexo_ruptura", "fase_4"], "g": "inimigos"},
	"eco_entropico": {"s": "Turno que não acaba", "r": "Repete a mesma tarefa até alguém interromper.", "d": 4, "h": "Quando o sinal de troca de turno soou, os operários perderam o brilho dos olhos de uma vez e andaram como autômatos para os transportadores. Cumpriram o roteiro. O Eco é o que sobra quando o roteiro dura trinta mil anos: uma ação que continua vindo, muito depois de fazer sentido.", "n": "Ninguém gritava ordens. Ninguém reclamava do peso. Ninguém ria.", "l": "\"Eles haviam cumprido o script.\"", "e": ["nexo_ruptura", "eco_de_impacto", "fase_4"], "g": "inimigos"},
	"enguia_miasma": {"s": "Febre que nada", "r": "Desliza pelo ar como se fosse lama.", "d": 6, "h": "Na raiz seca do holograma, a realidade \"perde cor e consistência\". A Enguia é uma das coisas que nadam nessa perda: fina, lenta para virar, rápida para chegar. Deixa a arena mais venenosa só de passar.", "n": "Eu não sei que mundo era esse antes de mim. Nunca vou saber.", "l": "\"As raízes mostravam o tecido do espaço-tempo rasgado.\"", "e": ["matriarca_chaga", "fase_6", "lodario"], "g": "inimigos"},
	"lodario": {"s": "Peso mole", "r": "Lama com vontade, derramada pelo mapa.", "d": 6, "h": "Mistura de sedimento, memória e carne cansada. A Matriarca não o comanda como soldado: ela o derrama, e o chão fica mais espesso e menos generoso com o erro. Feromônios de pústula o fazem saltar.", "n": "O chão desse lugar quer me segurar. Já basta a culpa.", "l": "\"A realidade está apodrecendo atrás de você.\"", "e": ["matriarca_chaga", "pustula_fossil", "fase_6"], "g": "inimigos"},
	"pustula_fossil": {"s": "Dor guardada em âmbar", "r": "Parece parada demais para ser urgente.", "d": 6, "h": "No Nexo, as cápsulas eram encravadas em rocha âmbar. Na Chaga, o âmbar guarda feridas. Cada pústula é uma dor antiga tentando voltar a ser carne. Quando Geovana chega perto, ela lembra.", "n": "Um dente cariado de âmbar. Eu sentei num desses quando cheguei no Nexo.", "l": "\"Uma formação rochosa de tom âmbar que emergia do solo como um dente cariado.\"", "e": ["matriarca_chaga", "lodario", "fase_6"], "g": "inimigos"},
	"sanguessuga_cronal": {"s": "Parasita de instante", "r": "Bebe segundos antes de beber sangue.", "d": 6, "h": "Cai, se enterra e espera ela passar perto demais para saltar em linha reta. Gruda no presente e tenta deixar todo futuro curto demais para fugir. Os sapos falavam de \"seres que tentam devorar planetas por puro capricho ou fome\". A Sanguessuga começa pequeno.", "n": "Eu tinha trinta e uma variáveis na cabeça e ela comeu três segundos de cada.", "l": "\"Venho enfrentando seres que tentam devorar planetas e rasgar o tecido do universo.\"", "e": ["matriarca_chaga", "cronofago", "fase_6"], "g": "inimigos"},
	"suturador_ambar": {"s": "Costura que guarda o caminho", "r": "Não persegue o corpo; guarda onde você vai passar.", "d": 6, "h": "\"Não parecia que estava sendo selada... parecia que estava sendo escondida.\" Foi assim que Geovana viu a primeira fenda se fechar no céu do Castelo. O Suturador faz esse trabalho com o próprio corpo: endurece a ferida da Chaga em linhas de âmbar que atravessam a arena e decidem por onde o futuro passa.", "n": "O universo costura as feridas que eu abro. Com pressa. Mal.", "l": "\"Como se o próprio tecido do universo costurasse a ferida que ela havia causado.\"", "e": ["matriarca_chaga", "sutura_gradual", "fase_6"], "g": "inimigos"},
	"cinerido": {"s": "Cinza que anda", "r": "O que restou de alguém que não fugiu do fogo.", "d": 7, "h": "Corpos leves, feitos do que a floresta foi. Andam em bando e caem como fuligem quando morrem, mas a fuligem nunca assenta de vez. Geovana segura um punhado e não sabe se está segurando uma árvore ou uma pessoa.", "n": "Eu segurei cinza na mão e pedi desculpa. Pra quem, eu não sei.", "l": "\"Uma floresta queimada... fui eu que fiz isso?\"", "e": ["fenix", "fase_7", "cinzas_escolha"], "texture_path": "res://assets/sprites/cinerido-mov-1.png", "m": "Avança em grupos rápidos e frágeis. Limpe o bando antes que ele cerque.", "img": "res://assets/sprites/cinerido-mov-1.png", "g": "inimigos"},
	"fuligarra_corvol": {"s": "Ave de fuligem", "r": "Mergulha do céu laranja direto em você.", "d": 7, "h": "A Fênix não voa sozinha. Corvos de fuligem acompanham o calor como acompanhariam um rebanho, mergulhando sobre tudo o que ainda se mexe no chão. Parecem pequenos de longe. De perto, o bico arde.", "n": "Até as aves daqui aprenderam a cair de propósito.", "l": "\"Até as cinzas aprendem a voltar.\" — a frase que ela disse quando a Fênix caiu.", "e": ["fenix", "fase_7", "cinerido"], "texture_path": "res://assets/sprites/Corvol1.png", "m": "Pressão aérea: mergulha em linha. Mova-se de lado no último instante.", "img": "res://assets/sprites/Corvol1.png", "g": "inimigos"},
	"carapaca_brasa_pangoliro": {"s": "Carapaça em brasa", "r": "Rola pelo mapa como uma pedra acesa.", "d": 7, "h": "Um bicho de escamas grossas que se enrola quando a floresta pega fogo e só desenrola quando o fogo passa. Aprendeu a usar isso: enrola, rola e atravessa o mapa carregando o incêndio nas costas.", "n": "Ele só queria sobreviver ao fogo. Eu entendo mais do que gostaria.", "l": "\"O mundo congelado agora ardia em luz.\" — o fogo também viaja de um mundo para outro.", "e": ["fenix", "fase_7", "bastiao_inercial"], "texture_path": "res://assets/sprites/Pangoliro.png", "m": "Investida rolando em linha reta. Saia da trajetória e puna a parada.", "img": "res://assets/sprites/Pangoliro.png", "g": "inimigos"},
	"caranguejo_cosmico": {"s": "O Caranguejo do Nulo", "r": "Um relógio no peito girando ao contrário.", "d": 1, "h": "Repousava sobre um altar de pedra lascada, embaixo de um vórtice roxo \"como se o céu estivesse pingando\". O corpo era de placas fundidas com memória; os olhos se dobravam como ponteiros procurando uma frequência. Guardava o primeiro fragmento cravado acima do relógio, sem usar, só para ter. Ferveu água do nada para cozinhar Geovana numa bolha. Matou Petro.", "n": "Ecooo. Eu falei isso em voz alta na frente dele. Primeira impressão.", "l": "\"A criatura parecia... feita de tempo.\"", "e": ["fase_1", "petro_ficha", "comum"], "g": "chefes"},
	"nevasca": {"s": "O colosso do mundo branco", "r": "Cada passo faz brotar lanças de gelo.", "d": 2, "h": "Era como os pequenos, só que deformado, maior e mais denso. A segunda peça estava cravada no peito dele como um medalhão vivo. Soprou uma muralha de nevasca larga demais para contornar, e foi ali que Geovana atravessou o gelo pela primeira vez sem saber como: piscou e estava do outro lado. Caiu com um tiro no olho.", "n": "Eu me teletransportei? Eu... me teletransportei.", "l": "\"Você tem o que eu preciso…\"", "e": ["fase_2", "teleporte", "pinguim_atirador"], "g": "chefes"},
	"pai_rato": {"s": "Profeta do Ninho", "r": "Trono de queijo, cálice de osso e um fragmento no símbolo.", "d": 3, "h": "Um rato quase do tamanho dela sentado num trono de queijos empilhados, segurando uma mandala torta com o fragmento dourado no centro. Há quarenta anos, uma estrela caída o pôs em contato com os Céus; ele aniquilou os humanos e levou a filha de Stiff \"por nascer diferente\". Bebeu do cálice e dobrou de tamanho. O queijo fechava as feridas dele. Devorou Stiff na frente dela.", "n": "Você me perguntou quantas vidas tinha. Eu respondi.", "l": "\"Me diga... quantas vidas você tem? Ou melhor... me mostre.\"", "e": ["fase_3", "stiff", "devoto"], "g": "chefes"},
	"nexo_ruptura": {"s": "O corpo que o Conselho vestiu", "r": "Colosso de traje que vaza a energia do motor.", "d": 4, "h": "O motor da cidade está parando, e o Capitão disse que a energia dele \"já não cintila\". O Conselho (Governador, Secretário e Ministro) achou outra saída: enfiar o que restava da centelha num traje do tamanho de um prédio e mandá-lo buscar a fonte que caiu do céu. O traje volta respirando. O que está dentro não sabe mais onde termina o metal.", "n": "Eu não sou a vilã... sou?", "l": "\"Celebramos a chegada da anomalia. Um recurso que garantirá que nosso sol nunca se apague.\"", "e": ["fase_4", "capitao", "cartografo_vazio"], "g": "chefes"},
	"umbra": {"s": "A outra Geovana", "r": "A metade que leu o mapa de rombos e concordou.", "d": 5, "h": "Quando Geovana se partiu na cápsula, uma metade ficou com o amor e a outra com a lógica. UMBRA é a segunda, inteira, armada e convencida. Aprendeu cada passo da primeira, cada atalho, cada hábito, porque viveu dentro dela. Só não aprendeu por que ela anda.", "n": "Você aprendeu os meus passos. Não aprendeu por que eu ando.", "l": "\"Olhe para o que você se tornou, Geovana. Você é um monstro.\" — Henrique, no pesadelo.", "e": ["fase_5", "insana", "geovana"], "g": "chefes"},
	"matriarca_chaga": {"s": "Mãe de sintomas", "r": "O mundo que apodreceu depois do salto, com rosto.", "d": 6, "h": "Não corre atrás de ninguém: controla o mapa como um organismo parado, escolhendo quando fermentar o chão e quando expor o núcleo. Tudo nela perdeu alguma coisa e voltou com fome. Se a Chaga é um rombo que Geovana deixou, a Matriarca é o rombo olhando de volta.", "n": "Nada fica preso pra sempre. Nem eu. Nem você.", "l": "\"Ou ele foi diplomático demais para dizer que você está assassinando mundos inteiros?\"", "e": ["fase_6", "ruptura", "suturador_ambar"], "g": "chefes"},
	"fenix": {"s": "A ave das cinzas", "r": "Trata a morte como uma etapa da luta.", "d": 7, "h": "Voa sobre a floresta que queimou e, quando cai, vira ovo, e do ovo volta. Cada queda dela deixa a arena mais quente e mais rápida. O último fragmento sobe das cinzas dela como se a Ruptura quisesse provar que nada acaba de verdade. Inclusive a dor.", "n": "Até as cinzas aprendem a voltar. Agora só falta você, Henrique.", "l": "\"A luz brilha mais forte onde tudo está prestes a queimar.\"", "e": ["fase_7", "cinerido", "fuligarra_corvol"], "texture_path": "res://assets/sprites/boss7_fenix/fenix_fly_01.png", "m": "Voo, mergulhos de fogo e renascimento num ovo. Quebre o ovo antes que ela volte inteira.", "g": "chefes"},
	"eletrica": {"s": "A primeira resposta", "r": "Nasceu na praia, quando a pedra se partiu na palma dela.", "h": "O formigamento começou nos dedos e virou um globo de plasma em volta do cabelo. A primeira esfera não foi lançada: rasgou o ar entre as palmas. Ela só funcionou quando Geovana parou de calcular e pensou nele: a risada idiota, a xícara segurada com as duas mãos, o som das teclas de madrugada.", "n": "Eu fechei os olhos e pensei no Henrique. Foi isso que funcionou. Não conta pra ninguém.", "l": "\"Empurrou as mãos para frente — como quem abre uma porta impossível.\"", "e": ["geovana", "projetador", "manifestacoes"], "g": "manifestacoes"},
	"lacerante": {"s": "O corte que ela não pediu", "r": "A raiva que sobrou da fase dois do luto.", "h": "Primeiro a negação, depois a raiva: contra o General, contra o governo, contra a física. No apartamento escondido, ela gritava com as paredes e jogava objetos no chão. A Lacerante é essa fase sem paredes em volta. Não dispara, corta, e corta perto, porque de longe a raiva não serve pra nada.", "n": "Eu dormia abraçada com os cadernos dele. Acordava querendo quebrar alguma coisa.", "l": "\"Contra o tempo que não perdoava, que andava e não voltava.\"", "e": ["sanguinaria", "geovana", "manifestacoes"], "g": "manifestacoes"},
	"prismatica": {"s": "A luz que se divide", "r": "Cada feixe é uma versão dela que poderia ter sido.", "h": "No vórtice, ela viu versões infinitas de si mesma: serenas, partidas, líderes, anônimas. Viu Henrique com cabelos brancos, sem um braço, feliz com outra, e num jardim de outono ao lado dela, num mundo onde o acidente nunca existiu. A Prismática dispara todas essas versões ao mesmo tempo, em ângulos diferentes.", "n": "Uma delas está num jardim de outono. Eu atiro em todas as outras direções.", "l": "\"E no meio de tudo… ela via a si mesma.\"", "e": ["profetica", "refrator_hostil", "manifestacoes"], "g": "manifestacoes"},
	"parasitica": {"s": "O que pega carona", "r": "A lição do veneno do Ninho, aprendida ao contrário.", "h": "A gosma dos ratos desajustou a carne dela até ela reiniciar a própria perna com eletricidade. Depois disso, Geovana entendeu como uma coisa pequena entra em outra e muda o sinal por dentro. A Parasítica é isso: não destrói de fora, se instala e espera.", "n": "Eles queriam que eu fizesse parte do Ninho. Agora o Ninho faz parte de mim.", "l": "\"Logo você fará parte do Ninho... e o Ninho fará parte de você.\"", "e": ["incensario", "poison", "manifestacoes"], "g": "manifestacoes"},
	"gravitante": {"s": "O peso de um mundo", "r": "Ela aprendeu gravidade no lugar que a esmagava.", "h": "No Nexo, a gravidade era um veredito: os joelhos falharam no primeiro passo e os sapos lhe deram uma bengala com sensores para ela andar. O Capitão dobrava o peso da sala só de se aproximar. Geovana saiu de lá sabendo fazer o mesmo: puxar, segurar, esmagar.", "n": "Eu andava de bengala. Agora o chão anda de bengala perto de mim.", "l": "\"A gravidade parecia dobrar-se à vontade dele.\"", "e": ["capitao", "fase_4", "manifestacoes"], "g": "manifestacoes"},
	"racional": {"s": "Precisão de relojoeiro", "r": "Ela ordenava as rupturas. Ele as provocava.", "h": "No laboratório do subsolo, Henrique quebrava os padrões e Geovana, \"com precisão de relojoeiro\", ordenava as rupturas. Quando o mundo acelera, ela faz o contrário: para, observa, calcula, e o tempo em volta desacelera como desacelerava quando ele a ouvia falar. Depois cobra o atraso.", "n": "Ele dizia que o mundo abaixava o volume quando eu falava. Agora eu abaixo o mundo.", "l": "\"Parecia que o tempo desacelerava quando ela falava.\"", "e": ["henrique", "rebobinador", "carta_zero"], "g": "espectros"},
	"impulsiva": {"s": "O jeito do Henrique", "r": "Montar o caminho enquanto anda.", "h": "\"No meu caso, parece mais que eu tô sempre improvisando. Montando o caminho enquanto ando.\" Henrique era o impulsivo do casal; ela, a que esperava. Depois da ruptura, ela precisou aprender a ser os dois. Cada abate que vem em sequência é um passo sem planejar.", "n": "Você pensa demais, eu disse a ele. Agora eu penso de menos.", "l": "\"Tipo... montando o caminho enquanto ando, sabe? E fingindo que sei o que tô fazendo.\"", "e": ["henrique", "speed_boost", "racional"], "g": "espectros"},
	"devota": {"s": "O que a mãe dela disse", "r": "\"Seu lugar no mundo não sumiu.\"", "h": "Meses sem falar com os pais. Quando atendeu, a mãe chorou, o pai pediu só para saber se ela comia e dormia, e depois os dois disseram que a casa dela ainda era dela. A Devota guarda essa ligação como três cargas de proteção. Quando quebram, ela se lembra de que prometeu aparecer depois.", "n": "Eles estavam fazendo strogonoff. Eu desliguei antes de responder.", "l": "\"Mesmo se você estiver perdida — e tudo bem estar — a gente tá aqui.\"", "e": ["geovana", "tregua_regenerativa", "ancora_vital"], "g": "espectros"},
	"vanguarda": {"s": "Ninguém entra no lugar dela", "r": "Ela trancou a porta para ir primeiro.", "h": "O General queria mandar cinco detentos de Bangu V pelo arco, \"gente que ninguém sentiria falta\". Geovana trancou o laboratório por dentro e foi ela. A Vanguarda é esse gesto transformado em calor: cada golpe que ela aceita no lugar de outro vira fogo em volta dela.", "n": "Acha mesmo que vou deixar algum infeliz enfiar os pés no que foi feito com as minhas mãos?", "l": "\"Enviar outra pessoa uma ova... Eu comecei isso. Eu vou terminar.\"", "e": ["general_aires", "lara", "pressao_cerco"], "g": "espectros"},
	"insana": {"s": "Duas Geovanas", "r": "A que ama e a que calcula, atirando ao mesmo tempo.", "h": "Na cápsula do Nexo, a mente dela se rasgou em duas direções: uma destruiria o multiverso por Henrique, a outra via o mapa de rombos e sabia que nenhum amor justificava aquilo. A Insana é quando as duas param de discutir e começam a disparar juntas, com um segundo de atraso uma da outra.", "n": "Uma de nós atira. A outra pede desculpa. Às vezes trocamos.", "l": "\"Como se sua mente fosse um tecido sendo rasgado em duas direções opostas.\"", "e": ["umbra", "fase_5", "eco_de_impacto"], "g": "espectros"},
	"voraz": {"s": "Quem come cresce", "r": "A regra do Castelo, do Ninho e do Nexo.", "h": "O monstro de pedra comeu a criatura de areia e cresceu. O Pai-Rato comeu Stiff e riu. O Capitão quer comer a energia dela para manter um sol aceso. Geovana passou por três mundos que funcionam do mesmo jeito e saiu com fome. Atravessa os fracos e não deixa nada para trás.", "n": "Não deu pra matar a fome. Mas pelo menos a fome não me mata.", "l": "\"Agarrou a criatura de areia como se fosse um pedaço de fruta.\"", "e": ["aglomerador", "pai_rato", "capitao"], "g": "espectros"},
	"nula": {"s": "O quarto estágio", "r": "Dias sem levantar. Cortinas fechadas.", "h": "Negação, raiva, barganha, depressão. No apartamento escondido e de novo na cápsula do Nexo, Geovana parou de sentir vontade até de esmurrar o travesseiro. A Nula usa esse vazio: quanto mais tempo ela fica sem atacar, mais pesado fica o próximo golpe.", "n": "Eu olhava pro teto. O teto não me dava respostas. Eu guardava a raiva pra depois.", "l": "\"Dias em que os olhos ardiam não de chorar, mas de olhar para o vazio.\"", "e": ["geovana", "fase_5", "abissal"], "g": "espectros"},
	"abissal": {"s": "Saudade com massa", "r": "Quanto mais cercada, mais funda.", "h": "Henrique dizia que estrelas que vemos talvez nem existam mais; ela respondia que física era a mais romântica das ciências. \"A mais perigosa\", ele corrigiu. A Abissal é essa conversa de lua de mel virada de cabeça para baixo: a saudade acumula até puxar tudo em volta para o fundo.", "n": "Física, amor. A mais romântica das ciências. Ele tinha razão sobre a outra parte.", "l": "\"Sabia que estrelas que vemos agora talvez nem existam mais?\"", "e": ["henrique", "nula", "gravitante"], "g": "espectros"},
	"profetica": {"s": "Qualquer escolha mínima", "r": "Ela vê os caminhos que ainda não aconteceram.", "h": "Depois do primeiro beijo, Henrique perguntou: \"Se você tivesse dormido mais cinco minutos, ou se eu não tivesse respondido aquele story, talvez a gente nem estivesse aqui.\" Geovana passou a vida estudando essa frase. A Profética mostra os próximos instantes como ela viu as outras realidades no vórtice: um pouco adiantados, um pouco dourados.", "n": "Imagina um lugar onde a gente nunca tivesse se conhecido? Deus me livre.", "l": "\"A teoria das realidades alternativas? Acho fascinante.\"", "e": ["henrique", "prismatica", "desvio_probabilidade"], "g": "espectros"},
	"sanguinaria": {"s": "A caça do General", "r": "Escolher a presa e não errar.", "h": "Aires escolhia quem usar como quem escolhe peças: detentos, técnicos substituíveis, uma cientista que \"talvez precise desaparecer\". Geovana odeia que esse espectro funcione tão bem nela. Escolhe a presa, decide como ela vai cair e cobra caro de si mesma quando erra.", "n": "Eu virei a pessoa que escolhe quem cai. Pelo menos eu escolho os monstros.", "l": "\"Quando ela terminar, talvez precise... desaparecer também.\"", "e": ["general_aires", "lacerante", "coletora"], "g": "espectros"},
	"crepuscular": {"s": "Brilhando até quando apaga a luz", "r": "A última coisa que ele disse sobre ela.", "h": "Pelo rádio selado, com a voz quebrada, Henrique disse que ela ia ficar bem, que ela sempre ficava, \"brilhando até quando apaga a luz\". A Crepuscular alterna entre as duas metades da frase: a alvorada que cura e o ocaso que fere, até a luz e o escuro se encontrarem num eclipse.", "n": "Eu ainda não sei se ele disse isso pra me consolar ou como aviso.", "l": "\"Você vai ficar bem… você sempre fica… brilhando até quando apaga a luz…\"", "e": ["henrique", "equilibrista", "cinzas_escolha"], "g": "espectros"},
	"peregrino": {"s": "Uma caminhada sem mapa", "r": "O bracelete aponta. Ela anda. O rastro fica.", "h": "\"Agora, tudo o que restava era uma caminhada sem mapa em um mundo onde nem o tempo parecia estável.\" Da praia ao castelo, do gelo ao Nexo, Geovana andou mais do que lutou. O Peregrino transforma o caminho em território: quem cruza a trilha dela queima, e quando ela fecha um laço, o que ficou dentro é dela.", "n": "Eu deixo pegadas que somem com a espuma. Aprendi isso na lua de mel.", "l": "\"Deixando pegadas que logo sumiam com a espuma.\"", "e": ["geovana", "rastro_de_retorno", "fase_1"], "g": "espectros"},
	"equilibrista": {"s": "Entre uma vida e o mundo", "r": "A balança que o Capitão segurava.", "h": "\"Entre salvar uma vida e salvar nada, eu escolheria a vida. Mas entre uma vida e o mundo, eu escolheria o mundo.\" Geovana não concorda. Mas vive na balança dele desde aquele dia: nem cheia demais, nem vazia demais, sempre pagando depois o que não pagou agora.", "n": "Eu não peço desculpas por ainda estar viva. Mas eu pago a dívida.", "l": "\"Você luta por um fantasma; eu luto pela realidade que resta.\"", "e": ["capitao", "margem_de_erro", "fase_4"], "g": "espectros"},
	"avarento": {"s": "O bolso esquerdo do jaleco", "r": "Guardar tudo. Gastar de uma vez.", "h": "Trenas, marcadores, um núcleo de pedra, uma foto, um chocolate meio derretido: Geovana guarda tudo, porque nesses mundos qualquer coisa pode ser a diferença. O peso no bolso a protege e a atrasa. Quando ela finalmente gasta, e Bússola sabe disso, é tudo de uma vez.", "n": "Nunca joguei fora o chocolate. Ainda bem.", "l": "\"Ela levou a mão ao bolso do jaleco e puxou algo esquecido ali — um chocolate amassado.\"", "e": ["bussola", "cofre_excesso", "moeda_estavel"], "g": "espectros"},
	"oportunista": {"s": "A lição do terno azul", "r": "Esperar o outro abrir a guarda.", "h": "Valicente nunca levantou a voz. Esperava, observava, e só falava quando a outra pessoa já tinha cedido. Geovana aprendeu a fazer o mesmo com monstros: desviar, esperar a abertura e só então cobrar, com juros.", "n": "Ele esperou eu terminar o projeto. Eu espero o monstro terminar o ataque.", "l": "\"Comandava mais com o silêncio do que com gritos.\"", "e": ["valicente", "ponto_cego", "desvio_probabilidade"], "g": "espectros"},
	"speed_boost": {"s": "Tênis velhos de sempre", "r": "Ela chegou às 6:27. Ele, atrasado.", "h": "Calçou os tênis velhos, prendeu o cabelo sem esforço e atravessou a cidade ainda dormindo para chegar três minutos antes. A Ruptura guardou essa pressa boa, a de quem corre na direção de alguém, e devolveu como velocidade.", "n": "Talvez ele não venha, eu pensei. Ele veio.", "l": "\"Skate park. Segunda. 6:30.\"", "e": ["impulsiva", "henrique"], "g": "cartas"},
	"porcao": {"s": "A fruta que Petro colheu", "r": "Cítrica, doce-amarga. Ninguém morreu.", "h": "Petro escalou uma árvore torta, protegeu a fruta com o corpo na queda e mordeu primeiro para provar que era segura. Ela não matou a fome. Mas a fome também não a matou.", "n": "Se eu desmaiar ou explodir, vou me arrepender de não ter te deixado lá dentro.", "l": "\"Veja, tá tudo bem.\"", "e": ["petro", "petro_ficha"], "g": "cartas"},
	"disparo_crescente": {"s": "Um, dois, três tiros", "r": "Cada disparo atrasava a evolução do monstro.", "h": "Ela não conseguia impedir o monstro de pedra de crescer, só atrasar. Então atirou de novo, e de novo, cada tiro mais concentrado que o anterior, recuando em zigue-zague. A carta lembra a lição: o próximo vale mais que o anterior.", "n": "Os impactos soavam como marteladas numa bigorna viva.", "l": "\"Disparo após disparo, tentando interromper a transformação.\"", "e": ["aglomerador", "eletrica"], "g": "cartas"},
	"tempestade": {"s": "Antes de uma tempestade", "r": "O ar estático que a fez flutuar o cabelo.", "h": "Na praia, antes da primeira esfera, o ar ficou carregado \"como a eletricidade suspensa antes de uma tempestade\". Ela nunca tinha sentido o próprio corpo funcionar como para-raios. Agora funciona como nuvem.", "n": "Globo de plasma em exposição. Eu era o globo.", "l": "\"Estático. Carregado.\"", "e": ["eletrica", "manifestacoes"], "g": "cartas"},
	"trembo": {"s": "O cachorro do skate park", "r": "Acorda cedo, não estuda e ainda ganha carinho.", "h": "Pequeno, orelhudo, com a cara de quem não deve nada a ninguém. Parou na frente deles, abanou o rabo com moderação e foi embora. Henrique disse que ele sabia viver. A Ruptura chama de Trembo qualquer milagre torto que só quer continuar existindo.", "n": "Esse aí deve achar que manda no dono. Eu nunca soube o nome dele.", "l": "\"Esse aí sabe viver.\"", "e": ["henrique"], "g": "cartas"},
	"roubo_de_vida": {"s": "A faísca dourada", "r": "O que sobe dos corrompidos quando eles caem.", "h": "De cada súdito de areia destruído subia uma centelha dourada, hesitante, até ser absorvida pela pele dela. Mais forte, mais rápida, mais estável. Ela nunca decidiu fazer isso. O corpo dela decidiu.", "n": "Eu não pedi. Mas também não recusei.", "l": "\"Como se cada vida derrotada lhe devolvesse um fragmento de si mesma.\"", "e": ["comum", "egide_hemofaga"], "g": "cartas"},
	"speed_atack": {"s": "As teclas de madrugada", "r": "O som dele programando com fone de ouvido.", "h": "Ela se lembra do ritmo das teclas quando Henrique programava em silêncio, cara de concentração, sem parar. Foi uma das lembranças que acendeu a primeira esfera. Agora os disparos dela têm esse mesmo ritmo.", "n": "Rápido, constante, sem levantar a cabeça. Igualzinho.", "l": "\"O som das teclas quando programava em silêncio.\"", "e": ["henrique", "eletrica"], "g": "cartas"},
	"teleporte": {"s": "O salto que não foi salto", "r": "Um rompimento breve da realidade.", "h": "Ela tentou fugir do monstro de pedra e, em vez de pular, rasgou o espaço e reapareceu metros adiante. No castelo não funcionou duas vezes seguidas; na nevasca, funcionou sem ela pedir. Ainda não sabe controlar direito.", "n": "Eu... me teletransportei? Henrique teria dado um nome horrível pra isso.", "l": "\"O salto não foi um salto. Foi um rompimento breve da realidade.\"", "e": ["nevasca", "passagem_intangivel"], "g": "cartas"},
	"petro": {"s": "Pe de pedra, tro de trovejante", "r": "Um cavaleiro pequenininho e teimoso.", "h": "Nasceu do núcleo do monstro, à noite, num canto frio do abrigo. Desenhou o perigo com carvão, colheu fruta, cresceu a dois metros quando ela pediu e caiu no castelo. O núcleo dele mora no bolso interno do jaleco, criando braços de novo.", "n": "Arrebenta, Petro.", "l": "\"Combina com o nome.\"", "e": ["petro_ficha", "caranguejo_cosmico", "aglomerador"], "g": "cartas"},
	"defesa": {"s": "A bolha invertida", "r": "Um campo azul que fez a areia cair como chuva.", "h": "Quando a areia viva subiu pelo braço dela procurando uma entrada, Geovana disparou para baixo, não para atacar, para se proteger. Um campo azul se abriu em volta e os grãos caíram inertes aos pés dela.", "n": "Eles tentam me absorver. Não deixo.", "l": "\"Um campo azulado se espalhou como uma bolha invertida em torno dela.\"", "e": ["comum", "casulo_reativo"], "g": "cartas"},
	"sorte": {"s": "\"Gato.\"", "r": "Um comentário que ela se arrependeu de mandar.", "h": "Numa tarde de tédio, ela comentou uma palavra na foto de um garoto da escola e enfiou o celular embaixo do travesseiro. De manhã, só uma curtida. Dias depois, um story do céu de Brasília e uma resposta brega. A sorte, para Geovana, sempre teve cara de acidente.", "n": "Mds, tomara que ele nem perceba.", "l": "\"Esse céu de Brasília aí parece até de filme.\"", "e": ["henrique", "profetica"], "g": "cartas"},
	"poison": {"s": "O veneno do Ninho", "r": "Desajusta a carne e inverte o comando.", "h": "A gosma cuspida por um rato velho fez a perna dela andar ao contrário do que ela mandava. Ela reiniciou os próprios nervos com eletricidade e guardou o que aprendeu. Agora é ela quem desajusta.", "n": "Bela tentativa. Mas o corpo ainda é meu.", "l": "\"O veneno do ninho desajusta a carne...\"", "e": ["incensario", "parasitica"], "g": "cartas"},
	"coletora": {"s": "Arrancar o núcleo", "r": "Ou eu quebro, ou ele quebra.", "h": "Ela enfiou o braço entre duas placas de rocha até achar a esfera que pulsava no peito do monstro, e segurou mesmo queimando os nervos. A carta é esse instante: terminar o que já está rachado.", "n": "Ou eu quebro, ou ele quebra.", "l": "\"Os dedos escorregaram nas bordas cortantes de rocha, até encontrar a esfera.\"", "e": ["aglomerador", "sanguinaria"], "g": "cartas"},
	"mercenaria": {"s": "\"Vai ser bom financeiramente\"", "r": "A promoção contada na varanda da pousada.", "h": "Na lua de mel ela contou: líder do projeto, horários pesados, muito dinheiro e, se desse certo, \"o mundo inteiro vai saber quem é Geovana\". Ele respondeu que eles iam demorar, e que ele já sabia. Ela ainda conta pontos como contava naquela noite.", "n": "Eles vão demorar. Eu já sabia. Ele falou isso de mim.", "l": "\"Você conseguiu. Caramba, Geo... isso é enorme.\"", "e": ["henrique", "cofre_excesso"], "g": "cartas"},
	"devorador_destinos": {"s": "O que o Pai comeu", "r": "Um deus que engole quem duvida.", "h": "Stiff entrou na missa implorando pela filha e foi devorado inteiro diante de Geovana. O Pai-Rato chamava aquilo de bênção. A carta marca o que deve cair e, quando cai, cobra o destino dele de volta.", "n": "Ele engoliu o Stiff olhando pra mim. Eu devolvi com juros.", "l": "\"Logo você fará parte do Ninho...\"", "e": ["pai_rato", "stiff"], "g": "cartas"},
	"tregua_regenerativa": {"s": "A visita da Lara", "r": "Sete andares até a porta 702.", "h": "Depois de semanas sem resposta, Lara subiu o prédio antigo, bateu três vezes e ficou. Não resolveu nada. Só ficou um pouco, e disse que ainda havia gente esperando. Às vezes uma trégua é só isso.", "n": "Volta pro mundo, Geo. Eu voltei. Do meu jeito.", "l": "\"Ainda tem trabalho. Ainda tem... chance.\"", "e": ["lara", "devota"], "g": "cartas"},
	"cinzas_escolha": {"s": "A fogueira do abrigo", "r": "Raízes, fibras e um coral petrificado.", "h": "Ela juntou o que rangia ao toque e acendeu com uma faísca da ponta do dedo. A fogueira apagou de madrugada. De manhã havia cinzas, um buraco na madeira e Petro. Queimar uma escolha às vezes faz nascer outra.", "n": "A noite não dizia quando acabaria. Mas ali eu tinha onde esperar.", "l": "\"Uma faísca azul saltou da ponta.\"", "e": ["petro_ficha", "fase_7"], "g": "cartas"},
	"reserva_pulso": {"s": "Um coração artificial", "r": "O núcleo do bracelete latejando no vórtice.", "h": "Quando a energia azul a atravessou, o bracelete superaqueceu e passou a latejar \"como um coração artificial\". O que sobra além do que ela aguenta não se perde: fica guardado nesse pulso, esperando.", "n": "Pressão 246 por 179. Eu ainda respirava.", "l": "\"O núcleo do bracelete latejava como um coração artificial.\"", "e": ["ruptura", "egide_hemofaga"], "g": "cartas"},
	"casulo_reativo": {"s": "O buraco na rocha", "r": "Um abrigo onde os joelhos encostavam no queixo.", "h": "Ela entrou de lado num recorte de pedra, tampou a entrada com madeira e galhos e dormiu encolhida. A rocha resistiu ao vento a noite inteira. A carta é esse casulo, fechando quando a pressão aperta.", "n": "Não era confortável. Era funcional. Isso basta.", "l": "\"O abrigo era funcional. E isso era tudo o que precisava agora.\"", "e": ["defesa", "fase_1"], "g": "cartas"},
	"passagem_intangivel": {"s": "Atravessar a nevasca", "r": "Correr na direção do tsunami branco.", "h": "A muralha de gelo era alta demais para pular e larga demais para contornar. Ela correu para dentro dela, e o mundo piscou. Saiu do outro lado ilesa. Desde então, logo depois de saltar, por um instante nada consegue tocá-la.", "n": "Eu não sabia que dava. Agora eu sei.", "l": "\"Correu em direção à nevasca.\"", "e": ["teleporte", "nevasca"], "g": "cartas"},
	"ancora_vital": {"s": "Âncora gravitacional pessoal", "r": "O Efeito Sombra de Minkowski tinha um ponto de retorno.", "h": "Na teoria dela, múltiplas interpretações do tempo podiam ser acessadas \"se o observador carregasse uma âncora gravitacional de origem pessoal\". A âncora tinha nome. É ela que a puxa de volta toda vez que o golpe quase a leva.", "n": "Henrique. Esse era o meu eixo. Ainda é.", "l": "\"Esse era seu eixo de memória. Seu ponto de retorno.\"", "e": ["henrique", "geovana"], "g": "cartas"},
	"inercia_cronal": {"s": "A bengala magnética", "r": "Um pulso que estabiliza as pernas contra o peso do mundo.", "h": "No Nexo, os sapos lhe deram uma haste com sensores de equilíbrio. Ao apoiar o peso, ela sentiu as pernas firmarem contra a gravidade. Ela aprendeu a não ser empurrada.", "n": "Este mundo não tem misericórdia com quem não nasceu sob o seu peso.", "l": "\"Sentiu um leve pulso magnético estabilizar suas pernas.\"", "e": ["gravitante", "fase_4"], "g": "cartas"},
	"moeda_estavel": {"s": "\"Não somos milionários\"", "r": "Ele disse isso na noite do pedido.", "h": "No sofá, com a pipoca esquecida, Henrique disse que eles não tinham tudo que o mundo vende como ideal, mas que tinha ela. A Moeda é o oposto da ganância de Bússola: um valor que não se desfaz.", "n": "Pra mim, isso fez tudo valer a pena. Pra mim também.", "l": "\"Mas... eu tenho você.\"", "e": ["henrique", "bussola", "avarento"], "g": "cartas"},
	"orbita_coletora": {"s": "Cinco peças no ar", "r": "Azul, verde, roxo, amarelo e vermelho.", "h": "Assim que ela se moveu na areia, cinco peças se soltaram do bracelete e flutuaram por um instante, \"como cacos de cristal vivo\", antes de serem sugadas em direções diferentes. A carta faz o caminho inverso: o que estiver solto volta a girar em volta dela.", "n": "Eu tentei alcançar. Agora elas é que vêm.", "l": "\"Elas flutuaram por um momento — cintilando entre cores.\"", "e": ["ruptura", "larapio"], "g": "cartas"},
	"pacto_possibilidades": {"s": "Os cadernos de campo", "r": "Códigos riscados à mão, com o cheiro dele.", "h": "Antes de sumir, ela levou os registros paralelos, croquis e pastas que nunca seriam vistos pela burocracia: \"ideias que surgiram entre um beijo e uma teoria\". A carta cava nessas páginas e desenterra possibilidades que ninguém mais leu.", "n": "Tudo o que era deles, e apenas deles.", "l": "\"Projetos que tinham o cheiro de Henrique.\"", "e": ["henrique", "arquivo_impossivel"], "g": "cartas"},
	"tributo_da_dor": {"s": "As etapas do luto", "r": "Negação, raiva, barganha, depressão. Propósito.", "h": "O luto veio \"como uma equação de etapas previsíveis, mas de impacto imprevisível\". A aceitação dela não trouxe paz: virou propósito. Cada ferida que ela recebe ainda é convertida em alguma coisa útil, e a conta nunca fecha.", "n": "Não a aceitação que traz paz. A que vira propósito.", "l": "\"Mas por fim, a aceitação… Não a que traz paz.\"", "e": ["geovana", "nula"], "g": "cartas"},
	"horizonte_ruptura": {"s": "Horizonte de eventos", "r": "Henrique caía num horizonte, estendendo a mão.", "h": "No pesadelo do Nexo, ele caía para trás de uma linha que a luz não atravessa, e ela não conseguia esticar o braço o bastante. Acordada, ela estica. A carta aumenta o alcance de quem passou a vida querendo alcançar.", "n": "Eu senti o calor da pele dele. Minhas mãos estavam presas.", "l": "\"Ao longe, Henrique caía em um horizonte de eventos.\"", "e": ["henrique", "fase_5"], "g": "cartas"},
	"fragmentacao_reativa": {"s": "As janelas estourando", "r": "Estilhaços cortando o ar em sequência.", "h": "Quando o portal virou um buraco faminto, as janelas do laboratório estouraram uma após a outra. Desde então, quando algo a atinge, os pedaços voam de volta.", "n": "O General correu. O vidro não.", "l": "\"As janelas ao redor do laboratório estouraram em sequência.\"", "e": ["ruptura", "general_aires"], "g": "cartas"},
	"bastiao_inercial": {"s": "Meses trancada", "r": "O apartamento que não estava no nome de ninguém.", "h": "Ela ficou meses no mesmo lugar, comida deixada na porta, ninguém a via. Parada, ela era impossível de alcançar. A carta lembra disso: quem não se move vira muralha.", "n": "Um exílio silencioso. Funcionou. Até a Lara bater.", "l": "\"Ficou meses trancada no pequeno apartamento escondido.\"", "e": ["lara", "nula"], "g": "cartas"},
	"estilhaco_prismatico": {"s": "Vidraças sobrepostas", "r": "Eras colidindo como vidro antigo.", "h": "No vórtice, camadas da realidade se estilhaçavam umas sobre as outras e, em cada caco, havia uma Geovana diferente. Alguns desses cacos ela ainda carrega. Às vezes um deles se solta quando algo morre perto dela.", "n": "Uma das minhas versões estava em paz. Eu guardei o caco dela.", "l": "\"Camadas da realidade colidindo como vidraças antigas se estilhaçando.\"", "e": ["prismatica", "ruptura"], "g": "cartas"},
	"rastro_de_retorno": {"s": "Pegadas na beira da água", "r": "Elas sumiam com a espuma.", "h": "Na lua de mel, eles andavam descalços deixando pegadas que o mar apagava logo. A carta deixa o mesmo tipo de marca, e voltar a ela devolve um pouco do tempo que passou.", "n": "Mergulhados no presente como se fosse o único lugar possível.", "l": "\"Deixando pegadas que logo sumiam com a espuma.\"", "e": ["peregrino", "henrique"], "g": "cartas"},
	"municao_de_rebate": {"s": "Ele respondeu o story", "r": "Um tiro no escuro que voltou.", "h": "Ela postou o céu sem legenda e foi embora. Era só uma foto temporária. O celular vibrou: ele tinha respondido. O que parece perdido às vezes volta, mais forte, procurando você.", "n": "Eu nem esperava. Por isso doeu tão bom.", "l": "\"Henrique. Tinha respondido o story.\"", "e": ["henrique", "sorte"], "g": "cartas"},
	"impulso_de_sobras": {"s": "Um anel no bolso do moletom", "r": "Ele esperou o horário certo: 23:10.", "h": "Henrique carregou o anel no bolso a noite inteira, testando se aquilo fazia sentido fora da cabeça dele, até decidir que 23:10 era um bom horário. A carta guarda o que está pronto e espera o momento.", "n": "Aceito. É um ótimo horário.", "l": "\"Acho que é um bom horário pra pedir a mulher da minha vida em casamento.\"", "e": ["henrique"], "g": "cartas"},
	"eco_de_impacto": {"s": "\"Ecooo...\"", "r": "O que ela disse ao ver o Caranguejo.", "h": "Diante de um caranguejo colossal com um relógio no peito, a primeira reação de uma física brilhante foi \"Ecooo\". O som voltou do salão vazio. Cada golpe dela agora volta também.", "n": "Eu tenho doutorado. Juro.", "l": "\"Ecooo...\"", "e": ["caranguejo_cosmico", "insana"], "g": "cartas"},
	"zona_de_descompressao": {"s": "O laboratório respirou", "r": "Uma onda de ar e luz que fez tudo flutuar.", "h": "Na ativação, não houve fogo: o espaço inteiro respirou com força, papéis voaram, cadeiras giraram, e a gravidade sumiu. Quando a cercam, ela faz o mesmo: empurra o mundo para longe de uma vez.", "n": "Inclusive eu flutuei. Eu e o café de três dias.", "l": "\"Como se o próprio espaço tivesse respirado com força.\"", "e": ["ruptura", "gravitante"], "g": "cartas"},
	"folego_de_perseguicao": {"s": "Correr até o núcleo", "r": "A distância era curta. O tempo, lento.", "h": "Ela viu a esfera roxa entre as placas do monstro e correu. O teleporte falhou duas vezes; na terceira, o mundo rasgou e ela apareceu colada ao peito dele. Quanto mais longe o alvo, mais forte chega quem não desiste.", "n": "Gritei. Apertei o ar. Funcionou.", "l": "\"Terceira tentativa. Gritou. Apertou o ar com os dedos.\"", "e": ["aglomerador", "teleporte"], "g": "cartas"},
	"margem_de_erro": {"s": "\"Não permite margem para erros\"", "r": "O médico disse isso enquanto Henrique piorava.", "h": "\"Esse projeto não permite margem para erros. Mas também não permite retorno.\" Geovana decidiu que, se não havia margem, ela criaria uma: adiar parte da dor e pagar depois, em parcelas.", "n": "Não sabem? Vocês nem testaram em humanos.", "l": "\"Mas também... não permite retorno.\"", "e": ["d37", "equilibrista"], "g": "cartas"},
	"ressonancia_de_alternancia": {"s": "Áudios e textos", "r": "Ele mandava áudio, ela respondia com texto. Depois invertiam.", "h": "As primeiras conversas tinham um ritmo: áudios curtos dele, textos dela, depois trocavam, e riam disso também. A carta recompensa o mesmo jogo: alternar e não repetir.", "n": "A conversa fluía como se só tivesse sido pausada por engano.", "l": "\"Henrique mandava áudios curtos, e ela respondia com texto.\"", "e": ["henrique", "choque_fontes"], "g": "cartas"},
	"intervalo_fraturado": {"s": "Onze meses", "r": "Na física, tempo nenhum.", "h": "Entre a volta ao projeto e a ativação passaram onze meses. Para a física, nada. Para a equipe certa, suficiente. Para ela, cada dia um pouco mais perto. A carta comprime a espera.", "n": "Era cada dia mais perto de voltar para ele.", "l": "\"Na linguagem da física, era tempo nenhum.\"", "e": ["ruptura", "racional"], "g": "cartas"},
	"nucleo_revigorante": {"s": "A cápsula sintética", "r": "Proteína e carboidrato feitos a partir dos dados dela.", "h": "Os sapos não sabiam o que ela comia, então sintetizaram algo a partir das moléculas dela e deram uma dose mínima enquanto dormia. Tinha gosto metálico. Funcionou. Desde então, o que a cura funciona melhor.", "n": "Um motor girando com o combustível errado. Mas girando.", "l": "\"Conseguimos sintetizar uma combinação de proteínas e carboidratos.\"", "e": ["cartografo_vazio", "fase_4"], "g": "cartas"},
	"limiar_de_ruina": {"s": "\"De igual pra igual, monstrão!\"", "r": "O primeiro grito de guerra dela.", "h": "O monstro de pedra se levantou de novo e ela gritou com ironia, coberta de poeira. Ela bate mais forte em quem ainda está inteiro, porque foi assim que aprendeu: a primeira pancada é a que avisa.", "n": "Eu tava morrendo de medo. Gritei mesmo assim.", "l": "\"De igual pra igual, monstrão!\"", "e": ["aglomerador", "carrasco_de_colossos"], "g": "cartas"},
	"estase_reparadora": {"s": "A câmara de luz quente", "r": "O lugar onde ela acordou inteira.", "h": "Depois do toque da criatura branca, Geovana acordou numa câmara limpa, \"como se o tempo tivesse desacelerado propositalmente\". Nenhuma dor. Nenhum arranhão. Parar um pouco, às vezes, é o que remenda.", "n": "Aonde ele está? Eu nunca descobri o nome dele.", "l": "\"Não havia dor. Nem arranhões.\"", "e": ["sutura_gradual", "fase_3"], "g": "cartas"},
	"manto_de_impulso": {"s": "O casaco azul da foto", "r": "\"Uniforme de cientista do tempo.\"", "h": "Na foto que ela colou ao lado do letreiro PROJETO: RUPTURA, ela usa o casaco azul que Henrique dizia parecer uniforme de cientista do tempo. Ironia. Agora, a cada salto, um manto de energia a cobre por um instante.", "n": "Ele achava que era piada. Era profecia.", "l": "\"Ela usava o casaco azul que ele dizia parecer 'uniforme de cientista do tempo'.\"", "e": ["henrique", "ruptura"], "g": "cartas"},
	"recusa_do_dano": {"s": "Nenhuma reação", "r": "Não houve ardor. Nem queimadura.", "h": "Quando a gota de D37 tocou Henrique, não aconteceu nada: nenhum alerta, nenhum sintoma. Geovana transformou a lembrança mais cruel em regra: às vezes, o golpe simplesmente não pega. Ela nunca usa essa carta sem pensar nele.", "n": "Se não há sintomas, não há problema. Certo? Errado.", "l": "\"Não houve ardor. Nem queimadura. Nenhuma reação.\"", "e": ["d37", "henrique"], "g": "cartas"},
	"carrasco_de_colossos": {"s": "Um tiro no olho", "r": "Como o colosso de gelo caiu.", "h": "Ferida, esgotada, coberta de neve e sangue, ela juntou tudo o que restava num único disparo direto no olho da criatura. O impacto atravessou a cabeça \"como uma flecha de energia viva\". Contra gigantes, ela mira melhor.", "n": "Um momento quase solene. Depois ele caiu.", "l": "\"Disparou uma rajada direta contra o olho da criatura.\"", "e": ["nevasca", "limiar_de_ruina"], "g": "cartas"},
	"sutura_gradual": {"s": "O curativo de jaleco", "r": "Ela rasgou a roupa para tratar um desconhecido.", "h": "A criatura branca com auréola mancava com um corte feio na lateral. Geovana rasgou um pedaço do jaleco e amarrou com nós firmes. Mais tarde, foi a criatura que a remendou inteira. O que a gente cuida devolve devagar.", "n": "Tá bom. Mas não me atrasa, hein?", "l": "\"Rasgou um pedaço de seu jaleco e cuidadosamente envolveu a ferida.\"", "e": ["estase_reparadora", "fase_3"], "g": "cartas"},
	"egide_hemofaga": {"s": "Saturação 121%", "r": "Mais do que o corpo devia comportar.", "h": "No vórtice, o bracelete leu saturação de 121% e escreveu \"padrão sobre-humano\". O que transborda dela agora não escorre: endurece em volta, como escudo.", "n": "Estado: instável. Ainda é.", "l": "\"Alerta: padrão sobre-humano. Estado: instável.\"", "e": ["roubo_de_vida", "reserva_pulso"], "g": "cartas"},
	"fratura_cronal": {"s": "De roxo para azul", "r": "O núcleo do monstro mudando de cor devagar.", "h": "Com a mão dentro do peito do monstro, ela empurrou energia sem técnica, com raiva e memória. As rachaduras se abriram e a esfera foi mudando de roxo para azul. Não precisou explodir: bastou insistir.", "n": "Devagar... muito devagar. Mas mudou.", "l": "\"De roxo, foi assumindo tons azulados, crescendo em intensidade.\"", "e": ["aglomerador", "coletora"], "g": "cartas"},
	"pulso_desestabilizador": {"s": "112%", "r": "Acima de qualquer simulação autorizada.", "h": "Ela girou o regulador de fluxo à mão e a carga passou de 112%. Nenhum corpo vivo havia passado pelo arco. Às vezes os disparos dela ainda carregam esse excesso e estouram do jeito que o projeto nunca permitiu.", "n": "Ela sabia o risco. Eu sabia.", "l": "\"A tela pulsava: 112% — acima de qualquer simulação autorizada.\"", "e": ["ruptura", "critico_absoluto"], "g": "cartas"},
	"pressao_cerco": {"s": "Uma meia-lua de súditos", "r": "Os corrompidos voltando furiosos.", "h": "Depois que o Caranguejo caiu, os súditos que sobraram saíram das rachaduras em meia-lua, \"protestando em silêncio pela queda do seu deus\". Ela mal ficava de pé. Correu mesmo assim. Cercada, ela fica pior para quem cerca.", "n": "Não estavam cegos. Não estavam submissos. Estavam furiosos. Eu também.", "l": "\"Eles se aproximavam em meia-lua, contornando os escombros.\"", "e": ["comum", "vanguarda"], "g": "cartas"},
	"choque_fontes": {"s": "Dois laboratórios", "r": "O oficial seguia diretrizes. O do subsolo, ideias.", "h": "No projeto do governo, eles seguiam o protocolo; no laboratório da casa, escondido sob a porta do quarto de ferramentas, corrigiam cálculos e inventavam. Alternar entre os dois foi o que fez o projeto andar. Alternar fontes ainda quebra coisas.", "n": "A matemática vinha com a gente. Vivia na cabeça.", "l": "\"Uma porta camuflada no chão do quarto de ferramentas.\"", "e": ["henrique", "ressonancia_de_alternancia"], "g": "cartas"},
	"ferrolho_ruptura": {"s": "Trancou por dentro", "r": "Cada camada de segurança, uma por uma.", "h": "Ela girou a trava da porta principal e selou o laboratório por dentro, \"como numa coreografia ensaiada\". Ninguém entrou. Ninguém tirou dela a decisão. O que ela acerta agora fica preso do mesmo jeito.", "n": "Hoje. Vai ser hoje.", "l": "\"A ação foi firme. Definitiva.\"", "e": ["vanguarda", "general_aires"], "g": "cartas"},
	"limiar_colapso": {"s": "Arrancar o próprio núcleo", "r": "O monstro tirou a esfera do peito e desmoronou.", "h": "Infectado pela energia dela, o monstro de pedra rodou em círculos, bateu a cabeça e, por fim, abriu as placas e jogou o núcleo fora. Sem ele, ruiu como estátua abandonada. Perto do fim, até o que parecia invencível sente medo.", "n": "Não era fúria. Era conflito.", "l": "\"Com um movimento brusco, puxou o núcleo de dentro de si.\"", "e": ["aglomerador", "coletora"], "g": "cartas"},
	"desvio_probabilidade": {"s": "Rolar pela neve", "r": "Ela não sabia o que eram. Sabia que vinham.", "h": "Os raios de gelo vinham de todas as direções e ela rolava, escorregava, mergulhava por instinto. Cada desvio a deixava com mais raiva, e a raiva virou o próximo disparo. Esquivar não é fugir: é preparar.", "n": "Se vocês vão tentar me parar, vão precisar de muito mais.", "l": "\"Geovana rolava pela neve, escorregava, mergulhava por instinto.\"", "e": ["pinguim_atirador", "oportunista"], "g": "cartas"},
	"ponto_cego": {"s": "Atrás do barril", "r": "Como ela pegou Stiff.", "h": "Ela se escondeu atrás de um barril, esperou o rato humanoide se distrair com a fogueira e o imobilizou antes que ele gritasse. Não se orgulha. Mas aprendeu que quase tudo tem um lado que não está olhando.", "n": "Quieto, ou estourarei sua cabeça. Desculpa, Stiff.", "l": "\"Aproximou-se e imobilizou a criatura antes que pudesse reagir.\"", "e": ["stiff", "oportunista"], "g": "cartas"},
	"mandamento_ruptura": {"s": "As sete fases da lousa", "r": "Do mapeamento de vórtices à Ruptura experimental.", "h": "Fase 1: mapeamento de vórtices. Fase 2: espaço não linear. Fase 3: ancoragem. Fase 4: singularidade. Fase 5: interface neural. Fase 6: ativação com piloto. Fase 7: Ruptura. Ela escreveu em letras grandes e firmes. A carta segue a mesma disciplina: uma etapa de cada vez, até o colapso.", "n": "Não havia espaço para interpretação.", "l": "\"Cada etapa tinha um nome e uma meta.\"", "e": ["ruptura", "fase_1", "fase_7"], "g": "cartas"},
	"carta_zero": {"s": "Se eu inventar uma máquina do tempo", "r": "\"A primeira coisa que vou fazer é voltar no passado.\"", "h": "No skate park, Henrique prometeu voltar no tempo para se cutucar no ombro e apontar para \"a Geovaninha\". Ela prometeu construir primeiro. Construiu. A Carta Zero não volta anos: volta os últimos instantes. É o mais perto que ela chegou.", "n": "Desafio aceito. Eu ganhei, Henrique. Eu ganhei e você não tá aqui.", "l": "\"Então tá lançado o desafio.\"", "e": ["henrique", "racional"], "g": "cartas"},
	"necrocronismo": {"s": "Células que não morriam", "r": "Elas se quebravam e se replicavam errado.", "h": "Roberto explicou: o que entrou no corpo de Henrique não matava as células, as fragmentava e replicava de forma errada, \"como um câncer, mas com pressa\". A Ruptura aprendeu a mesma coisa e a carta usa contra os monstros: o que cai não descansa direito.", "n": "Não aceito um adeus, Roberto. Não agora.", "l": "\"As células não estão morrendo. Estão se quebrando em partes menores.\"", "e": ["d37", "rebobinador"], "g": "cartas"},
	"coracao_antimateria": {"s": "A esfera do primeiro monstro", "r": "Não era vidro, nem rocha, nem energia pura.", "h": "Do tamanho de uma laranja e densa demais, com a superfície \"como magma resfriado\". Quando ela tocou, a luz roxa sumiu e ficou só o azul. Foi o primeiro coração que ela tirou de alguém. Não foi o último.", "n": "Eu a guardei no bolso esquerdo. O de sempre.", "l": "\"Não era vidro, nem rocha, nem energia pura — mas tudo ao mesmo tempo.\"", "e": ["aglomerador", "petro_ficha"], "g": "cartas"},
	"cofre_excesso": {"s": "Bilhões e décadas", "r": "O que custaria começar de novo sem ela.", "h": "O alto escalão fez as contas: recomeçar o projeto custaria bilhões e décadas; confiar nela, instável e de luto, era \"o menor dos riscos\". Ninguém desperdiça nada nessa matemática. Nem o dano que sobra.", "n": "Eles aceitaram. Eu deixei.", "l": "\"Começar de novo custaria bilhões e décadas.\"", "e": ["valicente", "mercenaria"], "g": "cartas"},
	"critico_absoluto": {"s": "Interface neural: 91%", "r": "A última leitura antes do salto.", "h": "\"Interface neural conectada. Resposta sináptica: 91%.\" Ela olhou para o canto onde Henrique havia trabalhado e prometeu trazê-lo de volta. Os nove por cento que faltavam ela completou com vontade. O crítico dela vem desse resto.", "n": "Você me levou até aqui. Agora eu te trago de volta.", "l": "\"Interface neural conectada. Resposta sináptica: 91%.\"", "e": ["ruptura", "pulso_desestabilizador"], "g": "cartas"},
	"coracao_paradoxo": {"s": "Temporal ou emocional?", "r": "A pergunta colada ao lado da foto.", "h": "Ela colou a foto com fita isolante ao lado do letreiro e perguntou ao Henrique ausente se aquela ruptura seria temporal ou emocional. Ele quase respondeu. Quando o coração dela carrega, a fenda que abre é as duas coisas.", "n": "Ou emocional? Ele teria rido. Eu ri sozinha.", "l": "\"O que você diria, hein, Henrique...? Essa ruptura será temporal?\"", "e": ["ruptura", "henrique"], "g": "cartas"},
	"arquivo_impossivel": {"s": "O caderno pessoal", "r": "\"Estou chegando perto de onde ele ainda existe.\"", "h": "Toda noite, depois dos testes, ela sentava no chão perto do portal desativado e escrevia. O catálogo que você está lendo é a continuação desse caderno. Algumas páginas se repetem, porque algumas coisas ela precisa escrever duas vezes para acreditar.", "n": "Se você está lendo isso, eu ainda não voltei.", "l": "\"Escrevia no caderno pessoal.\"", "e": ["cartas", "pacto_possibilidades", "geovana"], "g": "cartas"},
	"fase_8": {"s": "Onde o tempo anda devagar", "r": "Um meio-dia que não termina.", "h": "Depois de sete travessias, a Ruptura às vezes erra o salto e cospe Geovana num sertão onde o sol não se mexe. Tudo aqui anda no passo de um jabuti: a poeira, as nuvens, até os projéteis, que param no ar antes de decidir para onde ir. É o mesmo tempo da praia da lua de mel, quando ninguém tinha pressa. Só que agora a pressa é toda dela, e o sertão não liga.", "n": "Passei meses tentando fazer o tempo andar mais rápido. Aqui ele me responde.", "l": "\"A areia era clara, fina, e grudava nos tornozelos como um lembrete gentil de que ali o tempo corria diferente.\"", "e": ["casco_de_sol", "jabuti_errante", "cagado_cangaceiro"], "d": 8, "img": "res://assets/story/arrive8_wide.jpg", "g": "fases"},
	"jabuti_errante": {"name": "Jabuti Errante", "s": "O passo mais lento do sertão", "r": "Anda devagar até lembrar que sabe girar.", "h": "Os jabutis daqui têm anéis no casco como árvores têm no tronco: cada anel é um ano que passou sem pressa. A Ruptura rachou alguns desses anéis, e por dentro deles o tempo vaza em violeta. Quando um jabuti sente o calor do bracelete de Geovana, recolhe a cabeça e vira pião, como se quisesse recuperar de uma vez todos os anos que perdeu.", "n": "Eles não me atacam. Eles me alcançam. É diferente, e é pior.", "l": "\"O sol nascia com calma, como se soubesse que não precisava apressar nada naquele momento.\"", "m": "Comum. Anda devagar; perto de você se recolhe no casco e desliza girando. Girando leva metade do dano; logo depois fica tonto e frágil.", "e": ["fase_8", "cagado_piao", "casco_de_sol"], "d": 8, "img": "res://assets/sprites/sertao/s8_jabuti_0.png", "g": "inimigos"},
	"tartaruga_mandacaru": {"name": "Tartaruga-Mandacaru", "s": "Um cacto que aprendeu a andar", "r": "Planta-se no chão e vira um relógio de espinhos.", "h": "Carrega um mandacaru inteiro no lugar do casco. Quando para, enterra as patas, e os braços do cacto giram devagar cuspindo espinhos em espiral, como ponteiros de relógio. Quem fica longe toma a espiral de frente; quem encosta vê os espinhos passarem pelos lados. Geovana aprendeu do pior jeito que, aqui, distância é o que machuca.", "n": "Chegar perto é mais seguro. Nunca achei que fosse dizer isso de um cacto.", "l": "\"Sabe quando a gente saía nas interclasses e o sol rachava tanto que até a quadra parecia derreter?\"", "m": "Especial. Mantém distância, se planta e dispara uma espiral de dois braços por 4 s, fechando com um anel. Plantada recebe 15% a mais de dano: encoste nela.", "e": ["fase_8", "jabuti_morteiro", "jabuti_errante"], "d": 8, "img": "res://assets/sprites/sertao/s8_mandacaru_0.png", "g": "inimigos"},
	"jabuti_morteiro": {"name": "Jabuti-Morteiro", "s": "O casco que virou moringa", "r": "Atira ovos de sol onde você vai estar.", "h": "O casco dele é uma moringa de barro rachada pelo calor, e por dentro ferve alguma coisa que não é água. Ele não mira onde você está: mira onde você vai estar, e os ovos estouram em estrelas de brasa. É o jeito de Geovana fazer contas, sempre um passo à frente e sempre errando por pouco o que importava.", "n": "Ele calcula onde eu vou estar. Eu fazia isso com gente. Não funcionava.", "l": "\"O relógio ainda marcava um sol alto quando ela cruzou os portões do complexo.\"", "m": "Especial. Fica longe e lança 3 ovos no ponto previsto; cada ovo explode em área e solta 8 brasas em estrela. Mude de direção quando ele mirar.", "e": ["fase_8", "tartaruga_mandacaru", "cagado_piao"], "d": 8, "img": "res://assets/sprites/sertao/s8_morteiro_0.png", "g": "inimigos"},
	"cagado_piao": {"name": "Cágado-Pião", "s": "Um pião de casco liso", "r": "Gira, quica e deixa areia parada no ar.", "h": "Cágados de rio que nunca viram um rio. Aprenderam a girar no barro rachado e a quicar em qualquer borda, deixando para trás grãos de areia que ficam parados no ar por meio segundo antes de disparar. Nesse meio segundo, o mundo inteiro parece esperar junto com Geovana.", "n": "Meio segundo parado no ar. Dá para pensar numa vida inteira em meio segundo.", "l": "\"A distância era curta, mas o tempo parecia lento.\"", "m": "Especial. Gira e dispara em linha reta, quicando 3 vezes numa caixa em volta de você. O rastro fica parado meio segundo e depois atira para os lados. Girando leva menos dano; tonto depois.", "e": ["fase_8", "jabuti_errante", "cagado_cangaceiro"], "d": 8, "img": "res://assets/sprites/sertao/s8_piao_0.png", "g": "inimigos"},
	"cagado_cangaceiro": {"name": "Cágado Cangaceiro", "s": "Quem cobra pedágio no meio-dia", "r": "Mini chefe. As balas dele param no ar e esperam você.", "h": "Chapéu de couro em meia-lua com moedas na aba, duas cartucheiras cruzadas no peito e dois revólveres velhos. Diz que estava esperando, e não explica o quê. A Tocaia dele é o luto em forma de bala: tudo para, tudo espera, e depois tudo vem de uma vez, na direção de quem ficou.", "n": "Ele disse que estava me esperando. Todo mundo nesses mundos diz isso. Ninguém explica.", "l": "\"O luto é lento. Doloroso. Confuso. Às vezes parece que a gente vai se perder dentro dele.\"", "m": "Mini chefe (aparece aos 2:30) e trava a chamada do chefe. Rajada dupla em leque, Xaxado (gira atirando em quatro braços), Casco Fechado (ricochete, quase imune) e, abaixo de 55% de vida, Tocaia: as balas param no ar e depois miram em você ao mesmo tempo.", "e": ["fase_8", "casco_de_sol", "lara"], "d": 8, "img": "res://assets/sprites/sertao/s8_cangaceiro_0.png", "g": "inimigos"},
	"casco_de_sol": {"name": "Casco-de-Sol", "s": "O jabuti que carrega o meio-dia", "r": "Um relógio de sol que aprendeu a andar.", "h": "Tão velho que o casco virou pedra e a pedra virou relógio: doze runas em volta e um gnômon no centro, cuja sombra é o único lugar fresco do sertão. Para ele, os meses em que Geovana ignorou o relógio foram um piscar. Ferido, ele rola; perto do fim, o sol escurece e o tempo para. Entre as engrenagens de bronze dentro do casco está o fragmento.", "n": "Eu passei meses ignorando o relógio. Esse aqui não deixa.", "l": "\"A rotina se resumia a acordar, ignorar o relógio, sentar-se diante de cálculos, registros, equações.\"", "m": "Estágio 1: Ponteiro das Horas, Doze Badaladas e Areia da Ampulheta (passe pelas brechas iluminadas). Estágio 2 (65%): Sombra do Gnômon (fique na sombra do relógio), Rolagem do Casco e Ninhada (quebre os ovos). Aos 30%, Eclipse: o tempo para e as balas voltam mais rápidas.", "e": ["fase_8", "cagado_cangaceiro", "geovana"], "d": 8, "img": "res://assets/sprites/sertao/boss8_walk_0.png", "g": "chefes"},
}
